+    // still identify Profile 7.  Do not copy dv_el_present: this group is an
+    // explicit two-stream relation, not an in-band BL+EL stream.
+    if (!bl_sh->codec->dovi && el_sh->codec->dovi) {
+        bl_sh->codec->dovi = true;
+        bl_sh->codec->dv_profile = el_sh->codec->dv_profile;
+        bl_sh->codec->dv_level = el_sh->codec->dv_level;
+    }
     // [Luna] The group is an explicit lavf relation, so retain the EL marker
     // when the disc/container demuxer mirrors this topology.
     el_sh->codec->dovi_el_only = true;
-- 
