diff --git a/video/decode/vd_lavc.c b/video/decode/vd_lavc.c
index e0a06f4..5cd6822 100644
--- a/video/decode/vd_lavc.c
+++ b/video/decode/vd_lavc.c
@@ -1320,6 +1320,22 @@ static int decode_frame(struct mp_filter *vd)
     // data.
     mp_assert(ctx->pic->buf[0]);
 
+    // The Profile 7 enhancement-layer decoder deliberately receives recovery
+    // pictures after a seek so its reference state can converge before the next
+    // clean random-access point. FFmpeg marks those pictures as corrupt. Keep
+    // them inside the decoder for recovery, but never pair them with a clean
+    // base-layer picture: doing so exposes transient block corruption after
+    // rapid exact seeks.
+    if (ctx->codec->dovi && ctx->codec->dv_profile == 7 &&
+        ctx->codec->dovi_el_only &&
