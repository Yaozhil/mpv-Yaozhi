From 5e45373252a01b3130c2b721ffb639056b60536b Mon Sep 17 00:00:00 2001
From: Luna <luna@yaozhi.local>
Date: Thu, 27 Aug 2026 12:59:25 +0800
Subject: [PATCH 5/5] expose Profile 7 metadata for authored Blu-ray

---
 demux/demux_disc.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/demux/demux_disc.c b/demux/demux_disc.c
index bee7b54..9c3f995 100644
--- a/demux/demux_disc.c
+++ b/demux/demux_disc.c
@@ -448,6 +448,27 @@ static void sync_streams(struct demuxer *demuxer)
             MP_TARRAY_APPEND(grp, grp->members, grp->num_members, outer_member);
             outer_member->group = grp;
         }
+
+        // Blu-ray authored Dolby Vision stores the Profile 7 relation in the
+        // BL+EL topology even when the MPEG-TS codec parameters do not carry a
+        // configuration record. The lavf group handler has already marked the
+        // dependent member as a Dolby Vision-only enhancement layer, so this
+        // is narrower than guessing from PIDs or from two ordinary HEVC tracks.
+        // Mirror descriptive metadata only; do not change the pairing or claim
+        // an in-band enhancement layer on the selectable base stream.
+        if (p->is_bd && outer->type == STREAM_VIDEO &&
+            !outer->dependent_track && outer->codec && !outer->codec->dovi)
+        {
+            struct sh_stream *el = sh_stream_dependent_sibling(outer);
+            if (el && el->codec && el->codec->dovi_el_only) {
+                outer->codec->dovi = true;
+                outer->codec->dv_profile = 7;
+                outer->codec->dv_level = el->codec->dv_level;
+                MP_VERBOSE(demuxer, "Blu-ray Dolby Vision group: exposing "
+                           "Profile 7 metadata on base stream 0x%x\n",
+                           outer->demuxer_id);
+            }
+        }
     }
 }
 
