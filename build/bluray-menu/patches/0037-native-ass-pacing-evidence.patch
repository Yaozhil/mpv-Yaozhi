+                " evidence=gpu_completion_bracket lower_ns=%"PRId64
+                " upper_ns=%"PRId64" present_expected=%u"
+                " present_actual=%u present_bound=%d\n", m->seq,
+                m->generation, m->frame_id, stage, m->ready_lower_ns,
+                m->ready_upper_ns, m->expected_present, m->actual_present,
+                m->present_bound);
