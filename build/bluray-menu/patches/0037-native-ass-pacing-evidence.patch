+static void d3d11_gpu_marker_end(struct ra_ctx *ctx, uint64_t frame_id,
+                               uint32_t stage)
+{
+    struct priv *p = ctx->priv;
+    if (!p->gpu_marker_active || !p->gpu_marker_context)
+        return;
+
+    // Intermediate probes only enqueue End; repeated polling at every stage
+    // would add observer work to the CPU critical path.
+    if (!stage)
+        d3d11_gpu_marker_poll(ctx, "draw_end_before_end");
+    if (!p->gpu_marker_active)
+        return;
+    if (!stage)
+        p->gpu_marker_last = -1;
+    int n = -1;
+    for (int i = 0; i < MP_D3D11_GPU_MARKER_RING; i++) {
+        if (!p->gpu_markers[i].in_use) {
+            n = i;
+            break;
+        }
+    }
+    if (n < 0) {
+        d3d11_gpu_marker_issue_error(ctx, frame_id, stage, 3, S_FALSE);
+        if (p->secondary_trace)
+            MP_INFO(ctx, "native-ass-gpu-marker: status=ring_full"
+                " generation=%"PRIu64" frame_id=%"PRIu64"\n",
+                p->gpu_marker_generation, frame_id);
+        return;
+    }
+
+    struct d3d11_gpu_marker *m = &p->gpu_markers[n];
+    if (!m->query) {
+        d3d11_gpu_marker_issue_error(ctx, frame_id, stage, 4, E_FAIL);
+        if (p->secondary_trace)
+            MP_INFO(ctx, "native-ass-gpu-marker: status=marker_unavailable"
+                " generation=%"PRIu64" frame_id=%"PRIu64"\n",
+                p->gpu_marker_generation, frame_id);
+        return;
+    }
+    ID3D11Query *query = m->query;
+    int64_t before_ns = mp_time_ns();
+    ID3D11DeviceContext_End(p->gpu_marker_context,
+                            (ID3D11Asynchronous *)query);
+    int64_t after_ns = mp_time_ns();
+    *m = (struct d3d11_gpu_marker) {
+        .query = query,
+        .seq = ++p->gpu_marker_next_seq,
+        .generation = p->gpu_marker_generation,
+        .frame_id = frame_id,
+        .vo_seq = ctx->vo->pacing_vo_seq,
+        .draw_seq = ctx->vo->pacing_draw_seq,
+        .swapchain_generation = p->present_generation,
+        .stage = stage,
+        .present_verified = stage != 0, // stage probes do not consume a Present
+        .issue_before_ns = before_ns,
+        .issue_after_ns = after_ns,
+        .last_not_ready_ns = before_ns,
+        .in_use = true,
+    };
+    if (!stage)
+        p->gpu_marker_last = n;
+    d3d11_gpu_marker_record(ctx, m, 0, S_OK);
+    if (p->secondary_trace)
+        MP_INFO(ctx, "native-ass-gpu-marker: status=queued"
+            " seq=%"PRIu64" generation=%"PRIu64" frame_id=%"PRIu64
+            " issue_before_ns=%"PRId64" issue_after_ns=%"PRId64"\n",
+            m->seq, m->generation, m->frame_id, before_ns, after_ns);
+}
