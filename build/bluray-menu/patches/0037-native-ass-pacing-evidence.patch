Subject: [PATCH 06/11] vo: separate immutable present plan from historical
 display delay


diff --git a/video/out/secondary_ass_physical.h b/video/out/secondary_ass_physical.h
index f892f9c..ca618dc 100644
--- a/video/out/secondary_ass_physical.h
+++ b/video/out/secondary_ass_physical.h
@@ -396,6 +396,34 @@ static inline void secondary_ass_physical_submit_point(
     }
 }
 
+// Opt-in consumers provide the immutable eligibility base selected before
+// drawing.  It is not the actual API cycle and is never reconstructed using
+// the current historical median.  The feedback/median implementation below
+// remains unchanged and measures actual-slot minus this planned base.
+static inline bool secondary_ass_physical_submit_planned_point(
+    struct secondary_ass_physical *p, uint64_t id, uint64_t epoch,
+    struct secondary_ass_physical_point base,
+    struct secondary_ass_physical_point target)
+{
+    if (p->epoch_exhausted || !id || !epoch || epoch != p->epoch ||
+        base.wall <= 0 || base.slot <= 0 || target.wall < base.wall ||
+        target.slot < base.slot ||
+        !secondary_ass_physical_interval_valid(p->interval))
+        return false;
+    if (p->submitted[(p->next + 31) % 32].id == id)
+        return false;
+    p->submitted[p->next].id = id;
+    p->submitted[p->next].base = base.wall;
+    p->submitted[p->next].base_slot = base.slot;
+    p->submitted[p->next].target_slot = target.slot;
+    p->next = (p->next + 1) % 32;
+    if (base.slot > p->last_base_slot) {
+        p->last_base_slot = base.slot;
+        p->last_base = base.wall;
+    }
+    return true;
+}
+
 static inline void secondary_ass_physical_submit(
     struct secondary_ass_physical *p, uint64_t id, int64_t intended)
 {
diff --git a/video/out/secondary_ass_present_plan.h b/video/out/secondary_ass_present_plan.h
new file mode 100644
index 0000000..d19d8a7
--- /dev/null
+++ b/video/out/secondary_ass_present_plan.h
@@ -0,0 +1,116 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_PRESENT_PLAN_H
+#define MP_SECONDARY_ASS_PRESENT_PLAN_H
+
+#include "secondary_ass_physical.h"
+
+// A planned eligibility base is not the actual Present-entry cycle.  Keep
+// the original plan immutable even when an early call or lifecycle fallback
+// changes its execution time.  Historical delay is diagnostic only here.
+struct secondary_ass_present_plan {
+    bool valid, fifo_known;
+    struct secondary_ass_physical_point base, target;
+    int64_t submit, deadline, fallback_submit, lifecycle_safe_wait;
+    int64_t interval, fifo_lower;
+    uint64_t epoch, generation;
+    int historical_delay;
+};
+
+static inline struct secondary_ass_physical secondary_ass_present_plan_view(
+    const struct secondary_ass_physical *p)
+{
+    struct secondary_ass_physical view = *p;
+    // This copy is for planning only.  Registration/feedback always mutate
+    // the original ledger and preserve its median and outlier rules.
+    view.delay = 0;
+    return view;
+}
+
+static inline struct secondary_ass_present_plan secondary_ass_present_plan_make(
+    const struct secondary_ass_physical *p,
+    struct secondary_ass_physical_point base,
+    struct secondary_ass_physical_point target)
+{
+    struct secondary_ass_present_plan plan = {
+        .base = base, .target = target, .epoch = p->epoch,
+        .generation = p->success_generation, .interval = p->interval,
+        .historical_delay = p->delay,
+    };
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    plan.fifo_lower = secondary_ass_physical_fifo_lower_bound(&view);
+    plan.fifo_known = plan.fifo_lower > 0;
+    if (base.slot <= 0 || target.slot < base.slot || base.wall <= 0 ||
+        target.wall < base.wall || base.slot <= p->last_base_slot ||
+        !p->epoch || p->epoch_exhausted ||
+        !secondary_ass_physical_interval_valid(p->interval) ||
+        secondary_ass_physical_point_at(&view, base.slot).slot != base.slot ||
+        secondary_ass_physical_point_at(&view, base.slot).wall != base.wall ||
+        secondary_ass_physical_point_at(&view, target.slot).slot != target.slot ||
+        secondary_ass_physical_point_at(&view, target.slot).wall != target.wall)
+        return plan;
+    plan.submit = secondary_ass_physical_submit_time(&view, base.wall);
+    plan.fallback_submit = secondary_ass_physical_submit_time(&view, target.wall);
+    plan.deadline = target.wall;
+    // After a generation/Sync0/mode change, old T cannot identify the next
+    // display cycle.  Waiting until the sampled target wall is conservative.
+    plan.lifecycle_safe_wait = target.wall;
+    plan.valid = plan.submit > 0 && plan.fallback_submit > 0;
+    return plan;
+}
+
+static inline struct secondary_ass_present_plan secondary_ass_present_plan_fresh(
+    const struct secondary_ass_physical *p, int64_t ready)
+{
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    // The existing strict next-cycle rule also handles exact-boundary ready.
+    struct secondary_ass_physical_point base =
+        secondary_ass_physical_predict_point(&view, ready);
+    int64_t lower = secondary_ass_physical_fifo_lower_bound(&view);
+    struct secondary_ass_physical_point target = base;
+    if (base.slot > 0 && lower > base.slot)
+        target = secondary_ass_physical_point_at(&view, lower);
+    return secondary_ass_present_plan_make(p, base, target);
+}
+
+static inline struct secondary_ass_present_plan secondary_ass_present_plan_cache(
+    const struct secondary_ass_physical *p,
+    struct secondary_ass_physical_point sample)
+{
+    // Cached draws keep the exact original sampler lattice target and wait
+    // inside its preceding Sync1 cycle.  No cache early path is introduced.
+    struct secondary_ass_present_plan plan =
+        secondary_ass_present_plan_make(p, sample, sample);
+    if (plan.fifo_known && plan.fifo_lower > sample.slot)
+        plan.valid = false;
+    return plan;
+}
+
+static inline bool secondary_ass_present_plan_current(
+    const struct secondary_ass_physical *p,
+    const struct secondary_ass_present_plan *plan)
+{
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    int64_t lower = secondary_ass_physical_fifo_lower_bound(&view);
+    return plan->valid && !p->epoch_exhausted && plan->epoch == p->epoch &&
+        plan->generation == p->success_generation &&
+        plan->base.slot > p->last_base_slot &&
+        (lower <= 0 || lower <= plan->target.slot) &&
+        secondary_ass_physical_point_at(&view, plan->target.slot).slot ==
+            plan->target.slot;
+}
+
+static inline struct secondary_ass_physical_point
+secondary_ass_present_plan_cache_next(const struct secondary_ass_physical *p,
+    int64_t first_slot, int64_t divisor, int64_t now)
+{
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    int64_t lower = secondary_ass_physical_fifo_lower_bound(&view);
+    // A count-proven lower bound can rule out an old sampler task.  Select
+    // another point only on the original divided lattice; never rename an
+    // already captured task or change the fresh eligibility base.
+    if (lower > 0 && lower - 1 > view.last_base_slot)
+        view.last_base_slot = lower - 1;
+    return secondary_ass_physical_cache_next(&view, first_slot, divisor, now);
+}
+
+#endif
