+
+static void secondary_observe_flip_budget(struct vo *vo,
+    const struct vo_vsync_info *vsync,
+    const struct secondary_ass_present_plan *plan, int64_t begin,
+    int64_t vo_wait, int64_t flip_begin, bool guard_armed, bool fresh)
+{
+    struct vo_internal *in = vo->in;
+    if (!in->secondary_split_budget)
+        return;
+    int64_t end = mp_time_ns();
+    bool valid = guard_armed && plan && plan->valid && !vsync->secondary_phase_reset &&
+        vsync->secondary_submit_valid && vsync->secondary_submit_sync_interval == 1 &&
+        vsync->secondary_submit_generation == plan->generation &&
+        plan->epoch == in->secondary_physical.epoch &&
