         }
     }
     if (frame->display_synced && clock_rate > 0) {
@@ -1669,14 +1708,40 @@ static bool do_redraw(struct vo *vo, uint64_t current_id, uint64_t queued_id,
                 frame->frame_id, frame->display_synced, presentation_time,
                 display_interval, physical_phase, in->secondary_physical.delay,
                 in->secondary_physical.phase);
-    in->secondary_last_draw = mp_time_ns();
+    // Record the same execution boundaries for control and candidate draws.
+    // Capture them before feedback can refine the period or learned delay.
+    int64_t trace_deadline = grid_task ? grid_task->deadline :
+        secondary_ass_physical_cache_deadline(physical_point, display_interval,
+                                             in->secondary_physical.delay);
+    int64_t trace_submit = grid_task ? grid_task->submit_time :
+        secondary_ass_physical_submit_time(&in->secondary_physical, presentation_time);
+    uint64_t trace_epoch = grid_task ? grid_task->epoch : in->secondary_physical.epoch;
