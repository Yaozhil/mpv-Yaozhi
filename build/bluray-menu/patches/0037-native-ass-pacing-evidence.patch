diff --git a/test/secondary_ass_physical.c b/test/secondary_ass_physical.c
new file mode 100644
index 0000000..a7491e1
--- /dev/null
+++ b/test/secondary_ass_physical.c
@@ -0,0 +1,370 @@
+#include <stdint.h>
+
+#include "test_utils.h"
+#include "video/out/secondary_ass_physical.h"
+
+static const int64_t origin = INT64_C(1000000000);
+
+static struct secondary_ass_physical make_state(int64_t interval)
+{
+    return (struct secondary_ass_physical){
+        .phase = origin, .phase_slot = 100, .interval = interval, .epoch = 7,
+        .sync_qpc_ns = origin, .sync_count = 100, .sync_slot = 100,
+        .sync_segment_consistent = true,
+        .measure_qpc_ns = origin, .measure_count = 100,
+        .periods = {interval, interval, interval},
+        .period_count = 3, .period_next = 3,
+        .historical_id = 10, .last_submit_id = 10,
+        .delay = 1, .delay_samples = {1, 1, 2}, .delay_count = 3,
+    };
+}
+
+static bool observe(struct secondary_ass_physical *p, int64_t step,
+                    uint32_t count)
+{
+    return secondary_ass_physical_observe(p, origin + step * p->interval,
+                                          count, p->interval);
+}
+
+static bool bad(struct secondary_ass_physical *p, int64_t step, uint32_t count)
+{
+    return secondary_ass_physical_observe(p,
+        origin + step * p->interval - p->interval * 2 / 5, count, p->interval);
+}
+
+static struct secondary_ass_physical_point point(int64_t interval, int64_t slot)
+{
+    return (struct secondary_ass_physical_point){
+        .slot = slot, .wall = origin + (slot - 100) * interval,
+    };
+}
+
+static void phase_kept(const struct secondary_ass_physical *p)
+{
+    assert_int_equal(p->phase, origin);
+    assert_int_equal(p->phase_slot, 100);
+    assert_int_equal(p->epoch, 7);
+}
+
+static void learner_kept(const struct secondary_ass_physical *p)
+{
+    assert_int_equal(p->delay, 1);
+    assert_int_equal(p->delay_count, 3);
+    assert_int_equal(p->delay_next, 0);
+    assert_int_equal(p->delay_samples[0], 1);
+    assert_int_equal(p->delay_samples[1], 1);
+    assert_int_equal(p->delay_samples[2], 2);
+    assert_int_equal(p->period_count, 3);
+    assert_int_equal(p->period_next, 3);
+    for (unsigned n = 0; n < 3; n++)
+        assert_int_equal(p->periods[n], p->interval);
+}
+
+static void test_single_bad(int64_t interval)
+{
+    const uint32_t first_counts[] = {100, 102};
+    for (unsigned k = 0; k < 2; k++) {
+        struct secondary_ass_physical p = make_state(interval);
+        assert_false(bad(&p, 2, first_counts[k]));
+        phase_kept(&p);
+        learner_kept(&p);
+        assert_true(p.outlier_pending);
+        assert_false(p.sync_segment_consistent);
+        assert_int_equal(p.sync_slot, 100);
+        assert_int_equal(p.sync_qpc_ns, origin);
+        assert_int_equal(p.sync_count, 100);
+        for (unsigned n = 0; n < 20; n++)
+            assert_false(bad(&p, 2, first_counts[k]));
+        phase_kept(&p);
+        assert_false(bad(&p, 3, first_counts[k]));
+        phase_kept(&p); // Different QPC with the same raw count is not proof.
+        learner_kept(&p);
+        if (first_counts[k] == 100) {
+            assert_false(secondary_ass_physical_sample_available(&p,
+                         point(interval, 101).wall));
+        } else {
+            assert_int_equal(secondary_ass_physical_point_at(&p, 104).slot, 104);
+            assert_int_equal(secondary_ass_physical_point_at(&p, 105).slot, 0);
+        }
+        // Recovering the original raw count agreement skips gap feedback.
+        assert_false(observe(&p, 3, 103));
+        assert_false(p.outlier_pending);
+        assert_false(p.sync_segment_consistent);
+        assert_int_equal(p.history_floor_slot, 103);
+        assert_int_equal(p.measure_qpc_ns, origin + 3 * interval);
+        assert_int_equal(p.measure_count, 103);
+        phase_kept(&p);
+        learner_kept(&p);
+        assert_true(observe(&p, 4, 104));
+        assert_true(p.sync_segment_consistent);
+        assert_true(secondary_ass_physical_sample_available(&p,
+                    point(interval, 105).wall));
+    }
+
+    struct secondary_ass_physical p = make_state(interval);
+    assert_false(bad(&p, 2, 102));
+    assert_false(bad(&p, 3, 103));
+    assert_int_equal(p.phase, 0); // Preserve the old independently advanced rule.
+    assert_int_equal(p.phase_slot, 0);
+    assert_int_equal(p.epoch, 7);
+}
+
+static void test_lost_count_recovery(int64_t interval)
+{
+    struct secondary_ass_physical p = make_state(interval);
+    assert_false(bad(&p, 2, 100));
+    for (unsigned n = 0; n < 20; n++)
+        assert_false(observe(&p, 2, 101));
+    assert_true(p.outlier_pending);
+    assert_int_equal(p.recovery_slot, 102);
+    assert_int_equal(p.sync_slot, 100);
+    assert_false(secondary_ass_physical_sample_available(&p,
+                 point(interval, 104).wall));
+    assert_false(observe(&p, 3, 102));
+    assert_false(p.outlier_pending);
+    assert_int_equal(p.sync_qpc_ns, origin + 3 * interval);
+    assert_int_equal(p.sync_slot, 103);
+    assert_int_equal(p.sync_count, 102);
+    assert_int_equal(p.recovery_qpc_ns, 0);
+    assert_int_equal(p.history_floor_slot, 103);
+    assert_false(p.sync_segment_consistent);
+    phase_kept(&p);
+    learner_kept(&p);
+    assert_true(secondary_ass_physical_sample_available(&p,
+                point(interval, 104).wall));
+    // The one-count loss stays permanent; availability cannot wait for it.
+    for (int n = 4; n < 10004; n++) {
+        assert_true(observe(&p, n, (uint32_t)(100 + n - 1)));
+        assert_false(p.outlier_pending);
+        assert_int_equal(p.sync_slot, 100 + n);
+        assert_true(secondary_ass_physical_sample_available(&p,
+                    point(interval, 101 + n).wall));
+    }
+    phase_kept(&p);
+
+    p = make_state(interval);
+    assert_false(bad(&p, 2, 100));
+    assert_false(observe(&p, 2, 101));
+    assert_false(observe(&p, 3, 101)); // A stalled candidate is not recovery.
+    assert_true(p.outlier_pending);
+    assert_int_equal(p.recovery_slot, 103);
+    assert_false(observe(&p, 4, 102));
+    assert_false(p.outlier_pending);
+    assert_int_equal(p.sync_slot, 104);
+    phase_kept(&p);
+
+    p = make_state(interval);
+    p.sync_count = UINT32_MAX - 1;
+    assert_false(bad(&p, 2, UINT32_MAX - 1));
+    assert_false(observe(&p, 2, UINT32_MAX));
+    assert_false(observe(&p, 3, 0));
+    assert_false(p.outlier_pending);
+    assert_int_equal(p.sync_slot, 103);
+    assert_true(observe(&p, 4, 1));
+    phase_kept(&p);
+}
+
+static void test_threshold_and_stale(int64_t interval)
+{
+    struct secondary_ass_physical p = make_state(interval);
+    assert_false(bad(&p, 2, 100));
+    int64_t first = origin + 2 * interval + interval / 4;
+    assert_false(secondary_ass_physical_observe(&p, first, 101, interval));
+    assert_true(p.outlier_pending);
+    // Both original-lattice residuals pass T/4, but their relative residual
+    // must independently pass the same threshold; do not widen it to T/2.
+    int64_t second = origin + 3 * interval - interval / 4;
+    assert_false(secondary_ass_physical_observe(&p, second, 102, interval));
+    assert_true(p.outlier_pending);
+    assert_false(secondary_ass_physical_observe(&p, first, 101, interval));
+    assert_int_equal(p.recovery_qpc_ns, second); // Stale anchor cannot replace it.
+    assert_false(secondary_ass_physical_observe(&p,
+                 origin + 4 * interval - interval / 4, 103, interval));
+    assert_false(p.outlier_pending);
+    phase_kept(&p);
+
+    p = make_state(interval);
+    assert_false(secondary_ass_physical_observe(&p, origin - interval, 99,
+                                               interval));
+    assert_false(p.outlier_pending);
+    assert_int_equal(p.sync_slot, 100);
+    phase_kept(&p);
+    p.sync_qpc_ns = 1;
+    assert_false(secondary_ass_physical_observe(&p, INT64_MAX, 102, interval));
+    assert_int_equal(p.sync_slot, 100); // Checked rounding overflow.
+    phase_kept(&p);
+}
+
+static void update(struct secondary_ass_physical *p, int64_t step,
+                   uint32_t count, uint32_t present_count, uint64_t historical_id)
+{
+    secondary_ass_physical_update_observed(p, false, 0,
+        (struct secondary_ass_physical_point){0}, origin + step * p->interval,
+        origin + step * p->interval, count, present_count, historical_id,
+        p->interval);
+}
+
+static void test_gap_history(int64_t interval)
+{
+    struct secondary_ass_physical p = make_state(interval);
+    secondary_ass_physical_submit_point(&p, 11, point(interval, 102));
+    assert_int_equal(p.submitted[0].base_slot, 101);
+    assert_false(bad(&p, 2, 100));
+    assert_true(p.submitted[0].gap_excluded);
+    secondary_ass_physical_submit_point(&p, 12, point(interval, 104));
+    assert_true(p.submitted[1].gap_excluded);
+    update(&p, 2, 101, 101, 11);
+    update(&p, 3, 102, 102, 11);
+    assert_false(p.outlier_pending);
+    assert_false(p.sync_segment_consistent);
+    assert_int_equal(p.historical_id, 10); // Recovery call does not feed history.
+    phase_kept(&p);
+    learner_kept(&p);
+    assert_int_equal(p.submitted[0].base_slot, 101);
+    assert_int_equal(p.submitted[0].target_slot, 102);
+    assert_int_equal(p.submitted[1].base_slot, 103);
+    assert_int_equal(p.submitted[1].target_slot, 104);
+
+    update(&p, 4, 103, 102, 11); // Old/gap ID cannot cross new count segment.
+    phase_kept(&p);
+    learner_kept(&p);
+    assert_int_equal(p.historical_id, 10);
+    update(&p, 4, 103, 102, 999); // Unregistered history cannot extrapolate.
+    phase_kept(&p);
+    update(&p, 4, 103, 103, 11); // Exact pair has a real current physical point.
+    assert_int_equal(p.phase, origin + 4 * interval);
+    assert_int_equal(p.phase_slot, 104);
+    assert_int_equal(p.historical_id, 11);
+    learner_kept(&p); // Same ID still cannot synthesize a cross-gap delay.
+    update(&p, 5, 104, 104, 11);
+    learner_kept(&p); // A repeated historical ID is not another observation.
+    update(&p, 5, 104, 104, 12);
+    learner_kept(&p); // Submitted during quarantine is also excluded.
+
+    secondary_ass_physical_submit_point(&p, 13, point(interval, 103));
+    assert_false(p.submitted[2].gap_excluded);
+    assert_int_equal(p.submitted[2].base_slot, 102);
+    update(&p, 6, 105, 106, 13); // New ID with pre-floor base is still ambiguous.
+    learner_kept(&p);
+    assert_int_equal(p.historical_id, 12);
+
+    secondary_ass_physical_submit_point(&p, 14, point(interval, 106));
+    assert_int_equal(p.submitted[3].base_slot, 105);
+    assert_int_equal(p.submitted[3].target_slot, 106);
+    update(&p, 7, 106, 106, 14);
+    assert_int_equal(p.phase_slot, 107);
+    assert_int_equal(p.phase - (p.phase_slot - 100) * interval, origin);
+    assert_int_equal(p.delay_samples[0], 2); // Actual slot minus saved base.
+    assert_int_equal(p.delay, 2);
+    assert_int_equal(p.delay_next, 1);
+    assert_int_equal(p.submitted[3].base_slot, 105); // Median cannot rewrite it.
+    assert_int_equal(p.submitted[3].target_slot, 106);
+    update(&p, 8, 107, 107, 14);
+    assert_int_equal(p.delay_next, 1);
+    assert_int_equal(p.delay_samples[0], 2);
+    int64_t kept_phase = p.phase;
+    secondary_ass_physical_feedback_point(&p, point(interval, 102), 15);
+    assert_int_equal(p.phase, kept_phase); // Explicit history floor is checked.
+    assert_int_equal(p.historical_id, 14);
+}
+
+static void test_cleared_phase_bootstrap(int64_t interval)
+{
+    struct secondary_ass_physical p = make_state(interval);
+    secondary_ass_physical_submit_point(&p, 11, point(interval, 102));
+    assert_false(bad(&p, 2, 102));
+    assert_false(bad(&p, 3, 103));
+    assert_int_equal(p.phase, 0);
+    update(&p, 4, 103, 103, 11);
+    update(&p, 5, 104, 104, 11);
+    assert_false(p.outlier_pending);
+    assert_int_equal(p.phase, 0); // Recovery itself remains history-isolated.
+    update(&p, 6, 105, 105, 11);
+    assert_int_equal(p.phase, origin + 6 * interval);
+    assert_int_equal(p.phase_slot, 106);
+    assert_int_equal(p.epoch, 7);
+    learner_kept(&p);
+    assert_true(secondary_ass_physical_sample_available(&p,
+                point(interval, 107).wall));
+    secondary_ass_physical_reset(&p);
+    assert_int_equal(p.epoch, 8);
+    assert_int_equal(p.history_floor_slot, 0);
+    assert_int_equal(p.recovery_qpc_ns, 0);
+    assert_false(p.submitted[0].gap_excluded);
+    p.epoch = UINT64_MAX;
+    secondary_ass_physical_reset(&p);
+    assert_true(p.epoch_exhausted);
+    assert_false(observe(&p, 1, 1));
+}
+
+static void test_planned_base_and_clock_domains(int64_t interval)
+{
+    struct secondary_ass_physical p = make_state(interval);
+    const int64_t qpc_origin = origin + INT64_C(100000000000);
+    p.sync_qpc_ns = p.measure_qpc_ns = qpc_origin;
+    assert_true(secondary_ass_physical_submit_planned_point(&p, 11, p.epoch,
+                point(interval, 101), point(interval, 104)));
+    assert_false(secondary_ass_physical_observe(&p,
+                 qpc_origin + 2 * interval - interval * 2 / 5, 100, interval));
+    assert_true(p.submitted[0].gap_excluded);
+    for (int n = 2; n <= 3; n++) {
+        secondary_ass_physical_update_observed(&p, false, 0,
+            (struct secondary_ass_physical_point){0}, qpc_origin + n * interval,
+            origin + n * interval, (uint32_t)(99 + n), (uint32_t)(99 + n),
+            11, interval);
+    }
+    assert_false(p.outlier_pending);
+    assert_int_equal(p.sync_qpc_ns, qpc_origin + 3 * interval);
+    phase_kept(&p); // A raw QPC must never be copied into the wall/ASS phase.
+    learner_kept(&p);
+    secondary_ass_physical_update_observed(&p, false, 0,
+        (struct secondary_ass_physical_point){0}, qpc_origin + 4 * interval,
+        origin + 4 * interval, 103, 103, 11, interval);
+    learner_kept(&p);
+    assert_int_equal(p.phase, origin + 4 * interval);
+    assert_true(secondary_ass_physical_submit_planned_point(&p, 12, p.epoch,
+                point(interval, 105), point(interval, 109)));
+    // The API history refers to slot 107; learning is 107-105, never 107-109.
+    secondary_ass_physical_update_observed(&p, false, 0,
+        (struct secondary_ass_physical_point){0}, qpc_origin + 6 * interval,
+        origin + 6 * interval, 105, 106, 12, interval);
+    assert_int_equal(p.phase_slot, 107);
+    assert_int_equal(p.phase, origin + 7 * interval);
+    assert_int_equal(p.delay, 2);
+    assert_int_equal(p.delay_samples[0], 2);
+    assert_int_equal(p.submitted[1].base_slot, 105);
+    assert_int_equal(p.submitted[1].target_slot, 109);
+    assert_false(secondary_ass_physical_submit_planned_point(&p, 12, p.epoch,
+                 point(interval, 107), point(interval, 110)));
+    assert_int_equal(p.submitted[1].base_slot, 105); // Same ID is immutable.
+    assert_int_equal(p.submitted[1].target_slot, 109);
+    assert_int_equal(p.epoch, 7);
+
+    // A reused ring entry loses its previous gap exclusion only upon a new
+    // identified submission; legacy coordinates cannot survive the overwrite.
+    p = make_state(interval);
+    p.submitted[0].gap_excluded = true;
+    secondary_ass_physical_submit_point(&p, 20, point(interval, 106));
+    assert_false(p.submitted[0].gap_excluded);
+    p.next = 0;
+    p.phase_slot = 0;
+    secondary_ass_physical_submit(&p, 21, point(interval, 107).wall);
+    assert_int_equal(p.submitted[0].base_slot, 0);
+    assert_int_equal(p.submitted[0].target_slot, 0);
+    assert_false(p.submitted[0].gap_excluded);
+}
+
+int main(void)
+{
+    const int rates[] = {60, 120, 144, 165, 240, 360, 480};
+    for (unsigned n = 0; n < sizeof(rates) / sizeof(rates[0]); n++) {
+        int64_t interval = INT64_C(1000000000) / rates[n];
+        test_single_bad(interval);
+        test_lost_count_recovery(interval);
+        test_threshold_and_stale(interval);
+        test_gap_history(interval);
+        test_cleared_phase_bootstrap(interval);
+        test_planned_base_and_clock_domains(interval);
+    }
+    return 0;
+}
