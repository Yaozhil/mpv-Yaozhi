@@ -366,7 +421,8 @@ static inline void secondary_ass_physical_submit(
 static inline int64_t secondary_ass_physical_prepare(
     const struct secondary_ass_physical *p, int64_t sample)
 {
-    if (!p->phase || sample <= 0)
+    if (!p->phase || sample <= 0 ||
+        !secondary_ass_physical_sample_available(p, sample))
         return 0;
     return sample - p->delay * p->interval - p->interval / 2;
 }
@@ -389,7 +445,8 @@ static inline int64_t secondary_ass_physical_submit_time(
     const struct secondary_ass_physical *p, int64_t sample)
 {
     if (!p->phase || !secondary_ass_physical_interval_valid(p->interval) ||
-        p->delay < 0 || p->delay > 4 || sample <= (p->delay + 1) * p->interval)
+        p->delay < 0 || p->delay > 4 || sample <= (p->delay + 1) * p->interval ||
+        !secondary_ass_physical_sample_available(p, sample))
         return 0;
     // Present(sync=1) may target only the next scanout after its base cycle.
     // Submit just inside that cycle, leaving GPU/flip completion headroom.
@@ -409,6 +466,44 @@ static inline int64_t secondary_ass_physical_render_slot_time(
     return submit - cost;
 }
 
+// A sync=1 Present must enter before its original base scanout. This boundary
+// is separate from the preferred submit time and from CPU/GPU completion.
+static inline int64_t secondary_ass_physical_cache_deadline(
+    struct secondary_ass_physical_point sample, int64_t interval, int delay)
+{
+    if (!secondary_ass_physical_interval_valid(interval) || delay < 0 ||
+        delay > 4 || sample.slot <= delay || sample.wall <= delay * interval)
+        return 0;
+    return sample.wall - delay * interval;
+}
+
+// Select a new task on the existing divided lattice. Do not rename a task
+// after a late wakeup, or retry a sampler slot that can no longer be submitted.
+// This is a scheduling decision only: physical phase and sampler state stay put.
+static inline struct secondary_ass_physical_point secondary_ass_physical_cache_next(
+    const struct secondary_ass_physical *p, int64_t next_slot, int64_t divisor,
+    int64_t now)
+{
+    struct secondary_ass_physical_point sample =
+        secondary_ass_physical_point_at(p, next_slot);
+    int64_t deadline = secondary_ass_physical_cache_deadline(sample, p->interval, p->delay);
+    if (now <= 0 || deadline <= 0 || divisor <= 0 ||
+        divisor > INT64_MAX / p->interval)
+        return (struct secondary_ass_physical_point){0};
+    int64_t skip = 0;
+    if (deadline <= now)
+        skip = (now - deadline) / (divisor * p->interval) + 1;
+    int64_t base_slot = sample.slot - p->delay;
+    if (base_slot <= p->last_base_slot) {
+        int64_t occupied_skip = (p->last_base_slot - base_slot) / divisor + 1;
+        if (occupied_skip > skip)
+            skip = occupied_skip;
+    }
+    if (skip > (INT64_MAX - next_slot) / divisor)
+        return (struct secondary_ass_physical_point){0};
+    return secondary_ass_physical_point_at(p, next_slot + skip * divisor);
+}
+
 // The cache uses its original ASS slot while its headroom is bounded by the
 // unmodified fresh-video target. Never round that video target onto the ASS
 // lattice: doing so grants cache time by delaying the primary picture.
@@ -434,13 +529,16 @@ static inline int64_t secondary_ass_physical_cache_sample_prepare(
             now + fresh_cost > fresh_pts ? now + fresh_cost : fresh_pts);
     if (sample.wall <= 0 || fresh.wall <= 0 || sample.slot >= fresh.slot ||
         p->delay < 0 || p->delay > 4 || sample.slot <= p->delay ||
-        sample.slot - p->delay <= p->last_base_slot)
+        sample.slot - p->delay <= p->last_base_slot ||
+        now >= secondary_ass_physical_cache_deadline(sample, p->interval, p->delay))
         return 0;
     int64_t prepare = secondary_ass_physical_render_slot_time(p, sample.wall, redraw_cost);
     if (prepare < earliest_redraw)
         prepare = earliest_redraw;
     if (prepare <= 0 || (prepare > now && prepare - now > duration))
         return 0;
+    if (prepare >= secondary_ass_physical_cache_deadline(sample, p->interval, p->delay))
+        return 0;
     int64_t deadline = fresh.wall - p->delay * p->interval - p->interval / 4;
     return secondary_ass_budget_before_deadline(now > prepare ? now : prepare,
         deadline, fresh_cost, block_cost, 1000000) ? prepare : 0;
