Date: Sat, 3 Oct 2026 14:14:53 +0800
Subject: [PATCH 02/11] vo: require count agreement before ending timing
 quarantine


diff --git a/video/out/secondary_ass_physical.h b/video/out/secondary_ass_physical.h
index bfe7461..1943e41 100644
--- a/video/out/secondary_ass_physical.h
+++ b/video/out/secondary_ass_physical.h
@@ -205,12 +205,17 @@ static inline bool secondary_ass_physical_observe(
         p->measure_qpc_ns = 0;
         return false;
     }
-    p->outlier_pending = false;
-    p->outlier_qpc_ns = 0;
-    p->outlier_count = 0;
     uint32_t passed = count - p->sync_count;
     bool consistent = passed < UINT32_C(0x80000000) &&
                       (uint64_t)steps == passed;
+    // QPC landing on the old grid is insufficient if the independently
+    // observed count did not advance with it. A repeated/stalled statistic
+    // must not remove the count horizon or enter the delay learner.
+    if (p->outlier_pending && !consistent)
+        return false;
+    p->outlier_pending = false;
+    p->outlier_qpc_ns = 0;
+    p->outlier_count = 0;
     p->sync_slot += steps;
     p->sync_qpc_ns = qpc_ns;
     p->sync_count = count;
-- 
