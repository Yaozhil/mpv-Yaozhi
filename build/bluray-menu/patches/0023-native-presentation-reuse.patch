     return false;
 }
 
+// Cache only until the next event boundary. This avoids scanning a complete
+// preloaded track at every high-refresh tick, while still recognizing new moving,
+// fading, transforming, karaoke and Effect events after a static interval.
+static bool secondary_has_animation(struct sd_ass_priv *ctx, ASS_Track *track,
+                                    long long ts)
+{
+    if (ctx->animation_valid && ts >= ctx->animation_from && ts < ctx->animation_until)
+        return ctx->animation_active;
+
+    ctx->animation_from = ts;
+    ctx->animation_until = LLONG_MAX;
+    ctx->animation_active = false;
+    for (int i = 0; i < track->n_events; i++) {
+        ASS_Event *event = &track->events[i];
+        if (event->Duration <= 0)
+            continue;
+        if (event->Start > ts) {
+            ctx->animation_until = MPMIN(ctx->animation_until, event->Start);
+            continue;
+        }
+        long long end = event->Start > LLONG_MAX - event->Duration
+                            ? LLONG_MAX : event->Start + event->Duration;
+        if (ts >= end)
+            continue;
+        ctx->animation_until = MPMIN(ctx->animation_until, end);
+        if ((event->Effect && event->Effect[0]) ||
+            (event->Text && is_animated(event->Text)))
+            ctx->animation_active = true;
+    }
+    ctx->animation_valid = true;
+    return ctx->animation_active;
+}
+
 // Note: pkt is not necessarily a fully valid refcounted packet.
 static void filter_and_add(struct sd *sd, struct demux_packet *pkt)
 {
     struct sd_ass_priv *ctx = sd->priv;
+    ctx->animation_valid = false;
     struct demux_packet *orig_pkt = pkt;
     ASS_Track *track = ctx->ass_track;
     int old_n_events = track->n_events;
@@ -828,6 +865,8 @@ static struct sub_bitmaps *get_bitmaps(struct sd *sd, struct mp_osd_res dim,
     ASS_Image *imgs = ass_render_frame(renderer, track, ts, &changed);
     int64_t pack_start = timing ? mp_time_ns() : 0;
     mp_sub_packer_pack_ass(ctx->packer, &imgs, 1, changed, !converted, format, res);
+    if (sd->order == 1 && !converted)
+        res->static_image = !secondary_has_animation(ctx, track, ts);
     if (timing) {
         int64_t ass_ns = pack_start - ass_start;
         int64_t pack_ns = mp_time_ns() - pack_start;
@@ -1081,6 +1120,7 @@ static void fill_plaintext(struct sd *sd, double pts)
