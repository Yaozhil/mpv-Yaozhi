+    entry->upload_change_id = item->change_id;
+    entry->upload_format = item->format;
+    entry->upload_w = item->packed_w;
+    entry->upload_h = item->packed_h;
     if (p->timing_diagnostics) {
         p->timing_uploads++;
         p->timing_upload_bytes += (uint64_t)item->packed_w * item->packed_h *
@@ -1361,7 +1378,14 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
     struct pl_render_params params = pars->params;
     const struct gl_video_opts *opts = p->opts_cache->opts;
     bool will_redraw = frame->display_synced && frame->num_vsyncs > 1;
-    bool cache_frame = will_redraw || frame->still || p->paused;
+    // Independent subtitle ticks are not represented by num_vsyncs. Cache the
+    // fresh video frame too, otherwise its first subtitle redraw renders it a
+    // second time before subsequent redraws can reuse it. Keep video-blended
+    // subtitles on their original path, where subtitle changes affect the image.
+    double secondary_rate = osd_get_secondary_refresh(vo->osd);
+    bool secondary_redraw = !opts->blend_subs && secondary_rate > 0 &&
+        frame->duration > MP_TIME_S_TO_NS(1.0 / secondary_rate);
+    bool cache_frame = will_redraw || secondary_redraw || frame->still || p->paused;
     bool can_interpolate = opts->interpolation && frame->display_synced &&
                            !frame->still && frame->num_frames > 1 && !p->paused;
     if (p->timing_diagnostics) {
@@ -1779,7 +1803,7 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
             MP_INFO(vo, "native-vo-cost: upload=%.2f/s upload-MiB=%.3f/s "
                     "upload-cpu=%.3fms/s frame-passes=%.2f/s blend-passes=%.2f/s "
                     "render-avg=%.3fms render-max=%.3fms "
-                    "present-avg=%.3fms present-max=%.3fms tex-pool=%d\n",
