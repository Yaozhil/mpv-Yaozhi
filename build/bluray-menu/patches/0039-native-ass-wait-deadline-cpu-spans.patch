@@ -1655,10 +1670,12 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
 
     struct pl_swapchain_frame swframe;
     pacing_gpu_stage(vo, 100, 0);
+    vo_pacing_span_now(vo, 100, 0);
