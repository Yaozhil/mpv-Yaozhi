+    UINT after = 0;
+    HRESULT count_hr = IDXGISwapChain_GetLastPresentCount(p->swapchain, &after);
+    int n = p->gpu_marker_last;
+    if (n >= 0 && n < MP_D3D11_GPU_MARKER_RING &&
+        p->gpu_markers[n].in_use && p->gpu_markers[n].present_bound)
