diff --git a/video/out/secondary_ass_physical.h b/video/out/secondary_ass_physical.h
new file mode 100644
index 0000000..4c3beb0
--- /dev/null
+++ b/video/out/secondary_ass_physical.h
@@ -0,0 +1,477 @@
+#ifndef MP_SECONDARY_ASS_PHYSICAL_H
+#define MP_SECONDARY_ASS_PHYSICAL_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "secondary_ass_budget.h"
+
+// Historical feedback belongs to a real Present ID. Keep it separate from
+// the driver's prediction used by the primary video synchronization clock.
+struct secondary_ass_physical {
+    int64_t phase, interval, last_base;
+    uint64_t epoch;
+    bool epoch_exhausted;
+    int64_t phase_slot, last_base_slot;
+    int64_t sync_slot, sync_qpc_ns;
+    uint32_t sync_count;
+    bool sync_segment_consistent;
+    int64_t measure_qpc_ns;
+    uint32_t measure_count;
+    int64_t periods[5];
+    unsigned period_count, period_next;
+    uint64_t historical_id;
+    int delay, delay_samples[3], delay_count, delay_next;
+    struct { uint64_t id; int64_t base, base_slot, target_slot; } submitted[32];
+    unsigned next;
+};
+
+struct secondary_ass_physical_point {
+    int64_t slot, wall;
+};
+
+static inline void secondary_ass_physical_reset(struct secondary_ass_physical *p)
+{
+    uint64_t epoch = p->epoch;
+    *p = (struct secondary_ass_physical){0};
+    // Never reuse an epoch after wrapping. In that unreachable lifetime the
+    // physical path stays unavailable instead of reviving an old OSD grid.
+    p->epoch = epoch < UINT64_MAX ? epoch + 1 : UINT64_MAX;
+    p->epoch_exhausted = epoch == UINT64_MAX;
+}
+
+static inline bool secondary_ass_physical_interval_valid(int64_t interval)
+{
+    return interval > 0 && interval <= INT64_MAX / 8;
+}
+
+static inline struct secondary_ass_physical_point
+secondary_ass_physical_point_at(const struct secondary_ass_physical *p,
+                               int64_t slot)
+{
+    struct secondary_ass_physical_point none = {0};
+    if (p->epoch_exhausted || p->phase <= 0 || p->phase_slot <= 0 ||
+        slot <= 0 || !secondary_ass_physical_interval_valid(p->interval))
+        return none;
+    int64_t delta = slot - p->phase_slot;
+    int64_t wall;
+    if (delta >= 0) {
+        if (delta > (INT64_MAX - p->phase) / p->interval)
+            return none;
+        wall = p->phase + delta * p->interval;
+    } else {
+        if (-delta > (p->phase - 1) / p->interval)
+            return none;
+        wall = p->phase + delta * p->interval;
+    }
+    return (struct secondary_ass_physical_point){slot, wall};
+}
+
+static inline struct secondary_ass_physical_point
+secondary_ass_physical_predict_point(const struct secondary_ass_physical *p,
+                                    int64_t ready)
+{
+    struct secondary_ass_physical_point none = {0};
+    if (p->phase <= 0 || ready < p->phase || p->phase_slot <= 0 ||
+        !secondary_ass_physical_interval_valid(p->interval) ||
+        p->delay < 0 || p->delay > 4)
+        return none;
+    int64_t steps = (ready - p->phase) / p->interval + 1;
+    if (steps > INT64_MAX - p->phase_slot)
+        return none;
+    int64_t base = p->phase_slot + steps;
+    if (base <= p->last_base_slot) {
+        if (p->last_base_slot == INT64_MAX)
+            return none;
+        base = p->last_base_slot + 1;
+    }
+    if (base > INT64_MAX - p->delay)
+        return none;
+    return secondary_ass_physical_point_at(p, base + p->delay);
+}
+
+static inline void secondary_ass_physical_measure_anchor(
+    struct secondary_ass_physical *p, int64_t qpc_ns, uint32_t count)
+{
+    p->measure_qpc_ns = qpc_ns;
+    p->measure_count = count;
+}
+
+// QPC and raw refresh counts are independent observations. A missing raw
+// count invalidates a period-measurement segment, not the submission queue.
+// Logical slots advance from checked QPC differences in a fixed-mode epoch.
+static inline bool secondary_ass_physical_observe(
+    struct secondary_ass_physical *p, int64_t qpc_ns, uint32_t count,
+    int64_t seed_interval)
+{
+    if (p->epoch_exhausted || qpc_ns <= 0)
+        return false;
+    if (!p->epoch)
+        p->epoch = 1;
+    if (!p->interval) {
+        if (!secondary_ass_physical_interval_valid(seed_interval))
+            return false;
+        p->interval = seed_interval;
+    }
+    if (!p->sync_qpc_ns) {
+        p->sync_qpc_ns = qpc_ns;
+        p->sync_count = count;
+        // Leave room for a historical Present before the first Sync sample.
+        p->sync_slot = INT64_C(4294967296);
+        p->sync_segment_consistent = true;
+        secondary_ass_physical_measure_anchor(p, qpc_ns, count);
+        return true;
+    }
+    if (qpc_ns == p->sync_qpc_ns && count == p->sync_count)
+        return true;
+    if (qpc_ns <= p->sync_qpc_ns)
+        return false;
+    int64_t elapsed = qpc_ns - p->sync_qpc_ns;
+    if (elapsed > INT64_MAX - p->interval / 2)
+        return false;
+    int64_t steps = (elapsed + p->interval / 2) / p->interval;
+    if (steps <= 0 || steps > INT64_MAX - p->sync_slot ||
+        steps > INT64_MAX / p->interval)
+        return false;
+    int64_t residual = elapsed - steps * p->interval;
+    // An ambiguous non-integer gap cannot establish a fixed physical lattice.
+    // Keep the queue, but make predictions unavailable until valid feedback.
+    if (residual > p->interval / 4 || residual < -p->interval / 4) {
+        p->phase = p->phase_slot = 0;
+        p->measure_qpc_ns = 0;
+        return false;
+    }
+    uint32_t passed = count - p->sync_count;
+    bool consistent = passed < UINT32_C(0x80000000) &&
+                      (uint64_t)steps == passed;
+    p->sync_slot += steps;
+    p->sync_qpc_ns = qpc_ns;
+    p->sync_count = count;
+    p->sync_segment_consistent = consistent;
+    if (!consistent || !p->measure_qpc_ns) {
+        secondary_ass_physical_measure_anchor(p, qpc_ns, count);
+        return true;
+    }
+    int64_t window = qpc_ns - p->measure_qpc_ns;
+    if (window < INT64_C(500000000))
+        return true;
+    uint32_t refreshes = count - p->measure_count;
+    secondary_ass_physical_measure_anchor(p, qpc_ns, count);
+    if (!refreshes || refreshes >= UINT32_C(0x80000000))
+        return true;
+    int64_t measured = window / refreshes;
+    if (!secondary_ass_physical_interval_valid(measured))
+        return true;
+    p->periods[p->period_next] = measured;
+    p->period_next = (p->period_next + 1) % 5;
+    if (p->period_count < 5)
+        p->period_count++;
+    if (p->period_count < 3)
+        return true;
+    int64_t values[5];
+    for (unsigned n = 0; n < p->period_count; n++)
+        values[n] = p->periods[n];
+    for (unsigned n = 1; n < p->period_count; n++) {
+        int64_t value = values[n];
+        unsigned k = n;
+        while (k && values[k - 1] > value) {
+            values[k] = values[k - 1];
+            k--;
+        }
+        values[k] = value;
+    }
+    p->interval = values[p->period_count / 2];
+    return true;
+}
+
+static inline int64_t secondary_ass_physical_slot(int64_t phase,
+                                                 int64_t interval,
+                                                 int64_t ready)
+{
+    if (phase <= 0 || interval <= 0 || ready < phase)
+        return 0;
+    int64_t steps = (ready - phase) / interval + 1;
+    if (steps > (INT64_MAX - phase) / interval)
+        return 0;
+    return phase + steps * interval;
+}
+
+static inline void secondary_ass_physical_feedback_point(
+    struct secondary_ass_physical *p, struct secondary_ass_physical_point actual,
+    uint64_t historical_id)
+{
+    if (p->epoch_exhausted || actual.wall <= 0 || actual.slot <= 0 ||
+        !historical_id || historical_id == p->historical_id)
+        return;
+    p->phase = actual.wall;
+    p->phase_slot = actual.slot;
+    p->historical_id = historical_id;
+    for (unsigned n = 0; n < 32; n++) {
+        if (p->submitted[n].id != historical_id)
+            continue;
+        int64_t delta;
+        if (p->submitted[n].base_slot > 0) {
+            delta = actual.slot - p->submitted[n].base_slot;
+        } else {
+            // Legacy adapters have no slot identity. Keep their historical
+            // wall-offset learner; the observed path always has base_slot.
+            int64_t elapsed = actual.wall - p->submitted[n].base;
+            if (elapsed < -p->interval / 2 || elapsed > 4 * p->interval + p->interval / 2)
+                break;
+            delta = (elapsed + p->interval / 2) / p->interval;
+        }
+        // Delay is a learned submission pipeline offset, never a guessed
+        // fixed extra vsync. Ignore disjoint/overloaded history outliers.
+        if (delta < 0 || delta > 4)
+            break;
+        int delay = (int)delta;
+        p->delay_samples[p->delay_next] = delay;
+        p->delay_next = (p->delay_next + 1) % 3;
+        if (p->delay_count < 3)
+            p->delay_count++;
+        int values[3];
+        for (int j = 0; j < p->delay_count; j++)
+            values[j] = p->delay_samples[j];
+        for (int j = 1; j < p->delay_count; j++) {
+            int value = values[j], k = j;
+            while (k && values[k - 1] > value) {
+                values[k] = values[k - 1];
+                k--;
+            }
+            values[k] = value;
+        }
+        p->delay = values[p->delay_count / 2];
+        break;
+    }
+}
+
+// Compatibility for callers without raw clock/count pairs. This interface is
+// deliberately not the physical-period estimator used by the observed path.
+static inline void secondary_ass_physical_feedback(
+    struct secondary_ass_physical *p, int64_t actual, int64_t interval,
+    uint64_t historical_id)
+{
+    if (actual <= 0 || !secondary_ass_physical_interval_valid(interval) ||
+        !historical_id || p->epoch_exhausted ||
+        historical_id == p->historical_id)
+        return;
+    int64_t slot = p->phase_slot > 0 ? p->phase_slot : INT64_C(4294967296);
+    if (p->phase > 0 && p->interval > 0) {
+        int64_t delta = actual - p->phase;
+        int64_t steps = delta / p->interval;
+        int64_t remainder = delta % p->interval;
+        if (remainder >= p->interval / 2)
+            steps++;
+        if (remainder <= -p->interval / 2)
+            steps--;
+        if ((steps > 0 && slot > INT64_MAX - steps) ||
+            (steps < 0 && slot <= -steps))
+            return;
+        slot += steps;
+    }
+    if (!p->epoch)
+        p->epoch = 1;
+    p->interval = interval;
+    secondary_ass_physical_feedback_point(p,
+        (struct secondary_ass_physical_point){slot, actual}, historical_id);
+}
+
+static inline int64_t secondary_ass_physical_predict(
+    struct secondary_ass_physical *p, int64_t ready)
+{
+    if (p->phase_slot > 0)
+        return secondary_ass_physical_predict_point(p, ready).wall;
+    int64_t base = secondary_ass_physical_slot(p->phase, p->interval, ready);
+    if (!base)
+        return 0;
+    if (base <= p->last_base)
+    {
+        if (p->last_base > INT64_MAX - p->interval)
+            return 0;
+        base = p->last_base + p->interval;
+    }
+    if (base > INT64_MAX - p->delay * p->interval)
+        return 0;
+    return base + p->delay * p->interval;
+}
+
+static inline void secondary_ass_physical_submit_point(
+    struct secondary_ass_physical *p, uint64_t id,
+    struct secondary_ass_physical_point intended)
+{
+    if (p->epoch_exhausted || !id || intended.wall <= 0 ||
+        intended.slot <= p->delay || p->delay < 0 || p->delay > 4 ||
+        !secondary_ass_physical_interval_valid(p->interval) ||
+        intended.wall <= p->delay * p->interval)
+        return;
+    if (p->submitted[(p->next + 31) % 32].id == id)
+        return;
+    int64_t base_slot = intended.slot - p->delay;
+    int64_t base = intended.wall - p->delay * p->interval;
+    p->submitted[p->next].id = id;
+    p->submitted[p->next].base = base;
+    p->submitted[p->next].base_slot = base_slot;
+    p->submitted[p->next].target_slot = intended.slot;
+    p->next = (p->next + 1) % 32;
+    if (base_slot > p->last_base_slot) {
+        p->last_base_slot = base_slot;
+        p->last_base = base;
+    }
+}
+
+static inline void secondary_ass_physical_submit(
+    struct secondary_ass_physical *p, uint64_t id, int64_t intended)
+{
+    if (!p->phase || !id || intended <= 0)
+        return;
+    if (p->phase_slot > 0 && p->interval > 0) {
+        int64_t delta = intended - p->phase;
+        int64_t steps = delta / p->interval;
+        int64_t remainder = delta % p->interval;
+        if (remainder >= p->interval / 2)
+            steps++;
+        if (remainder <= -p->interval / 2)
+            steps--;
+        if ((steps > 0 && p->phase_slot > INT64_MAX - steps) ||
+            (steps < 0 && p->phase_slot <= -steps))
+            return;
+        secondary_ass_physical_submit_point(p, id,
+            (struct secondary_ass_physical_point){p->phase_slot + steps, intended});
+        return;
+    }
+    if (p->submitted[(p->next + 31) % 32].id == id)
+        return;
+    int64_t base = intended - p->delay * p->interval;
+    p->submitted[p->next].id = id;
+    p->submitted[p->next].base = base;
+    p->next = (p->next + 1) % 32;
+    p->last_base = base;
+}
+
+static inline int64_t secondary_ass_physical_prepare(
+    const struct secondary_ass_physical *p, int64_t sample)
+{
+    if (!p->phase || sample <= 0)
+        return 0;
+    return sample - p->delay * p->interval - p->interval / 2;
+}
+
+static inline int64_t secondary_ass_physical_render_time(
+    const struct secondary_ass_physical *p, int64_t sample, int64_t cost)
+{
+    int64_t submit = secondary_ass_physical_prepare(p, sample);
+    if (submit <= 0)
+        return 0;
+    // Prepare GPU work early on very high-refresh monitors. Submission still
+    // occurs in the intended half-vsync window, rather than displaying early.
+    int64_t lead = cost + 1000000;
+    if (lead < p->interval / 2)
+        lead = p->interval / 2;
+    return sample - p->delay * p->interval - lead;
+}
+
+static inline int64_t secondary_ass_physical_submit_time(
+    const struct secondary_ass_physical *p, int64_t sample)
+{
+    if (!p->phase || !secondary_ass_physical_interval_valid(p->interval) ||
+        p->delay < 0 || p->delay > 4 || sample <= (p->delay + 1) * p->interval)
+        return 0;
+    // Present(sync=1) may target only the next scanout after its base cycle.
+    // Submit just inside that cycle, leaving GPU/flip completion headroom.
+    // Half-cycle submission left <0.15 ms in the recorded missed scanouts.
+    int64_t guard = p->interval / 4;
+    if (guard > 1000000)
+        guard = 1000000;
+    return sample - (p->delay + 1) * p->interval + guard;
+}
+
+static inline int64_t secondary_ass_physical_render_slot_time(
+    const struct secondary_ass_physical *p, int64_t sample, int64_t cost)
+{
+    int64_t submit = secondary_ass_physical_submit_time(p, sample);
+    if (submit <= 0 || cost < 0 || cost > submit)
+        return 0;
+    return submit - cost;
+}
+
+// The queued video's actual submission opportunity bounds this cached draw.
+// Execute a successful decision directly; another deadline calculation must
+// not leave both the queued video and its earlier cached slot unserviced.
+static inline int64_t secondary_ass_physical_cache_prepare(
+    struct secondary_ass_physical *p, int64_t now, int64_t sample,
+    int64_t fresh_pts, int64_t duration, int64_t animation_interval,
+    int64_t fresh_cost, int64_t redraw_cost, int64_t block_cost,
+    int64_t earliest_redraw)
+{
+    if (!p->phase || p->interval <= 0 || sample <= 0 ||
+        duration < p->interval ||
+        !secondary_ass_budget_affordable(fresh_cost, redraw_cost,
+                                         duration, animation_interval) ||
+        now > INT64_MAX - fresh_cost)
+        return 0;
+    int64_t ready = now + fresh_cost;
+    if (ready < fresh_pts)
+        ready = fresh_pts;
+    int64_t slot = secondary_ass_physical_predict(p, ready);
+    int64_t prepare = secondary_ass_physical_render_slot_time(p, sample, redraw_cost);
+    if (prepare < earliest_redraw)
+        prepare = earliest_redraw;
+    if (slot <= 0 || prepare <= 0 || sample >= slot - p->interval / 2 ||
+        (prepare > now && prepare - now - fresh_cost > 2000000))
+        return 0;
+    int64_t deadline = slot - p->delay * p->interval - p->interval / 4;
+    return secondary_ass_budget_before_deadline(now > prepare ? now : prepare,
+        deadline, fresh_cost, block_cost, 1000000) ? prepare : 0;
+}
+
+static inline void secondary_ass_physical_update(
+    struct secondary_ass_physical *p, bool invalid, uint64_t submitted_id,
+    int64_t intended, int64_t actual, int64_t interval, uint64_t historical_id)
+{
+    if (invalid) {
+        secondary_ass_physical_reset(p);
+        return;
+    }
+    // A successful Present still occupies a slot when statistics temporarily
+    // contain zeroes. Its ID is independent of historical feedback validity.
+    secondary_ass_physical_submit(p, submitted_id, intended);
+    secondary_ass_physical_feedback(p, actual, interval, historical_id);
+}
+
+static inline void secondary_ass_physical_update_observed(
+    struct secondary_ass_physical *p, bool invalid, uint64_t submitted_id,
+    struct secondary_ass_physical_point intended, int64_t sync_qpc_ns,
+    int64_t sync_wall, uint32_t sync_count, uint32_t present_count,
+    uint64_t historical_id, int64_t seed_interval)
+{
+    if (invalid) {
+        secondary_ass_physical_reset(p);
+        return;
+    }
+    // Registration uses the exact slot selected before this feedback. A later
+    // period refinement cannot reinterpret a successful Present's identity.
+    secondary_ass_physical_submit_point(p, submitted_id, intended);
+    if (sync_wall <= 0 || !secondary_ass_physical_observe(
+            p, sync_qpc_ns, sync_count, seed_interval) || !historical_id)
+        return;
+    uint32_t raw_offset = present_count - sync_count;
+    int64_t offset = raw_offset <= INT32_MAX ? raw_offset :
+                    -(int64_t)(UINT32_MAX - raw_offset) - 1;
+    // Cross-gap extrapolation is ambiguous when a raw refresh count was lost.
+    // A same-count Sync/Present pair is still an identified exact timestamp.
+    if (offset < -32 || offset > 32 ||
+        (offset && !p->sync_segment_consistent) ||
+        (offset > 0 && p->sync_slot > INT64_MAX - offset) ||
+        (offset < 0 && p->sync_slot <= -offset))
+        return;
+    int64_t adjustment = offset * p->interval;
+    if ((adjustment > 0 && sync_wall > INT64_MAX - adjustment) ||
+        (adjustment < 0 && sync_wall <= -adjustment))
+        return;
+    secondary_ass_physical_feedback_point(p,
+        (struct secondary_ass_physical_point){p->sync_slot + offset,
+                                             sync_wall + adjustment},
+        historical_id);
+}
+
+#endif
diff --git a/video/out/secondary_ass_presentation.h b/video/out/secondary_ass_presentation.h
new file mode 100644
index 0000000..4d5a21d
--- /dev/null
+++ b/video/out/secondary_ass_presentation.h
@@ -0,0 +1,83 @@
+#ifndef MP_SECONDARY_ASS_PRESENTATION_H
+#define MP_SECONDARY_ASS_PRESENTATION_H
+
+#include <stdint.h>
+
+// Independent from the player's video-sync estimator: audio-sync must retain
+// its audio master while animated secondary ASS uses the display's phase.
+struct secondary_ass_presentation {
+    int64_t last_display;
+    int64_t last_target;
+    int64_t interval;
+    int64_t next_draw;
+    int64_t draw_interval;
+};
+
+static inline int64_t secondary_ass_predict_present(
+    struct secondary_ass_presentation *p, int64_t now, int64_t interval)
+{
+    if (interval <= 0)
+        interval = 1000000000 / 60;
+    // A monitor/rate change invalidates the old display lattice, not the media
+    // clock. Avoid reusing a timestamp many refreshes into an unrelated queue.
+    if (p->interval && (interval > p->interval + p->interval / 100 ||
+                       interval < p->interval - p->interval / 100))
+    {
+        p->last_display = p->last_target = 0;
+    }
+    p->interval = interval;
+    int64_t base = p->last_display > 0 ? p->last_display : p->last_target;
+    int64_t target = base > 0 ? base + interval : now + interval;
+    if (p->last_target > 0 && target <= p->last_target)
+        target = p->last_target + interval;
+    if (target < now)
+        target += ((now - target) / interval + 1) * interval;
+    if (target > now + 1000000000)
+        target = now + interval;
+    p->last_target = target;
+    return target;
+}
+
+static inline void secondary_ass_present_feedback(
+    struct secondary_ass_presentation *p, int64_t displayed)
+{
+    // Missing/sparse feedback must not invent a CPU flip-time display phase.
+    p->last_display = displayed > 0 ? displayed : p->last_target;
+}
+
+static inline int64_t secondary_ass_sample_prepare_time(
+    int64_t sample_wall, int64_t vsync_interval)
+{
+    if (sample_wall <= 0 || vsync_interval <= 0)
+        return 0;
+    // Match the sampler's half-vsync selection boundary. Preparing a full
+    // vsync early can submit the previous sample and consume the only redraw
+    // before a source-frame deadline. Cross the boundary by one ns to avoid
+    // integer/nearest-grid rounding selecting the previous tick.
+    int64_t lead = vsync_interval / 2;
+    return sample_wall - lead + (lead > 0);
+}
+
+static inline int64_t secondary_ass_next_draw(
+    struct secondary_ass_presentation *p, int64_t now, int64_t interval)
+{
+    if (interval <= 0)
+        interval = 1;
+    if (!p->next_draw || p->draw_interval != interval) {
+        p->next_draw = now + interval;
+        p->draw_interval = interval;
+    }
+    return p->next_draw;
+}
+
+static inline void secondary_ass_consume_draw(
+    struct secondary_ass_presentation *p, int64_t now)
+{
+    // A source-video frame can consume a due slot, but must not restart the
+    // secondary cadence. Advance missed slots without a catch-up redraw burst.
+    if (p->draw_interval > 0 && p->next_draw <= now)
+        p->next_draw += ((now - p->next_draw) / p->draw_interval + 1) *
+                        p->draw_interval;
+}
+
+#endif
