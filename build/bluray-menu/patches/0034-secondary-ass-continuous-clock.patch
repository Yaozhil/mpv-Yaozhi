+static void d3d11_gpu_marker_release_queries(struct priv *p)
+{
+    for (int n = 0; n < MP_D3D11_GPU_MARKER_RING; n++) {
+        SAFE_RELEASE(p->gpu_markers[n].query);
+        p->gpu_markers[n] = (struct d3d11_gpu_marker) {0};
+    }
+    p->gpu_marker_last = -1;
+    p->gpu_marker_generation++;
+}
+
+static void d3d11_gpu_marker_disable(struct ra_ctx *ctx, HRESULT hr,
+                                     const char *status)
+{
+    struct priv *p = ctx->priv;
+    if (!p->gpu_marker_active)
+        return;
+
+    MP_INFO(ctx, "native-ass-gpu-marker: status=%s hr=0x%08"PRIx32
+            " generation=%"PRIu64"\n", status, (uint32_t)hr,
+            p->gpu_marker_generation);
+    d3d11_gpu_marker_release_queries(p);
+    p->gpu_marker_active = false;
+    p->gpu_marker_error = true;
+}
+
+static bool d3d11_gpu_marker_create_queries(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    if (!p->gpu_marker_active)
+        return false;
+
+    if (!p->gpu_marker_context)
+        ID3D11Device_GetImmediateContext(p->device, &p->gpu_marker_context);
+    if (!p->gpu_marker_context) {
+        d3d11_gpu_marker_disable(ctx, E_NOINTERFACE, "no_immediate_context");
+        return false;
+    }
+
+    D3D11_QUERY_DESC desc = {
+        .Query = D3D11_QUERY_EVENT,
+        .MiscFlags = 0,
+    };
+    for (int n = 0; n < MP_D3D11_GPU_MARKER_RING; n++) {
+        HRESULT hr = ID3D11Device_CreateQuery(p->device, &desc,
+                                               &p->gpu_markers[n].query);
+        if (FAILED(hr)) {
+            d3d11_gpu_marker_disable(ctx, hr, "query_create_error");
+            return false;
+        }
+    }
+    return true;
+}
+
+static void d3d11_gpu_marker_maybe_release(struct priv *p, int n)
+{
+    struct d3d11_gpu_marker *m = &p->gpu_markers[n];
+    if (!m->in_use || !m->completed || !m->present_verified)
+        return;
+    SAFE_RELEASE(m->query);
+    *m = (struct d3d11_gpu_marker) {0};
+    if (p->gpu_marker_last == n)
+        p->gpu_marker_last = -1;
+}
+
+static void d3d11_gpu_marker_poll(struct ra_ctx *ctx, const char *stage)
+{
+    struct priv *p = ctx->priv;
+    if (!p->gpu_marker_active || !p->gpu_marker_context)
+        return;
+
+    for (int n = 0; n < MP_D3D11_GPU_MARKER_RING; n++) {
+        struct d3d11_gpu_marker *m = &p->gpu_markers[n];
+        if (!m->in_use || m->completed || !m->query)
+            continue;
+
+        int64_t before_ns = mp_time_ns();
+        HRESULT hr = ID3D11DeviceContext_GetData(
+            p->gpu_marker_context, (ID3D11Asynchronous *)m->query,
+            NULL, 0, D3D11_ASYNC_GETDATA_DONOTFLUSH);
+        int64_t after_ns = mp_time_ns();
+        if (hr == S_FALSE) {
+            m->last_not_ready_ns = after_ns;
+            continue;
+        }
+        if (FAILED(hr)) {
+            MP_INFO(ctx, "native-ass-gpu-marker: status=poll_error"
+                    " seq=%"PRIu64" generation=%"PRIu64
+                    " stage=%s hr=0x%08"PRIx32" before_ns=%"PRId64
+                    " after_ns=%"PRId64"\n", m->seq, m->generation, stage,
+                    (uint32_t)hr, before_ns, after_ns);
+            d3d11_gpu_marker_disable(ctx, hr, "poll_error");
+            return;
+        }
+
+        m->completed = true;
+        m->ready_lower_ns = m->last_not_ready_ns;
+        m->ready_upper_ns = after_ns;
+        MP_INFO(ctx, "native-ass-gpu-marker: status=complete"
+                " seq=%"PRIu64" generation=%"PRIu64
+                " frame_id=%"PRIu64" stage=%s"
+                " evidence=gpu_completion_bracket lower_ns=%"PRId64
+                " upper_ns=%"PRId64" present_expected=%u"
+                " present_actual=%u present_bound=%d\n", m->seq,
+                m->generation, m->frame_id, stage, m->ready_lower_ns,
+                m->ready_upper_ns, m->expected_present, m->actual_present,
+                m->present_bound);
+        d3d11_gpu_marker_maybe_release(p, n);
+    }
+}
+
+static void d3d11_gpu_marker_end(struct ra_ctx *ctx, uint64_t frame_id)
+{
+    struct priv *p = ctx->priv;
+    if (!p->gpu_marker_active || !p->gpu_marker_context)
+        return;
+
+    d3d11_gpu_marker_poll(ctx, "draw_end_before_end");
+    int n = -1;
+    for (int i = 0; i < MP_D3D11_GPU_MARKER_RING; i++) {
+        if (!p->gpu_markers[i].in_use) {
+            n = i;
+            break;
+        }
+    }
+    if (n < 0) {
+        MP_INFO(ctx, "native-ass-gpu-marker: status=ring_full"
+                " generation=%"PRIu64" frame_id=%"PRIu64"\n",
+                p->gpu_marker_generation, frame_id);
+        return;
+    }
+
+    struct d3d11_gpu_marker *m = &p->gpu_markers[n];
+    if (!m->query) {
+        MP_INFO(ctx, "native-ass-gpu-marker: status=marker_unavailable"
+                " generation=%"PRIu64" frame_id=%"PRIu64"
+",
+                p->gpu_marker_generation, frame_id);
+        return;
+    }
+    ID3D11Query *query = m->query;
+    int64_t before_ns = mp_time_ns();
+    ID3D11DeviceContext_End(p->gpu_marker_context,
+                            (ID3D11Asynchronous *)query);
+    int64_t after_ns = mp_time_ns();
+    *m = (struct d3d11_gpu_marker) {
+        .query = query,
+        .seq = ++p->gpu_marker_next_seq,
+        .generation = p->gpu_marker_generation,
+        .frame_id = frame_id,
+        .issue_before_ns = before_ns,
+        .issue_after_ns = after_ns,
+        .in_use = true,
+    };
+    p->gpu_marker_last = n;
+    MP_INFO(ctx, "native-ass-gpu-marker: status=queued"
+            " seq=%"PRIu64" generation=%"PRIu64" frame_id=%"PRIu64
+            " issue_before_ns=%"PRId64" issue_after_ns=%"PRId64"\n",
+            m->seq, m->generation, m->frame_id, before_ns, after_ns);
+}
