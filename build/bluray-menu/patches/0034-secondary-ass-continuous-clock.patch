-void osd_anchor_secondary_clock(struct osd_state *osd, double pts, int64_t wall)
+double osd_get_secondary_clock_rate(struct osd_state *osd)
+{
+    // A quiet/static section needs no extra redraws, but the next moving event
+    // still needs an accurate timeline. Do not tie clock validity to output.
+    mp_mutex_lock(&osd->lock);
+    double rate = osd->secondary_rate;
+    mp_mutex_unlock(&osd->lock);
+    return rate;
+}
+
+int64_t osd_get_secondary_next_sample_time(struct osd_state *osd)
 {
     mp_mutex_lock(&osd->lock);
-    osd->secondary_pts = pts;
-    osd->secondary_wall = wall;
-    osd->secondary_clock_valid = pts != MP_NOPTS_VALUE;
+    int64_t next = osd->secondary_rate > 0
+        ? secondary_ass_sampler_next_wall(&osd->secondary_sampler) : 0;
+    mp_mutex_unlock(&osd->lock);
+    return next;
+}
+
+int64_t osd_get_secondary_physical_next_sample_time(struct osd_state *osd)
+{
+    mp_mutex_lock(&osd->lock);
+    // A fallback sample is not aligned to physical refreshes. Establish the
+    // physical sampler from identified feedback before reusing its grid.
+    int64_t next = osd->secondary_rate > 0 && osd->secondary_physical_phase
+        ? secondary_ass_sampler_next_wall(&osd->secondary_sampler) : 0;
+    mp_mutex_unlock(&osd->lock);
+    return next;
+}
+
+void osd_anchor_secondary_clock(struct osd_state *osd, double pts, int64_t wall,
+                                bool display_synced)
+{
+    mp_mutex_lock(&osd->lock);
+    if (pts == MP_NOPTS_VALUE) {
+        secondary_ass_clock_reset(&osd->secondary_clock);
+        secondary_ass_sampler_reset(&osd->secondary_sampler);
+    } else {
+        secondary_ass_clock_set_speed(&osd->secondary_clock, osd->secondary_speed,
+                                      mp_time_ns());
+        if (secondary_ass_clock_anchor(&osd->secondary_clock, pts, wall, display_synced))
+            secondary_ass_sampler_reset(&osd->secondary_sampler);
+    }
+    mp_mutex_unlock(&osd->lock);
+}
+
+void osd_set_secondary_presentation_time(struct osd_state *osd, int64_t wall,
+                                        int64_t vsync_interval, int64_t submit_wall,
+                                        bool physical_phase)
+{
+    mp_mutex_lock(&osd->lock);
+    if (physical_phase != osd->secondary_physical_phase)
+        secondary_ass_sampler_reset(&osd->secondary_sampler);
+    osd->secondary_physical_phase = physical_phase;
+    osd->secondary_present_wall = wall > 0 ? wall : 0;
+    osd->secondary_submit_wall = submit_wall > 0 ? submit_wall : 0;
+    osd->secondary_vsync_interval = vsync_interval > 0 ? vsync_interval : 0;
+    mp_mutex_unlock(&osd->lock);
+}
+
+void osd_reset_secondary_clock(struct osd_state *osd)
+{
+    mp_mutex_lock(&osd->lock);
+    secondary_ass_clock_reset(&osd->secondary_clock);
+    secondary_ass_sampler_reset(&osd->secondary_sampler);
+    osd->secondary_present_wall = 0;
+    osd->secondary_submit_wall = 0;
+    osd->secondary_physical_phase = false;
     mp_mutex_unlock(&osd->lock);
 }
 
