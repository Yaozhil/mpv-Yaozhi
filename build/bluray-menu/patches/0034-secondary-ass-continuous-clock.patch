diff --git a/sub/secondary_ass_clock.h b/sub/secondary_ass_clock.h
new file mode 100644
index 0000000..9f04fda
--- /dev/null
+++ b/sub/secondary_ass_clock.h
@@ -0,0 +1,185 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_CLOCK_H
+#define MP_SECONDARY_ASS_CLOCK_H
+
+#include <math.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+// Media seconds at a monotonic wall-clock point, not decoded-frame cadence.
+// All state is protected by the owning OSD lock.
+struct secondary_ass_clock {
+    bool valid;
+    bool display_synced;
+    double pts;
+    double speed;
+    double phase_rate;
+    int64_t wall;
+};
+
+// Sampling cadence has a separate origin. Updating a source-frame authority
+// must not restart an animation tick at that source's frame rate.
+struct secondary_ass_sampler {
+    bool valid;
+    bool force;
+    double rate;
+    double pts;
+    int64_t origin_wall;
+    int64_t sample_wall;
+    uint64_t tick;
+};
+
+static inline void secondary_ass_sampler_reset(struct secondary_ass_sampler *sampler)
+{
+    *sampler = (struct secondary_ass_sampler){0};
+}
+
+static inline void secondary_ass_clock_reset(struct secondary_ass_clock *clock)
+{
+    *clock = (struct secondary_ass_clock){0};
+}
+
+static inline double secondary_ass_clock_sample(const struct secondary_ass_clock *clock,
+                                                int64_t wall)
+{
+    // Subtract in floating point so malformed timestamps cannot overflow an
+    // int64_t before validation. Negative offsets are intentional: an upcoming
+    // presentation may be queued before its wall-clock time.
+    double elapsed = ((double)wall - (double)clock->wall) * 1e-9;
+    return clock->pts + elapsed * (clock->speed + clock->phase_rate);
+}
+
+static inline void secondary_ass_clock_set_speed(struct secondary_ass_clock *clock,
+                                                 double speed, int64_t wall)
+{
+    if (!isfinite(speed) || speed <= 0) {
+        secondary_ass_clock_reset(clock);
+        return;
+    }
+    if (clock->speed == speed)
+        return;
+    if (clock->valid) {
+        // Changing speed must not apply the new multiplier to all time since
+        // the last source frame. Integrate the old speed to the change first.
+        clock->pts = secondary_ass_clock_sample(clock, wall);
+        clock->wall = wall;
+    }
+    clock->speed = speed;
+    clock->phase_rate = 0;
+}
+
+// Return true when an actual discontinuity requires a fresh sampling origin.
+static inline bool secondary_ass_clock_anchor(struct secondary_ass_clock *clock,
+                                              double pts, int64_t wall,
+                                              bool display_synced)
+{
+    if (!isfinite(pts) || !isfinite(clock->speed) || clock->speed <= 0) {
+        secondary_ass_clock_reset(clock);
+        return true;
+    }
+
+    double projected = clock->valid
+        ? secondary_ass_clock_sample(clock, wall) : pts;
+    double error = pts - projected;
+
+    bool reset = !clock->valid || clock->display_synced != display_synced ||
+                 !isfinite(projected) || error >= 0.250 || error <= -0.250;
+    if (reset)
+    {
+        // Both media authorities are paired with their wall-clock target.
+        // Display feedback can still jitter even after ideal_frame_vsync
+        // removes source-frame quantization. Never copy that phase noise into
+        // the animation's position on each display repeat.
+        // Explicit lifecycle resets take precedence over the discontinuity
+        // safeguard, including seeks smaller than 250ms.
+        clock->pts = pts;
+        clock->wall = wall;
+        clock->phase_rate = 0;
+    } else {
+        // Audio deadlines and display feedback may both jitter slightly.
+        // Discipline phase over one second instead of jumping position at
+        // every source frame. Limit relative rate adjustment to +/-0.5% so a
+        // late frame cannot visibly accelerate/decelerate the animation.
+        double limit = clock->speed * 0.005;
+        double correction = error; // error / 1 second
+        clock->phase_rate = correction < -limit ? -limit :
+                            correction > limit ? limit : correction;
+        clock->pts = projected;
+        clock->wall = wall;
+    }
+    clock->valid = true;
+    clock->display_synced = display_synced;
+    return reset;
+}
+
+static inline int64_t secondary_ass_sampler_next_wall(const struct secondary_ass_sampler *sampler)
+{
+    if (!sampler->valid || !isfinite(sampler->rate) || sampler->rate <= 0)
+        return 0;
+    double offset = ((double)sampler->tick + 1) * (1e9 / sampler->rate);
+    if (offset >= (double)INT64_MAX - sampler->origin_wall)
+        return 0;
+    return sampler->origin_wall + (int64_t)(offset + 0.5);
+}
+
+static inline bool secondary_ass_sampler_update(struct secondary_ass_sampler *sampler,
+                                                const struct secondary_ass_clock *clock,
+                                                double rate, int64_t present_wall,
+                                                int64_t vsync_interval)
+{
+    if (!clock->valid || !isfinite(rate) || rate <= 0) {
+        secondary_ass_sampler_reset(sampler);
+        return false;
+    }
+    if (!sampler->valid || sampler->rate != rate) {
+        sampler->valid = true;
+        sampler->force = false;
+        sampler->rate = rate;
+        sampler->origin_wall = sampler->sample_wall = present_wall;
+        sampler->tick = 0;
+        sampler->pts = secondary_ass_clock_sample(clock, present_wall);
+        return true;
+    }
+
+    double elapsed_ns = (double)present_wall - (double)sampler->origin_wall;
+    // Put an integer-divided animation tick boundary halfway between physical
+    // refreshes, rather than exactly on a jittery feedback timestamp. The
+    // selected sample still uses the stable grid wall, never the CPU draw time.
+    double margin_ns = vsync_interval > 0 ? vsync_interval * 0.5 : 0;
+    double tick_value = (elapsed_ns + margin_ns) * 1e-9 * rate;
+    if (tick_value <= 0 || tick_value >= (double)UINT64_MAX)
+        return false;
+    uint64_t tick = (uint64_t)tick_value;
+    if (tick <= sampler->tick && !sampler->force)
+        return false;
+
+    double offset_ns = tick * (1e9 / rate);
+    if (offset_ns >= (double)INT64_MAX - sampler->origin_wall)
+        return false;
+    if (tick > sampler->tick)
+        sampler->tick = tick;
+    sampler->sample_wall = sampler->force ? present_wall
+        : sampler->origin_wall + (int64_t)(offset_ns + 0.5);
+    sampler->force = false;
+    sampler->pts = secondary_ass_clock_sample(clock, sampler->sample_wall);
+    return true;
+}
+
+static inline bool secondary_ass_sampler_update_at_draw(
+    struct secondary_ass_sampler *sampler,
+    const struct secondary_ass_clock *clock, double rate,
+    int64_t present_wall, int64_t vsync_interval, int64_t draw_wall)
+{
+    // An audio-synced source frame may be drawn before the animation's own
+    // submission boundary. Its queue-time prediction must not advance ASS a
+    // physical refresh early. Initialization and explicit discontinuities
+    // still take effect immediately; they are not ordinary animated ticks.
+    if (!clock->display_synced && sampler->valid && !sampler->force &&
+        sampler->rate == rate && clock->valid && draw_wall > 0 &&
+        present_wall > draw_wall)
+        present_wall = draw_wall;
+    return secondary_ass_sampler_update(sampler, clock, rate,
+                                        present_wall, vsync_interval);
+}
+
+#endif
diff --git a/video/out/secondary_ass_presentation.h b/video/out/secondary_ass_presentation.h
new file mode 100644
index 0000000..4d5a21d
--- /dev/null
+++ b/video/out/secondary_ass_presentation.h
@@ -0,0 +1,83 @@
+#ifndef MP_SECONDARY_ASS_PRESENTATION_H
+#define MP_SECONDARY_ASS_PRESENTATION_H
+
+#include <stdint.h>
+
+// Independent from the player's video-sync estimator: audio-sync must retain
+// its audio master while animated secondary ASS uses the display's phase.
+struct secondary_ass_presentation {
+    int64_t last_display;
+    int64_t last_target;
+    int64_t interval;
+    int64_t next_draw;
+    int64_t draw_interval;
+};
+
+static inline int64_t secondary_ass_predict_present(
+    struct secondary_ass_presentation *p, int64_t now, int64_t interval)
+{
+    if (interval <= 0)
+        interval = 1000000000 / 60;
+    // A monitor/rate change invalidates the old display lattice, not the media
+    // clock. Avoid reusing a timestamp many refreshes into an unrelated queue.
+    if (p->interval && (interval > p->interval + p->interval / 100 ||
+                       interval < p->interval - p->interval / 100))
+    {
+        p->last_display = p->last_target = 0;
+    }
+    p->interval = interval;
+    int64_t base = p->last_display > 0 ? p->last_display : p->last_target;
+    int64_t target = base > 0 ? base + interval : now + interval;
+    if (p->last_target > 0 && target <= p->last_target)
+        target = p->last_target + interval;
+    if (target < now)
+        target += ((now - target) / interval + 1) * interval;
+    if (target > now + 1000000000)
+        target = now + interval;
+    p->last_target = target;
+    return target;
+}
+
+static inline void secondary_ass_present_feedback(
+    struct secondary_ass_presentation *p, int64_t displayed)
+{
+    // Missing/sparse feedback must not invent a CPU flip-time display phase.
+    p->last_display = displayed > 0 ? displayed : p->last_target;
+}
+
+static inline int64_t secondary_ass_sample_prepare_time(
+    int64_t sample_wall, int64_t vsync_interval)
+{
+    if (sample_wall <= 0 || vsync_interval <= 0)
+        return 0;
+    // Match the sampler's half-vsync selection boundary. Preparing a full
+    // vsync early can submit the previous sample and consume the only redraw
+    // before a source-frame deadline. Cross the boundary by one ns to avoid
+    // integer/nearest-grid rounding selecting the previous tick.
+    int64_t lead = vsync_interval / 2;
+    return sample_wall - lead + (lead > 0);
+}
+
+static inline int64_t secondary_ass_next_draw(
+    struct secondary_ass_presentation *p, int64_t now, int64_t interval)
+{
+    if (interval <= 0)
+        interval = 1;
+    if (!p->next_draw || p->draw_interval != interval) {
+        p->next_draw = now + interval;
+        p->draw_interval = interval;
+    }
+    return p->next_draw;
+}
+
+static inline void secondary_ass_consume_draw(
+    struct secondary_ass_presentation *p, int64_t now)
+{
+    // A source-video frame can consume a due slot, but must not restart the
+    // secondary cadence. Advance missed slots without a catch-up redraw burst.
+    if (p->draw_interval > 0 && p->next_draw <= now)
+        p->next_draw += ((now - p->next_draw) / p->draw_interval + 1) *
+                        p->draw_interval;
+}
+
+#endif
