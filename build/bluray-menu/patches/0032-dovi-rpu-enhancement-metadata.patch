+            sh->codec->dv_config_bl_present = cfg->bl_present_flag;
+            sh->codec->dv_config_el_present = cfg->el_present_flag;
+            sh->codec->dv_config_rpu_present = cfg->rpu_present_flag;
             sh->codec->dv_el_present = cfg->bl_present_flag && cfg->el_present_flag;
         }
 
