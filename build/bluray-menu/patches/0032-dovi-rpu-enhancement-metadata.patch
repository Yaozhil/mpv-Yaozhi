diff --git a/player/command.c b/player/command.c
index b707ef3..0f2012c 100644
--- a/player/command.c
+++ b/player/command.c
@@ -67,6 +67,7 @@
 #include "osdep/getpid.h"
 #include "video/out/vo.h"
 #include "video/csputils.h"
+#include "video/dovi_metadata.h"
 #include "video/hwdec.h"
 #include "audio/aframe.h"
 #include "audio/format.h"
@@ -2110,6 +2111,13 @@ static int get_track_entry(int item, int action, void *arg, void *ctx)
     }
 
     struct sh_stream *sh = track->stream;
+    struct sh_stream *dv_el = sh && !sh->dependent_track
