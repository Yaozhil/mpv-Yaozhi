     }
diff --git a/demux/stheader.h b/demux/stheader.h
index 85806f4..fa83469 100644
--- a/demux/stheader.h
+++ b/demux/stheader.h
@@ -176,6 +176,12 @@ struct mp_codec_params {
     bool dovi;
