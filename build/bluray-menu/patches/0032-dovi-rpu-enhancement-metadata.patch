         {0}
@@ -2737,6 +2755,34 @@ static int mp_property_vd_imgparams(void *ctx, struct m_property *prop,
     return M_PROPERTY_UNAVAILABLE;
 }
 
+// Read only the displayed frame's already decoded side data, including its
+// PTS-matched EL. This reports source metadata, not successful composition.
+static struct mp_dovi_metadata_info read_dovi_frame_info(struct mp_image *frame)
+{
+    struct mp_dovi_metadata_info info = {0};
+    struct mp_image *layers[] = {frame, frame->enhancement_layer};
+    for (size_t i = 0; i < MP_ARRAY_SIZE(layers); i++) {
+        struct mp_image *layer = layers[i];
+        if (!layer)
+            continue;
+        for (int n = 0; n < layer->num_ff_side_data; n++) {
+            struct mp_ff_side_data *sd = &layer->ff_side_data[n];
+            if (!sd->buf)
+                continue;
+            if (sd->type == AV_FRAME_DATA_DOVI_RPU_BUFFER)
+                info.rpu_present |= sd->buf->size > 0;
+            if (sd->type == AV_FRAME_DATA_DOVI_METADATA) {
+                struct mp_dovi_metadata_info parsed =
+                    mp_dovi_metadata_read(sd->buf->data, sd->buf->size);
+                info.rpu_present |= parsed.rpu_present;
+                if (!info.el_type)
+                    info.el_type = parsed.el_type;
+            }
+        }
+    }
+    return info;
+}
+
 static int mp_property_video_frame_info(void *ctx, struct m_property *prop,
                                         int action, void *arg)
 {
@@ -2758,6 +2804,7 @@ static int mp_property_video_frame_info(void *ctx, struct m_property *prop,
 
     char gop_tc[AV_TIMECODE_STR_SIZE] = {0};
     char s12m_tc[AV_TIMECODE_STR_SIZE] = {0};
+    struct mp_dovi_metadata_info dovi = read_dovi_frame_info(f);
     for (int n = 0; n < f->num_ff_side_data; n++) {
 
         struct mp_ff_side_data *mpsd = &f->ff_side_data[n];
@@ -2792,6 +2839,9 @@ static int mp_property_video_frame_info(void *ctx, struct m_property *prop,
         {"interlaced",      SUB_PROP_BOOL(!!(f->fields & MP_IMGFIELD_INTERLACED))},
         {"tff",             SUB_PROP_BOOL(!!(f->fields & MP_IMGFIELD_TOP_FIRST))},
         {"repeat",          SUB_PROP_BOOL(!!(f->fields & MP_IMGFIELD_REPEAT_FIRST))},
+        {"dolby-vision-rpu-present", SUB_PROP_BOOL(dovi.rpu_present)},
+        {"dolby-vision-el-type", SUB_PROP_STR(dovi.el_type),
+                                .unavailable = !dovi.el_type},
         {"gop-timecode",    SUB_PROP_STR(gop_tc), .unavailable = gop_tc[0] == '\0'},
         {"smpte-timecode",  SUB_PROP_STR(s12m_tc), .unavailable = s12m_tc[0] == '\0'},
         {"estimated-smpte-timecode", SUB_PROP_STR(approx_smpte), .unavailable = approx_smpte[0] == '\0'},
diff --git a/video/dovi_metadata.h b/video/dovi_metadata.h
new file mode 100644
index 0000000..9dd18b0
--- /dev/null
+++ b/video/dovi_metadata.h
@@ -0,0 +1,72 @@
+/* Read-only identification of decoded Dolby Vision RPU metadata. */
+#ifndef MP_DOVI_METADATA_H
+#define MP_DOVI_METADATA_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <libavutil/dovi_meta.h>
+
+struct mp_dovi_metadata_info {
+    bool rpu_present;
+    const char *el_type;
+};
+
+static inline bool mp_dovi_metadata_range(size_t offset, size_t length,
+                                          size_t size, size_t alignment)
+{
+    return offset >= sizeof(AVDOVIMetadata) && offset <= size &&
+           length <= size - offset && offset % alignment == 0;
+}
+
+// Side data describes the source RPU, not whether the renderer applies it.
+// Use the same Profile 7 header constraints as FFmpeg's profile inference.
+// MEL has neutral NLQ parameters in all three components (dovi_tool's
+// RpuDataNlq::is_mel); disable_residual_flag alone does not distinguish it.
+static inline struct mp_dovi_metadata_info
+mp_dovi_metadata_read(const void *data, size_t size)
+{
+    struct mp_dovi_metadata_info info = {0};
+    if (!data || size < sizeof(AVDOVIMetadata))
+        return info;
+
+    const AVDOVIMetadata *metadata = data;
+    if (!mp_dovi_metadata_range(metadata->header_offset,
+                               sizeof(AVDOVIRpuDataHeader), size,
+                               offsetof(struct { char c; AVDOVIRpuDataHeader v; }, v)))
+        return info;
+
+    const AVDOVIRpuDataHeader *header = av_dovi_get_header(metadata);
+    if (header->rpu_type != 2)
+        return info;
+    info.rpu_present = true;
+
+    if (header->vdr_rpu_profile != 1 || header->vdr_bit_depth != 12 ||
+        !header->el_spatial_resampling_filter_flag ||
+        header->disable_residual_flag || (header->rpu_format & 0x700) ||
+        header->coef_log2_denom < 13 || header->coef_log2_denom > 32 ||
+        !mp_dovi_metadata_range(metadata->mapping_offset,
+                                sizeof(AVDOVIDataMapping), size,
+                                offsetof(struct { char c; AVDOVIDataMapping v; }, v)))
+        return info;
+
+    const AVDOVIDataMapping *mapping = av_dovi_get_mapping(metadata);
+    if (mapping->nlq_method_idc != AV_DOVI_NLQ_LINEAR_DZ)
+        return info;
+
+    bool mel = true;
+    // FFmpeg combines each coefficient's integer/fractional parts into a
+    // fixed-point value, including originally floating-point coefficients.
+    uint64_t one = UINT64_C(1) << header->coef_log2_denom;
+    for (int c = 0; c < 3; c++) {
+        const AVDOVINLQParams *nlq = &mapping->nlq[c];
+        mel &= nlq->nlq_offset == 0 && nlq->vdr_in_max == one &&
+               nlq->linear_deadzone_slope == 0 &&
+               nlq->linear_deadzone_threshold == 0;
+    }
+    info.el_type = mel ? "MEL" : "FEL";
+    return info;
+}
+
+#endif
