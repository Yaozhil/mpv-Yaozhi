diff --git a/stream/stream_bluray.c b/stream/stream_bluray.c
index 451fbc7..ed46998 100644
--- a/stream/stream_bluray.c
+++ b/stream/stream_bluray.c
@@ -36,6 +36,7 @@
 #include <libbluray/keys.h>
 #include <libbluray/bluray-version.h>
 #include <libbluray/log_control.h>
+#include <libbluray/filesystem.h>
 #include <libavutil/common.h>
 
 #include "config.h"
@@ -48,6 +49,7 @@
 #include "options/path.h"
 #include "osdep/threads.h"
 #include "stream.h"
+#include "bluray_slideshow.h"
 #include "osdep/io.h"
 #include "sub/osd.h"
 #include "sub/img_convert.h"
@@ -175,8 +177,87 @@ struct bluray_priv_s {
     int audio_stream_num;
     int sub_stream_num;
     bool sub_visible;
+    int slideshow_playlist;
+    uint8_t *slideshow_mpls;
+    size_t slideshow_mpls_size;
 };
 
+static bool is_http_url(const char *device);
+
+static bool get_slideshow_audio(stream_t *s, struct stream_bd_audio *audio)
+{
+    struct bluray_priv_s *b = s->priv;
+    const BLURAY_TITLE_INFO *ti = b->title_info;
+    if (!b->hdmv_mode || !ti || !ti->clip_count ||
+        ti->clips[0].still_mode != BLURAY_STILL_INFINITE ||
+        b->audio_stream_num < 1 ||
+        b->audio_stream_num > ti->clips[0].audio_stream_count)
+        return false;
+    const BLURAY_STREAM_INFO *si =
+        &ti->clips[0].audio_streams[b->audio_stream_num - 1];
+    if (!b->slideshow_mpls || b->slideshow_playlist != b->current_playlist) {
+        TA_FREEP(&b->slideshow_mpls);
+        b->slideshow_mpls_size = 0;
+        b->slideshow_playlist = b->current_playlist;
+        char path[64];
+        snprintf(path, sizeof(path), "BDMV/PLAYLIST/%05d.mpls", b->current_playlist);
+        void *data = NULL;
+        int64_t size = 0;
+        if (bd_read_file(b->bd, path, &data, &size) && size > 0 && size <= (1 << 20)) {
+            b->slideshow_mpls = talloc_memdup(b, data, size);
+            b->slideshow_mpls_size = size;
+        }
+        free(data);
+    }
+    struct bd_slideshow_clip clip;
+    if (!bd_slideshow_parse(b->slideshow_mpls, b->slideshow_mpls_size,
+                            si->subpath_id, &clip))
+        return false;
+    *audio = (struct stream_bd_audio){
+        .playlist = b->current_playlist, .subpath = si->subpath_id,
+        .pid = si->pid, .in_time = clip.in_time / 45000.0,
+        .out_time = clip.out_time / 45000.0, .repeat = clip.repeat,
+    };
+    memcpy(audio->clip, clip.clip, sizeof(audio->clip));
+    return true;
+}
+
+static struct stream *open_slideshow_audio(stream_t *s,
+                                           struct stream_bd_audio *audio)
+{
+    struct bluray_priv_s *b = s->priv;
+    // A separate libbluray session prevents file reads from disturbing the
+    // live HDMV navigator/AACS state. Restrict this to local disc navigation.
+    if (!b->cfg_device || is_http_url(b->cfg_device)) return NULL;
+    BLURAY *reader = bd_open(b->cfg_device, NULL);
+    if (!reader) return NULL;
+    char path[64];
+    snprintf(path, sizeof(path), "BDMV/STREAM/%s.m2ts", audio->clip);
+    BD_FILE_H *file = bd_open_file_dec(reader, path);
+    struct stream *stream = NULL;
+    uint8_t *data = NULL;
+    if (file) {
+        int64_t size = file->seek(file, 0, SEEK_END);
+        // Type-2 menus are short audio loops; reject excessive allocations.
+        if (size > 0 && size <= (128 << 20) && file->seek(file, 0, SEEK_SET) == 0) {
+            data = talloc_array(NULL, uint8_t, size);
+            int64_t offset = 0;
+            while (offset < size && !mp_cancel_test(s->cancel)) {
+                int64_t n = file->read(file, data + offset,
+                                       MPMIN(size - offset, 6144 * 32));
+                if (n <= 0) break;
+                offset += n;
+            }
+            if (offset == size)
+                stream = stream_memory_open(s->global, data, size);
+        }
+        file->close(file);
+    }
+    talloc_free(data);
+    bd_close(reader);
+    return stream;
+}
+
 static bool is_http_url(const char *device)
 {
     return strncasecmp(device, "http://", 7) == 0 ||
@@ -830,6 +911,14 @@ static int bluray_stream_control(stream_t *s, int cmd, void *arg)
     struct bluray_priv_s *b = s->priv;
 
     switch (cmd) {
+    case STREAM_CTRL_GET_BD_AUDIO:
+        return get_slideshow_audio(s, arg) ? STREAM_OK : STREAM_UNSUPPORTED;
+    case STREAM_CTRL_OPEN_BD_AUDIO: {
+        struct stream_bd_audio *audio = arg;
+        if (!get_slideshow_audio(s, audio)) return STREAM_UNSUPPORTED;
+        audio->stream = open_slideshow_audio(s, audio);
+        return audio->stream ? STREAM_OK : STREAM_ERROR;
+    }
     case STREAM_CTRL_GET_NUM_CHAPTERS: {
         mp_mutex_lock(&b->overlay_lock);
         const BLURAY_TITLE_INFO *ti = b->title_info;
-- 
