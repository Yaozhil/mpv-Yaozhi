+static void feedback_changes(struct vo *vo, struct vo_internal *in,
+ struct osd_state *osd, struct vo_frame *retained, struct vo_frame *incoming,
+ struct vo_driver *driver) {
+ // Run the actual observed-feedback adapter before and after capture. A
+ // normal reanchor preserves D/S exactly; a 1 ns or 200 us wall change must
+ // never retarget a captured plan. Large jitter and missing counts do not
+ // authorize the new early path, and neither is treated as a mode reset.
+ for(int change=0;change<6;change++) {
+  setup(vo,in,osd,retained,driver);
+  struct secondary_ass_physical *p=&in->secondary_physical;
+  int64_t T=p->interval,F=secondary_next_sample(vo,2).wall-1000000;
+  p->sync_qpc_ns=p->measure_qpc_ns=p->phase;p->sync_slot=p->phase_slot;
+  p->sync_count=p->measure_count=100;
+  struct secondary_ass_physical_point history=secondary_ass_physical_point_at(p,102);
+  CHECK(secondary_ass_physical_submit_planned_point(p,11,p->epoch,history,history));
+  clock_ns=F-2*T-2000000;
+  CHECK(vo_is_ready_for_frame(vo,F));
+  *incoming=(struct vo_frame){.pts=F,.duration=16666666};vo_queue_frame(vo,incoming);
+  struct secondary_ass_queue_token captured=in->secondary_queue_pending;
+  int64_t jitter=change==1?1:change==2?200000:change==3?T/3:0;
+  uint32_t count=change==4?105:102;
+  if(change==5) {
+   p->period_count=p->period_next=2;p->periods[0]=p->periods[1]=T+1;
+   p->measure_qpc_ns-=72*T;p->measure_count-=72;
+  }
+  secondary_ass_physical_update_observed(p,false,0,(struct secondary_ass_physical_point){0},
+   p->sync_qpc_ns+2*T+jitter,p->phase+2*T+jitter,count,count,11,T);
+  secondary_ass_physical_record_present(p,true,12,3,1);
+  CHECK(p->epoch==captured.plan.epoch && osd->secondary_sampler.phase_slot==100);
+  CHECK(p->outlier_pending==(change==3));
+  CHECK(p->sync_segment_consistent==(change!=3 && change!=4));
+  CHECK(p->phase_slot==(change==3?100:102));
+  CHECK(p->interval==(change==5?T+1:T));
