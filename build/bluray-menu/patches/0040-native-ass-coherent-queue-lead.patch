new file mode 100644
index 0000000..740037d
--- /dev/null
+++ b/test/secondary_ass_queue_lead.c
@@ -0,0 +1,146 @@
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "video/out/secondary_ass_queue_lead.h"
+
+static unsigned checks;
+#define CHECK(expr) do { \
+    if (!(expr)) { \
+        fprintf(stderr, "check failed at line %d: %s\n", __LINE__, #expr); \
+        abort(); \
+    } \
+    checks++; \
+} while (0)
+
+static struct secondary_ass_queue_hint fixture(int64_t interval, int64_t divisor)
+{
+    struct secondary_ass_queue_hint hint = {
+        .valid = true, .retained_id = 42, .duration = 41666667,
+        .physical = {
+            .phase = 1000000000, .phase_slot = 100, .interval = interval,
+            .last_base_slot = 108, .epoch = 5, .success_generation = 3,
+            .success_contiguous = true, .sync_segment_consistent = true,
+            .historical_id = 10, .success_first_id = 11, .success_last_id = 11,
+        },
+    };
+    struct secondary_ass_physical_point point =
+        secondary_ass_physical_point_at(&hint.physical, 110);
+    hint.sample = (struct secondary_ass_sample_snapshot){
+        .valid = true, .rate = 1e9 / (interval * divisor),
+        .speed = 1, .requested_speed = 1, .epoch = 5,
+        .next_slot = point.slot, .next_wall = point.wall, .divisor = divisor,
+        .phase_wall = hint.physical.phase, .phase_slot = 100, .interval = interval,
+    };
+    return hint;
+}
+
+int main(void)
+{
+    const int rates[] = {60, 120, 144, 165, 240, 360};
+    for (unsigned i = 0; i < sizeof(rates) / sizeof(rates[0]); i++) {
+        int64_t T = 1000000000 / rates[i];
+        int64_t divisor = rates[i] <= 120 ? 1 : rates[i] / 120 + (rates[i] % 120 != 0);
+        struct secondary_ass_queue_hint hint = fixture(T, divisor);
+        int64_t F = hint.sample.next_wall - 1000000;
+        int64_t oldlead = T + 2000000;
+        struct secondary_ass_queue_token token = secondary_ass_queue_lead_make(
+            &hint, &hint.sample, F, oldlead, 50000000, 500000);
+        CHECK(token.valid == (divisor > 1));
+        if (!token.valid)
+            continue;
+        CHECK(token.fresh_due == F);
+        CHECK(token.old_admission == F - oldlead);
+        CHECK(token.admission < token.old_admission);
+        CHECK(token.plan.target.slot == 110 && token.plan.base.slot == 110);
+        CHECK(token.plan.submit == hint.sample.next_wall - T +
+            (T / 4 < 1000000 ? T / 4 : 1000000));
+        CHECK(secondary_ass_queue_lead_current(&token, &hint.sample,
+            &hint.physical, 42, F, 500000));
+        // Feedback reexpresses one lattice with a newer anchor while the
+        // sampler still owns its previous draw coordinates. This must be a
+        // useful candidate, not an always-rejecting safety guard.
+        struct secondary_ass_queue_hint rebased = hint;
+        rebased.physical.phase += 2 * T;
+        rebased.physical.phase_slot += 2;
+        struct secondary_ass_queue_token same = secondary_ass_queue_lead_make(
+            &rebased, &hint.sample, F, oldlead, 50000000, 500000);
+        CHECK(same.valid && same.plan.target.wall == token.plan.target.wall &&
+            same.plan.submit == token.plan.submit && same.fresh_due == F);
+        CHECK(secondary_ass_queue_lead_current(&token, &hint.sample,
+            &rebased.physical, 42, F, 500000));
+        // A period refinement before capture uses the current physical
+        // projection. Neither the raw OSD snapshot nor its phase is written.
+        rebased.physical.interval++;
+        int64_t refined_D = secondary_ass_physical_point_at(
+            &rebased.physical, hint.sample.next_slot).wall;
+        same = secondary_ass_queue_lead_make(&rebased, &hint.sample,
+            refined_D - 1000000, oldlead, 50000000, 500000);
+        CHECK(same.valid && same.plan.interval == T + 1 &&
+            same.plan.target.wall == refined_D && hint.sample.interval == T);
+        CHECK(!secondary_ass_queue_lead_current(&token, &hint.sample,
+            &rebased.physical, 42, F, 500000));
+        // A post-capture wall change, even 1 ns, cannot rename chosen D/S.
+        rebased.physical.interval = T;
+        rebased.physical.phase++;
+        CHECK(!secondary_ass_queue_lead_current(&token, &hint.sample,
+            &rebased.physical, 42, F, 500000));
+        for (int64_t redraw = 500000; redraw <= 2000000; redraw += 500000)
+            CHECK(secondary_ass_queue_lead_make(&hint, &hint.sample, F,
+                oldlead, 50000000, redraw).valid);
+        CHECK(!secondary_ass_queue_lead_make(&hint, &hint.sample, F,
+            oldlead, 50000000, 5000000).valid);
+        int64_t tie_cost = (T / 4 < 1000000 ? T / 4 : 1000000) + 3000000;
+        CHECK(!secondary_ass_queue_lead_make(&hint, &hint.sample, F,
+            oldlead, 50000000, tie_cost).valid);
+        CHECK(!secondary_ass_queue_lead_make(&hint, &hint.sample,
+            hint.sample.next_wall + 1, oldlead, 50000000, 500000).valid);
+        for (int change = 0; change < 16; change++) {
+            struct secondary_ass_sample_snapshot sample = hint.sample;
+            struct secondary_ass_physical physical = hint.physical;
+            uint64_t retained = 42;
+            int64_t due = F, cost = 500000;
+            switch (change) {
+            case 0: sample.held = true; break;
+            case 1: sample.force = true; break;
+            case 2: sample.valid = false; break;
+            case 3: sample.next_slot += divisor; break;
+            case 4: sample.next_wall++; break;
+            case 5: sample.rate += 1; break;
+            case 6: sample.requested_speed += .1; break;
+            case 7: physical.epoch++; break;
+            case 8: physical.success_generation++; break;
+            case 9: physical.phase++; break;
+            case 10: physical.last_base_slot = 110; break;
+            case 11: physical.outlier_pending = true; break;
+            case 12: retained++; break;
+            case 13: due++; break;
+            case 14: cost = 5000000; break;
+            case 15: physical.sync_segment_consistent = false; break;
+            }
+            CHECK(!secondary_ass_queue_lead_current(&token, &sample,
+                &physical, retained, due, cost));
+        }
+        // The former no-earlier-cache-only proposal changes the joint event
+        // order at redraw=5 ms. Actual cache helper and plan ledger show why
+        // the new prepare/admission guard must refuse it.
+        struct secondary_ass_physical view = secondary_ass_present_plan_view(&hint.physical);
+        int64_t prepare = secondary_ass_physical_render_slot_time(&view,
+            hint.sample.next_wall, 5000000);
+        if (rates[i] == 144) {
+            CHECK(F - divisor * T - 2000000 < prepare && prepare < F - oldlead);
+            struct secondary_ass_physical after_cache = hint.physical;
+            struct secondary_ass_physical_point old_sample =
+                secondary_ass_physical_point_at(&after_cache, 110);
+            CHECK(secondary_ass_physical_submit_planned_point(&after_cache, 12,
+                after_cache.epoch, old_sample, old_sample));
+            struct secondary_ass_present_plan original = secondary_ass_present_plan_fresh(
+                &after_cache, F, secondary_ass_physical_point_at(&after_cache, 112));
+            CHECK(original.target.slot == 112 && token.plan.target.slot == 110);
+        }
+        hint.physical.interval = 0;
+        CHECK(!secondary_ass_queue_lead_make(&hint, &hint.sample, F,
+            oldlead, 50000000, 500000).valid);
+    }
+    printf("{\"checks\":%u,\"passed\":true}\n", checks);
+    return 0;
+}
diff --git a/video/out/secondary_ass_queue_lead.h b/video/out/secondary_ass_queue_lead.h
new file mode 100644
index 0000000..07748e8
--- /dev/null
+++ b/video/out/secondary_ass_queue_lead.h
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_QUEUE_LEAD_H
+#define MP_SECONDARY_ASS_QUEUE_LEAD_H
+
+#include "secondary_ass_present_plan.h"
+#include "../../sub/secondary_ass_clock.h"
+
+struct secondary_ass_queue_hint {
+    bool valid;
+    uint64_t retained_id;
+    int64_t duration, earliest_redraw;
+    struct secondary_ass_sample_snapshot sample;
+    struct secondary_ass_physical physical;
+};
+
+struct secondary_ass_queue_token {
+    bool valid;
+    uint64_t retained_id;
+    int64_t fresh_due, old_lead, old_admission, admission;
+    struct secondary_ass_sample_snapshot sample;
+    struct secondary_ass_present_plan plan;
+};
+
+static inline bool secondary_ass_sample_snapshot_equal(
+    const struct secondary_ass_sample_snapshot *a,
+    const struct secondary_ass_sample_snapshot *b)
+{
+    return a->valid && b->valid && !a->held && !b->held && !a->force && !b->force &&
+        isfinite(a->rate) && isfinite(a->speed) && isfinite(a->requested_speed) &&
+        a->rate > 0 && a->speed > 0 && a->requested_speed > 0 &&
+        a->rate == b->rate && a->speed == b->speed &&
+        a->requested_speed == b->requested_speed && a->epoch == b->epoch &&
+        a->next_slot == b->next_slot && a->next_wall == b->next_wall &&
+        a->divisor == b->divisor && a->phase_wall == b->phase_wall &&
+        a->phase_slot == b->phase_slot && a->interval == b->interval;
+}
+
+static inline struct secondary_ass_queue_token secondary_ass_queue_lead_make(
+    const struct secondary_ass_queue_hint *hint,
+    const struct secondary_ass_sample_snapshot *sample,
+    int64_t fresh_due, int64_t old_lead, int64_t maximum_lead,
+    int64_t redraw_cost)
+{
+    struct secondary_ass_queue_token token = {0};
+    const struct secondary_ass_physical *p = &hint->physical;
+    if (!hint->valid || !hint->retained_id || old_lead <= 0 ||
+        maximum_lead <= old_lead || fresh_due <= maximum_lead ||
+        !secondary_ass_sample_snapshot_equal(&hint->sample, sample) ||
+        !p->success_contiguous || !p->success_generation || p->outlier_pending ||
+        !secondary_ass_physical_interval_valid(p->interval) ||
+        sample->epoch != p->epoch ||
+        sample->divisor <= 0 || sample->divisor > INT64_MAX / p->interval ||
+        hint->duration < sample->divisor * p->interval)
+        return token;
+    struct secondary_ass_physical_point point =
+        secondary_ass_physical_point_at(p, sample->next_slot);
+    // The sampler owns logical opportunity identity. Feedback may reanchor or
+    // refine the physical coordinates between draws; secondary_next_sample()
+    // also projects this integer slot through the latest physical state.
+    // Keep the raw snapshot for coherence, without interpreting its old wall
+    // coordinates as the current display model.
+    if (point.wall < fresh_due)
+        return token;
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    int64_t prepare = secondary_ass_physical_render_slot_time(&view,
+        point.wall, redraw_cost);
+    int64_t old_admission = fresh_due - old_lead;
+    // Even a cache slot at/after F must not change cache->fresh event order.
+    // Exact ties belong to the original path. This rejects the 5 ms redraw
+    // counterexample where an earlier queue consumes cache 110 as fresh 110.
+    if (prepare <= old_admission || hint->earliest_redraw >= point.wall)
+        return token;
+    struct secondary_ass_present_plan plan =
+        secondary_ass_present_plan_fresh(p, fresh_due, point);
+    if (!plan.valid || plan.base.slot != point.slot ||
+        plan.target.slot != point.slot || !plan.fifo_known ||
+        !secondary_ass_present_plan_current(p, &plan))
+        return token;
+    int64_t lead = sample->divisor * p->interval;
+    if (lead > INT64_MAX - 2000000)
+        return token;
+    lead += 2000000;
+    if (lead > maximum_lead)
+        lead = maximum_lead;
+    if (lead <= old_lead)
+        return token;
+    return (struct secondary_ass_queue_token){
+        .valid = true, .retained_id = hint->retained_id,
+        .fresh_due = fresh_due, .old_lead = old_lead,
+        .old_admission = old_admission, .admission = fresh_due - lead,
+        .sample = *sample, .plan = plan,
+    };
+}
+
+static inline bool secondary_ass_queue_lead_current(
+    const struct secondary_ass_queue_token *token,
+    const struct secondary_ass_sample_snapshot *sample,
+    const struct secondary_ass_physical *p, uint64_t retained_id,
+    int64_t fresh_due, int64_t redraw_cost)
+{
+    if (!token->valid || token->retained_id != retained_id ||
+        token->fresh_due != fresh_due ||
+        !secondary_ass_sample_snapshot_equal(&token->sample, sample) ||
+        !p->success_contiguous || !p->sync_segment_consistent || p->outlier_pending ||
+        p->interval != token->plan.interval ||
+        !secondary_ass_present_plan_current(p, &token->plan))
+        return false;
+    // A different anchor for the exact same lattice is harmless. A changed
+    // captured wall or period is not: do not retarget the already chosen D/S.
+    if (secondary_ass_physical_point_at(p, token->plan.base.slot).wall !=
+            token->plan.base.wall ||
+        secondary_ass_physical_point_at(p, token->plan.target.slot).wall !=
+            token->plan.target.wall)
+        return false;
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    return secondary_ass_physical_render_slot_time(&view,
+        token->plan.base.wall, redraw_cost) > token->old_admission;
+}
+
+#endif
