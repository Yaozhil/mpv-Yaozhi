+static void continuous_feedback(struct vo *vo, struct vo_internal *in,
+ struct osd_state *osd, struct vo_frame *retained, struct vo_driver *driver) {
+ const int rates[]={60,120,144,165,240,360};
+ for(unsigned r=0;r<6;r++) {
+  setup(vo,in,osd,retained,driver);
+  int64_t T=1000000000/rates[r],divisor=(rates[r]+119)/120;
+  struct secondary_ass_physical *p=&in->secondary_physical;
+  p->interval=T;p->last_base_slot=100;p->sync_slot=100;p->sync_count=100;
+  p->sync_qpc_ns=p->measure_qpc_ns=p->phase;p->measure_count=100;
+  in->vsync_interval=T;in->reported_display_fps=1e9/T;
+  retained->duration=41666667;osd->secondary_rate=1e9/(divisor*T);
+  secondary_ass_sampler_reset(&osd->secondary_sampler);
+  struct secondary_ass_physical_point first=secondary_ass_physical_point_at(p,100+divisor);
+  CHECK(secondary_ass_physical_submit_planned_point(p,11,p->epoch,first,first));
+  coverage[r].rate=rates[r];
+  for(uint64_t history=11;history<75;history++) {
+   int64_t old_phase=p->phase,old_slot=p->phase_slot;
+   struct secondary_ass_physical_point future=secondary_ass_physical_point_at(p,old_slot+2*divisor);
+   CHECK(secondary_ass_physical_submit_planned_point(p,history+1,p->epoch,future,future));
+   CHECK(secondary_ass_sampler_update_physical(&osd->secondary_sampler,
+    &osd->secondary_clock,osd->secondary_rate,future.wall,future.slot,
+    old_phase,old_slot,T,p->epoch));
+   struct secondary_ass_sample_snapshot raw=osd_get_secondary_sample_snapshot(osd);
+   struct secondary_ass_physical_point before=secondary_next_sample(vo,divisor);
+   int64_t F=before.wall-1000000;
+   struct secondary_ass_present_plan before_plan=secondary_ass_present_plan_fresh(p,F,before);
+   secondary_ass_physical_update_observed(p,false,0,(struct secondary_ass_physical_point){0},
+    p->sync_qpc_ns+divisor*T,old_phase+divisor*T,
+    p->sync_count+divisor,p->sync_count+divisor,history,T);
+   secondary_ass_physical_record_present(p,true,history+1,3,1);
+   struct secondary_ass_sample_snapshot after_raw=osd_get_secondary_sample_snapshot(osd);
+   struct secondary_ass_physical_point actual=secondary_next_sample(vo,divisor);
+   struct secondary_ass_present_plan actual_plan=secondary_ass_present_plan_fresh(p,F,actual);
+   CHECK(raw.valid && p->epoch==raw.epoch && !p->outlier_pending && p->sync_segment_consistent);
+   CHECK(secondary_ass_sample_snapshot_equal(&raw,&after_raw));
+   CHECK(secondary_ass_sample_snapshot_equal(&raw,&(struct secondary_ass_sample_snapshot){
+    .valid=true,.rate=osd->secondary_rate,.speed=1,.requested_speed=1,.epoch=p->epoch,
+    .next_slot=raw.next_slot,.next_wall=raw.next_wall,.divisor=divisor,
+    .phase_wall=old_phase,.phase_slot=old_slot,.interval=T}));
+   CHECK(before.slot==actual.slot && before.wall==actual.wall &&
+    before_plan.valid && actual_plan.valid && before_plan.target.wall==actual_plan.target.wall &&
+    before_plan.submit==actual_plan.submit && before_plan.epoch==actual_plan.epoch);
+   secondary_publish_queue_hint(vo);
+   struct secondary_ass_queue_token candidate=secondary_ass_queue_lead_make(
+    &in->secondary_queue_hint,&raw,F,T+2000000,in->timing_offset,in->secondary_redraw_cost);
+   CHECK(candidate.valid==(divisor>1));
+   CHECK(!candidate.valid || (candidate.plan.base.slot==actual.slot &&
+    candidate.plan.target.wall==actual.wall && candidate.plan.submit==actual_plan.submit));
+   clock_ns=F-divisor*T-2000000;in->wakeup_pts=0;
+   bool admitted=vo_is_ready_for_frame(vo,F) && in->secondary_queue_admission.valid;
+   CHECK(admitted==(divisor>1));
+   CHECK(!admitted || (in->secondary_queue_admission.fresh_due==F &&
+    in->secondary_queue_admission.plan.target.wall==actual.wall));
+   coverage[r].samples++;coverage[r].canonical++;
+   coverage[r].same_lattice++;
+   // These are the exact literal-coordinate predicates removed from make,
+   // evaluated on the same dynamic inputs, not a loose tolerance model.
+   coverage[r].old_eligible+=candidate.valid && raw.interval==p->interval &&
+    raw.phase_wall==p->phase && raw.phase_slot==p->phase_slot && raw.next_wall==actual.wall;
+   coverage[r].new_eligible+=admitted;
+  }
+ }
