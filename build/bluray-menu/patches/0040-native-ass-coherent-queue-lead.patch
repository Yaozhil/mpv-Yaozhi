+struct secondary_ass_sample_snapshot osd_get_secondary_sample_snapshot(struct osd_state *osd)
+{
+    mp_mutex_lock(&osd->lock);
+    struct secondary_ass_sampler *s = &osd->secondary_sampler;
+    struct secondary_ass_sample_snapshot snapshot = {
+        .held = osd->secondary_sample_held, .force = s->force,
+        .rate = osd->secondary_has_output ? osd->secondary_rate : 0,
+        .speed = osd->secondary_speed,
+        .requested_speed = osd->secondary_requested_speed,
+        .epoch = s->epoch, .divisor = s->divisor,
+        .next_slot = secondary_ass_sampler_next_slot(s),
+        .next_wall = secondary_ass_sampler_next_wall(s),
+        .phase_wall = s->phase_wall, .phase_slot = s->phase_slot,
+        .interval = s->physical_interval,
+    };
+    snapshot.valid = snapshot.rate > 0 && !snapshot.held && !snapshot.force &&
+        osd->secondary_physical_phase && osd->secondary_clock.valid &&
+        !osd->secondary_clock.display_synced && s->valid && s->physical_slots &&
+        s->rate == snapshot.rate && s->epoch == osd->secondary_physical_epoch &&
+        snapshot.epoch && snapshot.divisor > 0 && snapshot.next_slot > 0 &&
+        snapshot.next_wall > 0;
+    mp_mutex_unlock(&osd->lock);
+    return snapshot;
+}
