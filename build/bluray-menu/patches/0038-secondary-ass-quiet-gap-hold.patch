From 19f1650cdd551c52660f27665eaf77f0045b09cb Mon Sep 17 00:00:00 2001
From: mpv-Yaozhi Codex <yaozhi@users.noreply.github.com>
Date: Tue, 6 Oct 2026 14:59:03 +0800
Subject: [PATCH 1/2] video: advance quiet ASS samples on the retained display
 grid

---
 video/out/vo.c | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/video/out/vo.c b/video/out/vo.c
index 9562f7f..71f5ca0 100644
--- a/video/out/vo.c
+++ b/video/out/vo.c
@@ -1562,9 +1562,16 @@ static void secondary_physical_feedback(struct vo *vo,
 
 static bool secondary_set_presentation(struct vo *vo,
     struct secondary_ass_physical_point point, int64_t fallback,
-    int64_t interval, int64_t submit)
+    int64_t interval, int64_t submit, bool quiet_output)
 {
     struct secondary_ass_physical *p = &vo->in->secondary_physical;
+    if (!(point.slot > 0 && point.wall > 0) && quiet_output && p->epoch &&
+        !p->outlier_pending) {
+        // Quiet output needs no extra redraw, but future events still need an
+        // advancing sample on the retained physical lattice. This local point
+        // is for OSD only; it does not retarget video or register a Present.
+        point = secondary_ass_physical_predict_point(p, fallback);
+    }
     if (point.slot > 0 && point.wall > 0)
         osd_set_secondary_physical_presentation_time(vo->osd, point.wall, point.slot,
             p->phase, p->phase_slot, p->interval, p->epoch, submit);
@@ -1883,7 +1890,8 @@ static bool render_frame(struct vo *vo)
         }
         physical_phase = physical_point.slot > 0 && !frame->display_synced;
         bool secondary_target_updated = secondary_set_presentation(vo,
-            physical_point, presentation_time, display_interval, present_ready);
+            physical_point, presentation_time, display_interval, present_ready,
+            native_rate <= 0 && !frame->display_synced);
         if (!secondary_target_updated && in->secondary_trace)
             MP_INFO(vo, "native-ass-phase-hold: fresh=%d target_updated=0 "
                 "physical_point_available=0 actual_display_known=0 "
@@ -2282,7 +2290,8 @@ static bool do_redraw(struct vo *vo, uint64_t current_id, uint64_t queued_id,
     }
     bool secondary_target_updated = secondary_set_presentation(vo,
         physical_point, presentation_time, display_interval,
-        planned_audio && present_plan.valid ? present_plan.submit : mp_time_ns());
+        planned_audio && present_plan.valid ? present_plan.submit : mp_time_ns(),
+        secondary_rate <= 0 && !frame->display_synced);
     if (!secondary_target_updated && in->secondary_trace)
         MP_INFO(vo, "native-ass-phase-hold: fresh=0 target_updated=0 "
             "physical_point_available=0 actual_display_known=0 "

