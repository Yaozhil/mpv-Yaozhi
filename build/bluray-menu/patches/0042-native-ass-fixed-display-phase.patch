+        info->secondary_sync_time =
+            mp_time_ns_from_raw_time(info->secondary_sync_qpc_ns);
         info->secondary_sync_refresh_count = stats.SyncRefreshCount;
         info->secondary_present_refresh_count = stats.PresentRefreshCount;
         info->secondary_present_id = stats.PresentCount;
@@ -985,8 +988,8 @@ static void d3d11_get_vsync(struct ra_swapchain *sw, struct vo_vsync_info *info)
         int32_t refresh_offset = stats.PresentRefreshCount - stats.SyncRefreshCount;
         int64_t actual_qpc = stats.SyncQPCTime.QuadPart +
