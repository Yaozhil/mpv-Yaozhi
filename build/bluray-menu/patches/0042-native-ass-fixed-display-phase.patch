diff --git a/test/secondary_ass_fixed_forecast.c b/test/secondary_ass_fixed_forecast.c
new file mode 100644
index 0000000..8b78ff6
--- /dev/null
+++ b/test/secondary_ass_fixed_forecast.c
@@ -0,0 +1,218 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "sub/secondary_ass_clock.h"
+#include "video/out/secondary_ass_present_plan.h"
+
+// Actual production helper calls with synthetic count/Display input only.
+// These checks do not establish API, Ready, or physical Display performance.
+static unsigned checks, feedback_frames, historical_changes;
+#define CHECK(x) do { checks++; if (!(x)) { \
+    fprintf(stderr, "fixed forecast check %u line %d: %s\n", \
+            checks, __LINE__, #x); exit(2); } } while (0)
+static const int64_t origin = INT64_C(1000000000);
+
+static struct secondary_ass_physical state(int Hz)
+{
+    int64_t T = INT64_C(1000000000) / Hz;
+    return (struct secondary_ass_physical){
+        .phase = origin, .phase_slot = 100, .interval = T, .epoch = 7,
+        .sync_qpc_ns = origin, .sync_count = 100, .sync_slot = 100,
+        .sync_segment_consistent = true,
+        .measure_qpc_ns = origin, .measure_count = 100,
+        .periods = {T, T, T}, .period_count = 3, .period_next = 3,
+        .delay = 1, .delay_samples = {1, 1, 1}, .delay_count = 3,
+        .success_generation = 3, .success_contiguous = true,
+        .success_first_id = 1, .success_last_id = 1, .historical_id = 1,
+        .last_base_slot = 100,
+    };
+}
+
+static void feedback(struct secondary_ass_physical *p,
+    const struct secondary_ass_present_plan *plan, uint64_t id, int late)
+{
+    struct secondary_ass_physical_point actual =
+        secondary_ass_physical_point_at(p, plan->target.slot + late);
+    int old_H = p->delay;
+    CHECK(secondary_ass_physical_submit_planned_point(p, id, plan->epoch,
+                                                     plan->base, plan->target));
+    secondary_ass_physical_update_observed(p, false, id, plan->target,
+        actual.wall, actual.wall, (uint32_t)actual.slot, (uint32_t)actual.slot,
+        id, p->interval);
+    secondary_ass_physical_record_present(p, true, id, 3, 1);
+    CHECK(p->historical_id == id && p->last_submit_id == id);
+    CHECK(p->phase_slot == actual.slot && p->phase == actual.wall);
+    unsigned n = (p->next + 31) % 32;
+    CHECK(p->submitted[n].base_slot == plan->base.slot);
+    CHECK(p->submitted[n].target_slot == plan->target.slot);
+    historical_changes += p->delay != old_H;
+    feedback_frames++;
+}
+
+static void chain(int Hz, int N)
+{
+    struct secondary_ass_physical p = state(Hz);
+    struct secondary_ass_present_fixed_offset fixed = {0};
+    struct secondary_ass_sampler sampler = {0};
+    struct secondary_ass_clock clock = {
+        .valid = true, .pts = 10, .speed = 1, .wall = origin,
+    };
+    double rate = 1e9 / ((double)p.interval * N);
+    for (unsigned tick = 1; tick <= 24; tick++) {
+        int64_t G = 100 + tick * N;
+        struct secondary_ass_physical_point g = secondary_ass_physical_point_at(&p, G);
+        struct secondary_ass_physical before = p;
+        int offset = secondary_ass_present_fixed_offset_get(&fixed, &p, g, N, rate);
+        CHECK(offset == 1 && fixed.valid);
+        CHECK(!memcmp(&p, &before, sizeof(p)));
+        struct secondary_ass_present_fixed_offset captured_offset = fixed;
+        struct secondary_ass_present_plan plan =
+            secondary_ass_present_plan_make_fixed_forecast(&p, g, offset);
+        CHECK(plan.valid && plan.display_forecast && plan.captured_forecast == 1);
+        CHECK(plan.base.slot == G && plan.base.wall == g.wall);
+        CHECK(plan.target.slot == G + 1 && plan.target.wall == g.wall + p.interval);
+        CHECK(plan.historical_delay == p.delay);
+        CHECK(plan.submit == plan.target.wall - p.interval +
+            (p.interval / 4 < 1000000 ? p.interval / 4 : 1000000));
+        CHECK(plan.submit == plan.fallback_submit && plan.deadline == plan.target.wall);
+        CHECK(secondary_ass_sampler_update_physical_forecast(&sampler, &clock, rate,
+            plan.target.wall, plan.base.slot, plan.target.slot,
+            p.phase, p.phase_slot, p.interval, p.epoch));
+        CHECK(sampler.origin_slot == 100 + N && sampler.tick == tick - 1);
+        CHECK(sampler.display_slot == G + 1 && sampler.sample_wall == plan.target.wall);
+        CHECK(secondary_ass_sampler_next_slot(&sampler) == G + N);
+        struct secondary_ass_present_plan captured_plan = plan;
+        CHECK(!secondary_ass_sampler_update_physical_forecast(&sampler, &clock, rate,
+            plan.target.wall, plan.base.slot, plan.target.slot,
+            p.phase, p.phase_slot, p.interval, p.epoch));
+        CHECK(sampler.tick == tick - 1 && sampler.sample_wall == captured_plan.target.wall);
+        int late = N == 2 && ((tick - 1) / 3) % 2 == 0;
+        feedback(&p, &plan, tick + 1, late);
+        CHECK(p.epoch == 7 && !p.outlier_pending);
+        CHECK(!memcmp(&fixed, &captured_offset, sizeof(fixed)));
+        CHECK(!memcmp(&plan, &captured_plan, sizeof(plan)));
+        CHECK(sampler.origin_slot == 100 + N && sampler.tick == tick - 1);
+    }
+}
+
+static void identity_and_misses(void)
+{
+    struct secondary_ass_physical p = state(144);
+    struct secondary_ass_present_fixed_offset fixed = {0};
+    double rate = 1e9 / ((double)p.interval * 2);
+    struct secondary_ass_physical_point g = secondary_ass_physical_point_at(&p, 102);
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == 1);
+    struct secondary_ass_present_fixed_offset saved = fixed;
+    struct secondary_ass_present_plan captured =
+        secondary_ass_present_plan_make_fixed_forecast(&p, g, 1);
+    struct secondary_ass_present_plan saved_plan = captured;
+
+    p.success_generation = 0;
+    p.delay = 3;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == -1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    CHECK(!secondary_ass_present_plan_make_fixed_forecast(&p, g, 1).valid);
+    CHECK(!memcmp(&captured, &saved_plan, sizeof(captured)));
+    p.success_generation = 3;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == 1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    CHECK(secondary_ass_present_plan_make_fixed_forecast(&p, g, 1).target.slot == 103);
+
+    secondary_ass_physical_record_present(&p, false, 2, 0, 1);
+    CHECK(!p.success_contiguous);
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == -1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    CHECK(!secondary_ass_present_plan_make_fixed_forecast(&p, g, 1).valid);
+    secondary_ass_physical_record_present(&p, true, 2, 3, 1);
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == 1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 0, 0) == -1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    p.epoch = 0;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == -1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    p.epoch = saved.epoch;
+
+    p.outlier_pending = true;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == -1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    p.outlier_pending = false;
+    p.sync_segment_consistent = false;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == -1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    p.sync_segment_consistent = true;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == 1);
+    p.interval -= 17; // Local projection refinement is not a cadence change.
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p,
+        secondary_ass_physical_point_at(&p, 102), 2, rate) == 1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    g = secondary_ass_physical_point_at(&p, 102);
+
+    // A true nonzero backend generation change is a new identity, unlike 0.
+    p.success_generation = 4;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == 3);
+    CHECK(fixed.generation == 4 && fixed.offset == 3);
+    p.epoch++;
+    p.delay = 0;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == 0);
+    CHECK(fixed.epoch == p.epoch);
+    p.delay = 2;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p,
+        secondary_ass_physical_point_at(&p, 102), 1, rate * 2) == 2);
+    CHECK(fixed.divisor == 1 && fixed.rate == rate * 2);
+
+    // Dynamic H must affect neither expiry nor captured D in this lifecycle.
+    p = state(144);
+    g = secondary_ass_physical_point_at(&p, 102);
+    p.delay = 0;
+    struct secondary_ass_physical before = p;
+    int64_t now = g.wall + p.interval / 2;
+    CHECK(secondary_ass_present_plan_cache_next_forecast(&p, 102, 2, now).slot == 104);
+    CHECK(secondary_ass_present_plan_cache_next_fixed_forecast(&p, 102, 2, now, 1).slot == 102);
+    CHECK(!memcmp(&p, &before, sizeof(p)));
+    p.delay = 3;
+    CHECK(secondary_ass_present_plan_cache_next_fixed_forecast(&p, 102, 2, now, 1).slot == 102);
+    captured = secondary_ass_present_plan_make_fixed_forecast(&p, g, 1);
+    CHECK(captured.valid && captured.historical_delay == 3 && captured.target.slot == 103);
+    CHECK(captured.submit == g.wall + 1000000);
+    p.historical_id = 10;
+    p.success_first_id = 10;
+    p.success_last_id = 13;
+    p.success_contiguous = true;
+    struct secondary_ass_present_plan blocked =
+        secondary_ass_present_plan_make_fixed_forecast(&p, g, 1);
+    CHECK(!blocked.valid && blocked.target.slot == 103 && blocked.fifo_lower == 104);
+    CHECK(captured.valid && captured.target.slot == 103);
+    CHECK(secondary_ass_present_plan_cache_next_fixed_forecast(&p, 102, 2, now, 1).slot == 104);
+    CHECK(!secondary_ass_present_plan_make_fixed_forecast(&p, g, -1).valid);
+    CHECK(!secondary_ass_present_plan_make_fixed_forecast(&p, g, 5).valid);
+
+    // Real budget helper: a shifted S may consume fresh reservation even
+    // though the original G-window had enough time. Preserve the original F.
+    int64_t F = captured.submit + 2000000;
+    CHECK(secondary_ass_budget_before_deadline(captured.submit - p.interval,
+        F, 1500000, 1500000, 1000000));
+    CHECK(!secondary_ass_budget_before_deadline(captured.submit,
+        F, 1500000, 1500000, 1000000));
+    CHECK(secondary_ass_budget_probe_due(1000000, 40000000,
+        14000000, origin, origin));
+    CHECK(!secondary_ass_budget_probe_due(1000000, 40000000,
+        14000000, origin, origin + 1));
+}
+
+int main(void)
+{
+    const int rates[] = {60, 120, 144, 165, 240};
+    for (unsigned i = 0; i < sizeof(rates) / sizeof(rates[0]); i++) {
+        chain(rates[i], 1);
+        chain(rates[i], 2);
+    }
+    identity_and_misses();
+    CHECK(historical_changes > 0);
+    printf("{\"checks\":%u,\"feedback_frames\":%u,\"historical_changes\":%u,"
+           "\"cpu_only\":true,\"Display_PASS\":false}\n",
+           checks, feedback_frames, historical_changes);
+    return 0;
+}
