     secondary_ass_flip_budget_reset(&in->secondary_flip_budget);
     if (mp_ass_pacing_enabled(vo->global)) {
         struct mp_ass_pacing_record record = {
@@ -386,6 +389,7 @@ struct secondary_ass_grid_task {
     int delay;
