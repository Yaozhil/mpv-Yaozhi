-        info->secondary_display_time = mp_time_ns() +
-            qpc_to_ns(sw, actual_qpc) - qpc_ns_now(sw);
+        info->secondary_display_time =
+            mp_time_ns_from_raw_time(qpc_to_ns(sw, actual_qpc));
