         // Independent raw observation for the secondary clock. Primary video
         // synchronization retains its existing one-step estimator below.
         info->secondary_sync_qpc_ns = qpc_to_ns(sw, stats.SyncQPCTime.QuadPart);
-        info->secondary_sync_time = mp_time_ns() +
-            info->secondary_sync_qpc_ns - qpc_ns_now(sw);
+        // QPC uses the same raw nanosecond scale as the Windows mpv timer.
+        // Convert with its fixed initialization offset; two live clock reads
