diff --git a/video/out/secondary_ass_fresh_video.h b/video/out/secondary_ass_fresh_video.h
new file mode 100644
index 0000000..29a6d23
--- /dev/null
+++ b/video/out/secondary_ass_fresh_video.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_FRESH_VIDEO_H
+#define MP_SECONDARY_ASS_FRESH_VIDEO_H
+
+#include "secondary_ass_present_plan.h"
+
+// Mandatory video owns F. Its predicted display D may advance the ASS clock
+// only to an already due G on the retained sampler lattice, never next-G just
+// because another video frame arrived. Cached ASS keeps its existing policy.
+static inline struct secondary_ass_present_plan
+secondary_ass_fresh_video_plan(const struct secondary_ass_physical *p,
+    int64_t origin_slot, int64_t next_slot, int64_t divisor, int offset,
+    int64_t ready, int64_t video_submit)
+{
+    struct secondary_ass_present_plan none = {
+        .display_forecast = true, .fresh_clock_only = true,
+        .submit = video_submit, .fallback_submit = video_submit,
+        .lifecycle_safe_wait = video_submit,
+    };
+    if (origin_slot <= 0 || next_slot < origin_slot || divisor <= 0 ||
+        (next_slot - origin_slot) % divisor || offset < 0 || offset > 4 ||
+        ready <= 0 || video_submit <= 0 || !p->epoch || p->epoch_exhausted ||
+        !p->success_generation || !p->success_contiguous ||
+        p->outlier_pending || !p->sync_segment_consistent)
+        return none;
+
+    // Do not feed retrospective G-to-D quantization into this prediction.
+    // The accepted fixed offset is independent of the changing delay learner.
+    struct secondary_ass_physical display = *p;
+    display.delay = offset;
+    // An already registered pose cannot make wall time advance. When source
+    // video is faster than scanout, repeated fresh draws must hold the tick.
+    display.last_base_slot = 0;
+    int64_t after = ready > video_submit ? ready : video_submit;
+    struct secondary_ass_physical_point actual =
+        secondary_ass_physical_predict_point(&display, after);
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    int64_t lower = secondary_ass_physical_fifo_lower_bound(&view);
+    if (lower > actual.slot)
+        actual = secondary_ass_physical_point_at(&view, lower);
+    if (actual.slot <= offset || actual.wall <= after)
+        return none;
+    int64_t base = actual.slot - offset;
+    if (base < origin_slot)
+        return none;
+    int64_t logical_slot = base - (base - origin_slot) % divisor;
+    if (logical_slot < next_slot || logical_slot <= p->last_base_slot)
+        return none;
+    struct secondary_ass_physical_point logical =
+        secondary_ass_physical_point_at(&view, logical_slot);
+    struct secondary_ass_present_plan plan =
+        secondary_ass_present_plan_make(p, logical, actual);
+    if (!plan.valid || actual.slot - logical.slot > INT32_MAX)
+        return none;
+    plan.display_forecast = true;
+    plan.fresh_clock_only = true;
+    plan.captured_forecast = (int)(actual.slot - logical.slot);
+    plan.submit = video_submit;
+    plan.fallback_submit = video_submit;
+    plan.lifecycle_safe_wait = video_submit;
+    return plan;
+}
+
+#endif
