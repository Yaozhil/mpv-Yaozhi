 #include "secondary_ass_queue_stage.h"
@@ -560,6 +561,27 @@ static struct secondary_ass_present_plan secondary_forecast_fresh_clock_plan(
         ready, video_submit);
 }
 
+static struct secondary_ass_present_plan secondary_forecast_fresh_video_plan(
+    struct vo *vo, int64_t ready, int64_t video_submit,
+    struct secondary_ass_physical_point next, int64_t divisor, double rate)
+{
+    struct secondary_ass_sample_snapshot sample =
+        osd_get_secondary_sample_snapshot(vo->osd);
+    if (sample.epoch != vo->in->secondary_physical.epoch ||
+        sample.divisor != divisor || sample.rate != rate)
+        return (struct secondary_ass_present_plan){
+            .display_forecast = true, .fresh_clock_only = true,
+            .submit = video_submit, .fallback_submit = video_submit,
+            .lifecycle_safe_wait = video_submit,
+        };
+    // Held/forced samples remain usable identities. Requiring sample.valid
+    // here would prevent a held clock from ever accepting its next due tick.
+    return secondary_ass_fresh_video_plan(&vo->in->secondary_physical,
+        sample.origin_slot, next.slot, divisor,
+        secondary_fixed_forecast_offset(vo, next, divisor, rate),
+        ready, video_submit);
+}
+
 static struct secondary_ass_present_plan secondary_cache_plan(struct vo *vo,
     struct secondary_ass_physical_point logical, int64_t divisor, double rate)
 {
@@ -2485,6 +2507,13 @@ static bool render_frame(struct vo *vo)
         struct secondary_ass_present_plan present_plan = {0};
         bool planned_audio = secondary_plan_enabled(vo, frame->display_synced,
                                                   sample_divisor);
+        // This is the accepted launcher policy, not every diagnostic mode.
+        bool accepted_day_fresh = planned_audio && native_rate > 0 &&
+            !frame->display_synced && !frame->repeat && !early_plan.valid &&
+            in->secondary_fifo_present && in->secondary_present_grid &&
+            in->secondary_present_plan && in->secondary_split_budget &&
+            in->secondary_display_forecast && in->secondary_fixed_forecast &&
+            !in->secondary_queue_lead && !in->secondary_queue_stage;
         bool secondary_affordable = native_rate > 0 && secondary_ass_budget_affordable(
             in->secondary_render_cost, in->secondary_redraw_cost, duration,
             MPMAX(MP_TIME_S_TO_NS(1.0 / native_rate), in->secondary_physical.interval));
@@ -2492,7 +2521,7 @@ static bool render_frame(struct vo *vo)
         // is already mandatory. Keep the normal/early captured plans unchanged.
         bool fresh_clock_only = in->secondary_fixed_forecast && !frame->repeat &&
             secondary_forecast_enabled(vo, frame->display_synced, sample_divisor) &&
-            !early_plan.valid && !secondary_affordable;
+            !early_plan.valid && (!secondary_affordable || accepted_day_fresh);
         bool physical_phase = clock_rate > 0 && !frame->display_synced &&
             in->secondary_physical.phase && native_rate > 0 &&
             duration >= in->secondary_physical.interval &&
@@ -2570,9 +2599,23 @@ static bool render_frame(struct vo *vo)
                 physical_now + in->secondary_render_cost);
             if (planned_audio) {
                 if (fresh_clock_only) {
-                    present_plan = secondary_forecast_fresh_clock_plan(vo,
-                        physical_ready, original_video_target, native_point,
-                        sample_divisor, native_rate);
+                    if (accepted_day_fresh) {
+                        present_plan = secondary_forecast_fresh_video_plan(vo,
+                            physical_ready, original_video_target, native_point,
+                            sample_divisor, native_rate);
+                        if (!present_plan.valid) {
+                            // No due ASS tick: render video at F with the last
+                            // accepted pose, without a future task or wait.
+                            physical_point = (struct secondary_ass_physical_point){0};
+                            presentation_time = 0;
+                            target = original_video_target;
+                            present_ready = target;
+                        }
+                    } else {
+                        present_plan = secondary_forecast_fresh_clock_plan(vo,
+                            physical_ready, original_video_target, native_point,
+                            sample_divisor, native_rate);
+                    }
                 } else {
                     present_plan = early_plan.valid ? early_plan :
                     (secondary_forecast_enabled(vo, false, sample_divisor)
