+bool osd_set_secondary_physical_forecast_time(struct osd_state *osd,
+    int64_t display_wall, int64_t logical_slot, int64_t display_slot,
+    int64_t phase_wall, int64_t phase_slot, int64_t interval,
+    uint64_t epoch, int64_t submit_wall)
+{
+    mp_mutex_lock(&osd->lock);
+    struct secondary_ass_sampler projection = {
+        .phase_wall = phase_wall, .phase_slot = phase_slot,
+        .physical_interval = interval,
+    };
+    struct secondary_ass_sampler *s = &osd->secondary_sampler;
+    bool valid = epoch && logical_slot > 0 && display_slot >= logical_slot &&
+        phase_wall > 0 && phase_slot > 0 && interval > 0 && display_wall > 0 &&
+        secondary_ass_sampler_slot_wall(&projection, display_slot) == display_wall;
+    if (valid && s->valid && s->physical_slots && s->display_forecast &&
+        s->epoch == epoch && s->rate == osd->secondary_rate)
+    {
+        valid = logical_slot >= s->origin_slot && s->divisor > 0 &&
+            (logical_slot - s->origin_slot) % s->divisor == 0;
+        if (valid) {
+            uint64_t tick = (uint64_t)((logical_slot - s->origin_slot) / s->divisor);
+            if (tick > s->tick)
+                valid = display_slot > s->display_slot && display_wall > s->sample_wall;
+        }
+    }
+    if (!valid) {
+        // A colliding/stale captured D is a miss, never a new clock origin.
+        osd->secondary_sample_held = true;
+        mp_mutex_unlock(&osd->lock);
+        return false;
+    }
+    if (!osd->secondary_physical_phase || osd->secondary_physical_epoch != epoch ||
+        !osd->secondary_display_forecast)
+        secondary_ass_sampler_reset(s);
+    if (!osd->secondary_display_forecast || osd->secondary_logical_slot != logical_slot)
+        osd->secondary_forecast_forced_sample = false;
+    osd->secondary_sample_held = false;
+    osd->secondary_physical_phase = true;
+    osd->secondary_display_forecast = true;
+    osd->secondary_physical_epoch = epoch;
+    osd->secondary_logical_slot = logical_slot;
+    osd->secondary_target_slot = display_slot;
+    osd->secondary_phase_wall = phase_wall;
+    osd->secondary_phase_slot = phase_slot;
+    osd->secondary_present_wall = display_wall;
+    osd->secondary_submit_wall = submit_wall;
+    osd->secondary_vsync_interval = interval;
+    mp_mutex_unlock(&osd->lock);
+    return true;
+}
