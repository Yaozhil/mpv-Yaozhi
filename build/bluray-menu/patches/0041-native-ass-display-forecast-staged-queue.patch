+        logical, secondary_ass_physical_point_at(&view, target_slot));
+    plan.display_forecast = true;
+    plan.captured_forecast = (int)(target_slot - logical.slot);
+    return plan;
+}
+
+static inline struct secondary_ass_present_plan
+secondary_ass_present_plan_fresh_forecast(const struct secondary_ass_physical *p,
+    int64_t ready, struct secondary_ass_physical_point sampled)
+{
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    // A supplied G is authoritative, including an invalid/stale one. Never
+    // replace it using render completion and turn its miss into another task.
+    // The caller separately checks this G against the queued video's raw F.
+    if (!sampled.slot && !sampled.wall)
