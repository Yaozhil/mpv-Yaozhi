+    return secondary_ass_present_plan_make_forecast(p, sampled);
+}
+
+static inline struct secondary_ass_present_plan
+secondary_ass_present_plan_cache_forecast(const struct secondary_ass_physical *p,
+    struct secondary_ass_physical_point sampled)
+{
+    return secondary_ass_present_plan_make_forecast(p, sampled);
+}
+
+static inline struct secondary_ass_physical_point
+secondary_ass_present_plan_cache_next_forecast(
+    const struct secondary_ass_physical *p, int64_t first_slot,
+    int64_t divisor, int64_t now)
+{
+    struct secondary_ass_physical_point none = {0};
+    if (p->delay < 0 || p->delay > 4 || first_slot <= 0 || divisor <= 0 ||
+        now <= 0 || !secondary_ass_physical_interval_valid(p->interval) ||
+        divisor > INT64_MAX / p->interval ||
+        first_slot > INT64_MAX - p->delay)
+        return none;
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    struct secondary_ass_physical_point target =
+        secondary_ass_physical_point_at(&view, first_slot + p->delay);
+    if (!target.slot || target.wall <= 0)
+        return none;
+    int64_t skip = 0;
+    // A logical G may be past while its original future D is still reachable.
+    // Judge expiry at D, with no learned-delay subtraction from its deadline.
+    if (target.wall <= now)
+        skip = (now - target.wall) / (divisor * p->interval) + 1;
+    int64_t floor = p->last_base_slot;
+    int64_t lower = secondary_ass_physical_fifo_lower_bound(&view);
+    if (lower > p->delay && lower - p->delay - 1 > floor)
+        floor = lower - p->delay - 1;
+    if (first_slot <= floor) {
+        int64_t occupied = (floor - first_slot) / divisor + 1;
+        if (occupied > skip)
+            skip = occupied;
+    }
+    if (skip > (INT64_MAX - first_slot - p->delay) / divisor)
+        return none;
+    int64_t logical_slot = first_slot + skip * divisor;
+    // Validate both projections before returning a new logical task. The
+    // sampler still owns the decision to accept its separate display pose.
+    target = secondary_ass_physical_point_at(&view, logical_slot + p->delay);
+    return target.slot ? secondary_ass_physical_point_at(&view, logical_slot)
+                       : none;
+}
+
 #endif
diff --git a/video/out/secondary_ass_queue_stage.h b/video/out/secondary_ass_queue_stage.h
new file mode 100644
index 0000000..a45df6b
--- /dev/null
+++ b/video/out/secondary_ass_queue_stage.h
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_QUEUE_STAGE_H
+#define MP_SECONDARY_ASS_QUEUE_STAGE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+// Early ownership of one real video frame is separate from its normal render
+// admission. This scalar contract contains no physical clock, sample rate,
+// learned delay, waiting primitive or permission to invent a future frame.
+struct secondary_ass_queue_stage {
+    bool valid, bound;
+    uint64_t retained_id, queued_id;
+    int64_t pts, offset, due, old_lead, max_lead, admission, resume;
+};
+
+static inline struct secondary_ass_queue_stage secondary_ass_queue_stage_make(
+    uint64_t retained_id, int64_t pts, int64_t offset, int64_t old_lead,
+    int64_t max_lead)
+{
+    // Restore at most the standard 50 ms queue lead. An option with a smaller
+    // cap stays smaller; a larger value cannot enlarge this staging window.
+    const int64_t cap = 50000000;
+    if (max_lead > cap)
+        max_lead = cap;
+    if (!retained_id || pts <= 0 || offset < 0 || old_lead <= 0 ||
+        max_lead <= old_lead || pts <= offset)
+        return (struct secondary_ass_queue_stage){0};
+
+    // Both operands are nonnegative and pts > offset. Every subtraction is
+    // consequently in [1, INT64_MAX]; no timestamp addition is necessary.
+    int64_t due = pts - offset;
+    if (due <= max_lead)
+        return (struct secondary_ass_queue_stage){0};
+    return (struct secondary_ass_queue_stage){
+        .valid = true, .retained_id = retained_id,
+        .pts = pts, .offset = offset, .due = due,
+        .old_lead = old_lead, .max_lead = max_lead,
+        .admission = due - max_lead, .resume = due - old_lead,
+    };
+}
+
+// Validate the recorded scalar arithmetic rather than trusting a caller's
+// valid bit or reusing a malformed deadline from another admission.
+static inline bool secondary_ass_queue_stage_sane(
+    const struct secondary_ass_queue_stage *stage)
+{
+    if (!stage || !stage->valid)
+        return false;
+    struct secondary_ass_queue_stage expected = secondary_ass_queue_stage_make(
+        stage->retained_id, stage->pts, stage->offset,
+        stage->old_lead, stage->max_lead);
+    return expected.valid && stage->max_lead == expected.max_lead &&
+        stage->due == expected.due && stage->admission == expected.admission &&
+        stage->resume == expected.resume;
+}
+
+// Bind only after vo_queue_frame accepted the actual frame. Recompute from
+// that frame's real pts/offset; a provisional core deadline is never carried
+// forward as an immutable promise. The VO caller must separately verify
+// now >= admission and its paused/reset/reconfiguration eligibility.
+static inline struct secondary_ass_queue_stage secondary_ass_queue_stage_bind(
+    const struct secondary_ass_queue_stage *admission, uint64_t retained_id,
+    uint64_t queued_id, int64_t pts, int64_t offset)
+{
+    if (!secondary_ass_queue_stage_sane(admission) || admission->bound ||
+        admission->queued_id || admission->retained_id != retained_id ||
+        queued_id <= retained_id)
+        return (struct secondary_ass_queue_stage){0};
+    struct secondary_ass_queue_stage stage = secondary_ass_queue_stage_make(
+        retained_id, pts, offset, admission->old_lead, admission->max_lead);
+    if (stage.valid) {
+        stage.bound = true;
+        stage.queued_id = queued_id;
+    }
+    return stage;
+}
+
+// Any identity/offset/pts mismatch removes staging authority. The VO caller
+// clears it and returns to its normal queued flow; an old resume must never
+// be transplanted onto a different frame. This function does not mutate or
+// wait for the producer, including when a queued frame has disappeared.
+static inline bool secondary_ass_queue_stage_current(
+    const struct secondary_ass_queue_stage *stage, uint64_t retained_id,
+    uint64_t queued_id, int64_t pts, int64_t offset)
+{
+    return secondary_ass_queue_stage_sane(stage) && stage->bound &&
+        queued_id > retained_id && stage->retained_id == retained_id &&
+        stage->queued_id == queued_id && stage->pts == pts &&
+        stage->offset == offset;
+}
+
+static inline void secondary_ass_queue_stage_clear(
+    struct secondary_ass_queue_stage *stage)
+{
+    if (stage)
+        *stage = (struct secondary_ass_queue_stage){0};
+}
+
+#endif
diff --git a/video/out/secondary_ass_stage_prefix.h b/video/out/secondary_ass_stage_prefix.h
new file mode 100644
index 0000000..fc0bc52
--- /dev/null
+++ b/video/out/secondary_ass_stage_prefix.h
@@ -0,0 +1,269 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_STAGE_PREFIX_H
+#define MP_SECONDARY_ASS_STAGE_PREFIX_H
+
+#include "secondary_ass_queue_stage.h"
+#include "secondary_ass_present_plan.h"
+#include "../../sub/secondary_ass_clock.h"
+
+// VO-thread-owned permission for one bound stage. It tracks only continuous
+// successful cache submissions after the initial cursor. It does not change
+// the sampler, physical ledger, phase, learned delay, stage F or finite resume.
+struct secondary_ass_stage_prefix {
+    bool initialized, valid;
+    struct secondary_ass_queue_stage stage;
+    struct secondary_ass_sample_snapshot grid;
+    uint64_t generation, first_id, last_id;
+    int64_t next_slot;
+};
+
+static inline void secondary_ass_stage_prefix_clear(
+    struct secondary_ass_stage_prefix *prefix)
+{
+    if (prefix)
+        *prefix = (struct secondary_ass_stage_prefix){0};
+}
+
+// Failure is sticky for this bound stage. Clear only when that stage ends;
+// a later sampler cursor must not silently restart early-prepare permission.
+static inline void secondary_ass_stage_prefix_invalidate(
+    struct secondary_ass_stage_prefix *prefix)
+{
+    if (prefix)
+        prefix->valid = false;
+}
+
+static inline bool secondary_ass_stage_prefix_snapshot_valid(
+    const struct secondary_ass_sample_snapshot *sample)
+{
+    if (!sample || !sample->valid || sample->held || sample->force ||
+        sample->sample_forced || !sample->display_forecast ||
+        !isfinite(sample->rate) || !isfinite(sample->speed) ||
+        !isfinite(sample->requested_speed) || sample->rate <= 0 ||
+        sample->speed <= 0 || sample->requested_speed <= 0 || !sample->epoch ||
+        sample->divisor <= 0 || sample->origin_slot <= 0 ||
+        sample->sample_slot < sample->origin_slot ||
+        sample->sample_slot > INT64_MAX - sample->divisor ||
+        sample->next_slot != sample->sample_slot + sample->divisor ||
+        (sample->sample_slot - sample->origin_slot) % sample->divisor ||
+        !secondary_ass_physical_interval_valid(sample->interval) ||
+        sample->divisor > INT64_MAX / sample->interval)
+        return false;
+    struct secondary_ass_physical projection = {
+        .phase = sample->phase_wall, .phase_slot = sample->phase_slot,
+        .interval = sample->interval,
+    };
+    struct secondary_ass_physical_point next =
+        secondary_ass_physical_point_at(&projection, sample->next_slot);
+    return next.slot == sample->next_slot && next.wall > 0 &&
+        next.wall == sample->next_wall;
+}
+
+static inline bool secondary_ass_stage_prefix_grid_equal(
+    const struct secondary_ass_sample_snapshot *a,
+    const struct secondary_ass_sample_snapshot *b)
+{
+    // Ordinary feedback can refine the slot-to-wall projection. Grid/speed
+    // identity and integer cursor stay fixed; do not compare anchor bytes.
+    return secondary_ass_stage_prefix_snapshot_valid(a) &&
+        secondary_ass_stage_prefix_snapshot_valid(b) &&
+        a->epoch == b->epoch && a->divisor == b->divisor &&
+        a->origin_slot == b->origin_slot &&
+        a->display_forecast == b->display_forecast &&
+        a->rate == b->rate && a->speed == b->speed &&
+        a->requested_speed == b->requested_speed;
+}
+
+static inline bool secondary_ass_stage_prefix_physical_ready(
+    const struct secondary_ass_physical *p)
+{
+    return p && p->epoch && !p->epoch_exhausted && !p->outlier_pending &&
+        p->sync_segment_consistent && p->success_contiguous &&
+        p->success_generation && p->success_first_id &&
+        p->success_last_id >= p->success_first_id &&
+        p->historical_id && p->historical_id <= p->success_last_id &&
+        p->last_submit_id == p->success_last_id && p->last_base_slot > 0 &&
+        p->phase > 0 && p->phase_slot > 0 && p->sync_slot > 0 &&
+        p->sync_qpc_ns > 0 &&
+        secondary_ass_physical_interval_valid(p->interval) && p->next < 32;
+}
+
+static inline bool secondary_ass_stage_prefix_registered(
+    const struct secondary_ass_physical *p, uint64_t id, int64_t expected_base,
+    const struct secondary_ass_present_plan *captured)
+{
+    if (!secondary_ass_stage_prefix_physical_ready(p) || !id ||
+        id != p->success_last_id || expected_base <= 0 ||
+        p->last_base_slot != expected_base)
+        return false;
+    unsigned matches = 0;
+    for (unsigned n = 0; n < 32; n++) {
+        if (p->submitted[n].id != id)
+            continue;
+        if (p->submitted[n].base_slot != expected_base ||
+            p->submitted[n].base <= 0 || p->submitted[n].gap_excluded ||
+            p->submitted[n].target_slot < expected_base ||
+            (p->history_floor_slot && expected_base < p->history_floor_slot) ||
+            (captured && (p->submitted[n].base != captured->base.wall ||
+                          p->submitted[n].target_slot != captured->target.slot)))
+            return false;
+        matches++;
+    }
+    return matches == 1;
+}
+
+// History may lag the current submission. If an ID already belongs to this
+// prefix, a known different display slot is a real MISS, not more permission.
+// Missing/duplicated history registration inside the prefix is also unknown.
+static inline bool secondary_ass_stage_prefix_history_safe(
+    const struct secondary_ass_physical *p, uint64_t first_id, uint64_t last_id)
+{
+    if (!p || !first_id || last_id < first_id)
+        return false;
+    if (p->historical_id < first_id)
+        return true;
+    if (p->historical_id > last_id)
+        return false;
+    unsigned matches = 0;
+    for (unsigned n = 0; n < 32; n++) {
+        if (p->submitted[n].id != p->historical_id)
+            continue;
+        if (p->submitted[n].gap_excluded || p->submitted[n].target_slot <= 0 ||
+            p->submitted[n].target_slot != p->phase_slot)
+            return false;
+        matches++;
+    }
+    return matches == 1;
+}
+
+static inline bool secondary_ass_stage_prefix_stage_equal(
+    const struct secondary_ass_queue_stage *a,
+    const struct secondary_ass_queue_stage *b)
+{
+    return secondary_ass_queue_stage_sane(a) &&
+        secondary_ass_queue_stage_sane(b) && a->bound && b->bound &&
+        a->queued_id > a->retained_id && b->queued_id > b->retained_id &&
+        a->retained_id == b->retained_id && a->queued_id == b->queued_id &&
+        a->pts == b->pts && a->offset == b->offset && a->due == b->due &&
+        a->old_lead == b->old_lead && a->max_lead == b->max_lead &&
+        a->admission == b->admission && a->resume == b->resume;
+}
+
+// Call once in the VO thread after accepting the bound stage, with one OSD
+// snapshot and that thread's current physical ledger. Do not read physical
+// state from the core-side bind. The caller owns identity/reset/budget checks.
+static inline bool secondary_ass_stage_prefix_begin(
+    struct secondary_ass_stage_prefix *prefix,
+    const struct secondary_ass_queue_stage *stage,
+    const struct secondary_ass_sample_snapshot *sample,
+    const struct secondary_ass_physical *p)
+{
+    if (!prefix || prefix->initialized)
+        return false;
+    prefix->initialized = true;
+    prefix->valid = false;
+    if (!secondary_ass_stage_prefix_stage_equal(stage, stage))
+        return false;
+    // A bound stage's failed first proof remains this same stage's failure.
+    // The VO compares this identity before deciding that the stage ended.
+    prefix->stage = *stage;
+    if (!secondary_ass_stage_prefix_snapshot_valid(sample) ||
+        !secondary_ass_stage_prefix_physical_ready(p) || sample->epoch != p->epoch)
+        return false;
+    int64_t previous = sample->next_slot - sample->divisor;
+    if (sample->sample_slot != previous ||
+        !secondary_ass_stage_prefix_registered(p, p->success_last_id,
+                                               previous, NULL) ||
+        !secondary_ass_stage_prefix_history_safe(p, p->success_last_id,
+                                                 p->success_last_id))
+        return false;
+    prefix->grid = *sample;
+    prefix->generation = p->success_generation;
+    prefix->first_id = p->success_last_id;
+    prefix->last_id = p->success_last_id;
+    prefix->next_slot = sample->next_slot;
+    prefix->valid = true;
+    return true;
+}
+
+// Resolve exactly one captured cache opportunity after Present/registration.
+// The caller passes actual success, not draw_frame's return or sampler change.
+// Before belongs to this captured attempt; after is taken after feedback.
+// A force/reset observed during the actual OSD draw must be passed as missed
+// (or invalidate first): it cannot be recovered from a cleared after.force.
+// Skips, MISS, force, failed/unregistered/repeated Presents revoke permission;
+// this minimal version never grants again from an expired-MISS disposition.
+static inline bool secondary_ass_stage_prefix_resolve(
+    struct secondary_ass_stage_prefix *prefix,
+    const struct secondary_ass_present_plan *captured, bool submit_success,
+    bool missed, uint64_t submit_id,
+    const struct secondary_ass_sample_snapshot *before,
+    const struct secondary_ass_sample_snapshot *sample,
+    const struct secondary_ass_physical *p)
+{
+    if (!prefix || !prefix->initialized || !prefix->valid)
+        return false;
+    bool valid = captured && captured->valid && captured->display_forecast &&
+        submit_success && !missed &&
+        secondary_ass_stage_prefix_grid_equal(&prefix->grid, before) &&
+        before->next_slot == prefix->next_slot &&
+        before->sample_slot == prefix->next_slot - prefix->grid.divisor &&
+        secondary_ass_stage_prefix_grid_equal(&prefix->grid, sample) &&
+        secondary_ass_stage_prefix_physical_ready(p) &&
+        captured->epoch == prefix->grid.epoch && p->epoch == prefix->grid.epoch &&
+        captured->generation == prefix->generation &&
+        p->success_generation == prefix->generation &&
+        captured->base.slot == prefix->next_slot && captured->base.wall > 0 &&
+        captured->target.slot >= captured->base.slot &&
+        captured->target.wall >= captured->base.wall &&
+        captured->base.slot <= INT64_MAX - prefix->grid.divisor &&
+        sample->next_slot == captured->base.slot + prefix->grid.divisor &&
+        sample->sample_slot == captured->base.slot &&
+        prefix->last_id < UINT64_MAX && submit_id == prefix->last_id + 1 &&
+        secondary_ass_stage_prefix_history_safe(p, prefix->first_id, submit_id) &&
+        secondary_ass_stage_prefix_registered(p, submit_id,
+                                               captured->base.slot, captured);
+    if (!valid) {
+        secondary_ass_stage_prefix_invalidate(prefix);
+        return false;
+    }
+    prefix->last_id = submit_id;
+    prefix->next_slot = sample->next_slot;
+    return true;
+}
+
+// False at G<F means park/service the original cache, not a permanent failure.
+// Bad identity/proof is sticky. The VO still checks budget/reset/visibility,
+// stage admission/resume and final Sync1 guard, then keeps the original G S.
+static inline bool secondary_ass_stage_prefix_can_promote(
+    struct secondary_ass_stage_prefix *prefix,
+    const struct secondary_ass_queue_stage *stage,
+    const struct secondary_ass_sample_snapshot *sample,
+    const struct secondary_ass_physical *p)
+{
+    if (!prefix || !prefix->initialized || !prefix->valid)
+        return false;
+    bool valid = secondary_ass_stage_prefix_stage_equal(&prefix->stage, stage) &&
+        secondary_ass_stage_prefix_grid_equal(&prefix->grid, sample) &&
+        secondary_ass_stage_prefix_physical_ready(p) &&
+        p->epoch == prefix->grid.epoch &&
+        p->success_generation == prefix->generation &&
+        secondary_ass_stage_prefix_history_safe(p, prefix->first_id, prefix->last_id) &&
+        p->success_last_id == prefix->last_id && sample->next_slot == prefix->next_slot &&
+        sample->sample_slot == prefix->next_slot - prefix->grid.divisor &&
+        secondary_ass_stage_prefix_registered(p, prefix->last_id,
+            prefix->next_slot - prefix->grid.divisor, NULL);
+    if (!valid) {
+        secondary_ass_stage_prefix_invalidate(prefix);
+        return false;
+    }
+    struct secondary_ass_physical_point current =
+        secondary_ass_physical_point_at(p, prefix->next_slot);
+    if (current.slot != prefix->next_slot || current.wall <= 0) {
+        secondary_ass_stage_prefix_invalidate(prefix);
+        return false;
+    }
+    return current.wall >= stage->due;
+}
+
+#endif
diff --git a/video/out/vo.c b/video/out/vo.c
index ff9f2ae..bb92b72 100644
--- a/video/out/vo.c
+++ b/video/out/vo.c
@@ -45,6 +45,8 @@
 #include "secondary_ass_physical.h"
 #include "secondary_ass_present_plan.h"
 #include "secondary_ass_queue_lead.h"
+#include "secondary_ass_queue_stage.h"
+#include "secondary_ass_stage_prefix.h"
 #include "aspect.h"
 #include "dr_helper.h"
 #include "input/input.h"
@@ -186,8 +188,13 @@ struct vo_internal {
     bool secondary_present_grid; // opt-in cadence experiment, not a default
     bool secondary_fifo_present; // isolated opt-in FIFO submission experiment
     bool secondary_present_plan; // isolated planned-base consumption experiment
+    bool secondary_display_forecast; // opt-in separate eligibility/display slots
     bool secondary_split_budget; // opt-in measured submission envelope forecast
     bool secondary_queue_lead; // opt-in coherent native queue admission
+    bool secondary_queue_stage; // opt-in early ownership, normal render admission
+    struct secondary_ass_queue_stage secondary_stage_admission; // core, locked
+    struct secondary_ass_queue_stage secondary_stage_pending; // bound, locked
+    struct secondary_ass_stage_prefix secondary_stage_prefix; // VO thread only
     struct secondary_ass_queue_hint secondary_queue_hint; // copied under lock
     struct secondary_ass_queue_token secondary_queue_admission; // core, under lock
     struct secondary_ass_queue_token secondary_queue_pending; // under lock
@@ -380,8 +387,79 @@ struct secondary_ass_grid_task {
