 static inline struct secondary_ass_physical secondary_ass_present_plan_view(
@@ -123,4 +124,91 @@ secondary_ass_present_plan_cache_next(const struct secondary_ass_physical *p,
     return secondary_ass_physical_cache_next(&view, first_slot, divisor, now);
 }
 
+// Forecasting separates the eligibility slot G from the display pose D.
+// The median is captured once for this new task. It does not advance submit
+// time, change the original logical lattice, or reinterpret an existing plan.
+static inline struct secondary_ass_present_plan
+secondary_ass_present_plan_make_forecast(const struct secondary_ass_physical *p,
+    struct secondary_ass_physical_point logical)
+{
+    struct secondary_ass_present_plan none = {.display_forecast = true};
+    if (p->delay < 0 || p->delay > 4 || logical.slot <= 0 ||
+        logical.slot > INT64_MAX - p->delay)
+        return none;
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    int64_t target_slot = logical.slot + p->delay;
+    int64_t lower = secondary_ass_physical_fifo_lower_bound(&view);
+    if (lower > target_slot)
+        target_slot = lower;
