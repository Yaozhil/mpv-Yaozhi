diff --git a/test/secondary_ass_display_forecast.c b/test/secondary_ass_display_forecast.c
new file mode 100644
index 0000000..e8fa207
--- /dev/null
+++ b/test/secondary_ass_display_forecast.c
@@ -0,0 +1,416 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "sub/secondary_ass_clock.h"
+#include "video/out/secondary_ass_present_plan.h"
+
+// These are actual header calls, including the production feedback order.
+// Synthetic display/count inputs exercise logic; they are not GPU evidence.
+// Keep checks active in NDEBUG builds as well as ordinary test builds.
+static unsigned long long checks, chain_frames;
+#define CHECK(x) do { checks++; if (!(x)) { \
+    fprintf(stderr, "forecast check %llu failed at %d: %s\n", \
+            checks, __LINE__, #x); exit(2); } } while (0)
+
+static const int64_t origin = INT64_C(1000000000);
+
+static struct secondary_ass_physical state(int64_t T, int H)
+{
+    return (struct secondary_ass_physical){
+        .phase = origin, .phase_slot = 100, .interval = T, .epoch = 7,
+        .sync_qpc_ns = origin, .sync_count = 100, .sync_slot = 100,
+        .sync_segment_consistent = true,
+        .measure_qpc_ns = origin, .measure_count = 100,
+        .periods = {T, T, T}, .period_count = 3, .period_next = 3,
+        .delay = H, .delay_samples = {H, H, H}, .delay_count = 3,
+        .success_generation = 3,
+    };
+}
+
+static struct secondary_ass_clock clock_state(void)
+{
+    return (struct secondary_ass_clock){
+        .valid = true, .pts = 10, .speed = 1, .wall = origin,
+    };
+}
+
+static bool sample(struct secondary_ass_sampler *s,
+    const struct secondary_ass_clock *c,
+    const struct secondary_ass_physical *p,
+    const struct secondary_ass_present_plan *plan, int64_t divisor)
+{
+    double rate = s->valid && s->display_forecast
+        ? s->rate : 1e9 / (p->interval * divisor);
+    return secondary_ass_sampler_update_physical_forecast(s, c,
+        rate, plan->target.wall, plan->base.slot,
+        plan->target.slot, p->phase, p->phase_slot, p->interval, p->epoch);
+}
+
+static void feedback(struct secondary_ass_physical *p,
+    const struct secondary_ass_present_plan *plan, uint64_t id,
+    struct secondary_ass_physical_point actual)
+{
+    // This is the real secondary_physical_feedback ordering: immutable
+    // registration, observed raw Sync/Present feedback, successful Present.
+    CHECK(secondary_ass_physical_submit_planned_point(p, id, plan->epoch,
+                                                     plan->base, plan->target));
+    secondary_ass_physical_update_observed(p, false, id, plan->target,
+        actual.wall, actual.wall, (uint32_t)actual.slot, (uint32_t)actual.slot,
+        id, p->interval);
+    secondary_ass_physical_record_present(p, true, id, 3, 1);
+    unsigned saved = (p->next + 31) % 32;
+    CHECK(p->submitted[saved].id == id);
+    CHECK(p->submitted[saved].base_slot == plan->base.slot);
+    CHECK(p->submitted[saved].base == plan->base.wall);
+    CHECK(p->submitted[saved].target_slot == plan->target.slot);
+    CHECK(p->last_submit_id == id && p->historical_id == id);
+    CHECK(p->phase_slot == actual.slot && p->phase == actual.wall);
+    chain_frames++;
+}
+
+static void steady_chain(int Hz, int64_t N, int H)
+{
+    int64_t T = INT64_C(1000000000) / Hz;
+    struct secondary_ass_physical p = state(T, H);
+    struct secondary_ass_clock c = clock_state();
+    struct secondary_ass_sampler s = {0};
+    const int64_t first = 110;
+    // Cover three minutes of logical display time per rate/divisor/regime.
+    // This is accelerated CPU time, not three minutes of real scanout.
+    int ticks = Hz * 180 / (int)N;
+    for (int k = 0; k < ticks; k++) {
+        int64_t G = first + k * N;
+        struct secondary_ass_physical_point g = secondary_ass_physical_point_at(&p, G);
+        struct secondary_ass_physical before = p;
+        struct secondary_ass_present_plan plan = k % 3 == 0
+            ? secondary_ass_present_plan_fresh_forecast(&p, g.wall + 2 * T, g)
+            : secondary_ass_present_plan_cache_forecast(&p, g);
+        CHECK(!memcmp(&p, &before, sizeof(p)));
+        CHECK(plan.valid && plan.display_forecast);
+        CHECK(plan.base.slot == G && plan.target.slot == G + H);
+        CHECK(plan.base.wall == g.wall && plan.target.wall == g.wall + H * T);
+        CHECK(plan.historical_delay == H && plan.captured_forecast == H);
+        CHECK(plan.submit == g.wall - T + (T / 4 < 1000000 ? T / 4 : 1000000));
+        CHECK(plan.deadline == plan.target.wall);
+        CHECK(secondary_ass_present_plan_current(&p, &plan));
+        CHECK(sample(&s, &c, &p, &plan, N));
+        CHECK(s.display_forecast && s.origin_slot == first);
+        CHECK(s.origin_wall == origin + (first - 100) * T);
+        CHECK(s.tick == (uint64_t)k && s.display_slot == G + H);
+        CHECK(s.sample_wall == plan.target.wall);
+        CHECK(fabs(s.pts - secondary_ass_clock_sample(&c, plan.target.wall)) < 1e-12);
+        CHECK(secondary_ass_sampler_next_slot(&s) == G + N);
+        CHECK(secondary_ass_sampler_next_wall(&s) == g.wall + N * T);
+        struct secondary_ass_sampler saved = s;
+        CHECK(!sample(&s, &c, &p, &plan, N));
+        CHECK(s.tick == saved.tick && s.display_slot == saved.display_slot &&
+              s.sample_wall == saved.sample_wall && s.pts == saved.pts);
+        feedback(&p, &plan, (uint64_t)k + 1, plan.target);
+        CHECK(p.delay == H && p.epoch == 7 && !p.outlier_pending);
+        CHECK(s.origin_slot == first && s.tick == (uint64_t)k);
+        struct secondary_ass_physical_point next =
+            secondary_ass_present_plan_cache_next_forecast(&p, G + N, N,
+                                                           g.wall + (N - 1) * T);
+        CHECK(next.slot == G + N);
+    }
+}
+
+static void forecasts_and_fifo(int64_t T)
+{
+    struct secondary_ass_physical p = state(T, 2);
+    struct secondary_ass_physical_point g = secondary_ass_physical_point_at(&p, 110);
+    struct secondary_ass_present_plan plan = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(plan.valid && plan.base.slot == 110 && plan.target.slot == 112);
+    CHECK(plan.captured_forecast == 2 && plan.historical_delay == 2);
+    p.delay = 0; // Later feedback cannot reinterpret captured G, D or S.
+    CHECK(plan.base.slot == 110 && plan.target.slot == 112);
+    CHECK(plan.submit == g.wall - T + (T / 4 < 1000000 ? T / 4 : 1000000));
+    feedback(&p, &plan, 1, plan.target);
+    CHECK(p.submitted[0].base_slot == 110 && p.submitted[0].target_slot == 112);
+
+    p = state(T, 1);
+    p.last_base_slot = 99;
+    p.historical_id = 10;
+    p.success_first_id = 11;
+    p.success_last_id = 13;
+    p.success_contiguous = true;
+    g = secondary_ass_physical_point_at(&p, 100);
+    plan = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(plan.valid && plan.fifo_known && plan.fifo_lower == 104);
+    CHECK(plan.base.slot == 100 && plan.target.slot == 104);
+    CHECK(plan.historical_delay == 1 && plan.captured_forecast == 4);
+    CHECK(plan.submit == g.wall - T + (T / 4 < 1000000 ? T / 4 : 1000000));
+    struct secondary_ass_physical_point next =
+        secondary_ass_present_plan_cache_next_forecast(&p, 100, 2, g.wall - T);
+    CHECK(next.slot == 104); // lower-H=103, preserve the original even lattice.
+    plan = secondary_ass_present_plan_cache_forecast(&p, next);
+    CHECK(plan.valid && plan.target.slot == 105 && plan.captured_forecast == 1);
+
+    p = state(T, 2);
+    g = secondary_ass_physical_point_at(&p, 110);
+    next = secondary_ass_present_plan_cache_next_forecast(&p, 110, 2, g.wall + T / 2);
+    CHECK(next.slot == 110); // G has passed, but D112 has not expired.
+    next = secondary_ass_present_plan_cache_next_forecast(&p, 110, 2, g.wall + 2 * T - 1);
+    CHECK(next.slot == 110);
+    next = secondary_ass_present_plan_cache_next_forecast(&p, 110, 2, g.wall + 2 * T);
+    CHECK(next.slot == 112); // Exact D boundary is a real miss, not a relabel.
+    p.last_base_slot = 112;
+    next = secondary_ass_present_plan_cache_next_forecast(&p, 110, 2, g.wall - T);
+    CHECK(next.slot == 114);
+    plan = secondary_ass_present_plan_fresh_forecast(&p, g.wall + 20 * T, g);
+    CHECK(!plan.valid && plan.base.slot == g.slot); // No completion-time rescue.
+    plan = secondary_ass_present_plan_fresh_forecast(&p, g.wall + T, (struct secondary_ass_physical_point){0});
+    CHECK(plan.valid && plan.base.slot > p.last_base_slot);
+    g.wall++;
+    CHECK(!secondary_ass_present_plan_fresh_forecast(&p, g.wall, g).valid);
+}
+
+static void sampler_changes(int64_t T)
+{
+    struct secondary_ass_physical p = state(T, 1);
+    struct secondary_ass_clock c = clock_state();
+    struct secondary_ass_sampler s = {0};
+    struct secondary_ass_physical_point g = secondary_ass_physical_point_at(&p, 110);
+    struct secondary_ass_present_plan a = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(sample(&s, &c, &p, &a, 1));
+    struct secondary_ass_physical reverse = p;
+    reverse.phase -= 3 * T;
+    struct secondary_ass_present_plan backwards = secondary_ass_present_plan_make_forecast(&reverse,
+        secondary_ass_physical_point_at(&reverse, 112));
+    CHECK(backwards.valid && backwards.target.slot > s.display_slot);
+    CHECK(backwards.target.wall < s.sample_wall);
+    CHECK(!sample(&s, &c, &reverse, &backwards, 1));
+    CHECK(s.tick == 0 && s.display_slot == 111 && s.sample_wall == a.target.wall);
+    p.delay = 3;
+    struct secondary_ass_present_plan b = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(!sample(&s, &c, &p, &b, 1));
+    CHECK(s.tick == 0 && s.display_slot == 111 && s.sample_wall == a.target.wall);
+    s.force = true;
+    CHECK(sample(&s, &c, &p, &b, 1));
+    CHECK(s.tick == 0 && s.display_slot == 111 && s.sample_wall == a.target.wall && !s.force);
+    p.delay = 0;
+    g = secondary_ass_physical_point_at(&p, 111);
+    b = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(!sample(&s, &c, &p, &b, 1)); // D111 collides, task remains a MISS.
+    CHECK(s.tick == 0 && s.display_slot == 111 && s.origin_slot == 110);
+    g = secondary_ass_physical_point_at(&p, 112);
+    b = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(sample(&s, &c, &p, &b, 1));
+    CHECK(s.tick == 2 && s.display_slot == 112 && s.origin_slot == 110);
+    p.delay = 2;
+    g = secondary_ass_physical_point_at(&p, 113);
+    b = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(sample(&s, &c, &p, &b, 1));
+    CHECK(s.tick == 3 && s.display_slot == 115 && s.origin_slot == 110);
+    // A normal coordinate reanchor/refinement changes future projections,
+    // not the already sampled task or the continuous logical origin.
+    p.phase += T + 1000;
+    p.phase_slot++;
+    p.interval++;
+    CHECK(!sample(&s, &c, &p, &b, 1)); // Old D wall is not the new projection.
+    b = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(!b.valid); // Stale G wall is not silently repaired either.
+    g = secondary_ass_physical_point_at(&p, 113);
+    b = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(!sample(&s, &c, &p, &b, 1));
+    CHECK(s.origin_slot == 110 && s.tick == 3 && s.display_slot == 115);
+    CHECK(secondary_ass_sampler_next_slot(&s) == 114);
+    CHECK(secondary_ass_sampler_next_wall(&s) == secondary_ass_physical_point_at(&p, 114).wall);
+    p.epoch++;
+    CHECK(sample(&s, &c, &p, &b, 1)); // Explicit epoch lifecycle initializes.
+    CHECK(s.origin_slot == 113 && s.tick == 0 && s.epoch == p.epoch);
+    s.force = true;
+    struct secondary_ass_clock invalid = {0};
+    CHECK(!sample(&s, &invalid, &p, &b, 1) && !s.valid && !s.force);
+}
+
+static void jitter_and_history(int64_t T)
+{
+    struct secondary_ass_physical p = state(T, 1);
+    struct secondary_ass_clock c = clock_state();
+    struct secondary_ass_sampler s = {0};
+    for (int k = 0; k < 256; k++) {
+        int64_t G = 110 + 2 * k;
+        struct secondary_ass_present_plan plan = secondary_ass_present_plan_make_forecast(&p,
+            secondary_ass_physical_point_at(&p, G));
+        CHECK(plan.valid && sample(&s, &c, &p, &plan, 2));
+        struct secondary_ass_physical_point actual = plan.target;
+        if (k == 32)
+            actual.wall += T / 100; // One QPC jitter is not a count jump/reset.
+        feedback(&p, &plan, (uint64_t)k + 1, actual);
+        CHECK(p.epoch == 7 && p.delay == 1 && !p.outlier_pending);
+        CHECK(s.origin_slot == 110 && s.tick == (uint64_t)k);
+        // Duplicate historical ID is not a second delay observation.
+        int count = p.delay_count, cursor = p.delay_next;
+        secondary_ass_physical_update_observed(&p, false, 0,
+            (struct secondary_ass_physical_point){0}, actual.wall, actual.wall,
+            (uint32_t)actual.slot, (uint32_t)actual.slot, (uint64_t)k + 1, T);
+        CHECK(p.delay_count == count && p.delay_next == cursor);
+    }
+    uint64_t epoch = p.epoch;
+    int H = p.delay, count = p.delay_count, cursor = p.delay_next;
+    int64_t phase = p.phase, phase_slot = p.phase_slot;
+    CHECK(secondary_ass_physical_observe(&p, p.sync_qpc_ns + T,
+                                        p.sync_count, T));
+    CHECK(!p.sync_segment_consistent && !p.outlier_pending && p.epoch == epoch);
+    CHECK(p.phase == phase && p.phase_slot == phase_slot);
+    CHECK(p.delay == H && p.delay_count == count && p.delay_next == cursor);
+    CHECK(!secondary_ass_physical_observe(&p, p.sync_qpc_ns + T * 3 / 5,
+                                         p.sync_count, T));
+    CHECK(p.outlier_pending && p.epoch == epoch);
+    CHECK(p.phase == phase && p.phase_slot == phase_slot);
+    CHECK(p.delay == H && p.delay_count == count && p.delay_next == cursor);
+    secondary_ass_physical_reset(&p);
+    CHECK(p.epoch == epoch + 1 && !p.phase && !p.delay_count);
+}
+
+static void lagged_history_and_mode(int64_t T, int64_t N, unsigned lag)
+{
+    struct secondary_ass_physical p = state(T, 0);
+    struct secondary_ass_clock c = clock_state();
+    struct secondary_ass_sampler s = {0};
+    struct secondary_ass_physical_point actual[768] = {0};
+    int64_t last_display = 0;
+    for (unsigned k = 0; k < 768; k++) {
+        int64_t G = 110 + (int64_t)k * N;
+        struct secondary_ass_present_plan plan = secondary_ass_present_plan_make_forecast(&p,
+            secondary_ass_physical_point_at(&p, G));
+        CHECK(plan.valid && plan.historical_delay == p.delay);
+        CHECK(plan.target.slot - plan.base.slot == plan.captured_forecast);
+        CHECK(sample(&s, &c, &p, &plan, N));
+        CHECK(s.tick == k && s.origin_slot == 110);
+        CHECK(plan.submit == plan.base.wall - p.interval +
+              (p.interval / 4 < 1000000 ? p.interval / 4 : 1000000));
+        // Two stable transport regimes with exact count/QPC feedback. These
+        // are model inputs, not an inference about a real composition mode.
+        int offset = k >= 128 && k < 512 ? 1 : 0;
+        int64_t actual_slot = G + offset;
+        CHECK(actual_slot > last_display); // No synthetic same-refresh Sync1.
+        last_display = actual_slot;
+        actual[k] = (struct secondary_ass_physical_point){
+            .slot = actual_slot, .wall = origin + (actual_slot - 100) * T,
+        };
+        uint64_t id = (uint64_t)k + 1;
+        CHECK(secondary_ass_physical_submit_planned_point(&p, id, plan.epoch,
+                                                         plan.base, plan.target));
+        bool known = k >= lag;
+        uint64_t hist_id = known ? (uint64_t)k - lag + 1 : 0;
+        uint32_t hist_count = known ? (uint32_t)actual[k - lag].slot : 0;
+        secondary_ass_physical_update_observed(&p, false, id, plan.target,
+            actual[k].wall, actual[k].wall, (uint32_t)actual[k].slot,
+            hist_count, hist_id, T);
+        secondary_ass_physical_record_present(&p, true, id, 3, 1);
+        chain_frames++;
+        unsigned saved = (p.next + 31) % 32;
+        CHECK(p.submitted[saved].base_slot == G);
+        CHECK(p.submitted[saved].target_slot == plan.target.slot);
+        CHECK(p.epoch == 7 && !p.outlier_pending && p.sync_segment_consistent);
+        CHECK(s.origin_slot == 110 && s.tick == k);
+        if (known) {
+            CHECK(p.historical_id == hist_id);
+            CHECK(p.phase_slot == actual[k - lag].slot);
+            CHECK(p.phase == actual[k - lag].wall);
+        }
+        if (k >= 140 + lag && k < 512)
+            CHECK(p.delay == 1); // Forecasting must not erase learned H.
+        if (k >= 524 + lag)
+            CHECK(p.delay == 0); // Stable recovery must not oscillate H0/H1.
+    }
+}
+
+static void held_pose_committed_G(int64_t T)
+{
+    struct secondary_ass_physical p = state(T, 1);
+    struct secondary_ass_clock c = clock_state();
+    struct secondary_ass_sampler s = {0};
+    struct secondary_ass_present_plan a = secondary_ass_present_plan_make_forecast(&p,
+        secondary_ass_physical_point_at(&p, 110));
+    CHECK(sample(&s, &c, &p, &a, 1));
+    feedback(&p, &a, 1, a.target);
+    // Deliberately probe a decreasing captured forecast at N1. Its rejected
+    // pose is an explicit ASS MISS, even if the primary video Present succeeds.
+    p.delay = 0;
+    struct secondary_ass_present_plan missed = secondary_ass_present_plan_make_forecast(&p,
+        secondary_ass_physical_point_at(&p, 111));
+    CHECK(missed.valid && missed.target.slot == s.display_slot);
+    CHECK(!sample(&s, &c, &p, &missed, 1));
+    CHECK(s.tick == 0 && s.display_slot == 111);
+    struct secondary_ass_physical_point actual = secondary_ass_physical_point_at(&p, 112);
+    feedback(&p, &missed, 2, actual);
+    CHECK(p.last_base_slot == 111);
+    CHECK(missed.target.slot == 111); // Saved MISS is not renamed actual112.
+    CHECK(secondary_ass_sampler_next_slot(&s) == 111); // Pose did not consume G.
+    struct secondary_ass_physical_point next = secondary_ass_present_plan_cache_next_forecast(&p,
+        secondary_ass_sampler_next_slot(&s), 1, actual.wall - T);
+    CHECK(next.slot == 112); // The successful Present ledger skips attempted G.
+    struct secondary_ass_present_plan resumed = secondary_ass_present_plan_cache_forecast(&p, next);
+    CHECK(resumed.valid && sample(&s, &c, &p, &resumed, 1));
+    CHECK(s.origin_slot == 110 && s.tick == 2 && s.display_slot == resumed.target.slot);
+}
+
+static void invalid_and_legacy(int64_t T)
+{
+    struct secondary_ass_physical p = state(T, 1);
+    struct secondary_ass_physical_point g = secondary_ass_physical_point_at(&p, 110);
+    struct secondary_ass_present_plan old = secondary_ass_present_plan_cache(&p, g);
+    CHECK(old.valid && !old.display_forecast && !old.captured_forecast);
+    CHECK(old.base.slot == 110 && old.target.slot == 110 && old.deadline == g.wall);
+    struct secondary_ass_physical_point next = secondary_ass_present_plan_cache_next(&p, 110, 2, g.wall);
+    CHECK(next.slot == 112);
+    struct secondary_ass_clock c = clock_state();
+    struct secondary_ass_sampler s = {0};
+    CHECK(secondary_ass_sampler_update_physical(&s, &c, 1e9 / (2 * T), g.wall,
+        g.slot, p.phase, p.phase_slot, T, p.epoch));
+    CHECK(!s.display_forecast && !s.display_slot && s.origin_slot == 110);
+    CHECK(secondary_ass_sampler_next_slot(&s) == 112);
+    CHECK(!secondary_ass_present_plan_make_forecast(&p,
+        (struct secondary_ass_physical_point){INT64_MAX, INT64_MAX}).valid);
+    CHECK(!secondary_ass_present_plan_cache_next_forecast(&p, INT64_MAX, 2, origin).slot);
+    CHECK(!secondary_ass_present_plan_cache_next_forecast(&p, 110, INT64_MAX, origin).slot);
+    CHECK(!secondary_ass_present_plan_cache_next_forecast(&p, 110, 2, 0).slot);
+    p.delay = -1;
+    CHECK(!secondary_ass_present_plan_make_forecast(&p, g).valid);
+    CHECK(!secondary_ass_present_plan_cache_next_forecast(&p, 110, 2, origin).slot);
+    p.delay = 5;
+    CHECK(!secondary_ass_present_plan_make_forecast(&p, g).valid);
+    p.delay = 1;
+    p.epoch_exhausted = true;
+    CHECK(!secondary_ass_present_plan_make_forecast(&p, g).valid);
+    s = (struct secondary_ass_sampler){0};
+    CHECK(!secondary_ass_sampler_update_physical_forecast(&s, &c, 0,
+        g.wall, 110, 110, p.phase, p.phase_slot, T, 7));
+    CHECK(!s.valid);
+    CHECK(!secondary_ass_sampler_update_physical_forecast(&s, &c, 1e9 / T,
+        g.wall + 1, 110, 110, p.phase, p.phase_slot, T, 7));
+    CHECK(!s.valid);
+    CHECK(!secondary_ass_sampler_update_physical_forecast(&s, &c, 1e9 / (1.3 * T),
+        g.wall, 110, 110, p.phase, p.phase_slot, T, 7));
+    CHECK(!s.valid);
+}
+
+int main(void)
+{
+    const int rates[] = {30, 60, 120, 144, 165, 240, 360};
+    for (unsigned i = 0; i < sizeof(rates) / sizeof(rates[0]); i++) {
+        int64_t T = INT64_C(1000000000) / rates[i];
+        for (int64_t N = 1; N <= 4; N++) {
+            for (int H = 0; H <= 4; H++)
+                steady_chain(rates[i], N, H);
+        }
+        forecasts_and_fifo(T);
+        sampler_changes(T);
+        jitter_and_history(T);
+        held_pose_committed_G(T);
+        for (int64_t N = 2; N <= 4; N++) {
+            lagged_history_and_mode(T, N, 0);
+            lagged_history_and_mode(T, N, 1);
+            lagged_history_and_mode(T, N, 3);
+        }
+        invalid_and_legacy(T);
+    }
+    printf("display-forecast: %llu checks; %llu complete feedback frames; CPU only\n",
+           checks, chain_frames);
+    return 0;
+}
diff --git a/test/secondary_ass_queue_stage.c b/test/secondary_ass_queue_stage.c
