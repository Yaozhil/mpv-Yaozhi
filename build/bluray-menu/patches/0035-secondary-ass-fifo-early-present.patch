--- a/video/out/d3d11/context.h
+++ b/video/out/d3d11/context.h
@@ -9,6 +9,12 @@
 // refcounted and must be released by the caller.
 IDXGISwapChain *ra_d3d11_ctx_get_swapchain(struct ra_ctx *ra);
 
+// Returns true only when the current swapchain generation still permits a
+// fail-closed early Sync1 Present.
+bool ra_d3d11_ctx_can_present_early(struct ra_ctx *ra, uint64_t generation,
+                                    int64_t original_target,
+                                    void (*wait)(struct vo *, int64_t));
+
 // Sets pl_d3d11_swapchain_params according to requested d3d11-output-format for
 // an RA context.
 struct pl_d3d11_swapchain_params;
diff --git a/video/out/secondary_ass_physical.h b/video/out/secondary_ass_physical.h
index 1943e411916f69a707d74965c5773cee6b27b070..f892f9c504ee3979e073cc4c5922a3f6c4a661c6 100644
--- a/video/out/secondary_ass_physical.h
+++ b/video/out/secondary_ass_physical.h
@@ -25,6 +25,8 @@ struct secondary_ass_physical {
     unsigned period_count, period_next;
     uint64_t historical_id;
     uint64_t last_submit_id;
+    uint64_t success_first_id, success_last_id, success_generation;
+    bool success_contiguous;
     int delay, delay_samples[3], delay_count, delay_next;
     struct { uint64_t id; int64_t base, base_slot, target_slot; } submitted[32];
     unsigned next;
@@ -593,6 +595,56 @@ static inline void secondary_ass_physical_update(
     secondary_ass_physical_feedback(p, actual, interval, historical_id);
 }
 
+static inline void secondary_ass_physical_record_present(
+    struct secondary_ass_physical *p, bool valid, uint64_t id,
+    uint64_t generation, int sync_interval)
+{
+    // A wrapped/exhausted physical epoch must never revive from a late
+    // backend callback.  The reset path normally clears this state, but keep
+    // the recorder fail-closed on its own as well.
+    if (p->epoch_exhausted || !valid || !id || !generation ||
+        sync_interval != 1) {
+        p->success_contiguous = false;
+        return;
+    }
+    if (!p->success_contiguous) {
+        p->success_contiguous = true;
+        p->success_first_id = id;
+        p->success_last_id = id;
+        p->success_generation = generation;
+        return;
+    }
+    if (p->success_generation != generation ||
+        p->success_last_id == UINT64_MAX ||
+        id != p->success_last_id + 1) {
+        p->success_contiguous = false;
+        return;
+    }
+    p->success_last_id = id;
+}
+
+// Lower bound for the next FIFO scanout derived only from identified
+// historical refresh counts and a contiguous run of successful Sync1 Presents.
+// This is deliberately a lower bound, not a predicted display timestamp.
+static inline int64_t secondary_ass_physical_fifo_lower_bound(
+    const struct secondary_ass_physical *p)
+{
+    if (p->epoch_exhausted || !p->success_contiguous || p->delay != 0 ||
+        p->outlier_pending ||
+        !p->sync_segment_consistent || !p->success_generation ||
+        !p->success_first_id || p->historical_id == 0 ||
+        p->success_last_id <= p->historical_id ||
+        (p->historical_id != UINT64_MAX &&
+            p->success_first_id > p->historical_id + 1) ||
+        p->phase_slot <= 0)
+        return 0;
+    uint64_t delta = p->success_last_id - p->historical_id;
+    if (delta > 8 || delta > INT64_MAX - 1 ||
+        p->phase_slot > INT64_MAX - (int64_t)delta - 1)
+        return 0;
+    return p->phase_slot + (int64_t)delta + 1;
+}
+
 static inline void secondary_ass_physical_update_observed(
     struct secondary_ass_physical *p, bool invalid, uint64_t submitted_id,
     struct secondary_ass_physical_point intended, int64_t sync_qpc_ns,
