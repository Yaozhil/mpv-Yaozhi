@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_FLIP_BUDGET_H
+#define MP_SECONDARY_ASS_FLIP_BUDGET_H
+
+#include "secondary_ass_budget.h"
+
+// VO-thread-only post-CPU submission/feedback envelope. This is neither GPU work nor
+// scanout latency. Unlike a cached whole-draw sample, fresh frames also renew
+// this queue-blocking forecast when an old cached draw prevents new samples.
+struct secondary_ass_flip_budget {
+    struct secondary_ass_budget samples;
+    int64_t cost;
+    uint64_t epoch, generation, last_id;
+};
+
+static inline void secondary_ass_flip_budget_reset(
+    struct secondary_ass_flip_budget *b)
+{
+    *b = (struct secondary_ass_flip_budget){0};
+}
+
+static inline bool secondary_ass_flip_budget_observe(
+    struct secondary_ass_flip_budget *b, bool valid,
+    uint64_t epoch, uint64_t generation, uint64_t id,
+    int64_t begin, int64_t end, int64_t vo_wait)
+{
+    if (!valid || !epoch || !generation || !id || begin <= 0 || end <= begin ||
+        vo_wait < 0 || vo_wait >= end - begin) {
+        secondary_ass_flip_budget_reset(b);
+        return false;
+    }
+    if (b->epoch != epoch || b->generation != generation) {
+        secondary_ass_flip_budget_reset(b);
+        b->epoch = epoch;
+        b->generation = generation;
+    }
+    if (id <= b->last_id)
+        return false;
+    b->last_id = id;
+    b->cost = secondary_ass_budget_sample(&b->samples, end - begin - vo_wait, 0);
+    return true;
+}
+
+static inline int64_t secondary_ass_flip_budget_cost(
+    const struct secondary_ass_flip_budget *b,
+    uint64_t epoch, uint64_t generation, uint64_t last_id,
+    int64_t redraw_cost, int64_t legacy_block_cost)
+{
+    if (!b->samples.count || b->epoch != epoch ||
+        b->generation != generation || b->last_id != last_id ||
+        !last_id || redraw_cost < 0 || b->cost <= 0 ||
+        redraw_cost > INT64_MAX - b->cost)
+        return legacy_block_cost;
+    // Cache preparation starts at S - redraw_cost. Its forecast already
+    // reserves the compute/OSD portion through S. Charge the measured flip
+    // envelope separately rather than carrying a prior wait-until-S forever.
+    return redraw_cost + b->cost;
+}
+
+#endif
