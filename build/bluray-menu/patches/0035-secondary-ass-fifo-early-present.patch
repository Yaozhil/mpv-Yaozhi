--- a/video/out/vo.h
+++ b/video/out/vo.h
@@ -301,6 +301,9 @@ struct vo_vsync_info {
     uint32_t secondary_sync_refresh_count, secondary_present_refresh_count;
     uint64_t secondary_present_id;
