+static bool secondary_set_presentation(struct vo *vo,
+    struct secondary_ass_physical_point point, int64_t fallback,
+    int64_t interval, int64_t submit, bool quiet_output, bool forecast,
+    const struct secondary_ass_present_plan *plan)
+{
+    struct secondary_ass_physical *p = &vo->in->secondary_physical;
+    if (forecast) {
+        struct secondary_ass_present_plan quiet_plan = {0};
+        if ((!plan || !plan->valid) && quiet_output && p->epoch && !p->outlier_pending) {
+            int64_t divisor = osd_get_secondary_physical_sample_divisor(vo->osd);
+            double rate = osd_get_secondary_clock_rate(vo->osd);
+            struct secondary_ass_physical_point first = secondary_next_sample(vo, divisor);
+            // Quiet draws must also stay on the existing divided G lattice;
+            // a raw prediction could select odd slots forever on an even grid.
+            struct secondary_ass_physical_point logical = divisor > 0
+                ? secondary_forecast_next(vo, first.slot, divisor,
+                    MPMAX(submit, mp_time_ns()), rate)
+                : (struct secondary_ass_physical_point){0};
+            quiet_plan = secondary_forecast_plan(vo, logical, divisor, rate);
+            plan = &quiet_plan;
+        }
+        if (plan && plan->valid && plan->display_forecast)
+            return osd_set_secondary_physical_forecast_time(vo->osd,
+                plan->target.wall, plan->base.slot, plan->target.slot,
+                p->phase, p->phase_slot, p->interval, p->epoch, submit);
