+    int64_t analyze_duration = avfc->max_analyze_duration;
+    int skip_duration = avfc->skip_estimate_duration_from_pts;
+    int flags = avfc->flags;
+    int io_error = priv->pb ? priv->pb->error : 0;
+    int io_eof = priv->pb ? priv->pb->eof_reached : 0;
+    avfc->probesize = MPMIN(avfc->probesize, DISC_VC1_PROBE_BYTES);
+    avfc->max_analyze_duration = analyze_duration > 0
+        ? MPMIN(analyze_duration, DISC_VC1_PROBE_SECONDS * AV_TIME_BASE)
+        : DISC_VC1_PROBE_SECONDS * AV_TIME_BASE;
+    avfc->skip_estimate_duration_from_pts = 1;
+    avfc->flags &= ~AVFMT_FLAG_NOBUFFER;
+    priv->disc_vc1_probe_limited = false;
+    priv->disc_vc1_probe_read_eof = false;
+    priv->disc_vc1_probe_bytes_left = DISC_VC1_PROBE_BYTES;
+    priv->disc_vc1_probe_deadline = mp_time_ns_add(mp_time_ns(), DISC_VC1_PROBE_SECONDS);
+    priv->disc_vc1_probing = true;
+    int ret = avformat_find_stream_info(avfc, NULL);
+    priv->disc_vc1_probing = false;
+    avfc->probesize = probesize;
+    avfc->max_analyze_duration = analyze_duration;
+    avfc->skip_estimate_duration_from_pts = skip_duration;
+    avfc->flags = flags;
+
+    log_disc_vc1_params(demuxer, "after");
+    MP_VERBOSE(demuxer, "Blu-ray VC-1 bounded probe read %"PRId64
+               " bytes (limited=%d, result=%d).\n",
+               DISC_VC1_PROBE_BYTES - priv->disc_vc1_probe_bytes_left,
+               priv->disc_vc1_probe_limited, ret);
+    if (demux_read_interrupted(demuxer))
+        goto done;
+    if (priv->disc_vc1_probe_limited && !priv->disc_vc1_probe_read_eof &&
+        !io_error && !io_eof && priv->pb)
+    {
+        // A budget boundary is temporary, unlike a real media EOF/error.
+        priv->pb->eof_reached = 0;
+        priv->pb->error = 0;
+    }
+    if (num_streams != avfc->nb_streams) {
+        MP_ERR(demuxer, "Blu-ray stream layout changed during VC-1 probing.\n");
+        goto done;
+    }
+    ok = (ret >= 0 || (priv->disc_vc1_probe_limited &&
+                      (ret == AVERROR_EXIT || ret == AVERROR_EOF))) &&
+         !disc_vc1_needs_probe(demuxer);
