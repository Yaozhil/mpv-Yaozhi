+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_BUDGET_H
+#define MP_SECONDARY_ASS_BUDGET_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+// VO-thread-only history of video submission time. One late CPU wakeup or
+// first-use glyph upload must not disable otherwise affordable OSD redraws
+// until the next GPU sample. Two expensive video draws still engage protection.
+struct secondary_ass_budget {
+    int64_t cpu[3];
+    unsigned count, next;
+};
+
+static inline int64_t secondary_ass_budget_sample(struct secondary_ass_budget *b,
+                                                   int64_t cpu, int64_t gpu)
+{
+    b->cpu[b->next] = cpu;
+    b->next = (b->next + 1) % 3;
+    if (b->count < 3)
+        b->count++;
+    int64_t values[3];
+    for (unsigned i = 0; i < b->count; i++)
+        values[i] = b->cpu[i];
+    for (unsigned i = 1; i < b->count; i++) {
+        int64_t value = values[i];
+        unsigned j = i;
+        while (j && values[j - 1] > value) {
+            values[j] = values[j - 1];
+            j--;
+        }
+        values[j] = value;
+    }
+    // Use the upper median during startup rather than assuming unused zeros.
+    int64_t sustained = values[b->count / 2];
+    return sustained > gpu ? sustained : gpu;
+}
+
+// Low-fps video has time between fresh frames for cheap cached redraws. A fresh
+// frame need not fit inside every subtitle tick; reserve its share of the whole
+// video period and charge only the remaining ticks for cached redraws.
+static inline bool secondary_ass_budget_low_fps(int64_t duration, int64_t interval)
+{
+    return interval > 0 && duration > 2 * interval;
+}
+
+static inline bool secondary_ass_budget_probe_due(int64_t fresh, int64_t duration,
+                                                   int64_t interval, int64_t now,
+                                                   int64_t next_probe)
+{
+    return fresh >= 0 && secondary_ass_budget_low_fps(duration, interval) &&
+           fresh < duration * 0.75 && now >= next_probe;
+}
+
+// A fixed physical sampler can retain an expensive cached-draw estimate after
+// a resize even when fresh video frames still have headroom. Qualification is
+// not admission: callers retain the real video and submission deadline checks.
+// Keep the legacy low-fps policy unchanged for the other scheduling paths.
+static inline bool secondary_ass_budget_fixed_probe_due(int64_t fresh,
+                                                         int64_t duration,
+                                                         int64_t interval,
+                                                         int64_t now,
+                                                         int64_t next_probe)
+{
+    return interval > 0 && duration > 0 && fresh >= 0 &&
+           fresh < duration * 0.75 && now >= next_probe;
+}
+
+static inline bool secondary_ass_budget_affordable(int64_t fresh, int64_t redraw,
+                                                    int64_t duration,
+                                                    int64_t interval)
+{
+    if (interval <= 0 || fresh < 0 || redraw < 0)
+        return false;
+    if (!secondary_ass_budget_low_fps(duration, interval))
+        return fresh < interval * 0.75 && redraw < interval * 0.75;
+    if (fresh >= duration * 0.75)
+        return false;
+    // Permit an initial deadline-limited sample instead of waiting forever for
+    // a redraw cost which cannot exist until the first redraw has happened.
+    if (redraw <= 0)
+        return true;
+    double extra = (double)duration / interval - 1;
+    return redraw < interval * 0.75 &&
+           fresh + redraw * extra < duration * 0.75;
+}
+
+static inline bool secondary_ass_budget_before_deadline(int64_t now,
+                                                         int64_t deadline,
+                                                         int64_t fresh,
+                                                         int64_t redraw,
+                                                         int64_t margin)
+{
+    // Compare differences so absolute monotonic timestamps cannot overflow.
+    return fresh >= 0 && redraw >= 0 && margin >= 0 &&
+           deadline > now && deadline - now > fresh &&
+           deadline - now - fresh > redraw &&
+           deadline - now - fresh - redraw > margin;
+}
+
+// A non-display-synced frame has a real wall-clock deadline at every source
+// rate. A cheap GPU redraw can still block in presentation until the next
+// vsync, so high-fps video needs the same fresh+blocking-time reservation.
+// A zero/unknown duration also represents display-synced frames at callers;
+// retain their existing per-tick policy without inventing a source deadline.
