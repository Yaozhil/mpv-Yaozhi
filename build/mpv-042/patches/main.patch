new file mode 100644
index 0000000000000000000000000000000000000000..9dd18b0c9c321c2124a2c950c9484be121fb84c3
--- /dev/null
+++ b/video/dovi_metadata.h
@@ -0,0 +1,72 @@
+/* Read-only identification of decoded Dolby Vision RPU metadata. */
+#ifndef MP_DOVI_METADATA_H
+#define MP_DOVI_METADATA_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <libavutil/dovi_meta.h>
+
+struct mp_dovi_metadata_info {
+    bool rpu_present;
+    const char *el_type;
+};
+
+static inline bool mp_dovi_metadata_range(size_t offset, size_t length,
+                                          size_t size, size_t alignment)
+{
+    return offset >= sizeof(AVDOVIMetadata) && offset <= size &&
+           length <= size - offset && offset % alignment == 0;
+}
+
+// Side data describes the source RPU, not whether the renderer applies it.
+// Use the same Profile 7 header constraints as FFmpeg's profile inference.
+// MEL has neutral NLQ parameters in all three components (dovi_tool's
+// RpuDataNlq::is_mel); disable_residual_flag alone does not distinguish it.
+static inline struct mp_dovi_metadata_info
+mp_dovi_metadata_read(const void *data, size_t size)
+{
+    struct mp_dovi_metadata_info info = {0};
+    if (!data || size < sizeof(AVDOVIMetadata))
+        return info;
+
+    const AVDOVIMetadata *metadata = data;
+    if (!mp_dovi_metadata_range(metadata->header_offset,
+                               sizeof(AVDOVIRpuDataHeader), size,
+                               offsetof(struct { char c; AVDOVIRpuDataHeader v; }, v)))
+        return info;
+
+    const AVDOVIRpuDataHeader *header = av_dovi_get_header(metadata);
+    if (header->rpu_type != 2)
+        return info;
+    info.rpu_present = true;
+
+    if (header->vdr_rpu_profile != 1 || header->vdr_bit_depth != 12 ||
+        !header->el_spatial_resampling_filter_flag ||
+        header->disable_residual_flag || (header->rpu_format & 0x700) ||
+        header->coef_log2_denom < 13 || header->coef_log2_denom > 32 ||
+        !mp_dovi_metadata_range(metadata->mapping_offset,
+                                sizeof(AVDOVIDataMapping), size,
+                                offsetof(struct { char c; AVDOVIDataMapping v; }, v)))
+        return info;
+
+    const AVDOVIDataMapping *mapping = av_dovi_get_mapping(metadata);
+    if (mapping->nlq_method_idc != AV_DOVI_NLQ_LINEAR_DZ)
+        return info;
+
+    bool mel = true;
+    // FFmpeg combines each coefficient's integer/fractional parts into a
+    // fixed-point value, including originally floating-point coefficients.
+    uint64_t one = UINT64_C(1) << header->coef_log2_denom;
+    for (int c = 0; c < 3; c++) {
+        const AVDOVINLQParams *nlq = &mapping->nlq[c];
+        mel &= nlq->nlq_offset == 0 && nlq->vdr_in_max == one &&
+               nlq->linear_deadzone_slope == 0 &&
+               nlq->linear_deadzone_threshold == 0;
+    }
+    info.el_type = mel ? "MEL" : "FEL";
+    return info;
+}
+
+#endif
