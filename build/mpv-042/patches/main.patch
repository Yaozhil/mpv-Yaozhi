+static void d3d11_gpu_marker_bind_present(struct ra_swapchain *sw)
+{
+    struct ra_ctx *ctx = sw->ctx;
+    struct priv *p = ctx->priv;
+    if (!p->gpu_marker_active)
+        return;
+
+    d3d11_gpu_marker_poll(ctx, "present_before");
+    if (!p->gpu_marker_active)
+        return;
+    UINT before = 0;
+    HRESULT hr = IDXGISwapChain_GetLastPresentCount(p->swapchain, &before);
+    int n = p->gpu_marker_last;
+    // A Present may be called without a new draw. Consume this marker slot
+    // exactly once so that a later present cannot be rebound to the same End.
+    p->gpu_marker_last = -1;
+    p->gpu_marker_bound = -1;
+    if (FAILED(hr) || n < 0 || n >= MP_D3D11_GPU_MARKER_RING ||
+        !p->gpu_markers[n].in_use)
+    {
+        if (n >= 0 && n < MP_D3D11_GPU_MARKER_RING &&
+            p->gpu_markers[n].in_use)
+        {
+            p->gpu_markers[n].present_verified = true;
+            d3d11_gpu_marker_maybe_release(p, n);
+        }
+        if (p->secondary_trace)
+            MP_INFO(ctx, "native-ass-gpu-marker: status=present_unbound"
+                " generation=%"PRIu64" hr=0x%08"PRIx32"\n",
+                p->gpu_marker_generation, (uint32_t)hr);
+        return;
+    }
+
+    struct d3d11_gpu_marker *m = &p->gpu_markers[n];
+    m->expected_present = before + 1;
+    m->present_count_valid = SUCCEEDED(hr);
+    m->present_bound = SUCCEEDED(hr);
+    if (m->present_bound)
+        p->gpu_marker_bound = n;
+    if (p->secondary_trace)
+        MP_INFO(ctx, "native-ass-gpu-marker: status=present_bind"
+            " seq=%"PRIu64" generation=%"PRIu64
+            " expected_present=%u count_before=%u\n", m->seq,
+            m->generation, m->expected_present, before);
+}
+
+static void d3d11_gpu_marker_after_present(struct ra_swapchain *sw,
+                                           HRESULT present_hr)
+{
+    struct ra_ctx *ctx = sw->ctx;
+    struct priv *p = ctx->priv;
+    if (!p->gpu_marker_active)
+        return;
+
+    d3d11_gpu_marker_poll(ctx, "present_after");
+    if (!p->gpu_marker_active)
+        return;
+    UINT after = 0;
+    HRESULT count_hr = IDXGISwapChain_GetLastPresentCount(p->swapchain, &after);
+    int n = p->gpu_marker_bound;
+    p->gpu_marker_bound = -1;
+    if (n >= 0 && n < MP_D3D11_GPU_MARKER_RING &&
+        p->gpu_markers[n].in_use && p->gpu_markers[n].present_bound)
+    {
+        struct d3d11_gpu_marker *m = &p->gpu_markers[n];
+        m->actual_present_hr = count_hr;
+        m->actual_present_count_valid = SUCCEEDED(count_hr);
+        if (SUCCEEDED(count_hr))
+            m->actual_present = after;
+        m->present_verified = true;
+        d3d11_gpu_marker_record(ctx, m, 6, present_hr);
+        if (p->secondary_trace)
+            MP_INFO(ctx, "native-ass-gpu-marker: status=present_result"
+                " seq=%"PRIu64" generation=%"PRIu64
+                " expected_present=%u actual_present=%u match=%d"
+                " present_hr=0x%08"PRIx32" count_hr=0x%08"PRIx32"\n",
+                m->seq, m->generation, m->expected_present, after,
+                m->expected_present == after && SUCCEEDED(present_hr) &&
+                    SUCCEEDED(count_hr),
+                (uint32_t)present_hr, (uint32_t)count_hr);
+        d3d11_gpu_marker_maybe_release(p, n);
+    } else {
+        if (p->secondary_trace)
+            MP_INFO(ctx, "native-ass-gpu-marker: status=present_result_unbound"
+                " generation=%"PRIu64" present_hr=0x%08"PRIx32
+                " count_hr=0x%08"PRIx32" actual_present=%u\n",
+                p->gpu_marker_generation, (uint32_t)present_hr,
+                (uint32_t)count_hr, after);
+        if (n >= 0 && n < MP_D3D11_GPU_MARKER_RING &&
+            p->gpu_markers[n].in_use)
+        {
+            p->gpu_markers[n].present_verified = true;
+            d3d11_gpu_marker_maybe_release(p, n);
+        }
+    }
+}
