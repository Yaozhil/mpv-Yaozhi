+// Read only the displayed frame's already decoded side data, including its
+// PTS-matched EL. This reports source metadata, not successful composition.
+static struct mp_dovi_metadata_info read_dovi_frame_info(struct mp_image *frame)
+{
+    struct mp_dovi_metadata_info info = {0};
+    struct mp_image *layers[] = {frame, frame->enhancement_layer};
+    for (size_t i = 0; i < MP_ARRAY_SIZE(layers); i++) {
+        struct mp_image *layer = layers[i];
+        if (!layer)
+            continue;
+        for (int n = 0; n < layer->num_ff_side_data; n++) {
+            struct mp_ff_side_data *sd = &layer->ff_side_data[n];
+            if (!sd->buf)
+                continue;
+            if (sd->type == AV_FRAME_DATA_DOVI_RPU_BUFFER)
+                info.rpu_present |= sd->buf->size > 0;
+            if (sd->type == AV_FRAME_DATA_DOVI_METADATA) {
+                struct mp_dovi_metadata_info parsed =
+                    mp_dovi_metadata_read(sd->buf->data, sd->buf->size);
+                info.rpu_present |= parsed.rpu_present;
+                if (!info.el_type)
+                    info.el_type = parsed.el_type;
+            }
+        }
+    }
+    return info;
+}
