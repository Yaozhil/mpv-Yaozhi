+// dvdnav_button_activate() rejects a NAV packet after libdvdnav's read head
+// has already left it. That is normally correct, but a player with demuxer
+// queues can still be displaying and interacting with that menu packet. Keep
+// the guarded API as the primary path, then replay the cached button command
+// through libdvdnav's FIFO-safe API when the packet was rejected.
+static bool is_link_rsm_command(const vm_cmd_t *cmd)
+{
+    static const uint8_t link_rsm[8] = {
+        0x20, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x0d,
+    };
+    return memcmp(cmd->bytes, link_rsm, sizeof(link_rsm)) == 0;
+}
+
+static bool activate_current_button(struct priv *priv, pci_t *pci)
+{
+    int32_t btn = 0;
+    dvdnav_get_current_highlight(priv->dvdnav, &btn);
+    int num_buttons = MPMIN(pci->hli.hl_gi.btn_ns, MP_ARRAY_SIZE(pci->hli.btnit));
+    MP_VERBOSE(priv,
+               "select button: vm=%d cached=%d buttons=%d hli=%d "
+               "default=%d force-select=%d force-activate=%d "
+               "nav-lbn=%u vobu-pts=%u highlight=%u..%u\n",
+               btn, priv->current_button, num_buttons,
+               pci->hli.hl_gi.hli_ss, pci->hli.hl_gi.btn_ofn,
+               pci->hli.hl_gi.fosl_btnn, pci->hli.hl_gi.foac_btnn,
+               pci->pci_gi.nv_pck_lbn, pci->pci_gi.vobu_s_ptm,
+               pci->hli.hl_gi.hli_s_ptm, pci->hli.hl_gi.hli_e_ptm);
+    if (btn <= 0 || btn > num_buttons) {
+        MP_VERBOSE(priv, "select ignored: current DVD button is invalid\n");
+        return false;
+    }
+
+    btni_t b;
+    memcpy(&b, &pci->hli.btnit[btn - 1], sizeof(b));
+    MP_VERBOSE(priv,
+               "button %d command: %02x %02x %02x %02x %02x %02x %02x %02x\n",
+               btn, b.cmd.bytes[0], b.cmd.bytes[1], b.cmd.bytes[2],
+               b.cmd.bytes[3], b.cmd.bytes[4], b.cmd.bytes[5],
+               b.cmd.bytes[6], b.cmd.bytes[7]);
+
+    bool link_rsm = is_link_rsm_command(&b.cmd);
+    if (dvdnav_button_activate(priv->dvdnav, pci) == DVDNAV_STATUS_OK) {
+        MP_VERBOSE(priv, "button %d activation accepted by current NAV\n", btn);
+        if (!link_rsm || !in_menu_domain(priv->dvdnav))
+            return true;
+        // Some authored menus carry an unconditional LinkRSM button command
+        // which libdvdnav accepts but leaves in VTSM. Its dedicated Escape
+        // path performs the same resume without going through that decoder.
+        MP_VERBOSE(priv, "button %d LinkRSM stayed in the menu; "
+                   "using the dedicated resume path\n", btn);
+        if (dvdnav_menu_call(priv->dvdnav, DVD_MENU_Escape) == DVDNAV_STATUS_ERR) {
+            MP_WARN(priv, "button %d LinkRSM resume failed: %s\n", btn,
+                    dvdnav_err_to_string(priv->dvdnav));
+            return false;
+        }
+        return true;
+    }
+
+    if (link_rsm) {
+        MP_VERBOSE(priv, "button %d LinkRSM used the dedicated resume path: %s\n",
+                   btn, dvdnav_err_to_string(priv->dvdnav));
+        if (dvdnav_menu_call(priv->dvdnav, DVD_MENU_Escape) == DVDNAV_STATUS_ERR) {
+            MP_WARN(priv, "button %d LinkRSM resume failed: %s\n", btn,
+                    dvdnav_err_to_string(priv->dvdnav));
+            return false;
+        }
+        return true;
+    }
+
+    MP_VERBOSE(priv, "button %d activation used cached NAV command: %s\n",
+               btn, dvdnav_err_to_string(priv->dvdnav));
+    return dvdnav_button_activate_cmd(priv->dvdnav, btn, &b.cmd) == DVDNAV_STATUS_OK;
+}
