         mp_chmap_from_lavc(dst, src->u.mask);
         return dst->num == src->nb_channels;
+    case AV_CHANNEL_ORDER_CUSTOM:
+        if (src->nb_channels <= 0 || src->nb_channels > MP_NUM_CHANNELS)
+            return false;
+
+        dst->num = src->nb_channels;
+        for (int n = 0; n < src->nb_channels; n++) {
+            enum AVChannel channel = src->u.map[n].id;
