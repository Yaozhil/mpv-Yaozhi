+                                                  int64_t deadline, int64_t fresh,
+                                                  int64_t redraw, int64_t margin)
+{
+    return duration <= 0 || secondary_ass_budget_before_deadline(
+        now, deadline, fresh, redraw, margin);
+}
+
+#endif
diff --git a/video/out/secondary_ass_flip_budget.h b/video/out/secondary_ass_flip_budget.h
new file mode 100644
index 0000000000000000000000000000000000000000..9e1618231b82004ea30b68b82ee91f058887a3b2
--- /dev/null
+++ b/video/out/secondary_ass_flip_budget.h
@@ -0,0 +1,148 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_FLIP_BUDGET_H
+#define MP_SECONDARY_ASS_FLIP_BUDGET_H
+
+#include "secondary_ass_budget.h"
+
+// VO-thread-only post-CPU submission/feedback envelope. This is neither GPU work nor
+// scanout latency. Unlike a cached whole-draw sample, fresh frames also renew
+// this queue-blocking forecast when an old cached draw prevents new samples.
+struct secondary_ass_flip_budget {
+    struct secondary_ass_budget samples;
+    int64_t cost;
+    uint64_t epoch, generation, last_id;
+};
+
+static inline void secondary_ass_flip_budget_reset(
+    struct secondary_ass_flip_budget *b)
+{
+    *b = (struct secondary_ass_flip_budget){0};
+}
+
+static inline bool secondary_ass_flip_budget_observe(
+    struct secondary_ass_flip_budget *b, bool valid,
+    uint64_t epoch, uint64_t generation, uint64_t id,
+    int64_t begin, int64_t end, int64_t vo_wait)
+{
+    if (!valid || !epoch || !generation || !id || begin <= 0 || end <= begin ||
+        vo_wait < 0 || vo_wait >= end - begin) {
+        secondary_ass_flip_budget_reset(b);
+        return false;
+    }
+    if (b->epoch != epoch || b->generation != generation) {
+        secondary_ass_flip_budget_reset(b);
+        b->epoch = epoch;
+        b->generation = generation;
+    }
+    if (id <= b->last_id)
+        return false;
+    b->last_id = id;
+    b->cost = secondary_ass_budget_sample(&b->samples, end - begin - vo_wait, 0);
+    return true;
+}
+
+static inline int64_t secondary_ass_flip_budget_cost(
+    const struct secondary_ass_flip_budget *b,
+    uint64_t epoch, uint64_t generation, uint64_t last_id,
+    int64_t redraw_cost, int64_t legacy_block_cost)
+{
+    if (!b->samples.count || b->epoch != epoch ||
+        b->generation != generation || b->last_id != last_id ||
+        !last_id || redraw_cost < 0 || b->cost <= 0 ||
+        redraw_cost > INT64_MAX - b->cost)
+        return legacy_block_cost;
+    // Cache preparation starts at S - redraw_cost. Its forecast already
+    // reserves the compute/OSD portion through S. Charge the measured flip
+    // envelope separately rather than carrying a prior wait-until-S forever.
+    return redraw_cost + b->cost;
+}
+
+// Q is only the observed post-CPU envelope for this exact successful prefix.
+// Zero is unknown: callers must retain their original conservative guard,
+// not subtract redraw work from an unrelated legacy whole-draw estimate.
+static inline int64_t secondary_ass_flip_budget_post_cpu_cost(
+    const struct secondary_ass_flip_budget *b,
+    uint64_t epoch, uint64_t generation, uint64_t last_id)
+{
+    if (!b || !epoch || !generation || !last_id || !b->samples.count ||
+        b->epoch != epoch || b->generation != generation ||
+        b->last_id != last_id || b->cost <= 0)
+        return 0;
+    return b->cost;
+}
+
+enum secondary_ass_flip_window_outcome {
+    SECONDARY_ASS_FLIP_WINDOW_INVALID_INPUT,
+    SECONDARY_ASS_FLIP_WINDOW_BASELINE_REJECTED,
+    SECONDARY_ASS_FLIP_WINDOW_OVERFLOW,
+    SECONDARY_ASS_FLIP_WINDOW_TARGET_MISSED,
+    SECONDARY_ASS_FLIP_WINDOW_VIDEO_RESERVED,
+    SECONDARY_ASS_FLIP_WINDOW_ACCEPTED,
+};
+
+struct secondary_ass_flip_window {
+    bool valid;
+    enum secondary_ass_flip_window_outcome outcome;
+    int64_t prepare, cpu_done, submit, post_cpu_done, reserved_end;
+};
+
+// Preserve the caller's baseline policy and immutable S/D/F. S is the preferred
+// submission window, while D is this captured task's original target boundary.
+// Charge R once from actual preparation and Q after CPU submission. A late wake
+// must still fit before D and reserve the unchanged video F, without selecting a
+// future target or starting its accounting at an elapsed S.
+// This predicts a CPU/VO envelope, never GPU Ready or actual Display.
+static inline struct secondary_ass_flip_window secondary_ass_flip_budget_window(
+    bool baseline_guard, int64_t now, int64_t original_prepare,
+    int64_t earliest_redraw, int64_t captured_submit, int64_t captured_deadline,
+    int64_t video_deadline,
+    int64_t redraw_cost, int64_t post_cpu_cost, int64_t fresh_cost,
+    int64_t margin)
+{
+    struct secondary_ass_flip_window window = {0};
+    if (now <= 0 || original_prepare <= 0 ||
+        earliest_redraw < 0 || captured_submit <= 0 ||
+        captured_deadline <= captured_submit ||
+        video_deadline <= captured_submit || redraw_cost < 0 ||
+        post_cpu_cost <= 0 || fresh_cost < 0 || margin < 0)
+        return window;
+    if (!baseline_guard) {
+        window.outcome = SECONDARY_ASS_FLIP_WINDOW_BASELINE_REJECTED;
+        return window;
+    }
+    int64_t prepare = now > original_prepare ? now : original_prepare;
+    if (earliest_redraw > prepare)
+        prepare = earliest_redraw;
+    window.prepare = prepare;
+    window.outcome = SECONDARY_ASS_FLIP_WINDOW_OVERFLOW;
+    if (redraw_cost > INT64_MAX - prepare)
+        return window;
+    int64_t cpu_done = prepare + redraw_cost;
+    window.cpu_done = cpu_done;
+    int64_t submit = cpu_done > captured_submit ? cpu_done : captured_submit;
+    window.submit = submit;
+    if (post_cpu_cost > INT64_MAX - submit)
+        return window;
+    int64_t post_cpu_done = submit + post_cpu_cost;
+    window.post_cpu_done = post_cpu_done;
+    if (post_cpu_done >= captured_deadline) {
+        window.outcome = SECONDARY_ASS_FLIP_WINDOW_TARGET_MISSED;
+        return window;
+    }
+    if (fresh_cost > INT64_MAX - post_cpu_done)
+        return window;
+    int64_t reserved_end = post_cpu_done + fresh_cost;
+    if (margin > INT64_MAX - reserved_end)
+        return window;
+    reserved_end += margin;
+    window.reserved_end = reserved_end;
+    if (reserved_end >= video_deadline) {
+        window.outcome = SECONDARY_ASS_FLIP_WINDOW_VIDEO_RESERVED;
+        return window;
+    }
+    window.valid = true;
+    window.outcome = SECONDARY_ASS_FLIP_WINDOW_ACCEPTED;
+    return window;
+}
+
+#endif
diff --git a/video/out/secondary_ass_fresh_video.h b/video/out/secondary_ass_fresh_video.h
new file mode 100644
index 0000000000000000000000000000000000000000..29a6d239d6b4ca3ae31fea006df7f48b6be95dd4
--- /dev/null
+++ b/video/out/secondary_ass_fresh_video.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_FRESH_VIDEO_H
+#define MP_SECONDARY_ASS_FRESH_VIDEO_H
+
+#include "secondary_ass_present_plan.h"
+
+// Mandatory video owns F. Its predicted display D may advance the ASS clock
+// only to an already due G on the retained sampler lattice, never next-G just
+// because another video frame arrived. Cached ASS keeps its existing policy.
+static inline struct secondary_ass_present_plan
+secondary_ass_fresh_video_plan(const struct secondary_ass_physical *p,
+    int64_t origin_slot, int64_t next_slot, int64_t divisor, int offset,
+    int64_t ready, int64_t video_submit)
+{
+    struct secondary_ass_present_plan none = {
+        .display_forecast = true, .fresh_clock_only = true,
+        .submit = video_submit, .fallback_submit = video_submit,
+        .lifecycle_safe_wait = video_submit,
+    };
+    if (origin_slot <= 0 || next_slot < origin_slot || divisor <= 0 ||
+        (next_slot - origin_slot) % divisor || offset < 0 || offset > 4 ||
+        ready <= 0 || video_submit <= 0 || !p->epoch || p->epoch_exhausted ||
+        !p->success_generation || !p->success_contiguous ||
+        p->outlier_pending || !p->sync_segment_consistent)
+        return none;
+
+    // Do not feed retrospective G-to-D quantization into this prediction.
+    // The accepted fixed offset is independent of the changing delay learner.
+    struct secondary_ass_physical display = *p;
+    display.delay = offset;
+    // An already registered pose cannot make wall time advance. When source
+    // video is faster than scanout, repeated fresh draws must hold the tick.
+    display.last_base_slot = 0;
+    int64_t after = ready > video_submit ? ready : video_submit;
+    struct secondary_ass_physical_point actual =
+        secondary_ass_physical_predict_point(&display, after);
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    int64_t lower = secondary_ass_physical_fifo_lower_bound(&view);
+    if (lower > actual.slot)
+        actual = secondary_ass_physical_point_at(&view, lower);
+    if (actual.slot <= offset || actual.wall <= after)
+        return none;
+    int64_t base = actual.slot - offset;
+    if (base < origin_slot)
+        return none;
+    int64_t logical_slot = base - (base - origin_slot) % divisor;
+    if (logical_slot < next_slot || logical_slot <= p->last_base_slot)
+        return none;
+    struct secondary_ass_physical_point logical =
+        secondary_ass_physical_point_at(&view, logical_slot);
+    struct secondary_ass_present_plan plan =
+        secondary_ass_present_plan_make(p, logical, actual);
+    if (!plan.valid || actual.slot - logical.slot > INT32_MAX)
+        return none;
+    plan.display_forecast = true;
+    plan.fresh_clock_only = true;
+    plan.captured_forecast = (int)(actual.slot - logical.slot);
+    plan.submit = video_submit;
+    plan.fallback_submit = video_submit;
+    plan.lifecycle_safe_wait = video_submit;
+    return plan;
+}
+
+#endif
diff --git a/video/out/secondary_ass_neutral_pose.h b/video/out/secondary_ass_neutral_pose.h
new file mode 100644
index 0000000000000000000000000000000000000000..739ac9e3102caf6ebffa3398b74bb5a786a808ec
--- /dev/null
+++ b/video/out/secondary_ass_neutral_pose.h
@@ -0,0 +1,151 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_NEUTRAL_POSE_H
+#define MP_SECONDARY_ASS_NEUTRAL_POSE_H
+
+#include "sub/secondary_ass_clock.h"
+#include "secondary_ass_present_plan.h"
+
+// A one-use VO-thread lease for an ASS pose actually submitted by a grid-cache
+// draw. This does not certify its Display time or authorize another G/D task.
+struct secondary_ass_neutral_pose {
+    bool valid;
+    uint64_t submit_id;
+    struct secondary_ass_present_plan plan;
+    struct secondary_ass_sample_snapshot sample;
+};
+
+static inline void secondary_ass_neutral_pose_clear(
+    struct secondary_ass_neutral_pose *pose)
+{
+    *pose = (struct secondary_ass_neutral_pose){0};
+}
+
+static inline bool secondary_ass_neutral_pose_tuple_equal(
+    const struct secondary_ass_sample_snapshot *a,
+    const struct secondary_ass_sample_snapshot *b)
+{
+    return a->valid && b->valid && !a->held && !b->held &&
+        !a->force && !b->force && !a->sample_forced && !b->sample_forced &&
+        a->display_forecast && b->display_forecast &&
+        a->epoch == b->epoch && a->rate == b->rate &&
+        a->speed == b->speed && a->requested_speed == b->requested_speed &&
+        a->divisor == b->divisor && a->origin_slot == b->origin_slot &&
+        a->sample_slot == b->sample_slot && a->next_slot == b->next_slot &&
+        a->next_wall == b->next_wall && a->phase_wall == b->phase_wall &&
+        a->phase_slot == b->phase_slot && a->interval == b->interval;
+}
+
+static inline bool secondary_ass_neutral_pose_prefix_current(
+    const struct secondary_ass_neutral_pose *pose,
+    const struct secondary_ass_physical *p)
+{
+    if (!pose->valid || p->epoch_exhausted || p->outlier_pending ||
+        p->history_floor_slot || !p->sync_segment_consistent ||
+        !p->success_contiguous || p->epoch != pose->plan.epoch ||
+        p->success_generation != pose->plan.generation ||
+        p->success_last_id != pose->submit_id ||
+        p->last_submit_id != pose->submit_id ||
+        p->last_base_slot != pose->plan.base.slot ||
+        p->interval != pose->plan.interval)
+        return false;
+    unsigned n = (p->next + 31) % 32;
+    return p->submitted[n].id == pose->submit_id &&
+        !p->submitted[n].gap_excluded &&
+        p->submitted[n].base == pose->plan.base.wall &&
+        p->submitted[n].base_slot == pose->plan.base.slot &&
+        p->submitted[n].target_slot == pose->plan.target.slot;
+}
+
+// Call after physical feedback has registered this exact successful Sync1 ID.
+// A failed capture clears an old lease; no earlier successful pose can conceal
+// a sampler advanced by an unsuccessful/unknown intervening Present.
+static inline bool secondary_ass_neutral_pose_capture(
+    struct secondary_ass_neutral_pose *pose,
+    const struct secondary_ass_physical *p,
+    const struct secondary_ass_present_plan *plan,
+    const struct secondary_ass_sample_snapshot *before,
+    const struct secondary_ass_sample_snapshot *after,
+    bool grid_cache, bool owner_current, bool target_updated,
+    bool submit_valid, bool phase_reset,
+    uint64_t submit_id, uint64_t submit_generation, int sync_interval)
+{
+    secondary_ass_neutral_pose_clear(pose);
+    if (!grid_cache || !owner_current || !target_updated ||
+        !submit_valid || phase_reset ||
+        !submit_id || sync_interval != 1 || !plan->valid ||
+        !plan->display_forecast || plan->fresh_clock_only ||
+        !plan->epoch || !plan->generation || plan->base.slot <= 0 ||
+        plan->base.wall <= 0 || plan->target.slot < plan->base.slot ||
+        plan->target.wall < plan->base.wall || plan->submit <= 0 ||
+        submit_generation != plan->generation || !after->valid ||
+        after->held || after->force || after->sample_forced ||
+        !after->display_forecast || after->epoch != plan->epoch ||
+        after->divisor <= 0 ||
+        after->divisor > INT64_MAX - plan->base.slot ||
+        after->sample_slot != plan->base.slot ||
+        after->next_slot != plan->base.slot + after->divisor ||
+        after->interval != plan->interval || before->force ||
+        before->epoch != after->epoch || before->rate != after->rate ||
+        before->speed != after->speed ||
+        before->requested_speed != after->requested_speed ||
+        before->divisor != after->divisor ||
+        before->origin_slot != after->origin_slot ||
+        before->next_slot != plan->base.slot)
+        return false;
+    struct secondary_ass_sampler projection = {
+        .phase_wall = after->phase_wall, .phase_slot = after->phase_slot,
+        .physical_interval = after->interval,
+    };
+    if (secondary_ass_sampler_slot_wall(&projection, plan->base.slot) !=
+            plan->base.wall ||
+        secondary_ass_sampler_slot_wall(&projection, plan->target.slot) !=
+            plan->target.wall ||
+        secondary_ass_sampler_slot_wall(&projection, after->next_slot) !=
+            after->next_wall)
+        return false;
+    struct secondary_ass_neutral_pose candidate = {
+        .valid = true, .submit_id = submit_id, .plan = *plan, .sample = *after,
+    };
+    if (!secondary_ass_neutral_pose_prefix_current(&candidate, p))
+        return false;
+    *pose = candidate;
+    return true;
+}
+
+// The caller includes its unchanged headroom margin in predicted_release.
+// next_prepare is the original next-G S minus its known redraw cost. A neutral
+// Present retains raw F and consumes this lease once; it never samples next G.
+// These CPU/VO bounds are admission estimates, not actual Display guarantees.
+static inline bool secondary_ass_neutral_pose_admit(
+    const struct secondary_ass_neutral_pose *pose,
+    const struct secondary_ass_physical *p,
+    const struct secondary_ass_sample_snapshot *sample,
+    const struct secondary_ass_present_plan *next_plan,
+    bool owner_current, int64_t now, int64_t raw_video_target,
+    int64_t predicted_release, int64_t next_prepare)
+{
+    if (!owner_current || !secondary_ass_neutral_pose_prefix_current(pose, p) ||
+        !secondary_ass_neutral_pose_tuple_equal(&pose->sample, sample) ||
+        !secondary_ass_present_plan_current(p, next_plan) ||
+        !next_plan->display_forecast || next_plan->fresh_clock_only ||
+        next_plan->epoch != pose->plan.epoch ||
+        next_plan->generation != pose->plan.generation ||
+        next_plan->interval != pose->plan.interval ||
+        next_plan->base.slot != sample->next_slot ||
+        next_plan->captured_forecast != pose->plan.captured_forecast ||
+        next_plan->target.slot <= pose->plan.target.slot ||
+        next_plan->target.slot - pose->plan.target.slot != sample->divisor ||
+        now <= 0 || raw_video_target < pose->plan.submit ||
+        raw_video_target >= next_plan->submit ||
+        next_prepare <= now || next_prepare > next_plan->submit ||
+        predicted_release < now || predicted_release < raw_video_target ||
+        predicted_release >= next_prepare)
+        return false;
+    // A lower bound is sufficient to veto a known collision. It cannot prove
+    // that the neutral frame, GPU work or the following task will hit scanout.
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    int64_t lower = secondary_ass_physical_fifo_lower_bound(&view);
+    return lower > 0 && lower < next_plan->target.slot;
+}
+
+#endif
diff --git a/video/out/secondary_ass_physical.h b/video/out/secondary_ass_physical.h
new file mode 100644
index 0000000000000000000000000000000000000000..ce8dc47e873b4ddf730e92088cdc3d0b5d6d62ec
--- /dev/null
+++ b/video/out/secondary_ass_physical.h
@@ -0,0 +1,862 @@
+#ifndef MP_SECONDARY_ASS_PHYSICAL_H
+#define MP_SECONDARY_ASS_PHYSICAL_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "secondary_ass_budget.h"
+
+// Historical feedback belongs to a real Present ID. Keep it separate from
+// the driver's prediction used by the primary video synchronization clock.
+struct secondary_ass_physical {
+    int64_t phase, interval, last_base;
+    uint64_t epoch;
+    bool epoch_exhausted;
+    int64_t phase_slot, last_base_slot;
+    int64_t sync_slot, sync_qpc_ns;
+    uint32_t sync_count;
+    bool sync_segment_consistent;
+    bool outlier_pending;
+    int64_t outlier_qpc_ns;
+    uint32_t outlier_count;
+    int64_t recovery_qpc_ns, recovery_slot;
+    uint32_t recovery_count;
+    int64_t history_floor_slot;
+    int64_t measure_qpc_ns;
+    uint32_t measure_count;
+    int64_t periods[5];
+    unsigned period_count, period_next;
+    uint64_t historical_id;
+    uint64_t last_submit_id;
+    uint64_t success_first_id, success_last_id, success_generation;
+    bool success_contiguous;
+    int delay, delay_samples[3], delay_count, delay_next;
+    struct {
+        uint64_t id;
+        int64_t base, base_slot, target_slot;
+        bool gap_excluded;
+    } submitted[32];
+    unsigned next;
+};
+
+struct secondary_ass_physical_point {
+    int64_t slot, wall;
+};
+
+static inline void secondary_ass_physical_reset(struct secondary_ass_physical *p)
+{
+    uint64_t epoch = p->epoch;
+    *p = (struct secondary_ass_physical){0};
+    // Never reuse an epoch after wrapping. In that unreachable lifetime the
+    // physical path stays unavailable instead of reviving an old OSD grid.
+    p->epoch = epoch < UINT64_MAX ? epoch + 1 : UINT64_MAX;
+    p->epoch_exhausted = epoch == UINT64_MAX;
+}
+
+static inline bool secondary_ass_physical_interval_valid(int64_t interval)
+{
+    return interval > 0 && interval <= INT64_MAX / 8;
+}
+
+static inline struct secondary_ass_physical_point
+secondary_ass_physical_point_at(const struct secondary_ass_physical *p,
+                               int64_t slot)
+{
+    struct secondary_ass_physical_point none = {0};
+    if (p->epoch_exhausted || p->phase <= 0 || p->phase_slot <= 0 ||
+        slot <= 0 || !secondary_ass_physical_interval_valid(p->interval))
+        return none;
+    if (p->outlier_pending) {
+        uint32_t advance = p->outlier_count - p->sync_count;
+        if (!advance || advance >= UINT32_C(0x80000000) ||
+            p->delay < 0 || p->delay > 4 || p->sync_slot <= 0 ||
+            p->sync_slot > INT64_MAX - (int64_t)advance - 1 - p->delay ||
+            slot > p->sync_slot + (int64_t)advance + 1 + p->delay)
+            return none;
+    }
+    int64_t delta = slot - p->phase_slot;
+    int64_t wall;
+    if (delta >= 0) {
+        if (delta > (INT64_MAX - p->phase) / p->interval)
+            return none;
+        wall = p->phase + delta * p->interval;
+    } else {
+        if (-delta > (p->phase - 1) / p->interval)
+            return none;
+        wall = p->phase + delta * p->interval;
+    }
+    return (struct secondary_ass_physical_point){slot, wall};
+}
+
+// Quarantined wall-only callers must identify a point on the retained count
+// horizon; a naked CPU/future wall timestamp has no physical slot authority.
+static inline bool secondary_ass_physical_sample_available(
+    const struct secondary_ass_physical *p, int64_t sample)
+{
+    if (!p->outlier_pending)
+        return true;
+    if (sample <= 0 || p->phase <= 0 || p->phase_slot <= 0 ||
+        !secondary_ass_physical_interval_valid(p->interval))
+        return false;
+    int64_t delta = sample - p->phase;
+    if (delta % p->interval)
+        return false;
+    int64_t steps = delta / p->interval;
+    if ((steps > 0 && p->phase_slot > INT64_MAX - steps) ||
+        (steps < 0 && p->phase_slot <= -steps))
+        return false;
+    struct secondary_ass_physical_point point =
+        secondary_ass_physical_point_at(p, p->phase_slot + steps);
+    return point.slot > 0 && point.wall == sample;
+}
+
+static inline struct secondary_ass_physical_point
+secondary_ass_physical_predict_point(const struct secondary_ass_physical *p,
+                                    int64_t ready)
+{
+    struct secondary_ass_physical_point none = {0};
+    if (p->phase <= 0 || ready < p->phase || p->phase_slot <= 0 ||
+        !secondary_ass_physical_interval_valid(p->interval) ||
+        p->delay < 0 || p->delay > 4)
+        return none;
+    int64_t steps = (ready - p->phase) / p->interval + 1;
+    if (steps > INT64_MAX - p->phase_slot)
+        return none;
+    int64_t base = p->phase_slot + steps;
+    if (base <= p->last_base_slot) {
+        if (p->last_base_slot == INT64_MAX)
+            return none;
+        base = p->last_base_slot + 1;
+    }
+    if (base > INT64_MAX - p->delay)
+        return none;
+    return secondary_ass_physical_point_at(p, base + p->delay);
+}
+
+static inline void secondary_ass_physical_measure_anchor(
+    struct secondary_ass_physical *p, int64_t qpc_ns, uint32_t count)
+{
+    p->measure_qpc_ns = qpc_ns;
+    p->measure_count = count;
+}
+
+static inline void secondary_ass_physical_clear_recovery(
+    struct secondary_ass_physical *p)
+{
+    p->recovery_qpc_ns = p->recovery_slot = 0;
+    p->recovery_count = 0;
+}
+
+// A recovered count segment does not authorize history from the gap. Keep the
+// phase and immutable submission coordinates; exclude only ambiguous feedback,
+// leaving the existing period median and delay learner values untouched.
+static inline void secondary_ass_physical_recover(
+    struct secondary_ass_physical *p, int64_t qpc_ns, uint32_t count,
+    int64_t slot)
+{
+    p->sync_qpc_ns = qpc_ns;
+    p->sync_count = count;
+    p->sync_slot = slot;
+    p->sync_segment_consistent = false;
+    p->history_floor_slot = slot;
+    p->outlier_pending = false;
+    p->outlier_qpc_ns = 0;
+    p->outlier_count = 0;
+    secondary_ass_physical_clear_recovery(p);
+    secondary_ass_physical_measure_anchor(p, qpc_ns, count);
+}
+
+// A displaced old QPC anchor must not prevent the existing count/time recovery
+// test from running. These two observations identify a new count segment only;
+// neither is historical Present feedback or a delay-learning sample. Preserve
+// the old submission coordinates and require the new segment to follow them.
+static inline bool secondary_ass_physical_recover_displaced(
+    struct secondary_ass_physical *p, int64_t qpc_ns, uint32_t count)
+{
+    if (!p->outlier_pending || p->epoch_exhausted || p->sync_slot <= 0 ||
+        !secondary_ass_physical_interval_valid(p->interval))
+        return false;
+    if (p->recovery_qpc_ns && qpc_ns <= p->recovery_qpc_ns)
+        return false;
+    if (p->recovery_qpc_ns && qpc_ns > p->recovery_qpc_ns) {
+        int64_t delta = qpc_ns - p->recovery_qpc_ns;
+        uint32_t passed = count - p->recovery_count;
+        if (passed && passed < UINT32_C(0x80000000) &&
+            delta <= INT64_MAX - p->interval / 2) {
+            int64_t steps = (delta + p->interval / 2) / p->interval;
+            if (steps > 0 && steps <= INT64_MAX / p->interval &&
+                (uint64_t)steps == passed &&
+                p->recovery_slot <= INT64_MAX - steps) {
+                int64_t residual = delta - steps * p->interval;
+                int64_t slot = p->recovery_slot + steps;
+                if (residual <= p->interval / 4 &&
+                    residual >= -p->interval / 4 &&
+                    slot > p->last_base_slot && slot > p->sync_slot) {
+                    secondary_ass_physical_recover(p, qpc_ns, count, slot);
+                    return true;
+                }
+            }
+        }
+    }
+    uint32_t forward = count - p->sync_count;
+    if (forward && forward < UINT32_C(0x80000000) &&
+        p->sync_slot <= INT64_MAX - (int64_t)forward) {
+        p->recovery_qpc_ns = qpc_ns;
+        p->recovery_count = count;
+        p->recovery_slot = p->sync_slot + (int64_t)forward;
+    } else {
+        secondary_ass_physical_clear_recovery(p);
+    }
+    return false;
+}
+
+// Display-sync submits one frame per refresh. Pending Present IDs therefore
+// locate the next queued scanout from identified display history; they are not
+// an elapsed wall oscillator or a guess about independent audio redraws.
+static inline struct secondary_ass_physical_point
+secondary_ass_physical_queued_point(const struct secondary_ass_physical *p)
+{
+    if (!p->last_submit_id || !p->historical_id || p->phase_slot <= 0)
+        return (struct secondary_ass_physical_point){0};
+    uint32_t pending = (uint32_t)p->last_submit_id - (uint32_t)p->historical_id;
+    if (pending > 8 || p->phase_slot > INT64_MAX - pending - 1)
+        return (struct secondary_ass_physical_point){0};
+    return secondary_ass_physical_point_at(p, p->phase_slot + pending + 1);
+}
+
+// QPC and raw refresh counts are independent observations. A missing raw
+// count invalidates a period-measurement segment, not the submission queue.
+// Logical slots advance from checked QPC differences in a fixed-mode epoch.
+static inline bool secondary_ass_physical_observe(
+    struct secondary_ass_physical *p, int64_t qpc_ns, uint32_t count,
+    int64_t seed_interval)
+{
+    if (p->epoch_exhausted || qpc_ns <= 0)
+        return false;
+    if (!p->epoch)
+        p->epoch = 1;
+    if (!p->interval) {
+        if (!secondary_ass_physical_interval_valid(seed_interval))
+            return false;
+        p->interval = seed_interval;
+    }
+    if (!p->sync_qpc_ns) {
+        p->sync_qpc_ns = qpc_ns;
+        p->sync_count = count;
+        // Leave room for a historical Present before the first Sync sample.
+        p->sync_slot = INT64_C(4294967296);
+        p->sync_segment_consistent = true;
+        secondary_ass_physical_measure_anchor(p, qpc_ns, count);
+        return true;
+    }
+    if (qpc_ns == p->sync_qpc_ns && count == p->sync_count)
+        return !p->outlier_pending;
+    if (qpc_ns <= p->sync_qpc_ns)
+        return false;
+    int64_t elapsed = qpc_ns - p->sync_qpc_ns;
+    if (elapsed > INT64_MAX - p->interval / 2)
+        return false;
+    int64_t steps = (elapsed + p->interval / 2) / p->interval;
+    if (steps <= 0 || steps > INT64_MAX - p->sync_slot ||
+        steps > INT64_MAX / p->interval)
+        return false;
+    int64_t residual = elapsed - steps * p->interval;
+    // Reject ambiguous timing without treating a single scheduler/driver jitter
+    // as a mode change. Keep the last trusted phase, but only predict through
+    // the next base refresh supported by the independently observed count.
+    // A distinct second bad sample must also advance the count to invalidate it.
+    if (residual > p->interval / 4 || residual < -p->interval / 4) {
+        uint32_t forward = count - p->sync_count;
+        bool advanced = forward && forward < UINT32_C(0x80000000);
+        if (!p->outlier_pending) {
+            p->outlier_pending = true;
+            p->outlier_qpc_ns = qpc_ns;
+            p->outlier_count = count;
+            for (unsigned n = 0; n < 32; n++)
+                p->submitted[n].gap_excluded = true;
+        } else if (advanced) {
+            uint32_t another = count - p->outlier_count;
+            if (qpc_ns != p->outlier_qpc_ns && another &&
+                another < UINT32_C(0x80000000))
+                p->phase = p->phase_slot = 0;
+        }
+        p->sync_segment_consistent = false;
+        p->measure_qpc_ns = 0;
+        secondary_ass_physical_recover_displaced(p, qpc_ns, count);
+        return false;
+    }
+    uint32_t passed = count - p->sync_count;
+    bool consistent = passed < UINT32_C(0x80000000) &&
+                      (uint64_t)steps == passed;
+    if (p->outlier_pending) {
+        int64_t slot = p->sync_slot + steps;
+        if (consistent) {
+            secondary_ass_physical_recover(p, qpc_ns, count, slot);
+            // Commit the trusted segment, but skip this mixed-gap history.
+            return false;
+        }
+        // A permanently lost raw count can never agree with the old anchor.
+        // Require two distinct observations on its retained QPC lattice whose
+        // *relative* count/time deltas agree, instead of running a wall clock
+        // or waiting forever for the lost count. The first anchor grants no
+        // additional point horizon and neither observation enters the learner.
+        if (p->recovery_qpc_ns) {
+            if (qpc_ns <= p->recovery_qpc_ns)
+                return false;
+            int64_t delta = qpc_ns - p->recovery_qpc_ns;
+            if (delta > INT64_MAX - p->interval / 2)
+                return false;
+            int64_t recovery_steps = (delta + p->interval / 2) / p->interval;
+            if (recovery_steps > 0 &&
+                recovery_steps <= INT64_MAX / p->interval) {
+                int64_t recovery_residual = delta - recovery_steps * p->interval;
+                uint32_t recovery_passed = count - p->recovery_count;
+                if (recovery_passed && recovery_passed < UINT32_C(0x80000000) &&
+                    (uint64_t)recovery_steps == recovery_passed &&
+                    recovery_steps == slot - p->recovery_slot &&
+                    recovery_residual <= p->interval / 4 &&
+                    recovery_residual >= -p->interval / 4) {
+                    secondary_ass_physical_recover(p, qpc_ns, count, slot);
+                    return false;
+                }
+            }
+        }
+        p->recovery_qpc_ns = qpc_ns;
+        p->recovery_count = count;
+        p->recovery_slot = slot;
+        return false;
+    }
+    p->outlier_pending = false;
+    p->outlier_qpc_ns = 0;
+    p->outlier_count = 0;
+    p->sync_slot += steps;
+    p->sync_qpc_ns = qpc_ns;
+    p->sync_count = count;
+    p->sync_segment_consistent = consistent;
+    if (!consistent || !p->measure_qpc_ns) {
+        secondary_ass_physical_measure_anchor(p, qpc_ns, count);
+        return true;
+    }
+    int64_t window = qpc_ns - p->measure_qpc_ns;
+    if (window < INT64_C(500000000))
+        return true;
+    uint32_t refreshes = count - p->measure_count;
+    secondary_ass_physical_measure_anchor(p, qpc_ns, count);
+    if (!refreshes || refreshes >= UINT32_C(0x80000000))
+        return true;
+    int64_t measured = window / refreshes;
+    if (!secondary_ass_physical_interval_valid(measured))
+        return true;
+    p->periods[p->period_next] = measured;
+    p->period_next = (p->period_next + 1) % 5;
+    if (p->period_count < 5)
+        p->period_count++;
+    if (p->period_count < 3)
+        return true;
+    int64_t values[5];
+    for (unsigned n = 0; n < p->period_count; n++)
+        values[n] = p->periods[n];
+    for (unsigned n = 1; n < p->period_count; n++) {
+        int64_t value = values[n];
+        unsigned k = n;
+        while (k && values[k - 1] > value) {
+            values[k] = values[k - 1];
+            k--;
+        }
+        values[k] = value;
+    }
+    p->interval = values[p->period_count / 2];
+    return true;
+}
+
+static inline int64_t secondary_ass_physical_slot(int64_t phase,
+                                                 int64_t interval,
+                                                 int64_t ready)
+{
+    if (phase <= 0 || interval <= 0 || ready < phase)
+        return 0;
+    int64_t steps = (ready - phase) / interval + 1;
+    if (steps > (INT64_MAX - phase) / interval)
+        return 0;
+    return phase + steps * interval;
+}
+
+static inline void secondary_ass_physical_feedback_point(
+    struct secondary_ass_physical *p, struct secondary_ass_physical_point actual,
+    uint64_t historical_id)
+{
+    if (p->epoch_exhausted || p->outlier_pending || actual.wall <= 0 ||
+        actual.slot <= 0 || actual.slot < p->history_floor_slot ||
+        !historical_id || historical_id == p->historical_id)
+        return;
+    p->phase = actual.wall;
+    p->phase_slot = actual.slot;
+    p->historical_id = historical_id;
+    for (unsigned n = 0; n < 32; n++) {
+        if (p->submitted[n].id != historical_id)
+            continue;
+        if (p->submitted[n].gap_excluded ||
+            (p->history_floor_slot &&
+             p->submitted[n].base_slot < p->history_floor_slot))
+            break;
+        int64_t delta;
+        if (p->submitted[n].base_slot > 0) {
+            delta = actual.slot - p->submitted[n].base_slot;
+        } else {
+            // Legacy adapters have no slot identity. Keep their historical
+            // wall-offset learner; the observed path always has base_slot.
+            int64_t elapsed = actual.wall - p->submitted[n].base;
+            if (elapsed < -p->interval / 2 || elapsed > 4 * p->interval + p->interval / 2)
+                break;
+            delta = (elapsed + p->interval / 2) / p->interval;
+        }
+        // Delay is a learned submission pipeline offset, never a guessed
+        // fixed extra vsync. Ignore disjoint/overloaded history outliers.
+        if (delta < 0 || delta > 4)
+            break;
+        int delay = (int)delta;
+        p->delay_samples[p->delay_next] = delay;
+        p->delay_next = (p->delay_next + 1) % 3;
+        if (p->delay_count < 3)
+            p->delay_count++;
+        int values[3];
+        for (int j = 0; j < p->delay_count; j++)
+            values[j] = p->delay_samples[j];
+        for (int j = 1; j < p->delay_count; j++) {
+            int value = values[j], k = j;
+            while (k && values[k - 1] > value) {
+                values[k] = values[k - 1];
+                k--;
+            }
+            values[k] = value;
+        }
+        p->delay = values[p->delay_count / 2];
+        break;
+    }
+}
+
+// Compatibility for callers without raw clock/count pairs. This interface is
+// deliberately not the physical-period estimator used by the observed path.
+static inline void secondary_ass_physical_feedback(
+    struct secondary_ass_physical *p, int64_t actual, int64_t interval,
+    uint64_t historical_id)
+{
+    if (p->outlier_pending || actual <= 0 ||
+        !secondary_ass_physical_interval_valid(interval) ||
+        !historical_id || p->epoch_exhausted ||
+        historical_id == p->historical_id)
+        return;
+    int64_t slot = p->phase_slot > 0 ? p->phase_slot : INT64_C(4294967296);
+    if (p->phase > 0 && p->interval > 0) {
+        int64_t delta = actual - p->phase;
+        int64_t steps = delta / p->interval;
+        int64_t remainder = delta % p->interval;
+        if (remainder >= p->interval / 2)
+            steps++;
+        if (remainder <= -p->interval / 2)
+            steps--;
+        if ((steps > 0 && slot > INT64_MAX - steps) ||
+            (steps < 0 && slot <= -steps))
+            return;
+        slot += steps;
+    }
+    if (!p->epoch)
+        p->epoch = 1;
+    p->interval = interval;
+    secondary_ass_physical_feedback_point(p,
+        (struct secondary_ass_physical_point){slot, actual}, historical_id);
+}
+
+static inline int64_t secondary_ass_physical_predict(
+    struct secondary_ass_physical *p, int64_t ready)
+{
+    if (p->outlier_pending && p->phase_slot <= 0)
+        return 0;
+    if (p->phase_slot > 0)
+        return secondary_ass_physical_predict_point(p, ready).wall;
+    int64_t base = secondary_ass_physical_slot(p->phase, p->interval, ready);
+    if (!base)
+        return 0;
+    if (base <= p->last_base)
+    {
+        if (p->last_base > INT64_MAX - p->interval)
+            return 0;
+        base = p->last_base + p->interval;
+    }
+    if (base > INT64_MAX - p->delay * p->interval)
+        return 0;
+    return base + p->delay * p->interval;
+}
+
+static inline void secondary_ass_physical_submit_point(
+    struct secondary_ass_physical *p, uint64_t id,
+    struct secondary_ass_physical_point intended)
+{
+    if (p->epoch_exhausted || !id || intended.wall <= 0 ||
+        intended.slot <= p->delay || p->delay < 0 || p->delay > 4 ||
+        !secondary_ass_physical_interval_valid(p->interval) ||
+        intended.wall <= p->delay * p->interval)
+        return;
+    if (p->submitted[(p->next + 31) % 32].id == id)
+        return;
+    int64_t base_slot = intended.slot - p->delay;
+    int64_t base = intended.wall - p->delay * p->interval;
+    p->submitted[p->next].id = id;
+    p->submitted[p->next].base = base;
+    p->submitted[p->next].base_slot = base_slot;
+    p->submitted[p->next].target_slot = intended.slot;
+    p->submitted[p->next].gap_excluded = p->outlier_pending;
+    p->next = (p->next + 1) % 32;
+    if (base_slot > p->last_base_slot) {
+        p->last_base_slot = base_slot;
+        p->last_base = base;
+    }
+}
+
+// Opt-in consumers provide the immutable eligibility base selected before
+// drawing.  It is not the actual API cycle and is never reconstructed using
+// the current historical median.  The feedback/median implementation below
+// remains unchanged and measures actual-slot minus this planned base.
+static inline bool secondary_ass_physical_submit_planned_point(
+    struct secondary_ass_physical *p, uint64_t id, uint64_t epoch,
+    struct secondary_ass_physical_point base,
+    struct secondary_ass_physical_point target)
+{
+    if (p->epoch_exhausted || !id || !epoch || epoch != p->epoch ||
+        base.wall <= 0 || base.slot <= 0 || target.wall < base.wall ||
+        target.slot < base.slot ||
+        !secondary_ass_physical_interval_valid(p->interval))
+        return false;
+    if (p->submitted[(p->next + 31) % 32].id == id)
+        return false;
+    p->submitted[p->next].id = id;
+    p->submitted[p->next].base = base.wall;
+    p->submitted[p->next].base_slot = base.slot;
+    p->submitted[p->next].target_slot = target.slot;
+    p->submitted[p->next].gap_excluded = p->outlier_pending;
+    p->next = (p->next + 1) % 32;
+    if (base.slot > p->last_base_slot) {
+        p->last_base_slot = base.slot;
+        p->last_base = base.wall;
+    }
+    return true;
+}
+
+static inline void secondary_ass_physical_submit(
+    struct secondary_ass_physical *p, uint64_t id, int64_t intended)
+{
+    if (!p->phase || !id || intended <= 0)
+        return;
+    if (p->phase_slot > 0 && p->interval > 0) {
+        int64_t delta = intended - p->phase;
+        int64_t steps = delta / p->interval;
+        int64_t remainder = delta % p->interval;
+        if (remainder >= p->interval / 2)
+            steps++;
+        if (remainder <= -p->interval / 2)
+            steps--;
+        if ((steps > 0 && p->phase_slot > INT64_MAX - steps) ||
+            (steps < 0 && p->phase_slot <= -steps))
+            return;
+        secondary_ass_physical_submit_point(p, id,
+            (struct secondary_ass_physical_point){p->phase_slot + steps, intended});
+        return;
+    }
+    if (p->submitted[(p->next + 31) % 32].id == id)
+        return;
+    int64_t base = intended - p->delay * p->interval;
+    p->submitted[p->next].id = id;
+    p->submitted[p->next].base = base;
+    p->submitted[p->next].base_slot = 0;
+    p->submitted[p->next].target_slot = 0;
+    p->submitted[p->next].gap_excluded = p->outlier_pending;
+    p->next = (p->next + 1) % 32;
+    p->last_base = base;
+}
+
+static inline int64_t secondary_ass_physical_prepare(
+    const struct secondary_ass_physical *p, int64_t sample)
+{
+    if (!p->phase || sample <= 0 ||
+        !secondary_ass_physical_sample_available(p, sample))
+        return 0;
+    return sample - p->delay * p->interval - p->interval / 2;
+}
+
+static inline int64_t secondary_ass_physical_render_time(
+    const struct secondary_ass_physical *p, int64_t sample, int64_t cost)
+{
+    int64_t submit = secondary_ass_physical_prepare(p, sample);
+    if (submit <= 0)
+        return 0;
+    // Prepare GPU work early on very high-refresh monitors. Submission still
+    // occurs in the intended half-vsync window, rather than displaying early.
+    int64_t lead = cost + 1000000;
+    if (lead < p->interval / 2)
+        lead = p->interval / 2;
+    return sample - p->delay * p->interval - lead;
+}
+
+static inline int64_t secondary_ass_physical_submit_time(
+    const struct secondary_ass_physical *p, int64_t sample)
+{
+    if (!p->phase || !secondary_ass_physical_interval_valid(p->interval) ||
+        p->delay < 0 || p->delay > 4 || sample <= (p->delay + 1) * p->interval ||
+        !secondary_ass_physical_sample_available(p, sample))
+        return 0;
+    // Present(sync=1) may target only the next scanout after its base cycle.
+    // Submit just inside that cycle, leaving GPU/flip completion headroom.
+    // Half-cycle submission left <0.15 ms in the recorded missed scanouts.
+    int64_t guard = p->interval / 4;
+    if (guard > 1000000)
+        guard = 1000000;
+    return sample - (p->delay + 1) * p->interval + guard;
+}
+
+static inline int64_t secondary_ass_physical_render_slot_time(
+    const struct secondary_ass_physical *p, int64_t sample, int64_t cost)
+{
+    int64_t submit = secondary_ass_physical_submit_time(p, sample);
+    if (submit <= 0 || cost < 0 || cost > submit)
+        return 0;
+    return submit - cost;
+}
+
+// A sync=1 Present must enter before its original base scanout. This boundary
+// is separate from the preferred submit time and from CPU/GPU completion.
+static inline int64_t secondary_ass_physical_cache_deadline(
+    struct secondary_ass_physical_point sample, int64_t interval, int delay)
+{
+    if (!secondary_ass_physical_interval_valid(interval) || delay < 0 ||
+        delay > 4 || sample.slot <= delay || sample.wall <= delay * interval)
+        return 0;
+    return sample.wall - delay * interval;
+}
+
+// Select a new task on the existing divided lattice. Do not rename a task
+// after a late wakeup, or retry a sampler slot that can no longer be submitted.
+// This is a scheduling decision only: physical phase and sampler state stay put.
+static inline struct secondary_ass_physical_point secondary_ass_physical_cache_next(
+    const struct secondary_ass_physical *p, int64_t next_slot, int64_t divisor,
+    int64_t now)
+{
+    struct secondary_ass_physical_point sample =
+        secondary_ass_physical_point_at(p, next_slot);
+    int64_t deadline = secondary_ass_physical_cache_deadline(sample, p->interval, p->delay);
+    if (now <= 0 || deadline <= 0 || divisor <= 0 ||
+        divisor > INT64_MAX / p->interval)
+        return (struct secondary_ass_physical_point){0};
+    int64_t skip = 0;
+    if (deadline <= now)
+        skip = (now - deadline) / (divisor * p->interval) + 1;
+    int64_t base_slot = sample.slot - p->delay;
+    if (base_slot <= p->last_base_slot) {
+        int64_t occupied_skip = (p->last_base_slot - base_slot) / divisor + 1;
+        if (occupied_skip > skip)
+            skip = occupied_skip;
+    }
+    if (skip > (INT64_MAX - next_slot) / divisor)
+        return (struct secondary_ass_physical_point){0};
+    return secondary_ass_physical_point_at(p, next_slot + skip * divisor);
+}
+
+// The cache uses its original ASS slot while its headroom is bounded by the
+// unmodified fresh-video target. Never round that video target onto the ASS
+// lattice: doing so grants cache time by delaying the primary picture.
+static inline int64_t secondary_ass_physical_cache_sample_prepare(
+    struct secondary_ass_physical *p, int64_t now, int64_t sample_slot,
+    int64_t divisor, int64_t fresh_pts, int64_t duration,
+    int64_t animation_interval, int64_t fresh_cost, int64_t redraw_cost,
+    int64_t block_cost, int64_t earliest_redraw)
+{
+    if (now <= 0 || duration <= 0 || fresh_pts <= 0 || divisor <= 0 ||
+        !secondary_ass_physical_interval_valid(p->interval) ||
+        divisor > INT64_MAX / p->interval ||
+        duration < divisor * p->interval ||
+        fresh_pts > INT64_MAX - duration || fresh_cost < 0 ||
+        now > INT64_MAX - fresh_cost ||
+        !secondary_ass_budget_affordable(fresh_cost, redraw_cost,
+                                         duration, animation_interval))
+        return 0;
+    struct secondary_ass_physical_point sample =
+        secondary_ass_physical_point_at(p, sample_slot);
+    struct secondary_ass_physical_point fresh =
+        secondary_ass_physical_predict_point(p,
+            now + fresh_cost > fresh_pts ? now + fresh_cost : fresh_pts);
+    if (sample.wall <= 0 || fresh.wall <= 0 || sample.slot >= fresh.slot ||
+        p->delay < 0 || p->delay > 4 || sample.slot <= p->delay ||
+        sample.slot - p->delay <= p->last_base_slot ||
+        now >= secondary_ass_physical_cache_deadline(sample, p->interval, p->delay))
+        return 0;
+    int64_t prepare = secondary_ass_physical_render_slot_time(p, sample.wall, redraw_cost);
+    if (prepare < earliest_redraw)
+        prepare = earliest_redraw;
+    if (prepare <= 0 || (prepare > now && prepare - now > duration))
+        return 0;
+    if (prepare >= secondary_ass_physical_cache_deadline(sample, p->interval, p->delay))
+        return 0;
+    int64_t deadline = fresh.wall - p->delay * p->interval - p->interval / 4;
+    return secondary_ass_budget_before_deadline(now > prepare ? now : prepare,
+        deadline, fresh_cost, block_cost, 1000000) ? prepare : 0;
+}
+
+// The queued video's actual submission opportunity bounds this cached draw.
+// Execute a successful decision directly; another deadline calculation must
+// not leave both the queued video and its earlier cached slot unserviced.
+static inline int64_t secondary_ass_physical_cache_prepare(
+    struct secondary_ass_physical *p, int64_t now, int64_t sample,
+    int64_t fresh_pts, int64_t duration, int64_t animation_interval,
+    int64_t fresh_cost, int64_t redraw_cost, int64_t block_cost,
+    int64_t earliest_redraw)
+{
+    if (!p->phase || p->interval <= 0 || sample <= 0 ||
+        duration < p->interval ||
+        !secondary_ass_budget_affordable(fresh_cost, redraw_cost,
+                                         duration, animation_interval) ||
+        now > INT64_MAX - fresh_cost)
+        return 0;
+    int64_t ready = now + fresh_cost;
+    if (ready < fresh_pts)
+        ready = fresh_pts;
+    int64_t slot = secondary_ass_physical_predict(p, ready);
+    int64_t prepare = secondary_ass_physical_render_slot_time(p, sample, redraw_cost);
+    if (prepare < earliest_redraw)
+        prepare = earliest_redraw;
+    if (slot <= 0 || prepare <= 0 || sample >= slot - p->interval / 2 ||
+        (prepare > now && prepare - now - fresh_cost > 2000000))
+        return 0;
+    int64_t deadline = slot - p->delay * p->interval - p->interval / 4;
+    return secondary_ass_budget_before_deadline(now > prepare ? now : prepare,
+        deadline, fresh_cost, block_cost, 1000000) ? prepare : 0;
+}
+
+static inline void secondary_ass_physical_update(
+    struct secondary_ass_physical *p, bool invalid, uint64_t submitted_id,
+    int64_t intended, int64_t actual, int64_t interval, uint64_t historical_id)
+{
+    if (invalid) {
+        secondary_ass_physical_reset(p);
+        return;
+    }
+    // A successful Present still occupies a slot when statistics temporarily
+    // contain zeroes. Its ID is independent of historical feedback validity.
+    secondary_ass_physical_submit(p, submitted_id, intended);
+    secondary_ass_physical_feedback(p, actual, interval, historical_id);
+}
+
+static inline void secondary_ass_physical_record_present(
+    struct secondary_ass_physical *p, bool valid, uint64_t id,
+    uint64_t generation, int sync_interval)
+{
+    // A wrapped/exhausted physical epoch must never revive from a late
+    // backend callback.  The reset path normally clears this state, but keep
+    // the recorder fail-closed on its own as well.
+    if (p->epoch_exhausted || !valid || !id || !generation ||
+        sync_interval != 1) {
+        p->success_contiguous = false;
+        return;
+    }
+    if (!p->success_contiguous) {
+        p->success_contiguous = true;
+        p->success_first_id = id;
+        p->success_last_id = id;
+        p->success_generation = generation;
+        return;
+    }
+    if (p->success_generation != generation ||
+        p->success_last_id == UINT64_MAX ||
+        id != p->success_last_id + 1) {
+        p->success_contiguous = false;
+        return;
+    }
+    p->success_last_id = id;
+}
+
+// Lower bound for the next FIFO scanout derived only from identified
+// historical refresh counts and a contiguous run of successful Sync1 Presents.
+// This is deliberately a lower bound, not a predicted display timestamp.
+static inline int64_t secondary_ass_physical_fifo_lower_bound(
+    const struct secondary_ass_physical *p)
+{
+    if (p->epoch_exhausted || !p->success_contiguous || p->delay != 0 ||
+        p->outlier_pending ||
+        !p->sync_segment_consistent || !p->success_generation ||
+        !p->success_first_id || p->historical_id == 0 ||
+        p->success_last_id <= p->historical_id ||
+        (p->historical_id != UINT64_MAX &&
+            p->success_first_id > p->historical_id + 1) ||
+        p->phase_slot <= 0)
+        return 0;
+    uint64_t delta = p->success_last_id - p->historical_id;
+    if (delta > 8 || delta > INT64_MAX - 1 ||
+        p->phase_slot > INT64_MAX - (int64_t)delta - 1)
+        return 0;
+    return p->phase_slot + (int64_t)delta + 1;
+}
+
+static inline void secondary_ass_physical_update_observed(
+    struct secondary_ass_physical *p, bool invalid, uint64_t submitted_id,
+    struct secondary_ass_physical_point intended, int64_t sync_qpc_ns,
+    int64_t sync_wall, uint32_t sync_count, uint32_t present_count,
+    uint64_t historical_id, int64_t seed_interval)
+{
+    if (invalid) {
+        secondary_ass_physical_reset(p);
+        return;
+    }
+    // Registration uses the exact slot selected before this feedback. A later
+    // period refinement cannot reinterpret a successful Present's identity.
+    secondary_ass_physical_submit_point(p, submitted_id, intended);
+    if (submitted_id)
+        p->last_submit_id = submitted_id;
+    if (sync_wall <= 0 || !secondary_ass_physical_observe(
+            p, sync_qpc_ns, sync_count, seed_interval) || !historical_id)
+        return;
+    uint32_t raw_offset = present_count - sync_count;
+    int64_t offset = raw_offset <= INT32_MAX ? raw_offset :
+                    -(int64_t)(UINT32_MAX - raw_offset) - 1;
+    // Cross-gap extrapolation is ambiguous when a raw refresh count was lost.
+    // A same-count Sync/Present pair is still an identified exact timestamp.
+    if (offset < -32 || offset > 32 ||
+        (offset && !p->sync_segment_consistent) ||
+        (offset > 0 && p->sync_slot > INT64_MAX - offset) ||
+        (offset < 0 && p->sync_slot <= -offset))
+        return;
+    // Recovery established a count/time segment, not Present history. A real
+    // Sync observation can restore a cleared physical phase even while the
+    // previous Present belongs to the excluded gap. Keep the historical-ID,
+    // submission-coordinate and delay-learning guards below unchanged.
+    if (!p->phase && !p->phase_slot && p->history_floor_slot > 0 &&
+        p->sync_segment_consistent && !p->outlier_pending &&
+        p->sync_slot >= p->history_floor_slot) {
+        p->phase = sync_wall;
+        p->phase_slot = p->sync_slot;
+    }
+    if (offset && p->history_floor_slot) {
+        // A raw offset may only cross the newly established count segment for
+        // an identified post-recovery submission. Old/gap IDs (including an
+        // unregistered one) cannot move phase or invent a delay sample. Exact
+        // Sync/Present pairs remain usable to bootstrap a cleared phase.
+        bool post_recovery = false;
+        for (unsigned n = 0; n < 32; n++) {
+            if (p->submitted[n].id == historical_id &&
+                !p->submitted[n].gap_excluded &&
+                p->submitted[n].base_slot >= p->history_floor_slot) {
+                post_recovery = true;
+                break;
+            }
+        }
+        if (!post_recovery)
+            return;
+    }
+    int64_t adjustment = offset * p->interval;
+    if ((adjustment > 0 && sync_wall > INT64_MAX - adjustment) ||
+        (adjustment < 0 && sync_wall <= -adjustment))
+        return;
+    secondary_ass_physical_feedback_point(p,
+        (struct secondary_ass_physical_point){p->sync_slot + offset,
+                                             sync_wall + adjustment},
+        historical_id);
+}
+
+#endif
diff --git a/video/out/secondary_ass_present_plan.h b/video/out/secondary_ass_present_plan.h
new file mode 100644
index 0000000000000000000000000000000000000000..e8c2f3a378a3fc3f1896f042da9fc94436f572f6
--- /dev/null
+++ b/video/out/secondary_ass_present_plan.h
@@ -0,0 +1,330 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_PRESENT_PLAN_H
+#define MP_SECONDARY_ASS_PRESENT_PLAN_H
+
+#include <math.h>
+
+#include "secondary_ass_physical.h"
+
+// A planned eligibility base is not the actual Present-entry cycle.  Keep
+// the original plan immutable even when an early call or lifecycle fallback
+// changes its execution time. Legacy plans keep delay diagnostic; opt-in
+// forecasts capture it only when identifying a new task's display pose.
+struct secondary_ass_present_plan {
+    bool valid, fifo_known, display_forecast;
+    bool fresh_clock_only; // mandatory video draw, no additional cache admission
+    struct secondary_ass_physical_point base, target;
+    int64_t submit, deadline, fallback_submit, lifecycle_safe_wait;
+    int64_t interval, fifo_lower;
+    uint64_t epoch, generation;
+    int historical_delay, captured_forecast;
+};
+
+static inline struct secondary_ass_physical secondary_ass_present_plan_view(
+    const struct secondary_ass_physical *p)
+{
+    struct secondary_ass_physical view = *p;
+    // This copy is for planning only.  Registration/feedback always mutate
+    // the original ledger and preserve its median and outlier rules.
+    view.delay = 0;
+    return view;
+}
+
+static inline struct secondary_ass_present_plan secondary_ass_present_plan_make(
+    const struct secondary_ass_physical *p,
+    struct secondary_ass_physical_point base,
+    struct secondary_ass_physical_point target)
+{
+    struct secondary_ass_present_plan plan = {
+        .base = base, .target = target, .epoch = p->epoch,
+        .generation = p->success_generation, .interval = p->interval,
+        .historical_delay = p->delay,
+    };
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    plan.fifo_lower = secondary_ass_physical_fifo_lower_bound(&view);
+    plan.fifo_known = plan.fifo_lower > 0;
+    if (base.slot <= 0 || target.slot < base.slot || base.wall <= 0 ||
+        target.wall < base.wall || base.slot <= p->last_base_slot ||
+        !p->epoch || p->epoch_exhausted ||
+        !secondary_ass_physical_interval_valid(p->interval) ||
+        secondary_ass_physical_point_at(&view, base.slot).slot != base.slot ||
+        secondary_ass_physical_point_at(&view, base.slot).wall != base.wall ||
+        secondary_ass_physical_point_at(&view, target.slot).slot != target.slot ||
+        secondary_ass_physical_point_at(&view, target.slot).wall != target.wall)
+        return plan;
+    plan.submit = secondary_ass_physical_submit_time(&view, base.wall);
+    plan.fallback_submit = secondary_ass_physical_submit_time(&view, target.wall);
+    plan.deadline = target.wall;
+    // After a generation/Sync0/mode change, old T cannot identify the next
+    // display cycle.  Waiting until the sampled target wall is conservative.
+    plan.lifecycle_safe_wait = target.wall;
+    plan.valid = plan.submit > 0 && plan.fallback_submit > 0;
+    return plan;
+}
+
+static inline struct secondary_ass_present_plan secondary_ass_present_plan_fresh(
+    const struct secondary_ass_physical *p, int64_t ready,
+    struct secondary_ass_physical_point sampled)
+{
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    // Fresh rendering must follow the ASS sampler's already identified
+    // logical sample slot. Re-predicting from render completion makes a
+    // single CPU/GPU tail cross a vblank boundary, then alternates 1/3-slot
+    // gaps while the clock is otherwise continuous. A late draw is judged
+    // against this immutable target; it must not move the phase forward.
+    struct secondary_ass_physical_point base = {0};
+    if (sampled.slot > view.last_base_slot && sampled.wall > 0 &&
+        secondary_ass_physical_point_at(&view, sampled.slot).slot == sampled.slot &&
+        secondary_ass_physical_point_at(&view, sampled.slot).wall == sampled.wall)
+        base = sampled;
+    else
+        base = secondary_ass_physical_predict_point(&view, ready);
+    int64_t lower = secondary_ass_physical_fifo_lower_bound(&view);
+    struct secondary_ass_physical_point target = base;
+    if (base.slot > 0 && lower > base.slot)
+        target = secondary_ass_physical_point_at(&view, lower);
+    return secondary_ass_present_plan_make(p, base, target);
+}
+
+static inline struct secondary_ass_present_plan secondary_ass_present_plan_cache(
+    const struct secondary_ass_physical *p,
+    struct secondary_ass_physical_point sample)
+{
+    // Cached draws keep the exact original sampler lattice target and wait
+    // inside its preceding Sync1 cycle.  No cache early path is introduced.
+    struct secondary_ass_present_plan plan =
+        secondary_ass_present_plan_make(p, sample, sample);
+    if (plan.fifo_known && plan.fifo_lower > sample.slot)
+        plan.valid = false;
+    return plan;
+}
+
+static inline bool secondary_ass_present_plan_current(
+    const struct secondary_ass_physical *p,
+    const struct secondary_ass_present_plan *plan)
+{
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    int64_t lower = secondary_ass_physical_fifo_lower_bound(&view);
+    return plan->valid && !p->epoch_exhausted && plan->epoch == p->epoch &&
+        plan->generation == p->success_generation &&
+        plan->base.slot > p->last_base_slot &&
+        (lower <= 0 || lower <= plan->target.slot) &&
+        secondary_ass_physical_point_at(&view, plan->target.slot).slot ==
+            plan->target.slot;
+}
+
+static inline struct secondary_ass_physical_point
+secondary_ass_present_plan_cache_next(const struct secondary_ass_physical *p,
+    int64_t first_slot, int64_t divisor, int64_t now)
+{
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    int64_t lower = secondary_ass_physical_fifo_lower_bound(&view);
+    // A count-proven lower bound can rule out an old sampler task.  Select
+    // another point only on the original divided lattice; never rename an
+    // already captured task or change the fresh eligibility base.
+    if (lower > 0 && lower - 1 > view.last_base_slot)
+        view.last_base_slot = lower - 1;
+    return secondary_ass_physical_cache_next(&view, first_slot, divisor, now);
+}
+
+// Forecasting separates the eligibility slot G from the display pose D.
+// The median is captured once for this new task. It does not advance submit
+// time, change the original logical lattice, or reinterpret an existing plan.
+static inline struct secondary_ass_present_plan
+secondary_ass_present_plan_make_forecast(const struct secondary_ass_physical *p,
+    struct secondary_ass_physical_point logical)
+{
+    struct secondary_ass_present_plan none = {.display_forecast = true};
+    if (p->delay < 0 || p->delay > 4 || logical.slot <= 0 ||
+        logical.slot > INT64_MAX - p->delay)
+        return none;
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    int64_t target_slot = logical.slot + p->delay;
+    int64_t lower = secondary_ass_physical_fifo_lower_bound(&view);
+    if (lower > target_slot)
+        target_slot = lower;
+    // The count-proven FIFO horizon is finite, but guard conversion for an
+    // arbitrary malformed logical point instead of truncating its identity.
+    if (target_slot - logical.slot > INT32_MAX)
+        return none;
+    struct secondary_ass_present_plan plan = secondary_ass_present_plan_make(p,
+        logical, secondary_ass_physical_point_at(&view, target_slot));
+    plan.display_forecast = true;
+    plan.captured_forecast = (int)(target_slot - logical.slot);
+    return plan;
+}
+
+static inline struct secondary_ass_present_plan
+secondary_ass_present_plan_fresh_forecast(const struct secondary_ass_physical *p,
+    int64_t ready, struct secondary_ass_physical_point sampled)
+{
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    // A supplied G is authoritative, including an invalid/stale one. Never
+    // replace it using render completion and turn its miss into another task.
+    // The caller separately checks this G against the queued video's raw F.
+    if (!sampled.slot && !sampled.wall)
+        sampled = secondary_ass_physical_predict_point(&view, ready);
+    return secondary_ass_present_plan_make_forecast(p, sampled);
+}
+
+static inline struct secondary_ass_present_plan
+secondary_ass_present_plan_cache_forecast(const struct secondary_ass_physical *p,
+    struct secondary_ass_physical_point sampled)
+{
+    return secondary_ass_present_plan_make_forecast(p, sampled);
+}
+
+static inline struct secondary_ass_physical_point
+secondary_ass_present_plan_cache_next_forecast(
+    const struct secondary_ass_physical *p, int64_t first_slot,
+    int64_t divisor, int64_t now)
+{
+    struct secondary_ass_physical_point none = {0};
+    if (p->delay < 0 || p->delay > 4 || first_slot <= 0 || divisor <= 0 ||
+        now <= 0 || !secondary_ass_physical_interval_valid(p->interval) ||
+        divisor > INT64_MAX / p->interval ||
+        first_slot > INT64_MAX - p->delay)
+        return none;
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    struct secondary_ass_physical_point target =
+        secondary_ass_physical_point_at(&view, first_slot + p->delay);
+    if (!target.slot || target.wall <= 0)
+        return none;
+    int64_t skip = 0;
+    // A logical G may be past while its original future D is still reachable.
+    // Judge expiry at D, with no learned-delay subtraction from its deadline.
+    if (target.wall <= now)
+        skip = (now - target.wall) / (divisor * p->interval) + 1;
+    int64_t floor = p->last_base_slot;
+    int64_t lower = secondary_ass_physical_fifo_lower_bound(&view);
+    if (lower > p->delay && lower - p->delay - 1 > floor)
+        floor = lower - p->delay - 1;
+    if (first_slot <= floor) {
+        int64_t occupied = (floor - first_slot) / divisor + 1;
+        if (occupied > skip)
+            skip = occupied;
+    }
+    if (skip > (INT64_MAX - first_slot - p->delay) / divisor)
+        return none;
+    int64_t logical_slot = first_slot + skip * divisor;
+    // Validate both projections before returning a new logical task. The
+    // sampler still owns the decision to accept its separate display pose.
+    target = secondary_ass_physical_point_at(&view, logical_slot + p->delay);
+    return target.slot ? secondary_ass_physical_point_at(&view, logical_slot)
+                       : none;
+}
+
+// A VO-owned fixed offset is separate from the retrospective delay learner.
+// Cadence and lifecycle identity change explicitly; one timing outlier does
+// not reinitialize this state or choose another offset for a captured task.
+struct secondary_ass_present_fixed_offset {
+    bool valid;
+    int offset;
+    int64_t divisor;
+    double rate;
+    uint64_t epoch, generation;
+};
+
+static inline int secondary_ass_present_fixed_offset_get(
+    struct secondary_ass_present_fixed_offset *fixed,
+    const struct secondary_ass_physical *p,
+    struct secondary_ass_physical_point logical, int64_t divisor, double rate)
+{
+    bool known_rate = isfinite(rate) && rate > 0;
+    if (fixed->valid &&
+        ((p->epoch && fixed->epoch != p->epoch) ||
+         (p->success_generation && fixed->generation != p->success_generation) ||
+         (divisor > 0 && fixed->divisor != divisor) ||
+         (known_rate && fixed->rate != rate)))
+        *fixed = (struct secondary_ass_present_fixed_offset){0};
+    // Unknown identity cannot reset the established offset or revive a plan.
+    // A later identified observation in the same lifecycle retains that offset.
+    if (!p->epoch || !p->success_generation || divisor <= 0 || !known_rate ||
+        p->epoch_exhausted || p->outlier_pending || !p->sync_segment_consistent ||
+        !p->success_contiguous || p->phase <= 0 || p->phase_slot <= 0)
+        return -1;
+    if (!fixed->valid) {
+        struct secondary_ass_present_plan first =
+            secondary_ass_present_plan_make_forecast(p, logical);
+        if (first.valid && first.captured_forecast >= 0 &&
+            first.captured_forecast <= 4)
+            *fixed = (struct secondary_ass_present_fixed_offset){
+                .valid = true, .offset = first.captured_forecast,
+                .epoch = p->epoch, .generation = p->success_generation,
+                .divisor = divisor, .rate = rate,
+            };
+    }
+    return fixed->valid ? fixed->offset : -1;
+}
+
+static inline struct secondary_ass_present_plan
+secondary_ass_present_plan_make_fixed_forecast(
+    const struct secondary_ass_physical *p,
+    struct secondary_ass_physical_point logical, int offset)
+{
+    struct secondary_ass_present_plan none = {.display_forecast = true};
+    if (offset < 0 || offset > 4 || !p->success_generation || !p->success_contiguous ||
+        p->outlier_pending || !p->sync_segment_consistent || logical.slot <= 0 ||
+        logical.slot > INT64_MAX - offset)
+        return none;
+    struct secondary_ass_present_plan plan = secondary_ass_present_plan_make(p,
+        logical, secondary_ass_physical_point_at(p, logical.slot + offset));
+    plan.display_forecast = true;
+    plan.captured_forecast = offset;
+    // The historical base stays G, preserving A-G feedback. The new submit
+    // cycle is D's existing conservative window, not the old G window.
+    plan.submit = plan.fallback_submit;
+    // Keep an unreachable captured D as a miss, rather than moving its pose
+    // off the divided lattice to the next available FIFO position.
+    if (plan.fifo_known && plan.fifo_lower > plan.target.slot)
+        plan.valid = false;
+    return plan;
+}
+
+static inline struct secondary_ass_physical_point
+secondary_ass_present_plan_cache_next_fixed_forecast(
+    const struct secondary_ass_physical *p, int64_t first_slot,
+    int64_t divisor, int64_t now, int offset)
+{
+    if (offset < 0 || offset > 4)
+        return (struct secondary_ass_physical_point){0};
+    // Only selection uses the captured offset. This disposable copy must
+    // never enter registration or feedback, whose original H remains true.
+    struct secondary_ass_physical selection = *p;
+    selection.delay = offset;
+    return secondary_ass_present_plan_cache_next_forecast(&selection,
+                                                         first_slot, divisor, now);
+}
+
+// A new mandatory video draw still needs an advancing ASS pose when optional
+// cache work is unaffordable. Select a new D on the established divided lattice;
+// do not rename an already captured fresh/cache task or reset its clock origin.
+// F remains the video's actual submission/wait boundary, including lifecycle
+// fallback. The recorded G/D and real feedback still reveal any early/late D.
+static inline struct secondary_ass_present_plan
+secondary_ass_present_plan_fresh_clock(const struct secondary_ass_physical *p,
+    struct secondary_ass_physical_point first, int64_t divisor, int offset,
+    int64_t ready, int64_t video_submit)
+{
+    struct secondary_ass_present_plan none = {
+        .display_forecast = true, .fresh_clock_only = true,
+    };
+    if (ready <= 0 || video_submit <= 0 || first.slot <= 0 || first.wall <= 0 ||
+        secondary_ass_physical_point_at(p, first.slot).wall != first.wall)
+        return none;
+    int64_t after = ready > video_submit ? ready : video_submit;
+    struct secondary_ass_physical_point logical =
+        secondary_ass_present_plan_cache_next_fixed_forecast(p, first.slot,
+                                                             divisor, after, offset);
+    struct secondary_ass_present_plan plan =
+        secondary_ass_present_plan_make_fixed_forecast(p, logical, offset);
+    plan.fresh_clock_only = true;
+    if (!plan.valid || plan.target.wall <= after)
+        return none;
+    plan.submit = video_submit;
+    plan.fallback_submit = video_submit;
+    plan.lifecycle_safe_wait = video_submit;
+    return plan;
+}
+
+#endif
diff --git a/video/out/secondary_ass_presentation.h b/video/out/secondary_ass_presentation.h
new file mode 100644
index 0000000000000000000000000000000000000000..4d5a21d97c9fe5ffe3598b945be9e92c8526783d
--- /dev/null
+++ b/video/out/secondary_ass_presentation.h
@@ -0,0 +1,83 @@
+#ifndef MP_SECONDARY_ASS_PRESENTATION_H
+#define MP_SECONDARY_ASS_PRESENTATION_H
+
+#include <stdint.h>
+
+// Independent from the player's video-sync estimator: audio-sync must retain
+// its audio master while animated secondary ASS uses the display's phase.
+struct secondary_ass_presentation {
+    int64_t last_display;
+    int64_t last_target;
+    int64_t interval;
+    int64_t next_draw;
+    int64_t draw_interval;
+};
+
+static inline int64_t secondary_ass_predict_present(
+    struct secondary_ass_presentation *p, int64_t now, int64_t interval)
+{
+    if (interval <= 0)
+        interval = 1000000000 / 60;
+    // A monitor/rate change invalidates the old display lattice, not the media
+    // clock. Avoid reusing a timestamp many refreshes into an unrelated queue.
+    if (p->interval && (interval > p->interval + p->interval / 100 ||
+                       interval < p->interval - p->interval / 100))
+    {
+        p->last_display = p->last_target = 0;
+    }
+    p->interval = interval;
+    int64_t base = p->last_display > 0 ? p->last_display : p->last_target;
+    int64_t target = base > 0 ? base + interval : now + interval;
+    if (p->last_target > 0 && target <= p->last_target)
+        target = p->last_target + interval;
+    if (target < now)
+        target += ((now - target) / interval + 1) * interval;
+    if (target > now + 1000000000)
+        target = now + interval;
+    p->last_target = target;
+    return target;
+}
+
+static inline void secondary_ass_present_feedback(
+    struct secondary_ass_presentation *p, int64_t displayed)
+{
+    // Missing/sparse feedback must not invent a CPU flip-time display phase.
+    p->last_display = displayed > 0 ? displayed : p->last_target;
+}
+
+static inline int64_t secondary_ass_sample_prepare_time(
+    int64_t sample_wall, int64_t vsync_interval)
+{
+    if (sample_wall <= 0 || vsync_interval <= 0)
+        return 0;
+    // Match the sampler's half-vsync selection boundary. Preparing a full
+    // vsync early can submit the previous sample and consume the only redraw
+    // before a source-frame deadline. Cross the boundary by one ns to avoid
+    // integer/nearest-grid rounding selecting the previous tick.
+    int64_t lead = vsync_interval / 2;
+    return sample_wall - lead + (lead > 0);
+}
+
+static inline int64_t secondary_ass_next_draw(
+    struct secondary_ass_presentation *p, int64_t now, int64_t interval)
+{
+    if (interval <= 0)
+        interval = 1;
+    if (!p->next_draw || p->draw_interval != interval) {
+        p->next_draw = now + interval;
+        p->draw_interval = interval;
+    }
+    return p->next_draw;
+}
+
+static inline void secondary_ass_consume_draw(
+    struct secondary_ass_presentation *p, int64_t now)
+{
+    // A source-video frame can consume a due slot, but must not restart the
+    // secondary cadence. Advance missed slots without a catch-up redraw burst.
+    if (p->draw_interval > 0 && p->next_draw <= now)
+        p->next_draw += ((now - p->next_draw) / p->draw_interval + 1) *
+                        p->draw_interval;
+}
+
+#endif
diff --git a/video/out/secondary_ass_queue_lead.h b/video/out/secondary_ass_queue_lead.h
new file mode 100644
index 0000000000000000000000000000000000000000..07748e8c9243b3b16aad770a4eeab795406d321d
--- /dev/null
+++ b/video/out/secondary_ass_queue_lead.h
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_QUEUE_LEAD_H
+#define MP_SECONDARY_ASS_QUEUE_LEAD_H
+
+#include "secondary_ass_present_plan.h"
+#include "../../sub/secondary_ass_clock.h"
+
+struct secondary_ass_queue_hint {
+    bool valid;
+    uint64_t retained_id;
+    int64_t duration, earliest_redraw;
+    struct secondary_ass_sample_snapshot sample;
+    struct secondary_ass_physical physical;
+};
+
+struct secondary_ass_queue_token {
+    bool valid;
+    uint64_t retained_id;
+    int64_t fresh_due, old_lead, old_admission, admission;
+    struct secondary_ass_sample_snapshot sample;
+    struct secondary_ass_present_plan plan;
+};
+
+static inline bool secondary_ass_sample_snapshot_equal(
+    const struct secondary_ass_sample_snapshot *a,
+    const struct secondary_ass_sample_snapshot *b)
+{
+    return a->valid && b->valid && !a->held && !b->held && !a->force && !b->force &&
+        isfinite(a->rate) && isfinite(a->speed) && isfinite(a->requested_speed) &&
+        a->rate > 0 && a->speed > 0 && a->requested_speed > 0 &&
+        a->rate == b->rate && a->speed == b->speed &&
+        a->requested_speed == b->requested_speed && a->epoch == b->epoch &&
+        a->next_slot == b->next_slot && a->next_wall == b->next_wall &&
+        a->divisor == b->divisor && a->phase_wall == b->phase_wall &&
+        a->phase_slot == b->phase_slot && a->interval == b->interval;
+}
+
+static inline struct secondary_ass_queue_token secondary_ass_queue_lead_make(
+    const struct secondary_ass_queue_hint *hint,
+    const struct secondary_ass_sample_snapshot *sample,
+    int64_t fresh_due, int64_t old_lead, int64_t maximum_lead,
+    int64_t redraw_cost)
+{
+    struct secondary_ass_queue_token token = {0};
+    const struct secondary_ass_physical *p = &hint->physical;
+    if (!hint->valid || !hint->retained_id || old_lead <= 0 ||
+        maximum_lead <= old_lead || fresh_due <= maximum_lead ||
+        !secondary_ass_sample_snapshot_equal(&hint->sample, sample) ||
+        !p->success_contiguous || !p->success_generation || p->outlier_pending ||
+        !secondary_ass_physical_interval_valid(p->interval) ||
+        sample->epoch != p->epoch ||
+        sample->divisor <= 0 || sample->divisor > INT64_MAX / p->interval ||
+        hint->duration < sample->divisor * p->interval)
+        return token;
+    struct secondary_ass_physical_point point =
+        secondary_ass_physical_point_at(p, sample->next_slot);
+    // The sampler owns logical opportunity identity. Feedback may reanchor or
+    // refine the physical coordinates between draws; secondary_next_sample()
+    // also projects this integer slot through the latest physical state.
+    // Keep the raw snapshot for coherence, without interpreting its old wall
+    // coordinates as the current display model.
+    if (point.wall < fresh_due)
+        return token;
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    int64_t prepare = secondary_ass_physical_render_slot_time(&view,
+        point.wall, redraw_cost);
+    int64_t old_admission = fresh_due - old_lead;
+    // Even a cache slot at/after F must not change cache->fresh event order.
+    // Exact ties belong to the original path. This rejects the 5 ms redraw
+    // counterexample where an earlier queue consumes cache 110 as fresh 110.
+    if (prepare <= old_admission || hint->earliest_redraw >= point.wall)
+        return token;
+    struct secondary_ass_present_plan plan =
+        secondary_ass_present_plan_fresh(p, fresh_due, point);
+    if (!plan.valid || plan.base.slot != point.slot ||
+        plan.target.slot != point.slot || !plan.fifo_known ||
+        !secondary_ass_present_plan_current(p, &plan))
+        return token;
+    int64_t lead = sample->divisor * p->interval;
+    if (lead > INT64_MAX - 2000000)
+        return token;
+    lead += 2000000;
+    if (lead > maximum_lead)
+        lead = maximum_lead;
+    if (lead <= old_lead)
+        return token;
+    return (struct secondary_ass_queue_token){
+        .valid = true, .retained_id = hint->retained_id,
+        .fresh_due = fresh_due, .old_lead = old_lead,
+        .old_admission = old_admission, .admission = fresh_due - lead,
+        .sample = *sample, .plan = plan,
+    };
+}
+
+static inline bool secondary_ass_queue_lead_current(
+    const struct secondary_ass_queue_token *token,
+    const struct secondary_ass_sample_snapshot *sample,
+    const struct secondary_ass_physical *p, uint64_t retained_id,
+    int64_t fresh_due, int64_t redraw_cost)
+{
+    if (!token->valid || token->retained_id != retained_id ||
+        token->fresh_due != fresh_due ||
+        !secondary_ass_sample_snapshot_equal(&token->sample, sample) ||
+        !p->success_contiguous || !p->sync_segment_consistent || p->outlier_pending ||
+        p->interval != token->plan.interval ||
+        !secondary_ass_present_plan_current(p, &token->plan))
+        return false;
+    // A different anchor for the exact same lattice is harmless. A changed
+    // captured wall or period is not: do not retarget the already chosen D/S.
+    if (secondary_ass_physical_point_at(p, token->plan.base.slot).wall !=
+            token->plan.base.wall ||
+        secondary_ass_physical_point_at(p, token->plan.target.slot).wall !=
+            token->plan.target.wall)
+        return false;
+    struct secondary_ass_physical view = secondary_ass_present_plan_view(p);
+    return secondary_ass_physical_render_slot_time(&view,
+        token->plan.base.wall, redraw_cost) > token->old_admission;
+}
+
+#endif
diff --git a/video/out/secondary_ass_queue_stage.h b/video/out/secondary_ass_queue_stage.h
new file mode 100644
index 0000000000000000000000000000000000000000..a45df6bb1ab24f7035a1c8ff1e5b9e6b552662fb
--- /dev/null
+++ b/video/out/secondary_ass_queue_stage.h
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_QUEUE_STAGE_H
+#define MP_SECONDARY_ASS_QUEUE_STAGE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+// Early ownership of one real video frame is separate from its normal render
+// admission. This scalar contract contains no physical clock, sample rate,
+// learned delay, waiting primitive or permission to invent a future frame.
+struct secondary_ass_queue_stage {
+    bool valid, bound;
+    uint64_t retained_id, queued_id;
+    int64_t pts, offset, due, old_lead, max_lead, admission, resume;
+};
+
+static inline struct secondary_ass_queue_stage secondary_ass_queue_stage_make(
+    uint64_t retained_id, int64_t pts, int64_t offset, int64_t old_lead,
+    int64_t max_lead)
+{
+    // Restore at most the standard 50 ms queue lead. An option with a smaller
+    // cap stays smaller; a larger value cannot enlarge this staging window.
+    const int64_t cap = 50000000;
+    if (max_lead > cap)
+        max_lead = cap;
+    if (!retained_id || pts <= 0 || offset < 0 || old_lead <= 0 ||
+        max_lead <= old_lead || pts <= offset)
+        return (struct secondary_ass_queue_stage){0};
+
+    // Both operands are nonnegative and pts > offset. Every subtraction is
+    // consequently in [1, INT64_MAX]; no timestamp addition is necessary.
+    int64_t due = pts - offset;
+    if (due <= max_lead)
+        return (struct secondary_ass_queue_stage){0};
+    return (struct secondary_ass_queue_stage){
+        .valid = true, .retained_id = retained_id,
+        .pts = pts, .offset = offset, .due = due,
+        .old_lead = old_lead, .max_lead = max_lead,
+        .admission = due - max_lead, .resume = due - old_lead,
+    };
+}
+
+// Validate the recorded scalar arithmetic rather than trusting a caller's
+// valid bit or reusing a malformed deadline from another admission.
+static inline bool secondary_ass_queue_stage_sane(
+    const struct secondary_ass_queue_stage *stage)
+{
+    if (!stage || !stage->valid)
+        return false;
+    struct secondary_ass_queue_stage expected = secondary_ass_queue_stage_make(
+        stage->retained_id, stage->pts, stage->offset,
+        stage->old_lead, stage->max_lead);
+    return expected.valid && stage->max_lead == expected.max_lead &&
+        stage->due == expected.due && stage->admission == expected.admission &&
+        stage->resume == expected.resume;
+}
+
+// Bind only after vo_queue_frame accepted the actual frame. Recompute from
+// that frame's real pts/offset; a provisional core deadline is never carried
+// forward as an immutable promise. The VO caller must separately verify
+// now >= admission and its paused/reset/reconfiguration eligibility.
+static inline struct secondary_ass_queue_stage secondary_ass_queue_stage_bind(
+    const struct secondary_ass_queue_stage *admission, uint64_t retained_id,
+    uint64_t queued_id, int64_t pts, int64_t offset)
+{
+    if (!secondary_ass_queue_stage_sane(admission) || admission->bound ||
+        admission->queued_id || admission->retained_id != retained_id ||
+        queued_id <= retained_id)
+        return (struct secondary_ass_queue_stage){0};
+    struct secondary_ass_queue_stage stage = secondary_ass_queue_stage_make(
+        retained_id, pts, offset, admission->old_lead, admission->max_lead);
+    if (stage.valid) {
+        stage.bound = true;
+        stage.queued_id = queued_id;
+    }
+    return stage;
+}
+
+// Any identity/offset/pts mismatch removes staging authority. The VO caller
+// clears it and returns to its normal queued flow; an old resume must never
+// be transplanted onto a different frame. This function does not mutate or
+// wait for the producer, including when a queued frame has disappeared.
+static inline bool secondary_ass_queue_stage_current(
+    const struct secondary_ass_queue_stage *stage, uint64_t retained_id,
+    uint64_t queued_id, int64_t pts, int64_t offset)
+{
+    return secondary_ass_queue_stage_sane(stage) && stage->bound &&
+        queued_id > retained_id && stage->retained_id == retained_id &&
+        stage->queued_id == queued_id && stage->pts == pts &&
+        stage->offset == offset;
+}
+
+static inline void secondary_ass_queue_stage_clear(
+    struct secondary_ass_queue_stage *stage)
+{
+    if (stage)
+        *stage = (struct secondary_ass_queue_stage){0};
+}
+
+#endif
diff --git a/video/out/secondary_ass_stage_prefix.h b/video/out/secondary_ass_stage_prefix.h
new file mode 100644
index 0000000000000000000000000000000000000000..fc0bc52cc5d6d5f20d7c531867b62d70c2a02715
--- /dev/null
+++ b/video/out/secondary_ass_stage_prefix.h
@@ -0,0 +1,269 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_STAGE_PREFIX_H
+#define MP_SECONDARY_ASS_STAGE_PREFIX_H
+
+#include "secondary_ass_queue_stage.h"
+#include "secondary_ass_present_plan.h"
+#include "../../sub/secondary_ass_clock.h"
+
+// VO-thread-owned permission for one bound stage. It tracks only continuous
+// successful cache submissions after the initial cursor. It does not change
+// the sampler, physical ledger, phase, learned delay, stage F or finite resume.
+struct secondary_ass_stage_prefix {
+    bool initialized, valid;
+    struct secondary_ass_queue_stage stage;
+    struct secondary_ass_sample_snapshot grid;
+    uint64_t generation, first_id, last_id;
+    int64_t next_slot;
+};
+
+static inline void secondary_ass_stage_prefix_clear(
+    struct secondary_ass_stage_prefix *prefix)
+{
+    if (prefix)
+        *prefix = (struct secondary_ass_stage_prefix){0};
+}
+
+// Failure is sticky for this bound stage. Clear only when that stage ends;
+// a later sampler cursor must not silently restart early-prepare permission.
+static inline void secondary_ass_stage_prefix_invalidate(
+    struct secondary_ass_stage_prefix *prefix)
+{
+    if (prefix)
+        prefix->valid = false;
+}
+
+static inline bool secondary_ass_stage_prefix_snapshot_valid(
+    const struct secondary_ass_sample_snapshot *sample)
+{
+    if (!sample || !sample->valid || sample->held || sample->force ||
+        sample->sample_forced || !sample->display_forecast ||
+        !isfinite(sample->rate) || !isfinite(sample->speed) ||
+        !isfinite(sample->requested_speed) || sample->rate <= 0 ||
+        sample->speed <= 0 || sample->requested_speed <= 0 || !sample->epoch ||
+        sample->divisor <= 0 || sample->origin_slot <= 0 ||
+        sample->sample_slot < sample->origin_slot ||
+        sample->sample_slot > INT64_MAX - sample->divisor ||
+        sample->next_slot != sample->sample_slot + sample->divisor ||
+        (sample->sample_slot - sample->origin_slot) % sample->divisor ||
+        !secondary_ass_physical_interval_valid(sample->interval) ||
+        sample->divisor > INT64_MAX / sample->interval)
+        return false;
+    struct secondary_ass_physical projection = {
+        .phase = sample->phase_wall, .phase_slot = sample->phase_slot,
+        .interval = sample->interval,
+    };
+    struct secondary_ass_physical_point next =
+        secondary_ass_physical_point_at(&projection, sample->next_slot);
+    return next.slot == sample->next_slot && next.wall > 0 &&
+        next.wall == sample->next_wall;
+}
+
+static inline bool secondary_ass_stage_prefix_grid_equal(
+    const struct secondary_ass_sample_snapshot *a,
+    const struct secondary_ass_sample_snapshot *b)
+{
+    // Ordinary feedback can refine the slot-to-wall projection. Grid/speed
+    // identity and integer cursor stay fixed; do not compare anchor bytes.
+    return secondary_ass_stage_prefix_snapshot_valid(a) &&
+        secondary_ass_stage_prefix_snapshot_valid(b) &&
+        a->epoch == b->epoch && a->divisor == b->divisor &&
+        a->origin_slot == b->origin_slot &&
+        a->display_forecast == b->display_forecast &&
+        a->rate == b->rate && a->speed == b->speed &&
+        a->requested_speed == b->requested_speed;
+}
+
+static inline bool secondary_ass_stage_prefix_physical_ready(
+    const struct secondary_ass_physical *p)
+{
+    return p && p->epoch && !p->epoch_exhausted && !p->outlier_pending &&
+        p->sync_segment_consistent && p->success_contiguous &&
+        p->success_generation && p->success_first_id &&
+        p->success_last_id >= p->success_first_id &&
+        p->historical_id && p->historical_id <= p->success_last_id &&
+        p->last_submit_id == p->success_last_id && p->last_base_slot > 0 &&
+        p->phase > 0 && p->phase_slot > 0 && p->sync_slot > 0 &&
+        p->sync_qpc_ns > 0 &&
+        secondary_ass_physical_interval_valid(p->interval) && p->next < 32;
+}
+
+static inline bool secondary_ass_stage_prefix_registered(
+    const struct secondary_ass_physical *p, uint64_t id, int64_t expected_base,
+    const struct secondary_ass_present_plan *captured)
+{
+    if (!secondary_ass_stage_prefix_physical_ready(p) || !id ||
+        id != p->success_last_id || expected_base <= 0 ||
+        p->last_base_slot != expected_base)
+        return false;
+    unsigned matches = 0;
+    for (unsigned n = 0; n < 32; n++) {
+        if (p->submitted[n].id != id)
+            continue;
+        if (p->submitted[n].base_slot != expected_base ||
+            p->submitted[n].base <= 0 || p->submitted[n].gap_excluded ||
+            p->submitted[n].target_slot < expected_base ||
+            (p->history_floor_slot && expected_base < p->history_floor_slot) ||
+            (captured && (p->submitted[n].base != captured->base.wall ||
+                          p->submitted[n].target_slot != captured->target.slot)))
+            return false;
+        matches++;
+    }
+    return matches == 1;
+}
+
+// History may lag the current submission. If an ID already belongs to this
+// prefix, a known different display slot is a real MISS, not more permission.
+// Missing/duplicated history registration inside the prefix is also unknown.
+static inline bool secondary_ass_stage_prefix_history_safe(
+    const struct secondary_ass_physical *p, uint64_t first_id, uint64_t last_id)
+{
+    if (!p || !first_id || last_id < first_id)
+        return false;
+    if (p->historical_id < first_id)
+        return true;
+    if (p->historical_id > last_id)
+        return false;
+    unsigned matches = 0;
+    for (unsigned n = 0; n < 32; n++) {
+        if (p->submitted[n].id != p->historical_id)
+            continue;
+        if (p->submitted[n].gap_excluded || p->submitted[n].target_slot <= 0 ||
+            p->submitted[n].target_slot != p->phase_slot)
+            return false;
+        matches++;
+    }
+    return matches == 1;
+}
+
+static inline bool secondary_ass_stage_prefix_stage_equal(
+    const struct secondary_ass_queue_stage *a,
+    const struct secondary_ass_queue_stage *b)
+{
+    return secondary_ass_queue_stage_sane(a) &&
+        secondary_ass_queue_stage_sane(b) && a->bound && b->bound &&
+        a->queued_id > a->retained_id && b->queued_id > b->retained_id &&
+        a->retained_id == b->retained_id && a->queued_id == b->queued_id &&
+        a->pts == b->pts && a->offset == b->offset && a->due == b->due &&
+        a->old_lead == b->old_lead && a->max_lead == b->max_lead &&
+        a->admission == b->admission && a->resume == b->resume;
+}
+
+// Call once in the VO thread after accepting the bound stage, with one OSD
+// snapshot and that thread's current physical ledger. Do not read physical
+// state from the core-side bind. The caller owns identity/reset/budget checks.
+static inline bool secondary_ass_stage_prefix_begin(
+    struct secondary_ass_stage_prefix *prefix,
+    const struct secondary_ass_queue_stage *stage,
+    const struct secondary_ass_sample_snapshot *sample,
+    const struct secondary_ass_physical *p)
+{
+    if (!prefix || prefix->initialized)
+        return false;
+    prefix->initialized = true;
+    prefix->valid = false;
+    if (!secondary_ass_stage_prefix_stage_equal(stage, stage))
+        return false;
+    // A bound stage's failed first proof remains this same stage's failure.
+    // The VO compares this identity before deciding that the stage ended.
+    prefix->stage = *stage;
+    if (!secondary_ass_stage_prefix_snapshot_valid(sample) ||
+        !secondary_ass_stage_prefix_physical_ready(p) || sample->epoch != p->epoch)
+        return false;
+    int64_t previous = sample->next_slot - sample->divisor;
+    if (sample->sample_slot != previous ||
+        !secondary_ass_stage_prefix_registered(p, p->success_last_id,
+                                               previous, NULL) ||
+        !secondary_ass_stage_prefix_history_safe(p, p->success_last_id,
+                                                 p->success_last_id))
+        return false;
+    prefix->grid = *sample;
+    prefix->generation = p->success_generation;
+    prefix->first_id = p->success_last_id;
+    prefix->last_id = p->success_last_id;
+    prefix->next_slot = sample->next_slot;
+    prefix->valid = true;
+    return true;
+}
+
+// Resolve exactly one captured cache opportunity after Present/registration.
+// The caller passes actual success, not draw_frame's return or sampler change.
+// Before belongs to this captured attempt; after is taken after feedback.
+// A force/reset observed during the actual OSD draw must be passed as missed
+// (or invalidate first): it cannot be recovered from a cleared after.force.
+// Skips, MISS, force, failed/unregistered/repeated Presents revoke permission;
+// this minimal version never grants again from an expired-MISS disposition.
+static inline bool secondary_ass_stage_prefix_resolve(
+    struct secondary_ass_stage_prefix *prefix,
+    const struct secondary_ass_present_plan *captured, bool submit_success,
+    bool missed, uint64_t submit_id,
+    const struct secondary_ass_sample_snapshot *before,
+    const struct secondary_ass_sample_snapshot *sample,
+    const struct secondary_ass_physical *p)
+{
+    if (!prefix || !prefix->initialized || !prefix->valid)
+        return false;
+    bool valid = captured && captured->valid && captured->display_forecast &&
+        submit_success && !missed &&
+        secondary_ass_stage_prefix_grid_equal(&prefix->grid, before) &&
+        before->next_slot == prefix->next_slot &&
+        before->sample_slot == prefix->next_slot - prefix->grid.divisor &&
+        secondary_ass_stage_prefix_grid_equal(&prefix->grid, sample) &&
+        secondary_ass_stage_prefix_physical_ready(p) &&
+        captured->epoch == prefix->grid.epoch && p->epoch == prefix->grid.epoch &&
+        captured->generation == prefix->generation &&
+        p->success_generation == prefix->generation &&
+        captured->base.slot == prefix->next_slot && captured->base.wall > 0 &&
+        captured->target.slot >= captured->base.slot &&
+        captured->target.wall >= captured->base.wall &&
+        captured->base.slot <= INT64_MAX - prefix->grid.divisor &&
+        sample->next_slot == captured->base.slot + prefix->grid.divisor &&
+        sample->sample_slot == captured->base.slot &&
+        prefix->last_id < UINT64_MAX && submit_id == prefix->last_id + 1 &&
+        secondary_ass_stage_prefix_history_safe(p, prefix->first_id, submit_id) &&
+        secondary_ass_stage_prefix_registered(p, submit_id,
+                                               captured->base.slot, captured);
+    if (!valid) {
+        secondary_ass_stage_prefix_invalidate(prefix);
+        return false;
+    }
+    prefix->last_id = submit_id;
+    prefix->next_slot = sample->next_slot;
+    return true;
+}
+
+// False at G<F means park/service the original cache, not a permanent failure.
+// Bad identity/proof is sticky. The VO still checks budget/reset/visibility,
+// stage admission/resume and final Sync1 guard, then keeps the original G S.
+static inline bool secondary_ass_stage_prefix_can_promote(
+    struct secondary_ass_stage_prefix *prefix,
+    const struct secondary_ass_queue_stage *stage,
+    const struct secondary_ass_sample_snapshot *sample,
+    const struct secondary_ass_physical *p)
+{
+    if (!prefix || !prefix->initialized || !prefix->valid)
+        return false;
+    bool valid = secondary_ass_stage_prefix_stage_equal(&prefix->stage, stage) &&
+        secondary_ass_stage_prefix_grid_equal(&prefix->grid, sample) &&
+        secondary_ass_stage_prefix_physical_ready(p) &&
+        p->epoch == prefix->grid.epoch &&
+        p->success_generation == prefix->generation &&
+        secondary_ass_stage_prefix_history_safe(p, prefix->first_id, prefix->last_id) &&
+        p->success_last_id == prefix->last_id && sample->next_slot == prefix->next_slot &&
+        sample->sample_slot == prefix->next_slot - prefix->grid.divisor &&
+        secondary_ass_stage_prefix_registered(p, prefix->last_id,
+            prefix->next_slot - prefix->grid.divisor, NULL);
+    if (!valid) {
+        secondary_ass_stage_prefix_invalidate(prefix);
+        return false;
+    }
+    struct secondary_ass_physical_point current =
+        secondary_ass_physical_point_at(p, prefix->next_slot);
+    if (current.slot != prefix->next_slot || current.wall <= 0) {
+        secondary_ass_stage_prefix_invalidate(prefix);
+        return false;
+    }
+    return current.wall >= stage->due;
+}
