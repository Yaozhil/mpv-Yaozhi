+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "sub/secondary_ass_clock.h"
+#include "video/out/secondary_ass_present_plan.h"
+
+// These are actual header calls, including the production feedback order.
+// Synthetic display/count inputs exercise logic; they are not GPU evidence.
+// Keep checks active in NDEBUG builds as well as ordinary test builds.
+static unsigned long long checks, chain_frames;
+#define CHECK(x) do { checks++; if (!(x)) { \
+    fprintf(stderr, "forecast check %llu failed at %d: %s\n", \
+            checks, __LINE__, #x); exit(2); } } while (0)
+
+static const int64_t origin = INT64_C(1000000000);
+
+static struct secondary_ass_physical state(int64_t T, int H)
+{
+    return (struct secondary_ass_physical){
+        .phase = origin, .phase_slot = 100, .interval = T, .epoch = 7,
+        .sync_qpc_ns = origin, .sync_count = 100, .sync_slot = 100,
+        .sync_segment_consistent = true,
+        .measure_qpc_ns = origin, .measure_count = 100,
+        .periods = {T, T, T}, .period_count = 3, .period_next = 3,
+        .delay = H, .delay_samples = {H, H, H}, .delay_count = 3,
+        .success_generation = 3,
+    };
+}
+
+static struct secondary_ass_clock clock_state(void)
+{
+    return (struct secondary_ass_clock){
+        .valid = true, .pts = 10, .speed = 1, .wall = origin,
+    };
+}
+
+static bool sample(struct secondary_ass_sampler *s,
+    const struct secondary_ass_clock *c,
+    const struct secondary_ass_physical *p,
+    const struct secondary_ass_present_plan *plan, int64_t divisor)
+{
+    double rate = s->valid && s->display_forecast
+        ? s->rate : 1e9 / (p->interval * divisor);
+    return secondary_ass_sampler_update_physical_forecast(s, c,
+        rate, plan->target.wall, plan->base.slot,
+        plan->target.slot, p->phase, p->phase_slot, p->interval, p->epoch);
+}
+
+static void feedback(struct secondary_ass_physical *p,
+    const struct secondary_ass_present_plan *plan, uint64_t id,
+    struct secondary_ass_physical_point actual)
+{
+    // This is the real secondary_physical_feedback ordering: immutable
+    // registration, observed raw Sync/Present feedback, successful Present.
+    CHECK(secondary_ass_physical_submit_planned_point(p, id, plan->epoch,
+                                                     plan->base, plan->target));
+    secondary_ass_physical_update_observed(p, false, id, plan->target,
+        actual.wall, actual.wall, (uint32_t)actual.slot, (uint32_t)actual.slot,
+        id, p->interval);
+    secondary_ass_physical_record_present(p, true, id, 3, 1);
+    unsigned saved = (p->next + 31) % 32;
+    CHECK(p->submitted[saved].id == id);
+    CHECK(p->submitted[saved].base_slot == plan->base.slot);
+    CHECK(p->submitted[saved].base == plan->base.wall);
+    CHECK(p->submitted[saved].target_slot == plan->target.slot);
+    CHECK(p->last_submit_id == id && p->historical_id == id);
+    CHECK(p->phase_slot == actual.slot && p->phase == actual.wall);
+    chain_frames++;
+}
+
+static void steady_chain(int Hz, int64_t N, int H)
+{
+    int64_t T = INT64_C(1000000000) / Hz;
+    struct secondary_ass_physical p = state(T, H);
+    struct secondary_ass_clock c = clock_state();
+    struct secondary_ass_sampler s = {0};
+    const int64_t first = 110;
+    // Cover three minutes of logical display time per rate/divisor/regime.
+    // This is accelerated CPU time, not three minutes of real scanout.
+    int ticks = Hz * 180 / (int)N;
+    for (int k = 0; k < ticks; k++) {
+        int64_t G = first + k * N;
+        struct secondary_ass_physical_point g = secondary_ass_physical_point_at(&p, G);
+        struct secondary_ass_physical before = p;
+        struct secondary_ass_present_plan plan = k % 3 == 0
+            ? secondary_ass_present_plan_fresh_forecast(&p, g.wall + 2 * T, g)
+            : secondary_ass_present_plan_cache_forecast(&p, g);
+        CHECK(!memcmp(&p, &before, sizeof(p)));
+        CHECK(plan.valid && plan.display_forecast);
+        CHECK(plan.base.slot == G && plan.target.slot == G + H);
+        CHECK(plan.base.wall == g.wall && plan.target.wall == g.wall + H * T);
+        CHECK(plan.historical_delay == H && plan.captured_forecast == H);
+        CHECK(plan.submit == g.wall - T + (T / 4 < 1000000 ? T / 4 : 1000000));
+        CHECK(plan.deadline == plan.target.wall);
+        CHECK(secondary_ass_present_plan_current(&p, &plan));
+        CHECK(sample(&s, &c, &p, &plan, N));
+        CHECK(s.display_forecast && s.origin_slot == first);
+        CHECK(s.origin_wall == origin + (first - 100) * T);
+        CHECK(s.tick == (uint64_t)k && s.display_slot == G + H);
+        CHECK(s.sample_wall == plan.target.wall);
+        CHECK(fabs(s.pts - secondary_ass_clock_sample(&c, plan.target.wall)) < 1e-12);
+        CHECK(secondary_ass_sampler_next_slot(&s) == G + N);
+        CHECK(secondary_ass_sampler_next_wall(&s) == g.wall + N * T);
+        struct secondary_ass_sampler saved = s;
+        CHECK(!sample(&s, &c, &p, &plan, N));
+        CHECK(s.tick == saved.tick && s.display_slot == saved.display_slot &&
+              s.sample_wall == saved.sample_wall && s.pts == saved.pts);
+        feedback(&p, &plan, (uint64_t)k + 1, plan.target);
+        CHECK(p.delay == H && p.epoch == 7 && !p.outlier_pending);
+        CHECK(s.origin_slot == first && s.tick == (uint64_t)k);
+        struct secondary_ass_physical_point next =
+            secondary_ass_present_plan_cache_next_forecast(&p, G + N, N,
+                                                           g.wall + (N - 1) * T);
+        CHECK(next.slot == G + N);
+    }
+}
+
+static void forecasts_and_fifo(int64_t T)
+{
+    struct secondary_ass_physical p = state(T, 2);
+    struct secondary_ass_physical_point g = secondary_ass_physical_point_at(&p, 110);
+    struct secondary_ass_present_plan plan = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(plan.valid && plan.base.slot == 110 && plan.target.slot == 112);
+    CHECK(plan.captured_forecast == 2 && plan.historical_delay == 2);
+    p.delay = 0; // Later feedback cannot reinterpret captured G, D or S.
+    CHECK(plan.base.slot == 110 && plan.target.slot == 112);
+    CHECK(plan.submit == g.wall - T + (T / 4 < 1000000 ? T / 4 : 1000000));
+    feedback(&p, &plan, 1, plan.target);
+    CHECK(p.submitted[0].base_slot == 110 && p.submitted[0].target_slot == 112);
+
+    p = state(T, 1);
+    p.last_base_slot = 99;
+    p.historical_id = 10;
+    p.success_first_id = 11;
+    p.success_last_id = 13;
+    p.success_contiguous = true;
+    g = secondary_ass_physical_point_at(&p, 100);
+    plan = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(plan.valid && plan.fifo_known && plan.fifo_lower == 104);
+    CHECK(plan.base.slot == 100 && plan.target.slot == 104);
+    CHECK(plan.historical_delay == 1 && plan.captured_forecast == 4);
+    CHECK(plan.submit == g.wall - T + (T / 4 < 1000000 ? T / 4 : 1000000));
+    struct secondary_ass_physical_point next =
+        secondary_ass_present_plan_cache_next_forecast(&p, 100, 2, g.wall - T);
+    CHECK(next.slot == 104); // lower-H=103, preserve the original even lattice.
+    plan = secondary_ass_present_plan_cache_forecast(&p, next);
+    CHECK(plan.valid && plan.target.slot == 105 && plan.captured_forecast == 1);
+
+    p = state(T, 2);
+    g = secondary_ass_physical_point_at(&p, 110);
+    next = secondary_ass_present_plan_cache_next_forecast(&p, 110, 2, g.wall + T / 2);
+    CHECK(next.slot == 110); // G has passed, but D112 has not expired.
+    next = secondary_ass_present_plan_cache_next_forecast(&p, 110, 2, g.wall + 2 * T - 1);
+    CHECK(next.slot == 110);
+    next = secondary_ass_present_plan_cache_next_forecast(&p, 110, 2, g.wall + 2 * T);
+    CHECK(next.slot == 112); // Exact D boundary is a real miss, not a relabel.
+    p.last_base_slot = 112;
+    next = secondary_ass_present_plan_cache_next_forecast(&p, 110, 2, g.wall - T);
+    CHECK(next.slot == 114);
+    plan = secondary_ass_present_plan_fresh_forecast(&p, g.wall + 20 * T, g);
+    CHECK(!plan.valid && plan.base.slot == g.slot); // No completion-time rescue.
+    plan = secondary_ass_present_plan_fresh_forecast(&p, g.wall + T, (struct secondary_ass_physical_point){0});
+    CHECK(plan.valid && plan.base.slot > p.last_base_slot);
+    g.wall++;
+    CHECK(!secondary_ass_present_plan_fresh_forecast(&p, g.wall, g).valid);
+}
+
+static void sampler_changes(int64_t T)
+{
+    struct secondary_ass_physical p = state(T, 1);
+    struct secondary_ass_clock c = clock_state();
+    struct secondary_ass_sampler s = {0};
+    struct secondary_ass_physical_point g = secondary_ass_physical_point_at(&p, 110);
+    struct secondary_ass_present_plan a = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(sample(&s, &c, &p, &a, 1));
+    struct secondary_ass_physical reverse = p;
+    reverse.phase -= 3 * T;
+    struct secondary_ass_present_plan backwards = secondary_ass_present_plan_make_forecast(&reverse,
+        secondary_ass_physical_point_at(&reverse, 112));
+    CHECK(backwards.valid && backwards.target.slot > s.display_slot);
+    CHECK(backwards.target.wall < s.sample_wall);
+    CHECK(!sample(&s, &c, &reverse, &backwards, 1));
+    CHECK(s.tick == 0 && s.display_slot == 111 && s.sample_wall == a.target.wall);
+    p.delay = 3;
+    struct secondary_ass_present_plan b = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(!sample(&s, &c, &p, &b, 1));
+    CHECK(s.tick == 0 && s.display_slot == 111 && s.sample_wall == a.target.wall);
+    s.force = true;
+    CHECK(sample(&s, &c, &p, &b, 1));
+    CHECK(s.tick == 0 && s.display_slot == 111 && s.sample_wall == a.target.wall && !s.force);
+    p.delay = 0;
+    g = secondary_ass_physical_point_at(&p, 111);
+    b = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(!sample(&s, &c, &p, &b, 1)); // D111 collides, task remains a MISS.
+    CHECK(s.tick == 0 && s.display_slot == 111 && s.origin_slot == 110);
+    g = secondary_ass_physical_point_at(&p, 112);
+    b = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(sample(&s, &c, &p, &b, 1));
+    CHECK(s.tick == 2 && s.display_slot == 112 && s.origin_slot == 110);
+    p.delay = 2;
+    g = secondary_ass_physical_point_at(&p, 113);
+    b = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(sample(&s, &c, &p, &b, 1));
+    CHECK(s.tick == 3 && s.display_slot == 115 && s.origin_slot == 110);
+    // A normal coordinate reanchor/refinement changes future projections,
+    // not the already sampled task or the continuous logical origin.
+    p.phase += T + 1000;
+    p.phase_slot++;
+    p.interval++;
+    CHECK(!sample(&s, &c, &p, &b, 1)); // Old D wall is not the new projection.
+    b = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(!b.valid); // Stale G wall is not silently repaired either.
+    g = secondary_ass_physical_point_at(&p, 113);
+    b = secondary_ass_present_plan_make_forecast(&p, g);
+    CHECK(!sample(&s, &c, &p, &b, 1));
+    CHECK(s.origin_slot == 110 && s.tick == 3 && s.display_slot == 115);
+    CHECK(secondary_ass_sampler_next_slot(&s) == 114);
+    CHECK(secondary_ass_sampler_next_wall(&s) == secondary_ass_physical_point_at(&p, 114).wall);
+    p.epoch++;
+    CHECK(sample(&s, &c, &p, &b, 1)); // Explicit epoch lifecycle initializes.
+    CHECK(s.origin_slot == 113 && s.tick == 0 && s.epoch == p.epoch);
+    s.force = true;
+    struct secondary_ass_clock invalid = {0};
+    CHECK(!sample(&s, &invalid, &p, &b, 1) && !s.valid && !s.force);
+}
+
+static void jitter_and_history(int64_t T)
+{
+    struct secondary_ass_physical p = state(T, 1);
+    struct secondary_ass_clock c = clock_state();
+    struct secondary_ass_sampler s = {0};
+    for (int k = 0; k < 256; k++) {
+        int64_t G = 110 + 2 * k;
+        struct secondary_ass_present_plan plan = secondary_ass_present_plan_make_forecast(&p,
+            secondary_ass_physical_point_at(&p, G));
+        CHECK(plan.valid && sample(&s, &c, &p, &plan, 2));
+        struct secondary_ass_physical_point actual = plan.target;
+        if (k == 32)
+            actual.wall += T / 100; // One QPC jitter is not a count jump/reset.
+        feedback(&p, &plan, (uint64_t)k + 1, actual);
+        CHECK(p.epoch == 7 && p.delay == 1 && !p.outlier_pending);
+        CHECK(s.origin_slot == 110 && s.tick == (uint64_t)k);
+        // Duplicate historical ID is not a second delay observation.
+        int count = p.delay_count, cursor = p.delay_next;
+        secondary_ass_physical_update_observed(&p, false, 0,
+            (struct secondary_ass_physical_point){0}, actual.wall, actual.wall,
+            (uint32_t)actual.slot, (uint32_t)actual.slot, (uint64_t)k + 1, T);
+        CHECK(p.delay_count == count && p.delay_next == cursor);
+    }
+    uint64_t epoch = p.epoch;
+    int H = p.delay, count = p.delay_count, cursor = p.delay_next;
+    int64_t phase = p.phase, phase_slot = p.phase_slot;
+    CHECK(secondary_ass_physical_observe(&p, p.sync_qpc_ns + T,
+                                        p.sync_count, T));
+    CHECK(!p.sync_segment_consistent && !p.outlier_pending && p.epoch == epoch);
+    CHECK(p.phase == phase && p.phase_slot == phase_slot);
+    CHECK(p.delay == H && p.delay_count == count && p.delay_next == cursor);
+    CHECK(!secondary_ass_physical_observe(&p, p.sync_qpc_ns + T * 3 / 5,
+                                         p.sync_count, T));
+    CHECK(p.outlier_pending && p.epoch == epoch);
+    CHECK(p.phase == phase && p.phase_slot == phase_slot);
+    CHECK(p.delay == H && p.delay_count == count && p.delay_next == cursor);
+    secondary_ass_physical_reset(&p);
+    CHECK(p.epoch == epoch + 1 && !p.phase && !p.delay_count);
+}
+
+static void lagged_history_and_mode(int64_t T, int64_t N, unsigned lag)
+{
+    struct secondary_ass_physical p = state(T, 0);
+    struct secondary_ass_clock c = clock_state();
+    struct secondary_ass_sampler s = {0};
+    struct secondary_ass_physical_point actual[768] = {0};
+    int64_t last_display = 0;
+    for (unsigned k = 0; k < 768; k++) {
+        int64_t G = 110 + (int64_t)k * N;
+        struct secondary_ass_present_plan plan = secondary_ass_present_plan_make_forecast(&p,
+            secondary_ass_physical_point_at(&p, G));
+        CHECK(plan.valid && plan.historical_delay == p.delay);
+        CHECK(plan.target.slot - plan.base.slot == plan.captured_forecast);
+        CHECK(sample(&s, &c, &p, &plan, N));
+        CHECK(s.tick == k && s.origin_slot == 110);
+        CHECK(plan.submit == plan.base.wall - p.interval +
+              (p.interval / 4 < 1000000 ? p.interval / 4 : 1000000));
+        // Two stable transport regimes with exact count/QPC feedback. These
+        // are model inputs, not an inference about a real composition mode.
+        int offset = k >= 128 && k < 512 ? 1 : 0;
+        int64_t actual_slot = G + offset;
+        CHECK(actual_slot > last_display); // No synthetic same-refresh Sync1.
+        last_display = actual_slot;
+        actual[k] = (struct secondary_ass_physical_point){
+            .slot = actual_slot, .wall = origin + (actual_slot - 100) * T,
+        };
+        uint64_t id = (uint64_t)k + 1;
+        CHECK(secondary_ass_physical_submit_planned_point(&p, id, plan.epoch,
+                                                         plan.base, plan.target));
+        bool known = k >= lag;
+        uint64_t hist_id = known ? (uint64_t)k - lag + 1 : 0;
+        uint32_t hist_count = known ? (uint32_t)actual[k - lag].slot : 0;
+        secondary_ass_physical_update_observed(&p, false, id, plan.target,
+            actual[k].wall, actual[k].wall, (uint32_t)actual[k].slot,
+            hist_count, hist_id, T);
+        secondary_ass_physical_record_present(&p, true, id, 3, 1);
+        chain_frames++;
+        unsigned saved = (p.next + 31) % 32;
+        CHECK(p.submitted[saved].base_slot == G);
+        CHECK(p.submitted[saved].target_slot == plan.target.slot);
+        CHECK(p.epoch == 7 && !p.outlier_pending && p.sync_segment_consistent);
+        CHECK(s.origin_slot == 110 && s.tick == k);
+        if (known) {
+            CHECK(p.historical_id == hist_id);
+            CHECK(p.phase_slot == actual[k - lag].slot);
+            CHECK(p.phase == actual[k - lag].wall);
+        }
+        if (k >= 140 + lag && k < 512)
+            CHECK(p.delay == 1); // Forecasting must not erase learned H.
+        if (k >= 524 + lag)
+            CHECK(p.delay == 0); // Stable recovery must not oscillate H0/H1.
+    }
+}
+
+static void held_pose_committed_G(int64_t T)
+{
+    struct secondary_ass_physical p = state(T, 1);
+    struct secondary_ass_clock c = clock_state();
+    struct secondary_ass_sampler s = {0};
+    struct secondary_ass_present_plan a = secondary_ass_present_plan_make_forecast(&p,
+        secondary_ass_physical_point_at(&p, 110));
+    CHECK(sample(&s, &c, &p, &a, 1));
+    feedback(&p, &a, 1, a.target);
+    // Deliberately probe a decreasing captured forecast at N1. Its rejected
+    // pose is an explicit ASS MISS, even if the primary video Present succeeds.
+    p.delay = 0;
+    struct secondary_ass_present_plan missed = secondary_ass_present_plan_make_forecast(&p,
+        secondary_ass_physical_point_at(&p, 111));
+    CHECK(missed.valid && missed.target.slot == s.display_slot);
+    CHECK(!sample(&s, &c, &p, &missed, 1));
+    CHECK(s.tick == 0 && s.display_slot == 111);
+    struct secondary_ass_physical_point actual = secondary_ass_physical_point_at(&p, 112);
+    feedback(&p, &missed, 2, actual);
+    CHECK(p.last_base_slot == 111);
+    CHECK(missed.target.slot == 111); // Saved MISS is not renamed actual112.
+    CHECK(secondary_ass_sampler_next_slot(&s) == 111); // Pose did not consume G.
+    struct secondary_ass_physical_point next = secondary_ass_present_plan_cache_next_forecast(&p,
+        secondary_ass_sampler_next_slot(&s), 1, actual.wall - T);
+    CHECK(next.slot == 112); // The successful Present ledger skips attempted G.
+    struct secondary_ass_present_plan resumed = secondary_ass_present_plan_cache_forecast(&p, next);
+    CHECK(resumed.valid && sample(&s, &c, &p, &resumed, 1));
+    CHECK(s.origin_slot == 110 && s.tick == 2 && s.display_slot == resumed.target.slot);
+}
+
+static void invalid_and_legacy(int64_t T)
+{
+    struct secondary_ass_physical p = state(T, 1);
+    struct secondary_ass_physical_point g = secondary_ass_physical_point_at(&p, 110);
+    struct secondary_ass_present_plan old = secondary_ass_present_plan_cache(&p, g);
+    CHECK(old.valid && !old.display_forecast && !old.captured_forecast);
+    CHECK(old.base.slot == 110 && old.target.slot == 110 && old.deadline == g.wall);
+    struct secondary_ass_physical_point next = secondary_ass_present_plan_cache_next(&p, 110, 2, g.wall);
+    CHECK(next.slot == 112);
+    struct secondary_ass_clock c = clock_state();
+    struct secondary_ass_sampler s = {0};
+    CHECK(secondary_ass_sampler_update_physical(&s, &c, 1e9 / (2 * T), g.wall,
+        g.slot, p.phase, p.phase_slot, T, p.epoch));
+    CHECK(!s.display_forecast && !s.display_slot && s.origin_slot == 110);
+    CHECK(secondary_ass_sampler_next_slot(&s) == 112);
+    CHECK(!secondary_ass_present_plan_make_forecast(&p,
+        (struct secondary_ass_physical_point){INT64_MAX, INT64_MAX}).valid);
+    CHECK(!secondary_ass_present_plan_cache_next_forecast(&p, INT64_MAX, 2, origin).slot);
+    CHECK(!secondary_ass_present_plan_cache_next_forecast(&p, 110, INT64_MAX, origin).slot);
+    CHECK(!secondary_ass_present_plan_cache_next_forecast(&p, 110, 2, 0).slot);
+    p.delay = -1;
+    CHECK(!secondary_ass_present_plan_make_forecast(&p, g).valid);
+    CHECK(!secondary_ass_present_plan_cache_next_forecast(&p, 110, 2, origin).slot);
+    p.delay = 5;
+    CHECK(!secondary_ass_present_plan_make_forecast(&p, g).valid);
+    p.delay = 1;
+    p.epoch_exhausted = true;
+    CHECK(!secondary_ass_present_plan_make_forecast(&p, g).valid);
+    s = (struct secondary_ass_sampler){0};
+    CHECK(!secondary_ass_sampler_update_physical_forecast(&s, &c, 0,
+        g.wall, 110, 110, p.phase, p.phase_slot, T, 7));
+    CHECK(!s.valid);
+    CHECK(!secondary_ass_sampler_update_physical_forecast(&s, &c, 1e9 / T,
+        g.wall + 1, 110, 110, p.phase, p.phase_slot, T, 7));
+    CHECK(!s.valid);
+    CHECK(!secondary_ass_sampler_update_physical_forecast(&s, &c, 1e9 / (1.3 * T),
+        g.wall, 110, 110, p.phase, p.phase_slot, T, 7));
+    CHECK(!s.valid);
+}
+
+int main(void)
+{
+    const int rates[] = {30, 60, 120, 144, 165, 240, 360};
+    for (unsigned i = 0; i < sizeof(rates) / sizeof(rates[0]); i++) {
+        int64_t T = INT64_C(1000000000) / rates[i];
+        for (int64_t N = 1; N <= 4; N++) {
+            for (int H = 0; H <= 4; H++)
+                steady_chain(rates[i], N, H);
+        }
+        forecasts_and_fifo(T);
+        sampler_changes(T);
+        jitter_and_history(T);
+        held_pose_committed_G(T);
+        for (int64_t N = 2; N <= 4; N++) {
+            lagged_history_and_mode(T, N, 0);
+            lagged_history_and_mode(T, N, 1);
+            lagged_history_and_mode(T, N, 3);
+        }
+        invalid_and_legacy(T);
+    }
+    printf("display-forecast: %llu checks; %llu complete feedback frames; CPU only\n",
+           checks, chain_frames);
+    return 0;
+}
diff --git a/test/secondary_ass_fixed_forecast.c b/test/secondary_ass_fixed_forecast.c
new file mode 100644
index 0000000000000000000000000000000000000000..8b78ff64fef808f8d8a32c4feeeae6705ab21617
--- /dev/null
+++ b/test/secondary_ass_fixed_forecast.c
@@ -0,0 +1,218 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "sub/secondary_ass_clock.h"
+#include "video/out/secondary_ass_present_plan.h"
+
+// Actual production helper calls with synthetic count/Display input only.
+// These checks do not establish API, Ready, or physical Display performance.
+static unsigned checks, feedback_frames, historical_changes;
+#define CHECK(x) do { checks++; if (!(x)) { \
+    fprintf(stderr, "fixed forecast check %u line %d: %s\n", \
+            checks, __LINE__, #x); exit(2); } } while (0)
+static const int64_t origin = INT64_C(1000000000);
+
+static struct secondary_ass_physical state(int Hz)
+{
+    int64_t T = INT64_C(1000000000) / Hz;
+    return (struct secondary_ass_physical){
+        .phase = origin, .phase_slot = 100, .interval = T, .epoch = 7,
+        .sync_qpc_ns = origin, .sync_count = 100, .sync_slot = 100,
+        .sync_segment_consistent = true,
+        .measure_qpc_ns = origin, .measure_count = 100,
+        .periods = {T, T, T}, .period_count = 3, .period_next = 3,
+        .delay = 1, .delay_samples = {1, 1, 1}, .delay_count = 3,
+        .success_generation = 3, .success_contiguous = true,
+        .success_first_id = 1, .success_last_id = 1, .historical_id = 1,
+        .last_base_slot = 100,
+    };
+}
+
+static void feedback(struct secondary_ass_physical *p,
+    const struct secondary_ass_present_plan *plan, uint64_t id, int late)
+{
+    struct secondary_ass_physical_point actual =
+        secondary_ass_physical_point_at(p, plan->target.slot + late);
+    int old_H = p->delay;
+    CHECK(secondary_ass_physical_submit_planned_point(p, id, plan->epoch,
+                                                     plan->base, plan->target));
+    secondary_ass_physical_update_observed(p, false, id, plan->target,
+        actual.wall, actual.wall, (uint32_t)actual.slot, (uint32_t)actual.slot,
+        id, p->interval);
+    secondary_ass_physical_record_present(p, true, id, 3, 1);
+    CHECK(p->historical_id == id && p->last_submit_id == id);
+    CHECK(p->phase_slot == actual.slot && p->phase == actual.wall);
+    unsigned n = (p->next + 31) % 32;
+    CHECK(p->submitted[n].base_slot == plan->base.slot);
+    CHECK(p->submitted[n].target_slot == plan->target.slot);
+    historical_changes += p->delay != old_H;
+    feedback_frames++;
+}
+
+static void chain(int Hz, int N)
+{
+    struct secondary_ass_physical p = state(Hz);
+    struct secondary_ass_present_fixed_offset fixed = {0};
+    struct secondary_ass_sampler sampler = {0};
+    struct secondary_ass_clock clock = {
+        .valid = true, .pts = 10, .speed = 1, .wall = origin,
+    };
+    double rate = 1e9 / ((double)p.interval * N);
+    for (unsigned tick = 1; tick <= 24; tick++) {
+        int64_t G = 100 + tick * N;
+        struct secondary_ass_physical_point g = secondary_ass_physical_point_at(&p, G);
+        struct secondary_ass_physical before = p;
+        int offset = secondary_ass_present_fixed_offset_get(&fixed, &p, g, N, rate);
+        CHECK(offset == 1 && fixed.valid);
+        CHECK(!memcmp(&p, &before, sizeof(p)));
+        struct secondary_ass_present_fixed_offset captured_offset = fixed;
+        struct secondary_ass_present_plan plan =
+            secondary_ass_present_plan_make_fixed_forecast(&p, g, offset);
+        CHECK(plan.valid && plan.display_forecast && plan.captured_forecast == 1);
+        CHECK(plan.base.slot == G && plan.base.wall == g.wall);
+        CHECK(plan.target.slot == G + 1 && plan.target.wall == g.wall + p.interval);
+        CHECK(plan.historical_delay == p.delay);
+        CHECK(plan.submit == plan.target.wall - p.interval +
+            (p.interval / 4 < 1000000 ? p.interval / 4 : 1000000));
+        CHECK(plan.submit == plan.fallback_submit && plan.deadline == plan.target.wall);
+        CHECK(secondary_ass_sampler_update_physical_forecast(&sampler, &clock, rate,
+            plan.target.wall, plan.base.slot, plan.target.slot,
+            p.phase, p.phase_slot, p.interval, p.epoch));
+        CHECK(sampler.origin_slot == 100 + N && sampler.tick == tick - 1);
+        CHECK(sampler.display_slot == G + 1 && sampler.sample_wall == plan.target.wall);
+        CHECK(secondary_ass_sampler_next_slot(&sampler) == G + N);
+        struct secondary_ass_present_plan captured_plan = plan;
+        CHECK(!secondary_ass_sampler_update_physical_forecast(&sampler, &clock, rate,
+            plan.target.wall, plan.base.slot, plan.target.slot,
+            p.phase, p.phase_slot, p.interval, p.epoch));
+        CHECK(sampler.tick == tick - 1 && sampler.sample_wall == captured_plan.target.wall);
+        int late = N == 2 && ((tick - 1) / 3) % 2 == 0;
+        feedback(&p, &plan, tick + 1, late);
+        CHECK(p.epoch == 7 && !p.outlier_pending);
+        CHECK(!memcmp(&fixed, &captured_offset, sizeof(fixed)));
+        CHECK(!memcmp(&plan, &captured_plan, sizeof(plan)));
+        CHECK(sampler.origin_slot == 100 + N && sampler.tick == tick - 1);
+    }
+}
+
+static void identity_and_misses(void)
+{
+    struct secondary_ass_physical p = state(144);
+    struct secondary_ass_present_fixed_offset fixed = {0};
+    double rate = 1e9 / ((double)p.interval * 2);
+    struct secondary_ass_physical_point g = secondary_ass_physical_point_at(&p, 102);
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == 1);
+    struct secondary_ass_present_fixed_offset saved = fixed;
+    struct secondary_ass_present_plan captured =
+        secondary_ass_present_plan_make_fixed_forecast(&p, g, 1);
+    struct secondary_ass_present_plan saved_plan = captured;
+
+    p.success_generation = 0;
+    p.delay = 3;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == -1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    CHECK(!secondary_ass_present_plan_make_fixed_forecast(&p, g, 1).valid);
+    CHECK(!memcmp(&captured, &saved_plan, sizeof(captured)));
+    p.success_generation = 3;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == 1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    CHECK(secondary_ass_present_plan_make_fixed_forecast(&p, g, 1).target.slot == 103);
+
+    secondary_ass_physical_record_present(&p, false, 2, 0, 1);
+    CHECK(!p.success_contiguous);
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == -1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    CHECK(!secondary_ass_present_plan_make_fixed_forecast(&p, g, 1).valid);
+    secondary_ass_physical_record_present(&p, true, 2, 3, 1);
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == 1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 0, 0) == -1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    p.epoch = 0;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == -1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    p.epoch = saved.epoch;
+
+    p.outlier_pending = true;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == -1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    p.outlier_pending = false;
+    p.sync_segment_consistent = false;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == -1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    p.sync_segment_consistent = true;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == 1);
+    p.interval -= 17; // Local projection refinement is not a cadence change.
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p,
+        secondary_ass_physical_point_at(&p, 102), 2, rate) == 1);
+    CHECK(!memcmp(&saved, &fixed, sizeof(fixed)));
+    g = secondary_ass_physical_point_at(&p, 102);
+
+    // A true nonzero backend generation change is a new identity, unlike 0.
+    p.success_generation = 4;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == 3);
+    CHECK(fixed.generation == 4 && fixed.offset == 3);
+    p.epoch++;
+    p.delay = 0;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p, g, 2, rate) == 0);
+    CHECK(fixed.epoch == p.epoch);
+    p.delay = 2;
+    CHECK(secondary_ass_present_fixed_offset_get(&fixed, &p,
+        secondary_ass_physical_point_at(&p, 102), 1, rate * 2) == 2);
+    CHECK(fixed.divisor == 1 && fixed.rate == rate * 2);
+
+    // Dynamic H must affect neither expiry nor captured D in this lifecycle.
+    p = state(144);
+    g = secondary_ass_physical_point_at(&p, 102);
+    p.delay = 0;
+    struct secondary_ass_physical before = p;
+    int64_t now = g.wall + p.interval / 2;
+    CHECK(secondary_ass_present_plan_cache_next_forecast(&p, 102, 2, now).slot == 104);
+    CHECK(secondary_ass_present_plan_cache_next_fixed_forecast(&p, 102, 2, now, 1).slot == 102);
+    CHECK(!memcmp(&p, &before, sizeof(p)));
+    p.delay = 3;
+    CHECK(secondary_ass_present_plan_cache_next_fixed_forecast(&p, 102, 2, now, 1).slot == 102);
+    captured = secondary_ass_present_plan_make_fixed_forecast(&p, g, 1);
+    CHECK(captured.valid && captured.historical_delay == 3 && captured.target.slot == 103);
+    CHECK(captured.submit == g.wall + 1000000);
+    p.historical_id = 10;
+    p.success_first_id = 10;
+    p.success_last_id = 13;
+    p.success_contiguous = true;
+    struct secondary_ass_present_plan blocked =
+        secondary_ass_present_plan_make_fixed_forecast(&p, g, 1);
+    CHECK(!blocked.valid && blocked.target.slot == 103 && blocked.fifo_lower == 104);
+    CHECK(captured.valid && captured.target.slot == 103);
+    CHECK(secondary_ass_present_plan_cache_next_fixed_forecast(&p, 102, 2, now, 1).slot == 104);
+    CHECK(!secondary_ass_present_plan_make_fixed_forecast(&p, g, -1).valid);
+    CHECK(!secondary_ass_present_plan_make_fixed_forecast(&p, g, 5).valid);
+
+    // Real budget helper: a shifted S may consume fresh reservation even
+    // though the original G-window had enough time. Preserve the original F.
+    int64_t F = captured.submit + 2000000;
+    CHECK(secondary_ass_budget_before_deadline(captured.submit - p.interval,
+        F, 1500000, 1500000, 1000000));
+    CHECK(!secondary_ass_budget_before_deadline(captured.submit,
+        F, 1500000, 1500000, 1000000));
+    CHECK(secondary_ass_budget_probe_due(1000000, 40000000,
+        14000000, origin, origin));
+    CHECK(!secondary_ass_budget_probe_due(1000000, 40000000,
+        14000000, origin, origin + 1));
+}
+
+int main(void)
+{
+    const int rates[] = {60, 120, 144, 165, 240};
+    for (unsigned i = 0; i < sizeof(rates) / sizeof(rates[0]); i++) {
+        chain(rates[i], 1);
+        chain(rates[i], 2);
+    }
+    identity_and_misses();
+    CHECK(historical_changes > 0);
+    printf("{\"checks\":%u,\"feedback_frames\":%u,\"historical_changes\":%u,"
+           "\"cpu_only\":true,\"Display_PASS\":false}\n",
+           checks, feedback_frames, historical_changes);
+    return 0;
+}
diff --git a/test/secondary_ass_physical.c b/test/secondary_ass_physical.c
new file mode 100644
index 0000000000000000000000000000000000000000..c96ab05e655876d7e899f5deff53fcc663e43b0c
--- /dev/null
+++ b/test/secondary_ass_physical.c
@@ -0,0 +1,406 @@
+#include <stdint.h>
+
+#include "test_utils.h"
+#include "video/out/secondary_ass_physical.h"
+
+static const int64_t origin = INT64_C(1000000000);
+
+static struct secondary_ass_physical make_state(int64_t interval)
+{
+    return (struct secondary_ass_physical){
+        .phase = origin, .phase_slot = 100, .interval = interval, .epoch = 7,
+        .sync_qpc_ns = origin, .sync_count = 100, .sync_slot = 100,
+        .sync_segment_consistent = true,
+        .measure_qpc_ns = origin, .measure_count = 100,
+        .periods = {interval, interval, interval},
+        .period_count = 3, .period_next = 3,
+        .historical_id = 10, .last_submit_id = 10,
+        .delay = 1, .delay_samples = {1, 1, 2}, .delay_count = 3,
+    };
+}
+
+static bool observe(struct secondary_ass_physical *p, int64_t step,
+                    uint32_t count)
+{
+    return secondary_ass_physical_observe(p, origin + step * p->interval,
+                                          count, p->interval);
+}
+
+static bool bad(struct secondary_ass_physical *p, int64_t step, uint32_t count)
+{
+    return secondary_ass_physical_observe(p,
+        origin + step * p->interval - p->interval * 2 / 5, count, p->interval);
+}
+
+static struct secondary_ass_physical_point point(int64_t interval, int64_t slot)
+{
+    return (struct secondary_ass_physical_point){
+        .slot = slot, .wall = origin + (slot - 100) * interval,
+    };
+}
+
+static void phase_kept(const struct secondary_ass_physical *p)
+{
+    assert_int_equal(p->phase, origin);
+    assert_int_equal(p->phase_slot, 100);
+    assert_int_equal(p->epoch, 7);
+}
+
+static void learner_kept(const struct secondary_ass_physical *p)
+{
+    assert_int_equal(p->delay, 1);
+    assert_int_equal(p->delay_count, 3);
+    assert_int_equal(p->delay_next, 0);
+    assert_int_equal(p->delay_samples[0], 1);
+    assert_int_equal(p->delay_samples[1], 1);
+    assert_int_equal(p->delay_samples[2], 2);
+    assert_int_equal(p->period_count, 3);
+    assert_int_equal(p->period_next, 3);
+    for (unsigned n = 0; n < 3; n++)
+        assert_int_equal(p->periods[n], p->interval);
+}
+
+static void test_single_bad(int64_t interval)
+{
+    const uint32_t first_counts[] = {100, 102};
+    for (unsigned k = 0; k < 2; k++) {
+        struct secondary_ass_physical p = make_state(interval);
+        assert_false(bad(&p, 2, first_counts[k]));
+        phase_kept(&p);
+        learner_kept(&p);
+        assert_true(p.outlier_pending);
+        assert_false(p.sync_segment_consistent);
+        assert_int_equal(p.sync_slot, 100);
+        assert_int_equal(p.sync_qpc_ns, origin);
+        assert_int_equal(p.sync_count, 100);
+        for (unsigned n = 0; n < 20; n++)
+            assert_false(bad(&p, 2, first_counts[k]));
+        phase_kept(&p);
+        assert_false(bad(&p, 3, first_counts[k]));
+        phase_kept(&p); // Different QPC with the same raw count is not proof.
+        learner_kept(&p);
+        if (first_counts[k] == 100) {
+            assert_false(secondary_ass_physical_sample_available(&p,
+                         point(interval, 101).wall));
+        } else {
+            assert_int_equal(secondary_ass_physical_point_at(&p, 104).slot, 104);
+            assert_int_equal(secondary_ass_physical_point_at(&p, 105).slot, 0);
+        }
+        // Recovering the original raw count agreement skips gap feedback.
+        assert_false(observe(&p, 3, 103));
+        assert_false(p.outlier_pending);
+        assert_false(p.sync_segment_consistent);
+        assert_int_equal(p.history_floor_slot, 103);
+        assert_int_equal(p.measure_qpc_ns, origin + 3 * interval);
+        assert_int_equal(p.measure_count, 103);
+        phase_kept(&p);
+        learner_kept(&p);
+        assert_true(observe(&p, 4, 104));
+        assert_true(p.sync_segment_consistent);
+        assert_true(secondary_ass_physical_sample_available(&p,
+                    point(interval, 105).wall));
+    }
+
+    struct secondary_ass_physical p = make_state(interval);
+    assert_false(bad(&p, 2, 102));
+    assert_false(bad(&p, 3, 103));
+    assert_int_equal(p.phase, 0); // Preserve the old independently advanced rule.
+    assert_int_equal(p.phase_slot, 0);
+    assert_int_equal(p.epoch, 7);
+}
+
+static void test_lost_count_recovery(int64_t interval)
+{
+    struct secondary_ass_physical p = make_state(interval);
+    assert_false(bad(&p, 2, 100));
+    for (unsigned n = 0; n < 20; n++)
+        assert_false(observe(&p, 2, 101));
+    assert_true(p.outlier_pending);
+    assert_int_equal(p.recovery_slot, 102);
+    assert_int_equal(p.sync_slot, 100);
+    assert_false(secondary_ass_physical_sample_available(&p,
+                 point(interval, 104).wall));
+    assert_false(observe(&p, 3, 102));
+    assert_false(p.outlier_pending);
+    assert_int_equal(p.sync_qpc_ns, origin + 3 * interval);
+    assert_int_equal(p.sync_slot, 103);
+    assert_int_equal(p.sync_count, 102);
+    assert_int_equal(p.recovery_qpc_ns, 0);
+    assert_int_equal(p.history_floor_slot, 103);
+    assert_false(p.sync_segment_consistent);
+    phase_kept(&p);
+    learner_kept(&p);
+    assert_true(secondary_ass_physical_sample_available(&p,
+                point(interval, 104).wall));
+    // The one-count loss stays permanent; availability cannot wait for it.
+    for (int n = 4; n < 10004; n++) {
+        assert_true(observe(&p, n, (uint32_t)(100 + n - 1)));
+        assert_false(p.outlier_pending);
+        assert_int_equal(p.sync_slot, 100 + n);
+        assert_true(secondary_ass_physical_sample_available(&p,
+                    point(interval, 101 + n).wall));
+    }
+    phase_kept(&p);
+
+    p = make_state(interval);
+    assert_false(bad(&p, 2, 100));
+    assert_false(observe(&p, 2, 101));
+    assert_false(observe(&p, 3, 101)); // A stalled candidate is not recovery.
+    assert_true(p.outlier_pending);
+    assert_int_equal(p.recovery_slot, 103);
+    assert_false(observe(&p, 4, 102));
+    assert_false(p.outlier_pending);
+    assert_int_equal(p.sync_slot, 104);
+    phase_kept(&p);
+
+    p = make_state(interval);
+    p.sync_count = UINT32_MAX - 1;
+    assert_false(bad(&p, 2, UINT32_MAX - 1));
+    assert_false(observe(&p, 2, UINT32_MAX));
+    assert_false(observe(&p, 3, 0));
+    assert_false(p.outlier_pending);
+    assert_int_equal(p.sync_slot, 103);
+    assert_true(observe(&p, 4, 1));
+    phase_kept(&p);
+}
+
+static void test_threshold_and_stale(int64_t interval)
+{
+    struct secondary_ass_physical p = make_state(interval);
+    assert_false(bad(&p, 2, 100));
+    int64_t first = origin + 2 * interval + interval / 4;
+    assert_false(secondary_ass_physical_observe(&p, first, 101, interval));
+    assert_true(p.outlier_pending);
+    // Both original-lattice residuals pass T/4, but their relative residual
+    // must independently pass the same threshold; do not widen it to T/2.
+    int64_t second = origin + 3 * interval - interval / 4;
+    assert_false(secondary_ass_physical_observe(&p, second, 102, interval));
+    assert_true(p.outlier_pending);
+    assert_false(secondary_ass_physical_observe(&p, first, 101, interval));
+    assert_int_equal(p.recovery_qpc_ns, second); // Stale anchor cannot replace it.
+    assert_false(secondary_ass_physical_observe(&p,
+                 origin + 4 * interval - interval / 4, 103, interval));
+    assert_false(p.outlier_pending);
+    phase_kept(&p);
+
+    p = make_state(interval);
+    assert_false(secondary_ass_physical_observe(&p, origin - interval, 99,
+                                               interval));
+    assert_false(p.outlier_pending);
+    assert_int_equal(p.sync_slot, 100);
+    phase_kept(&p);
+    p.sync_qpc_ns = 1;
+    assert_false(secondary_ass_physical_observe(&p, INT64_MAX, 102, interval));
+    assert_int_equal(p.sync_slot, 100); // Checked rounding overflow.
+    phase_kept(&p);
+}
+
+static void update(struct secondary_ass_physical *p, int64_t step,
+                   uint32_t count, uint32_t present_count, uint64_t historical_id)
+{
+    secondary_ass_physical_update_observed(p, false, 0,
+        (struct secondary_ass_physical_point){0}, origin + step * p->interval,
+        origin + step * p->interval, count, present_count, historical_id,
+        p->interval);
+}
+
+static void test_gap_history(int64_t interval)
+{
+    struct secondary_ass_physical p = make_state(interval);
+    secondary_ass_physical_submit_point(&p, 11, point(interval, 102));
+    assert_int_equal(p.submitted[0].base_slot, 101);
+    assert_false(bad(&p, 2, 100));
+    assert_true(p.submitted[0].gap_excluded);
+    secondary_ass_physical_submit_point(&p, 12, point(interval, 104));
+    assert_true(p.submitted[1].gap_excluded);
+    update(&p, 2, 101, 101, 11);
+    update(&p, 3, 102, 102, 11);
+    assert_false(p.outlier_pending);
+    assert_false(p.sync_segment_consistent);
+    assert_int_equal(p.historical_id, 10); // Recovery call does not feed history.
+    phase_kept(&p);
+    learner_kept(&p);
+    assert_int_equal(p.submitted[0].base_slot, 101);
+    assert_int_equal(p.submitted[0].target_slot, 102);
+    assert_int_equal(p.submitted[1].base_slot, 103);
+    assert_int_equal(p.submitted[1].target_slot, 104);
+
+    update(&p, 4, 103, 102, 11); // Old/gap ID cannot cross new count segment.
+    phase_kept(&p);
+    learner_kept(&p);
+    assert_int_equal(p.historical_id, 10);
+    update(&p, 4, 103, 102, 999); // Unregistered history cannot extrapolate.
+    phase_kept(&p);
+    update(&p, 4, 103, 103, 11); // Exact pair has a real current physical point.
+    assert_int_equal(p.phase, origin + 4 * interval);
+    assert_int_equal(p.phase_slot, 104);
+    assert_int_equal(p.historical_id, 11);
+    learner_kept(&p); // Same ID still cannot synthesize a cross-gap delay.
+    update(&p, 5, 104, 104, 11);
+    learner_kept(&p); // A repeated historical ID is not another observation.
+    update(&p, 5, 104, 104, 12);
+    learner_kept(&p); // Submitted during quarantine is also excluded.
+
+    secondary_ass_physical_submit_point(&p, 13, point(interval, 103));
+    assert_false(p.submitted[2].gap_excluded);
+    assert_int_equal(p.submitted[2].base_slot, 102);
+    update(&p, 6, 105, 106, 13); // New ID with pre-floor base is still ambiguous.
+    learner_kept(&p);
+    assert_int_equal(p.historical_id, 12);
+
+    secondary_ass_physical_submit_point(&p, 14, point(interval, 106));
+    assert_int_equal(p.submitted[3].base_slot, 105);
+    assert_int_equal(p.submitted[3].target_slot, 106);
+    update(&p, 7, 106, 106, 14);
+    assert_int_equal(p.phase_slot, 107);
+    assert_int_equal(p.phase - (p.phase_slot - 100) * interval, origin);
+    assert_int_equal(p.delay_samples[0], 2); // Actual slot minus saved base.
+    assert_int_equal(p.delay, 2);
+    assert_int_equal(p.delay_next, 1);
+    assert_int_equal(p.submitted[3].base_slot, 105); // Median cannot rewrite it.
+    assert_int_equal(p.submitted[3].target_slot, 106);
+    update(&p, 8, 107, 107, 14);
+    assert_int_equal(p.delay_next, 1);
+    assert_int_equal(p.delay_samples[0], 2);
+    int64_t kept_phase = p.phase;
+    secondary_ass_physical_feedback_point(&p, point(interval, 102), 15);
+    assert_int_equal(p.phase, kept_phase); // Explicit history floor is checked.
+    assert_int_equal(p.historical_id, 14);
+}
+
+static void test_cleared_phase_bootstrap(int64_t interval)
+{
+    struct secondary_ass_physical p = make_state(interval);
+    secondary_ass_physical_submit_point(&p, 11, point(interval, 102));
+    assert_false(bad(&p, 2, 102));
+    assert_false(bad(&p, 3, 103));
+    assert_int_equal(p.phase, 0);
+    assert_false(p.outlier_pending);
+    assert_int_equal(p.phase, 0); // Recovery itself remains history-isolated.
+    assert_int_equal(p.history_floor_slot, 103);
+    assert_int_equal(p.historical_id, 10);
+    learner_kept(&p);
+    // The two displaced observations already establish the new segment. Its
+    // next exact Sync/Present pair, rather than a return to the old lattice,
+    // supplies the wall-clock phase without learning from the gap submission.
+    int64_t actual = origin + 4 * interval - interval * 2 / 5;
+    secondary_ass_physical_update_observed(&p, false, 0,
+        (struct secondary_ass_physical_point){0}, actual, actual,
+        104, 104, 11, interval);
+    assert_int_equal(p.phase, actual);
+    assert_int_equal(p.phase_slot, 104);
+    assert_int_equal(p.epoch, 7);
+    learner_kept(&p);
+    assert_true(secondary_ass_physical_sample_available(&p,
+                point(interval, 107).wall));
+    secondary_ass_physical_reset(&p);
+    assert_int_equal(p.epoch, 8);
+    assert_int_equal(p.history_floor_slot, 0);
+    assert_int_equal(p.recovery_qpc_ns, 0);
+    assert_false(p.submitted[0].gap_excluded);
+    p.epoch = UINT64_MAX;
+    secondary_ass_physical_reset(&p);
+    assert_true(p.epoch_exhausted);
+    assert_false(observe(&p, 1, 1));
+}
+
+static void test_planned_base_and_clock_domains(int64_t interval)
+{
+    struct secondary_ass_physical p = make_state(interval);
+    const int64_t qpc_origin = origin + INT64_C(100000000000);
+    p.sync_qpc_ns = p.measure_qpc_ns = qpc_origin;
+    assert_true(secondary_ass_physical_submit_planned_point(&p, 11, p.epoch,
+                point(interval, 101), point(interval, 104)));
+    assert_false(secondary_ass_physical_observe(&p,
+                 qpc_origin + 2 * interval - interval * 2 / 5, 100, interval));
+    assert_true(p.submitted[0].gap_excluded);
+    for (int n = 2; n <= 3; n++) {
+        secondary_ass_physical_update_observed(&p, false, 0,
+            (struct secondary_ass_physical_point){0}, qpc_origin + n * interval,
+            origin + n * interval, (uint32_t)(99 + n), (uint32_t)(99 + n),
+            11, interval);
+    }
+    assert_false(p.outlier_pending);
+    assert_int_equal(p.sync_qpc_ns, qpc_origin + 3 * interval);
+    phase_kept(&p); // A raw QPC must never be copied into the wall/ASS phase.
+    learner_kept(&p);
+    secondary_ass_physical_update_observed(&p, false, 0,
+        (struct secondary_ass_physical_point){0}, qpc_origin + 4 * interval,
+        origin + 4 * interval, 103, 103, 11, interval);
+    learner_kept(&p);
+    assert_int_equal(p.phase, origin + 4 * interval);
+    assert_true(secondary_ass_physical_submit_planned_point(&p, 12, p.epoch,
+                point(interval, 105), point(interval, 109)));
+    // The API history refers to slot 107; learning is 107-105, never 107-109.
+    secondary_ass_physical_update_observed(&p, false, 0,
+        (struct secondary_ass_physical_point){0}, qpc_origin + 6 * interval,
+        origin + 6 * interval, 105, 106, 12, interval);
+    assert_int_equal(p.phase_slot, 107);
+    assert_int_equal(p.phase, origin + 7 * interval);
+    assert_int_equal(p.delay, 2);
+    assert_int_equal(p.delay_samples[0], 2);
+    assert_int_equal(p.submitted[1].base_slot, 105);
+    assert_int_equal(p.submitted[1].target_slot, 109);
+    assert_false(secondary_ass_physical_submit_planned_point(&p, 12, p.epoch,
+                 point(interval, 107), point(interval, 110)));
+    assert_int_equal(p.submitted[1].base_slot, 105); // Same ID is immutable.
+    assert_int_equal(p.submitted[1].target_slot, 109);
+    assert_int_equal(p.epoch, 7);
+
+    // A reused ring entry loses its previous gap exclusion only upon a new
+    // identified submission; legacy coordinates cannot survive the overwrite.
+    p = make_state(interval);
+    p.submitted[0].gap_excluded = true;
+    secondary_ass_physical_submit_point(&p, 20, point(interval, 106));
+    assert_false(p.submitted[0].gap_excluded);
+    p.next = 0;
+    p.phase_slot = 0;
+    secondary_ass_physical_submit(&p, 21, point(interval, 107).wall);
+    assert_int_equal(p.submitted[0].base_slot, 0);
+    assert_int_equal(p.submitted[0].target_slot, 0);
+    assert_false(p.submitted[0].gap_excluded);
+}
+
+static void test_displaced_segment_returns(int64_t interval)
+{
+    struct secondary_ass_physical p = make_state(interval);
+    secondary_ass_physical_submit_point(&p, 11, point(interval, 102));
+    assert_false(bad(&p, 2, 102));
+    assert_false(bad(&p, 3, 103));
+    assert_false(p.outlier_pending);
+    assert_int_equal(p.phase, 0);
+    // Returning to the original QPC lattice is another discontinuity. It
+    // needs its own independent relative pair, not the former anchor or a
+    // fabricated phase. The original lost-count sequence remains explicit.
+    update(&p, 4, 103, 103, 11);
+    update(&p, 5, 104, 104, 11);
+    assert_true(p.outlier_pending);
+    assert_int_equal(p.phase, 0);
+    update(&p, 6, 105, 105, 11);
+    assert_false(p.outlier_pending);
+    assert_int_equal(p.phase, 0);
+    assert_int_equal(p.historical_id, 10);
+    assert_int_equal(p.history_floor_slot, 105);
+    learner_kept(&p);
+    update(&p, 7, 106, 106, 11);
+    assert_int_equal(p.phase, origin + 7 * interval);
+    assert_int_equal(p.phase_slot, 106);
+    assert_int_equal(p.epoch, 7);
+    learner_kept(&p);
+}
+
+int main(void)
+{
+    const int rates[] = {60, 120, 144, 165, 240, 360, 480};
+    for (unsigned n = 0; n < sizeof(rates) / sizeof(rates[0]); n++) {
+        int64_t interval = INT64_C(1000000000) / rates[n];
+        test_single_bad(interval);
+        test_lost_count_recovery(interval);
+        test_threshold_and_stale(interval);
+        test_gap_history(interval);
+        test_cleared_phase_bootstrap(interval);
+        test_planned_base_and_clock_domains(interval);
+        test_displaced_segment_returns(interval);
+    }
+    return 0;
+}
diff --git a/test/secondary_ass_queue_lead.c b/test/secondary_ass_queue_lead.c
new file mode 100644
index 0000000000000000000000000000000000000000..740037dd1ef3c29012da3a20cacca7a10b0049a1
--- /dev/null
+++ b/test/secondary_ass_queue_lead.c
@@ -0,0 +1,146 @@
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "video/out/secondary_ass_queue_lead.h"
+
+static unsigned checks;
+#define CHECK(expr) do { \
+    if (!(expr)) { \
+        fprintf(stderr, "check failed at line %d: %s\n", __LINE__, #expr); \
+        abort(); \
+    } \
+    checks++; \
+} while (0)
+
+static struct secondary_ass_queue_hint fixture(int64_t interval, int64_t divisor)
+{
+    struct secondary_ass_queue_hint hint = {
+        .valid = true, .retained_id = 42, .duration = 41666667,
+        .physical = {
+            .phase = 1000000000, .phase_slot = 100, .interval = interval,
+            .last_base_slot = 108, .epoch = 5, .success_generation = 3,
+            .success_contiguous = true, .sync_segment_consistent = true,
+            .historical_id = 10, .success_first_id = 11, .success_last_id = 11,
+        },
+    };
+    struct secondary_ass_physical_point point =
+        secondary_ass_physical_point_at(&hint.physical, 110);
+    hint.sample = (struct secondary_ass_sample_snapshot){
+        .valid = true, .rate = 1e9 / (interval * divisor),
+        .speed = 1, .requested_speed = 1, .epoch = 5,
+        .next_slot = point.slot, .next_wall = point.wall, .divisor = divisor,
+        .phase_wall = hint.physical.phase, .phase_slot = 100, .interval = interval,
+    };
+    return hint;
+}
+
+int main(void)
+{
+    const int rates[] = {60, 120, 144, 165, 240, 360};
+    for (unsigned i = 0; i < sizeof(rates) / sizeof(rates[0]); i++) {
+        int64_t T = 1000000000 / rates[i];
+        int64_t divisor = rates[i] <= 120 ? 1 : rates[i] / 120 + (rates[i] % 120 != 0);
+        struct secondary_ass_queue_hint hint = fixture(T, divisor);
+        int64_t F = hint.sample.next_wall - 1000000;
+        int64_t oldlead = T + 2000000;
+        struct secondary_ass_queue_token token = secondary_ass_queue_lead_make(
+            &hint, &hint.sample, F, oldlead, 50000000, 500000);
+        CHECK(token.valid == (divisor > 1));
+        if (!token.valid)
+            continue;
+        CHECK(token.fresh_due == F);
+        CHECK(token.old_admission == F - oldlead);
+        CHECK(token.admission < token.old_admission);
+        CHECK(token.plan.target.slot == 110 && token.plan.base.slot == 110);
+        CHECK(token.plan.submit == hint.sample.next_wall - T +
+            (T / 4 < 1000000 ? T / 4 : 1000000));
+        CHECK(secondary_ass_queue_lead_current(&token, &hint.sample,
+            &hint.physical, 42, F, 500000));
+        // Feedback reexpresses one lattice with a newer anchor while the
+        // sampler still owns its previous draw coordinates. This must be a
+        // useful candidate, not an always-rejecting safety guard.
+        struct secondary_ass_queue_hint rebased = hint;
+        rebased.physical.phase += 2 * T;
+        rebased.physical.phase_slot += 2;
+        struct secondary_ass_queue_token same = secondary_ass_queue_lead_make(
+            &rebased, &hint.sample, F, oldlead, 50000000, 500000);
+        CHECK(same.valid && same.plan.target.wall == token.plan.target.wall &&
+            same.plan.submit == token.plan.submit && same.fresh_due == F);
+        CHECK(secondary_ass_queue_lead_current(&token, &hint.sample,
+            &rebased.physical, 42, F, 500000));
+        // A period refinement before capture uses the current physical
+        // projection. Neither the raw OSD snapshot nor its phase is written.
+        rebased.physical.interval++;
+        int64_t refined_D = secondary_ass_physical_point_at(
+            &rebased.physical, hint.sample.next_slot).wall;
+        same = secondary_ass_queue_lead_make(&rebased, &hint.sample,
+            refined_D - 1000000, oldlead, 50000000, 500000);
+        CHECK(same.valid && same.plan.interval == T + 1 &&
+            same.plan.target.wall == refined_D && hint.sample.interval == T);
+        CHECK(!secondary_ass_queue_lead_current(&token, &hint.sample,
+            &rebased.physical, 42, F, 500000));
+        // A post-capture wall change, even 1 ns, cannot rename chosen D/S.
+        rebased.physical.interval = T;
+        rebased.physical.phase++;
+        CHECK(!secondary_ass_queue_lead_current(&token, &hint.sample,
+            &rebased.physical, 42, F, 500000));
+        for (int64_t redraw = 500000; redraw <= 2000000; redraw += 500000)
+            CHECK(secondary_ass_queue_lead_make(&hint, &hint.sample, F,
+                oldlead, 50000000, redraw).valid);
+        CHECK(!secondary_ass_queue_lead_make(&hint, &hint.sample, F,
+            oldlead, 50000000, 5000000).valid);
+        int64_t tie_cost = (T / 4 < 1000000 ? T / 4 : 1000000) + 3000000;
+        CHECK(!secondary_ass_queue_lead_make(&hint, &hint.sample, F,
+            oldlead, 50000000, tie_cost).valid);
+        CHECK(!secondary_ass_queue_lead_make(&hint, &hint.sample,
+            hint.sample.next_wall + 1, oldlead, 50000000, 500000).valid);
+        for (int change = 0; change < 16; change++) {
+            struct secondary_ass_sample_snapshot sample = hint.sample;
+            struct secondary_ass_physical physical = hint.physical;
+            uint64_t retained = 42;
+            int64_t due = F, cost = 500000;
+            switch (change) {
+            case 0: sample.held = true; break;
+            case 1: sample.force = true; break;
+            case 2: sample.valid = false; break;
+            case 3: sample.next_slot += divisor; break;
+            case 4: sample.next_wall++; break;
+            case 5: sample.rate += 1; break;
+            case 6: sample.requested_speed += .1; break;
+            case 7: physical.epoch++; break;
+            case 8: physical.success_generation++; break;
+            case 9: physical.phase++; break;
+            case 10: physical.last_base_slot = 110; break;
+            case 11: physical.outlier_pending = true; break;
+            case 12: retained++; break;
+            case 13: due++; break;
+            case 14: cost = 5000000; break;
+            case 15: physical.sync_segment_consistent = false; break;
+            }
+            CHECK(!secondary_ass_queue_lead_current(&token, &sample,
+                &physical, retained, due, cost));
+        }
+        // The former no-earlier-cache-only proposal changes the joint event
+        // order at redraw=5 ms. Actual cache helper and plan ledger show why
+        // the new prepare/admission guard must refuse it.
+        struct secondary_ass_physical view = secondary_ass_present_plan_view(&hint.physical);
+        int64_t prepare = secondary_ass_physical_render_slot_time(&view,
+            hint.sample.next_wall, 5000000);
+        if (rates[i] == 144) {
+            CHECK(F - divisor * T - 2000000 < prepare && prepare < F - oldlead);
+            struct secondary_ass_physical after_cache = hint.physical;
+            struct secondary_ass_physical_point old_sample =
+                secondary_ass_physical_point_at(&after_cache, 110);
+            CHECK(secondary_ass_physical_submit_planned_point(&after_cache, 12,
+                after_cache.epoch, old_sample, old_sample));
+            struct secondary_ass_present_plan original = secondary_ass_present_plan_fresh(
+                &after_cache, F, secondary_ass_physical_point_at(&after_cache, 112));
+            CHECK(original.target.slot == 112 && token.plan.target.slot == 110);
+        }
+        hint.physical.interval = 0;
+        CHECK(!secondary_ass_queue_lead_make(&hint, &hint.sample, F,
+            oldlead, 50000000, 500000).valid);
+    }
+    printf("{\"checks\":%u,\"passed\":true}\n", checks);
+    return 0;
+}
diff --git a/test/secondary_ass_queue_stage.c b/test/secondary_ass_queue_stage.c
new file mode 100644
index 0000000000000000000000000000000000000000..c931515e24c8e9eb37aa44aa605ba685ef0e009b
--- /dev/null
+++ b/test/secondary_ass_queue_stage.c
@@ -0,0 +1,169 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include <inttypes.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "video/out/secondary_ass_queue_stage.h"
+
+// Explicit checks remain enabled under NDEBUG. This pure scalar test proves
+// admission and lifecycle boundaries, not frame pacing, AO timing or a VO
+// loop's implementation. The runtime flag stays the caller's responsibility.
+static unsigned checks;
+#define CHECK(x) do { checks++; if (!(x)) { \
+    fprintf(stderr, "queue-stage check %u failed: %s:%d: %s\n", \
+            checks, __FILE__, __LINE__, #x); exit(2); } } while (0)
+
+static struct secondary_ass_queue_stage make(void)
+{
+    return secondary_ass_queue_stage_make(20, 1000000000, 0, 9000000, 50000000);
+}
+
+static struct secondary_ass_queue_stage bound(void)
+{
+    struct secondary_ass_queue_stage admission = make();
+    return secondary_ass_queue_stage_bind(&admission, 20, 21, 1000000000, 0);
+}
+
+static void arithmetic_boundaries(void)
+{
+    struct secondary_ass_queue_stage s = make();
+    CHECK(s.valid && !s.bound && !s.queued_id);
+    CHECK(s.due == 1000000000 && s.admission == 950000000 && s.resume == 991000000);
+    CHECK(!secondary_ass_queue_stage_current(&s, 20, 21, s.pts, s.offset));
+    CHECK(!secondary_ass_queue_stage_make(0, 1000000000, 0, 1, 50000000).valid);
+    CHECK(!secondary_ass_queue_stage_make(1, 0, 0, 1, 50000000).valid);
+    CHECK(!secondary_ass_queue_stage_make(1, -1, 0, 1, 50000000).valid);
+    CHECK(!secondary_ass_queue_stage_make(1, INT64_MIN, 0, 1, 50000000).valid);
+    CHECK(!secondary_ass_queue_stage_make(1, 1000000000, -1, 1, 50000000).valid);
+    CHECK(!secondary_ass_queue_stage_make(1, 1000000000, INT64_MIN, 1, 50000000).valid);
+    CHECK(!secondary_ass_queue_stage_make(1, 1000000000, 1000000000, 1, 50000000).valid);
+    CHECK(!secondary_ass_queue_stage_make(1, 1000000000, INT64_MAX, 1, 50000000).valid);
+    CHECK(!secondary_ass_queue_stage_make(1, 1000000000, 0, 0, 50000000).valid);
+    CHECK(!secondary_ass_queue_stage_make(1, 1000000000, 0, -1, 50000000).valid);
+    CHECK(!secondary_ass_queue_stage_make(1, 1000000000, 0, INT64_MIN, 50000000).valid);
+    CHECK(!secondary_ass_queue_stage_make(1, 1000000000, 0, 50000000, 50000000).valid);
+    CHECK(!secondary_ass_queue_stage_make(1, 1000000000, 0, 60000000, INT64_MAX).valid);
+    CHECK(!secondary_ass_queue_stage_make(1, 1000000000, 0, INT64_MAX, INT64_MAX).valid);
+    CHECK(!secondary_ass_queue_stage_make(1, 1000000000, 0, 1, 0).valid);
+    CHECK(!secondary_ass_queue_stage_make(1, 1000000000, 0, 1, -1).valid);
+    CHECK(!secondary_ass_queue_stage_make(1, 50000000, 0, 1, 50000000).valid);
+    s = secondary_ass_queue_stage_make(1, 50000001, 0, 1, 50000000);
+    CHECK(s.valid && s.admission == 1 && s.resume == 50000000);
+    s = secondary_ass_queue_stage_make(1, INT64_MAX, 0, 1, INT64_MAX);
+    CHECK(s.valid && s.max_lead == 50000000);
+    CHECK(s.admission == INT64_MAX - 50000000 && s.resume == INT64_MAX - 1);
+    CHECK(!secondary_ass_queue_stage_make(1, INT64_MAX, INT64_MAX-1, 1, 50000000).valid);
+    s = secondary_ass_queue_stage_make(1, 1000000000, 0, 1, 2);
+    CHECK(s.valid && s.admission == 999999998 && s.resume == 999999999);
+    s = secondary_ass_queue_stage_make(1, 1000000000, 0, 49999999, 50000000);
+    CHECK(s.valid && s.resume - s.admission == 1);
+    s = secondary_ass_queue_stage_make(1, 1000000000, 2000000, 9000000, 50000000);
+    CHECK(s.valid && s.due == 998000000 && s.resume == 989000000);
+    s = secondary_ass_queue_stage_make(UINT64_MAX, 1000000000, 0, 1, 50000000);
+    CHECK(s.valid);
+    CHECK(!secondary_ass_queue_stage_bind(&s, UINT64_MAX, 0, s.pts, s.offset).valid);
+}
+
+static void actual_queue_binding(void)
+{
+    struct secondary_ass_queue_stage a = make(), s = bound();
+    CHECK(s.valid && s.bound && s.queued_id == 21);
+    CHECK(secondary_ass_queue_stage_current(&s, 20, 21, 1000000000, 0));
+    CHECK(!secondary_ass_queue_stage_bind(NULL, 20, 21, 1000000000, 0).valid);
+    CHECK(!secondary_ass_queue_stage_bind(&s, 20, 21, s.pts, s.offset).valid);
+    CHECK(!secondary_ass_queue_stage_bind(&a, 19, 21, a.pts, a.offset).valid);
+    CHECK(!secondary_ass_queue_stage_bind(&a, 20, 20, a.pts, a.offset).valid);
+    CHECK(!secondary_ass_queue_stage_bind(&a, 20, 0, a.pts, a.offset).valid);
+    CHECK(!secondary_ass_queue_stage_bind(&a, 20, 19, a.pts, a.offset).valid);
+    CHECK(!secondary_ass_queue_stage_bind(&a, 20, 21, 0, 0).valid);
+    CHECK(!secondary_ass_queue_stage_bind(&a, 20, 21, INT64_MIN, 0).valid);
+    CHECK(!secondary_ass_queue_stage_bind(&a, 20, 21, 1000000000, -1).valid);
+    CHECK(!secondary_ass_queue_stage_bind(&a, 20, 21, 50000000, 0).valid);
+    s = secondary_ass_queue_stage_bind(&a, 20, 21, 995000000, 2000000);
+    CHECK(s.valid && s.pts == 995000000 && s.offset == 2000000);
+    CHECK(s.due == 993000000 && s.admission == 943000000 && s.resume == 984000000);
+    CHECK(s.resume != a.resume); // actual committed F is used, not proposal F
+    s = secondary_ass_queue_stage_bind(&a, 20, 21, 1005000000, 0);
+    CHECK(s.valid && s.resume == 996000000 && s.admission == 955000000);
+    // Scalar validity does not authorize queue before actual admission.
+    int64_t now = 952000000;
+    CHECK(now < s.admission);
+    // The root VO integration must reject this early actual-F bind as a grant.
+    CHECK(!secondary_ass_queue_stage_current(NULL, 20, 21, a.pts, a.offset));
+    s = bound();
+    CHECK(!secondary_ass_queue_stage_current(&s, 19, 21, s.pts, s.offset));
+    CHECK(!secondary_ass_queue_stage_current(&s, 20, 22, s.pts, s.offset));
+    CHECK(!secondary_ass_queue_stage_current(&s, 20, 0, s.pts, s.offset));
+    CHECK(!secondary_ass_queue_stage_current(&s, 20, 21, s.pts - 1, s.offset));
+    CHECK(!secondary_ass_queue_stage_current(&s, 20, 21, s.pts, s.offset + 1));
+    CHECK(!secondary_ass_queue_stage_current(&s, 20, 21, s.pts, -1));
+    s.resume++;
+    CHECK(!secondary_ass_queue_stage_current(&s, 20, 21, s.pts, s.offset));
+    s = bound(); s.admission++;
+    CHECK(!secondary_ass_queue_stage_current(&s, 20, 21, s.pts, s.offset));
+    s = bound(); s.due++;
+    CHECK(!secondary_ass_queue_stage_current(&s, 20, 21, s.pts, s.offset));
+    a = make(); a.resume++;
+    CHECK(!secondary_ass_queue_stage_bind(&a, 20, 21, a.pts, a.offset).valid);
+    a = make(); a.queued_id = 21;
+    CHECK(!secondary_ass_queue_stage_bind(&a, 20, 21, a.pts, a.offset).valid);
+    s = bound(); s.max_lead = 50000001;
+    CHECK(!secondary_ass_queue_stage_current(&s, 20, 21, s.pts, s.offset));
+}
+
+static void lifecycle_and_finite_holds(void)
+{
+    // Each scenario represents a caller clearing authority at that boundary:
+    // seek, reset, pause, resize, sync-mode switch, shutdown, queued promotion,
+    // queued cancellation. It does not stand in for actual VO source coverage.
+    for (unsigned scenario = 0; scenario < 8; scenario++) {
+        struct secondary_ass_queue_stage s = bound();
+        CHECK(secondary_ass_queue_stage_current(&s, 20, 21, s.pts, s.offset));
+        secondary_ass_queue_stage_clear(&s);
+        CHECK(!s.valid && !s.bound && !s.resume && !s.admission && !s.queued_id);
+        CHECK(!secondary_ass_queue_stage_current(&s, 20, 21, 1000000000, 0));
+        // A new frame is not granted permission by old scalar values.
+        CHECK(!secondary_ass_queue_stage_current(&s, 20, 22, 1010000000, 0));
+    }
+    secondary_ass_queue_stage_clear(NULL);
+    CHECK(true);
+    struct secondary_ass_queue_stage s = bound();
+    int64_t original_resume = s.resume;
+    // Continuous cached draws/physical feedback must not slide this boundary.
+    for (int n = 0; n < 64; n++) {
+        int64_t now = s.admission + n * (s.resume - s.admission) / 64;
+        CHECK(now < s.resume);
+        CHECK(secondary_ass_queue_stage_current(&s, 20, 21, s.pts, s.offset));
+        CHECK(s.resume == original_resume);
+    }
+    CHECK(s.resume - s.admission == 41000000);
+    CHECK(!(original_resume < s.resume)); // equality releases the held frame
+    CHECK(!(original_resume + 1 < s.resume));
+    // An earlier current-frame end or core wakeup must survive the VO's
+    // timer min. This models a boundary the actual caller must preserve.
+    int64_t frame_end = s.admission + 1000000;
+    int64_t wakeup = s.admission + 500000;
+    int64_t wait_until = s.resume;
+    if (frame_end < wait_until) wait_until = frame_end;
+    if (wakeup < wait_until) wait_until = wakeup;
+    CHECK(wait_until == wakeup && wait_until < frame_end && frame_end < s.resume);
+    // The old hold-branch assignment would erase those earlier deadlines.
+    int64_t overwritten_wait = s.resume;
+    CHECK(overwritten_wait > frame_end && overwritten_wait > wakeup);
+    secondary_ass_queue_stage_clear(&s); // stop must never wait for a timer
+    CHECK(!s.resume && !s.valid);
+    s = bound();
+    CHECK(!secondary_ass_queue_stage_current(&s, 20, 22, s.pts, s.offset));
+    secondary_ass_queue_stage_clear(&s);
+    CHECK(!s.resume); // do not transplant the old hold to a different frame
+}
+
+int main(void)
+{
+    arithmetic_boundaries();
+    actual_queue_binding();
+    lifecycle_and_finite_holds();
+    printf("secondary_ass_queue_stage: %u checks passed\n", checks);
+    return 0;
+}
diff --git a/test/secondary_ass_stage_prefix.c b/test/secondary_ass_stage_prefix.c
new file mode 100644
index 0000000000000000000000000000000000000000..12e77e5d4b415e2918bdb0f35be7cc02b916d2e6
--- /dev/null
+++ b/test/secondary_ass_stage_prefix.c
@@ -0,0 +1,421 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "video/out/secondary_ass_stage_prefix.h"
+
+// Calls the actual production headers and unchanged physical feedback chain.
+// Synthetic QPC/count input is CPU evidence, not scanout or VO-thread proof.
+static unsigned long long checks, feedback_frames;
+#define CHECK(x) do { checks++; if (!(x)) { \
+    fprintf(stderr, "stage-prefix check %llu failed at %d: %s\n", \
+            checks, __LINE__, #x); exit(2); } } while (0)
+
+static const int64_t origin = INT64_C(1000000000);
+
+struct fixture {
+    struct secondary_ass_physical p;
+    struct secondary_ass_clock clock;
+    struct secondary_ass_sampler sampler;
+    struct secondary_ass_queue_stage stage;
+    struct secondary_ass_stage_prefix prefix;
+    int64_t divisor;
+};
+
+static struct secondary_ass_sample_snapshot snapshot(const struct fixture *f)
+{
+    const struct secondary_ass_sampler *s = &f->sampler;
+    return (struct secondary_ass_sample_snapshot){
+        .valid = s->valid && s->physical_slots, .held = false, .force = s->force,
+        .rate = s->rate, .speed = 1, .requested_speed = 1, .epoch = s->epoch,
+        .origin_slot = s->origin_slot,
+        .sample_slot = s->origin_slot + (int64_t)s->tick * s->divisor,
+        .display_forecast = s->display_forecast, .sample_forced = false,
+        .next_slot = secondary_ass_sampler_next_slot(s),
+        .next_wall = secondary_ass_sampler_next_wall(s), .divisor = s->divisor,
+        .phase_wall = s->phase_wall, .phase_slot = s->phase_slot,
+        .interval = s->physical_interval,
+    };
+}
+
+static bool sample(struct fixture *f, const struct secondary_ass_present_plan *plan)
+{
+    double rate = f->sampler.valid ? f->sampler.rate :
+        1e9 / ((double)f->p.interval * f->divisor);
+    return secondary_ass_sampler_update_physical_forecast(&f->sampler,
+        &f->clock, rate, plan->target.wall, plan->base.slot,
+        plan->target.slot, f->p.phase, f->p.phase_slot,
+        f->p.interval, f->p.epoch);
+}
+
+static void feedback(struct fixture *f,
+    const struct secondary_ass_present_plan *plan, uint64_t id,
+    uint64_t history_id, struct secondary_ass_physical_point history,
+    struct secondary_ass_physical_point sync)
+{
+    // Real VO ordering: immutable base/target registration, observed raw
+    // history exactly once without legacy re-registration, successful Sync1.
+    CHECK(secondary_ass_present_plan_current(&f->p, plan));
+    CHECK(secondary_ass_physical_submit_planned_point(&f->p, id, plan->epoch,
+                                                     plan->base, plan->target));
+    f->p.last_submit_id = id;
+    secondary_ass_physical_update_observed(&f->p, false, 0, plan->target,
+        sync.wall, sync.wall, (uint32_t)sync.slot, (uint32_t)history.slot,
+        history_id, f->p.interval);
+    secondary_ass_physical_record_present(&f->p, true, id, 3, 1);
+    CHECK(f->p.success_last_id == id && f->p.success_contiguous);
+    CHECK(f->p.historical_id == history_id && f->p.phase_slot == history.slot);
+    feedback_frames++;
+}
+
+static struct fixture fixture(int hz, int64_t divisor, int H)
+{
+    int64_t T = INT64_C(1000000000) / hz;
+    struct fixture f = {
+        .p = {
+            .phase = origin, .phase_slot = 100, .interval = T, .epoch = 7,
+            .sync_qpc_ns = origin, .sync_count = 100, .sync_slot = 100,
+            .sync_segment_consistent = true, .measure_qpc_ns = origin,
+            .measure_count = 100, .periods = {T, T, T},
+            .period_count = 3, .period_next = 3,
+            .delay = H, .delay_samples = {H, H, H}, .delay_count = 3,
+            .success_generation = 3,
+        },
+        .clock = {.valid = true, .pts = 10, .speed = 1, .wall = origin},
+        .divisor = divisor,
+    };
+    struct secondary_ass_physical_point G =
+        secondary_ass_physical_point_at(&f.p, 110);
+    struct secondary_ass_present_plan first =
+        secondary_ass_present_plan_cache_forecast(&f.p, G);
+    CHECK(first.valid && sample(&f, &first));
+    feedback(&f, &first, 1, 1, first.target, first.target);
+    struct secondary_ass_sample_snapshot s = snapshot(&f);
+    struct secondary_ass_physical_point F = secondary_ass_physical_point_at(
+        &f.p, s.next_slot + 4 * divisor);
+    struct secondary_ass_queue_stage a = secondary_ass_queue_stage_make(
+        20, F.wall, 0, 9000000, 50000000);
+    f.stage = secondary_ass_queue_stage_bind(&a, 20, 21, F.wall, 0);
+    CHECK(f.stage.valid && f.stage.bound);
+    CHECK(secondary_ass_stage_prefix_begin(&f.prefix, &f.stage, &s, &f.p));
+    CHECK(f.prefix.valid && f.prefix.initialized && f.prefix.next_slot == s.next_slot);
+    return f;
+}
+
+static struct secondary_ass_present_plan advance(struct fixture *f,
+    struct secondary_ass_sample_snapshot *before,
+    struct secondary_ass_sample_snapshot *after, uint64_t id)
+{
+    *before = snapshot(f);
+    struct secondary_ass_physical_point G =
+        secondary_ass_physical_point_at(&f->p, before->next_slot);
+    struct secondary_ass_present_plan plan =
+        secondary_ass_present_plan_cache_forecast(&f->p, G);
+    CHECK(plan.valid && sample(f, &plan));
+    feedback(f, &plan, id, id, plan.target, plan.target);
+    *after = snapshot(f);
+    return plan;
+}
+
+static void real_chains(void)
+{
+    const int rates[] = {60, 120, 144, 165, 240, 360};
+    const int lags[] = {0, 1, 3};
+    for (unsigned r = 0; r < sizeof(rates)/sizeof(rates[0]); r++) {
+        for (int64_t N = 1; N <= 2; N++) {
+            for (int H = 0; H <= 1; H++) {
+                for (unsigned lag_index = 0; lag_index < sizeof(lags)/sizeof(lags[0]); lag_index++) {
+                    struct fixture f = fixture(rates[r], N, H);
+                    struct secondary_ass_present_plan saved[81] = {0};
+                    saved[0].target = secondary_ass_physical_point_at(&f.p, 110 + H);
+                    for (int k = 1; k <= 80; k++) {
+                        struct secondary_ass_sample_snapshot before = snapshot(&f);
+                        int64_t Gslot = 110 + k*N;
+                        CHECK(before.next_slot == Gslot);
+                        struct secondary_ass_present_plan plan = secondary_ass_present_plan_cache_forecast(
+                            &f.p, secondary_ass_physical_point_at(&f.p, Gslot));
+                        CHECK(plan.valid && plan.base.slot == Gslot && sample(&f, &plan));
+                        saved[k] = plan;
+                        // Before Present, a moved sampler alone cannot grant.
+                        struct secondary_ass_stage_prefix shadow = f.prefix;
+                        struct secondary_ass_sample_snapshot selected = snapshot(&f);
+                        CHECK(!secondary_ass_stage_prefix_can_promote(&shadow, &f.stage, &selected, &f.p));
+                        CHECK(!shadow.valid && f.prefix.valid);
+                        int hist_index = k - lags[lag_index];
+                        if (hist_index < 0) hist_index = 0;
+                        feedback(&f, &plan, (uint64_t)k+1, (uint64_t)hist_index+1,
+                                 saved[hist_index].target, plan.target);
+                        struct secondary_ass_sample_snapshot after = snapshot(&f);
+                        struct secondary_ass_physical p_before = f.p;
+                        struct secondary_ass_queue_stage stage_before = f.stage;
+                        struct secondary_ass_sampler sampler_before = f.sampler;
+                        CHECK(secondary_ass_stage_prefix_resolve(&f.prefix, &plan,
+                            true, false, (uint64_t)k+1, &before, &after, &f.p));
+                        CHECK(f.prefix.next_slot == Gslot+N && f.prefix.last_id == (uint64_t)k+1);
+                        bool allowed = secondary_ass_stage_prefix_can_promote(
+                            &f.prefix, &f.stage, &after, &f.p);
+                        struct secondary_ass_physical_point next =
+                            secondary_ass_physical_point_at(&f.p, Gslot+N);
+                        CHECK(allowed == (next.wall >= f.stage.due));
+                        CHECK(f.prefix.valid && f.p.delay == H);
+                        CHECK(!memcmp(&f.p, &p_before, sizeof(f.p)));
+                        CHECK(!memcmp(&f.stage, &stage_before, sizeof(f.stage)));
+                        CHECK(!memcmp(&f.sampler, &sampler_before, sizeof(f.sampler)));
+                    }
+                }
+            }
+        }
+    }
+}
+
+static void failures_and_cursor(void)
+{
+    struct fixture f = fixture(144, 2, 1);
+    struct secondary_ass_sample_snapshot before = snapshot(&f);
+    struct secondary_ass_present_plan plan = secondary_ass_present_plan_cache_forecast(
+        &f.p, secondary_ass_physical_point_at(&f.p, before.next_slot));
+    CHECK(sample(&f, &plan));
+    struct secondary_ass_sample_snapshot after = snapshot(&f);
+    // Same as a failed Present: selected cursor moves; old register stays.
+    secondary_ass_physical_record_present(&f.p, false, 0, 3, 1);
+    CHECK(after.next_slot > before.next_slot && f.p.last_base_slot == 110);
+    CHECK(!secondary_ass_stage_prefix_resolve(&f.prefix, &plan,
+        false, false, 0, &before, &after, &f.p));
+    CHECK(!f.prefix.valid && f.prefix.initialized);
+    CHECK(!secondary_ass_stage_prefix_begin(&f.prefix, &f.stage, &before, &f.p));
+
+    f = fixture(144, 2, 1);
+    plan = advance(&f, &before, &after, 2);
+    // A genuine original MISS must revoke even if the later Present succeeded.
+    CHECK(!secondary_ass_stage_prefix_resolve(&f.prefix, &plan,
+        true, true, 2, &before, &after, &f.p));
+    CHECK(!f.prefix.valid);
+
+    f = fixture(144, 2, 1);
+    before = snapshot(&f);
+    plan = secondary_ass_present_plan_cache_forecast(&f.p,
+        secondary_ass_physical_point_at(&f.p, before.next_slot+2));
+    CHECK(sample(&f, &plan));
+    feedback(&f, &plan, 2, 2, plan.target, plan.target);
+    after = snapshot(&f);
+    CHECK(!secondary_ass_stage_prefix_resolve(&f.prefix, &plan,
+        true, false, 2, &before, &after, &f.p)); // skipped logical G
+
+    f = fixture(144, 2, 1);
+    plan = advance(&f, &before, &after, 2);
+    unsigned index = (f.p.next+31)%32;
+    f.p.submitted[index].base_slot = 0;
+    CHECK(!secondary_ass_stage_prefix_resolve(&f.prefix, &plan,
+        true, false, 2, &before, &after, &f.p)); // no exact registration
+
+    f = fixture(144, 2, 1);
+    plan = advance(&f, &before, &after, 2);
+    CHECK(secondary_ass_stage_prefix_resolve(&f.prefix, &plan,
+        true, false, 2, &before, &after, &f.p));
+    CHECK(!secondary_ass_stage_prefix_resolve(&f.prefix, &plan,
+        true, false, 2, &before, &after, &f.p)); // duplicate resolved tick
+
+    f = fixture(144, 2, 1);
+    before = snapshot(&f);
+    plan = secondary_ass_present_plan_cache_forecast(&f.p,
+        secondary_ass_physical_point_at(&f.p, before.next_slot));
+    CHECK(sample(&f, &plan));
+    struct secondary_ass_physical_point late = secondary_ass_physical_point_at(
+        &f.p, plan.target.slot+1);
+    feedback(&f, &plan, 2, 2, late, late);
+    after = snapshot(&f);
+    CHECK(!secondary_ass_stage_prefix_resolve(&f.prefix, &plan,
+        true, false, 2, &before, &after, &f.p)); // actual known late history
+    CHECK(late.slot-plan.target.slot == 1); // MISS is not renamed to success
+
+    // A forecast sample must not resolve against a legacy captured target,
+    // even while exact old history has not observed the new target mismatch.
+    f = fixture(144, 2, 1);
+    before = snapshot(&f);
+    struct secondary_ass_physical_point G = secondary_ass_physical_point_at(
+        &f.p, before.next_slot);
+    struct secondary_ass_present_plan forecast =
+        secondary_ass_present_plan_cache_forecast(&f.p, G);
+    plan = secondary_ass_present_plan_cache(&f.p, G);
+    CHECK(plan.valid && !plan.display_forecast && forecast.display_forecast);
+    CHECK(plan.target.slot == G.slot && forecast.target.slot == G.slot + 1);
+    CHECK(sample(&f, &forecast));
+    struct secondary_ass_physical_point old = secondary_ass_physical_point_at(
+        &f.p, 111);
+    feedback(&f, &plan, 2, 1, old, forecast.target);
+    after = snapshot(&f);
+    CHECK(after.display_forecast && after.sample_slot == G.slot);
+    CHECK(f.p.historical_id == 1 && f.p.success_last_id == 2);
+    CHECK(!secondary_ass_stage_prefix_resolve(&f.prefix, &plan,
+        true, false, 2, &before, &after, &f.p));
+    CHECK(!f.prefix.valid && f.prefix.initialized);
+}
+
+static void forced_origin_and_identity(void)
+{
+    struct fixture f;
+    struct secondary_ass_sample_snapshot before, after;
+    struct secondary_ass_present_plan plan;
+    for (unsigned mode = 0; mode < 13; mode++) {
+        f = fixture(144, 2, 1);
+        plan = advance(&f, &before, &after, 2);
+        switch (mode) {
+        case 0: before.force = true; break;
+        case 1: after.force = true; break;
+        case 2: before.sample_forced = true; break;
+        case 3: after.sample_forced = true; break;
+        case 4: after.origin_slot += 2; break;
+        case 5: after.display_forecast = false; break;
+        case 6: after.speed = 2; break;
+        case 7: after.requested_speed = 2; break;
+        case 8: after.rate += 1; break;
+        case 9: after.epoch++; break;
+        case 10: after.next_wall++; break;
+        case 11: after.sample_slot++; break;
+        case 12: after.held = true; break;
+        }
+        CHECK(!secondary_ass_stage_prefix_resolve(&f.prefix, &plan,
+            true, false, 2, &before, &after, &f.p));
+        CHECK(!f.prefix.valid && f.prefix.initialized);
+    }
+    // Actual same-tick forced forecast repaint preserves pose and logical G.
+    f = fixture(144, 2, 1);
+    before = snapshot(&f);
+    plan = secondary_ass_present_plan_cache_forecast(&f.p,
+        secondary_ass_physical_point_at(&f.p, before.sample_slot));
+    plan.valid = true; // attempted repaint, not a newly eligible plan
+    f.sampler.force = true;
+    CHECK(sample(&f, &plan));
+    after = snapshot(&f);
+    CHECK(after.next_slot == before.next_slot);
+    CHECK(!secondary_ass_stage_prefix_resolve(&f.prefix, &plan,
+        true, false, 2, &before, &after, &f.p));
+
+    // Concurrent force before sampling a genuinely new tick is cleared by
+    // the sampler. The actual OSD latch, not after.force, carries this fact.
+    f = fixture(144, 2, 1);
+    before = snapshot(&f);
+    plan = secondary_ass_present_plan_cache_forecast(&f.p,
+        secondary_ass_physical_point_at(&f.p, before.next_slot));
+    f.sampler.force = true;
+    bool actual_forced = f.sampler.force;
+    CHECK(sample(&f, &plan) && !f.sampler.force);
+    feedback(&f, &plan, 2, 2, plan.target, plan.target);
+    after = snapshot(&f);
+    after.sample_forced = actual_forced;
+    CHECK(!after.force && after.sample_forced);
+    CHECK(!secondary_ass_stage_prefix_resolve(&f.prefix, &plan,
+        true, false, 2, &before, &after, &f.p));
+}
+
+static void promotion_and_malformed(void)
+{
+    struct fixture f = fixture(144, 2, 1);
+    struct secondary_ass_sample_snapshot s = snapshot(&f);
+    CHECK(!secondary_ass_stage_prefix_can_promote(&f.prefix, &f.stage, &s, &f.p));
+    CHECK(f.prefix.valid); // G<F parks without losing later permission
+    struct secondary_ass_physical_point G =
+        secondary_ass_physical_point_at(&f.p, s.next_slot);
+    struct secondary_ass_queue_stage a = secondary_ass_queue_stage_make(
+        20, G.wall+1, 0, 9000000, 50000000);
+    f.stage = secondary_ass_queue_stage_bind(&a, 20, 21, G.wall+1, 0);
+    secondary_ass_stage_prefix_clear(&f.prefix);
+    CHECK(secondary_ass_stage_prefix_begin(&f.prefix, &f.stage, &s, &f.p));
+    CHECK(!secondary_ass_stage_prefix_can_promote(&f.prefix, &f.stage, &s, &f.p));
+    f.p.phase += 2; // accepted same-integer-lattice anchor jitter, no reset
+    CHECK(secondary_ass_stage_prefix_can_promote(&f.prefix, &f.stage, &s, &f.p));
+    CHECK(f.prefix.valid);
+    f.p.phase -= 3;
+    CHECK(!secondary_ass_stage_prefix_can_promote(&f.prefix, &f.stage, &s, &f.p));
+    CHECK(f.prefix.valid && f.p.epoch == 7 && f.p.delay == 1);
+
+    for (unsigned mode = 0; mode < 16; mode++) {
+        f = fixture(144, 2, 1); s = snapshot(&f);
+        switch (mode) {
+        case 0: s.force = true; break;
+        case 1: s.sample_forced = true; break;
+        case 2: s.origin_slot += 2; break;
+        case 3: s.rate = NAN; break;
+        case 4: s.speed = INFINITY; break;
+        case 5: s.requested_speed = 0; break;
+        case 6: f.p.epoch++; break;
+        case 7: f.p.success_generation++; break;
+        case 8: f.p.outlier_pending = true; break;
+        case 9: f.p.sync_segment_consistent = false; break;
+        case 10: f.p.success_contiguous = false; break;
+        case 11: f.stage.queued_id++; break;
+        case 12: f.stage.retained_id--; break;
+        case 13: f.stage.resume++; break;
+        case 14: f.p.last_base_slot += 2; break;
+        case 15: f.p.next = 32; break;
+        }
+        CHECK(!secondary_ass_stage_prefix_can_promote(&f.prefix, &f.stage, &s, &f.p));
+        CHECK(!f.prefix.valid && f.prefix.initialized);
+    }
+    f = fixture(144, 2, 1); s = snapshot(&f);
+    unsigned last = (f.p.next+31)%32;
+    f.p.submitted[(last+1)%32] = f.p.submitted[last];
+    struct secondary_ass_stage_prefix fresh = {0};
+    CHECK(!secondary_ass_stage_prefix_begin(&fresh, &f.stage, &s, &f.p));
+    CHECK(fresh.initialized && !fresh.valid);
+    f.p.submitted[(last+1)%32].id = 0;
+    CHECK(!secondary_ass_stage_prefix_begin(&fresh, &f.stage, &s, &f.p));
+    secondary_ass_stage_prefix_clear(&fresh);
+    CHECK(secondary_ass_stage_prefix_begin(&fresh, &f.stage, &s, &f.p));
+    secondary_ass_stage_prefix_invalidate(&fresh);
+    CHECK(!fresh.valid && fresh.initialized);
+    CHECK(!secondary_ass_stage_prefix_begin(&fresh, &f.stage, &s, &f.p));
+    // Even a malformed nonzero, uninitialized storage cannot retain an old
+    // valid bit when its first attempted begin lacks a current bound stage.
+    fresh = f.prefix;
+    fresh.initialized = false;
+    CHECK(!secondary_ass_stage_prefix_begin(&fresh, NULL, &s, &f.p));
+    CHECK(fresh.initialized && !fresh.valid);
+    for (unsigned mode = 0; mode < 2; mode++) {
+        f = fixture(144, 2, 1);
+        s = snapshot(&f);
+        struct secondary_ass_physical unknown = f.p;
+        fresh = (struct secondary_ass_stage_prefix){0};
+        if (mode == 0)
+            s.valid = false;
+        else
+            unknown.sync_segment_consistent = false;
+        CHECK(!secondary_ass_stage_prefix_begin(&fresh, &f.stage, &s, &unknown));
+        CHECK(fresh.initialized && !fresh.valid);
+        CHECK(secondary_ass_stage_prefix_stage_equal(&fresh.stage, &f.stage));
+        // Exact root render boundary: UNKNOWN did not end this bound stage,
+        // so a later usable snapshot must not turn its failed begin into new
+        // permission. The real sampler/ledger remain available but untouched.
+        if (fresh.initialized &&
+            !secondary_ass_stage_prefix_stage_equal(&fresh.stage, &f.stage))
+            secondary_ass_stage_prefix_clear(&fresh);
+        CHECK(fresh.initialized && !fresh.valid);
+        s = snapshot(&f);
+        CHECK(!secondary_ass_stage_prefix_begin(&fresh, &f.stage, &s, &f.p));
+        CHECK(fresh.initialized && !fresh.valid);
+        secondary_ass_stage_prefix_clear(&fresh); // an actual stage end
+        CHECK(secondary_ass_stage_prefix_begin(&fresh, &f.stage, &s, &f.p));
+    }
+    CHECK(!secondary_ass_stage_prefix_begin(NULL, &f.stage, &s, &f.p));
+    CHECK(!secondary_ass_stage_prefix_resolve(NULL, NULL, false, true, 0, NULL, NULL, NULL));
+    CHECK(!secondary_ass_stage_prefix_can_promote(NULL, NULL, NULL, NULL));
+    secondary_ass_stage_prefix_clear(NULL);
+    secondary_ass_stage_prefix_invalidate(NULL);
+    fresh = (struct secondary_ass_stage_prefix){0};
+    s.next_slot = INT64_MAX; s.sample_slot = INT64_MAX;
+    CHECK(!secondary_ass_stage_prefix_begin(&fresh, &f.stage, &s, &f.p));
+    CHECK(fresh.initialized && !fresh.valid);
+}
+
+int main(void)
+{
+    real_chains();
+    failures_and_cursor();
+    forced_origin_and_identity();
+    promotion_and_malformed();
+    printf("secondary_ass_stage_prefix: %llu checks, %llu feedback frames passed\n",
+           checks, feedback_frames);
+    return 0;
+}
