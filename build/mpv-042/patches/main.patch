+
+static void secondary_observe_flip_budget(struct vo *vo,
+    const struct vo_vsync_info *vsync,
+    const struct secondary_ass_present_plan *plan, int64_t begin,
+    int64_t vo_wait, int64_t flip_begin, bool guard_armed, bool fresh,
+    bool neutral_admitted)
+{
+    struct vo_internal *in = vo->in;
+    if (!in->secondary_split_budget)
+        return;
+    int64_t end = mp_time_ns();
+    bool valid = guard_armed && plan && (plan->valid || neutral_admitted) &&
+        !vsync->secondary_phase_reset &&
+        vsync->secondary_submit_valid && vsync->secondary_submit_sync_interval == 1 &&
+        vsync->secondary_submit_generation == plan->generation &&
+        plan->epoch == in->secondary_physical.epoch &&
+        plan->generation == in->secondary_physical.success_generation &&
+        in->secondary_physical.success_contiguous &&
+        (!neutral_admitted || (!in->secondary_physical.outlier_pending &&
+            !in->secondary_physical.history_floor_slot &&
+            vsync->secondary_submit_id == in->secondary_physical.success_last_id));
+    bool observed = secondary_ass_flip_budget_observe(&in->secondary_flip_budget,
+        valid, plan ? plan->epoch : 0, plan ? plan->generation : 0,
+        vsync->secondary_submit_id, begin, end, vo_wait);
+    if (mp_ass_pacing_enabled(vo->global)) {
+        struct mp_ass_pacing_record record = {
+            .event_ns = end, .vo_seq = vo->pacing_vo_seq,
+            .draw_seq = vo->pacing_draw_seq, .frame_id = vo->pacing_frame_id,
+            .epoch = in->secondary_physical.epoch,
+            .generation = in->secondary_physical.success_generation,
+            .flags = (uint64_t)fresh | ((uint64_t)valid << 1) |
+                ((uint64_t)observed << 2) | ((uint64_t)guard_armed << 3) |
+                ((uint64_t)neutral_admitted << 4),
+            .v = {(int64_t)vsync->secondary_submit_id, begin, end, vo_wait,
+                flip_begin, in->secondary_flip_budget.cost,
+                in->secondary_redraw_block_cost, in->secondary_redraw_cost},
+        };
+        mp_ass_pacing_record(vo->global, MP_ASS_PACING_FLIP_BUDGET, &record);
+    }
+    if (in->secondary_trace)
+    MP_INFO(vo, "native-ass-flip-budget: fresh=%d id=%"PRIu64
+        " valid=%d observed=%d guard_armed=%d begin_ns=%"PRId64" end_ns=%"PRId64
+        " vo_wait_ns=%"PRId64" flip_begin_ns=%"PRId64
+        " envelope_ns=%"PRId64" sustained_ns=%"PRId64
+        " legacy_block_ns=%"PRId64" redraw_ns=%"PRId64
+        " epoch=%"PRIu64" generation=%"PRIu64"\n",
+        fresh, vsync->secondary_submit_id, valid, observed, guard_armed, begin, end,
+        vo_wait, flip_begin,
+        begin > 0 && end > begin && vo_wait >= 0 && end - begin > vo_wait
+            ? end - begin - vo_wait : 0,
+        in->secondary_flip_budget.cost, in->secondary_redraw_block_cost,
+        in->secondary_redraw_cost, in->secondary_physical.epoch,
+        in->secondary_physical.success_generation);
+}
