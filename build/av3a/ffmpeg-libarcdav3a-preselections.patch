+static int arcdav3a_json_add(char **next, size_t *left, const char *fmt, ...)
+{
+	va_list args;
+	int length;
+	va_start(args, fmt);
+	length = vsnprintf(*next, *left, fmt, args);
+	va_end(args);
+	if (length < 0 || (size_t)length >= *left)
+		return AVERROR(ENOSPC);
+	*next += length;
+	*left -= length;
+	return 0;
+}
+
+static int arcdav3a_publish_contents(arcdav3a_context *h, int applied)
+{
+	const AVS3SpatialContents *table = &h->contents;
+	/* Export only an applied selection that belongs to this output graph. */
+	int selected_present = 0;
+	for (int i = 0; i < table->num_contents && i < 4; i++)
+		selected_present |= table->contents[i].content_id == h->content_id;
+	applied = applied && table->available && table->status == AVS3_CONTENTS_OK &&
+		h->spatial_render == AV3A_RENDER_BINAURAL && selected_present;
+	const char *status = table->status == AVS3_CONTENTS_OK ? "ok" :
+		table->status == AVS3_CONTENTS_NO_METADATA ? "no-metadata" :
+		table->status == AVS3_CONTENTS_UNSUPPORTED ? "unsupported" : "invalid";
+	char json[8192], *next = json;
+	size_t left = sizeof(json);
+	int i, j;
+	char *copy;
+
+#define ADD(...) do { if (arcdav3a_json_add(&next, &left, __VA_ARGS__) < 0) \
+	return AVERROR(ENOSPC); } while (0)
+	ADD("{\"version\":1,\"status\":\"%s\",\"render\":\"%s\","
+	    "\"selected\":%d,\"applied\":%s,\"contents\":[", status,
+	    h->spatial_render == AV3A_RENDER_BINAURAL ? "binaural" : "native",
+	    h->content_id, applied ? "true" : "false");
+	for (i = 0; i < table->num_contents; i++) {
+		const AVS3SpatialContent *content = &table->contents[i];
+		if (content->num_objects < 0 || content->num_objects > 8)
+			return AVERROR_INVALIDDATA;
+		ADD("%s{\"id\":%d,\"mask\":%u,\"objects\":[", i ? "," : "",
+		    content->content_id, (unsigned)content->pcm_channel_mask);
+		for (j = 0; j < content->num_objects; j++)
+			ADD("%s%d", j ? "," : "", content->object_ids[j]);
+		ADD("]}");
+	}
+	ADD("],\"objects\":[");
+	for (i = 0; i < table->num_objects; i++) {
+		const AVS3SpatialContentObject *object = &table->objects[i];
+		ADD("%s{\"id\":%d,\"mask\":%u,\"name\":\"", i ? "," : "",
+		    object->object_id, (unsigned)object->pcm_channel_mask);
+		/* The SDK does not declare a character encoding for objectName.
+		 * Publish printable ASCII only; IDs remain authoritative. */
+		for (j = 0; j < sizeof(object->name) && object->name[j]; j++) {
+			unsigned char c = object->name[j];
+			if (c < 32 || c > 126)
+				continue;
+			if (c == '"' || c == '\\')
+				ADD("\\%c", c);
+			else
+				ADD("%c", c);
+		}
+		ADD("\"}");
+	}
+	ADD("]}");
+#undef ADD
+	if (h->contents_json && !strcmp(h->contents_json, json))
+		return 0;
+	copy = av_strdup(json);
+	if (!copy)
+		return AVERROR(ENOMEM);
+	av_freep(&h->contents_json);
+	h->contents_json = copy;
+	return 0;
+}
