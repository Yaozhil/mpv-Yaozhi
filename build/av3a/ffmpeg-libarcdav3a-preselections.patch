+/* Selection is applied to each decoded block, before the renderer consumes
+ * PCM. Native transport output is never changed by a content selection. */
+static int arcdav3a_content_mask(arcdav3a_context *h, uint32_t *mask,
+				 int *applied)
+{
+	AVS3SpatialContents *table = &h->contents;
+	int ret, i;
+
+	memset(table, 0, sizeof(*table));
+	table->struct_size = sizeof(*table);
+	ret = avs3_get_spatial_contents(h->m_hAvs3, table);
+	*mask = UINT32_MAX;
+	*applied = 0;
+	if (ret == AVS3_DECODER_SUCCESS && table->available &&
+	    table->abi_version == AVS3_SPATIAL_CONTENTS_ABI_VERSION &&
+	    table->status == AVS3_CONTENTS_OK &&
+	    table->num_contents > 0 && table->num_contents <= 4 &&
+	    table->num_objects > 0 && table->num_objects <= 8 &&
+	    table->total_channels > 0 && table->total_channels <= 32) {
+		h->content_missing_frames = 0;
+		if (h->content_id < 0 || h->spatial_render != AV3A_RENDER_BINAURAL)
+			return 0;
+		for (i = 0; i < table->num_contents; i++) {
+			const AVS3SpatialContent *content = &table->contents[i];
+			if (content->content_id != h->content_id)
+				continue;
+			if (!content->pcm_channel_mask ||
+			    (table->total_channels < 32 &&
+			     content->pcm_channel_mask >> table->total_channels))
+				return AVERROR_INVALIDDATA;
+			*mask = content->pcm_channel_mask;
+			*applied = 1;
+			return 0;
+		}
+		return AVERROR(EINVAL);
+	}
+	/* Reject a malformed table even if the provider returned success. */
+	if (ret == AVS3_DECODER_SUCCESS || table->status == AVS3_CONTENTS_OK) {
+		table->available = 0;
+		table->status = AVS3_CONTENTS_INVALID;
+	}
+	table->num_contents = table->num_objects = 0;
+	if (h->content_id < 0 || h->spatial_render != AV3A_RENDER_BINAURAL)
+		return 0;
+	/* A seek may begin between repeated static metadata frames. Never play
+	 * unselected sources while waiting for the first complete scene graph. */
+	*mask = 0;
+	if (table->status == AVS3_CONTENTS_NO_METADATA &&
+	    h->content_missing_frames < 64) {
+		h->content_missing_frames++;
+		return 0;
+	}
+	return AVERROR_INVALIDDATA;
+}
