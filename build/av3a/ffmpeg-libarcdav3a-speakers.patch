diff --git a/libavcodec/libarcdav3a_speakers.h b/libavcodec/libarcdav3a_speakers.h
new file mode 100644
--- /dev/null
+++ b/libavcodec/libarcdav3a_speakers.h
@@ -0,0 +1,52 @@
+#ifndef LIBARCDAV3A_SPEAKERS_H
+#define LIBARCDAV3A_SPEAKERS_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <avs3a/avs3_spatial_metadata.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define AV3A_SPEAKERS_CHANNELS 12
+#define AV3A_SPEAKERS_MAX_FRAMES 8192
+
+typedef struct AV3ASpeakers AV3ASpeakers;
+
+enum AV3ASpeakersResult {
+    AV3A_SPEAKERS_OK = 0,
+    AV3A_SPEAKERS_INVALID = -1,
+    AV3A_SPEAKERS_UNSUPPORTED = -2,
+    AV3A_SPEAKERS_NOMEM = -3,
+    AV3A_SPEAKERS_INTERNAL = -4
+};
+
+/* Creates a point-object renderer for a standard 7.1.4 bed. No audio-device
+ * settings are changed. The implementation adds zero samples of latency.
+ * Recreate the renderer on seek, stream change, and audio reinitialization. */
+int av3a_speakers_create(AV3ASpeakers **out,
+                         const AVS3SpatialStreamInfo *info);
+void av3a_speakers_destroy(AV3ASpeakers *ctx);
+
+/* Capacities are scalar sample counts, not bytes or sample frames.
+ * Input: signed 16-bit interleaved decoder PCM in the SDK's transport order.
+ * Output: float interleaved FL FR FC LFE BL BR SL SR TFL TFR TBL TBR.
+ * Exactly frames * 12 samples are produced with no FIR tail or extra delay.
+ * The mask addresses transport PCM channels and is applied before panning;
+ * unselected tracks still advance their spatial interpolation state.
+ * Nonzero diffuseness, extent, divergence, lock, screen-reference and HOA
+ * are not supported by this deliberately bounded rendering subset. */
+int av3a_speakers_process(AV3ASpeakers *ctx,
+                          const AVS3SpatialStreamInfo *info,
+                          const AVS3SpatialFrame *metadata,
+                          const int16_t *pcm, size_t input_samples,
+                          size_t frames, uint32_t content_channel_mask,
+                          float *output, size_t output_samples);
+
+const char *av3a_speakers_error_string(int result);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libavcodec/libarcdav3a_speakers.cpp b/libavcodec/libarcdav3a_speakers.cpp
new file mode 100644
--- /dev/null
+++ b/libavcodec/libarcdav3a_speakers.cpp
@@ -0,0 +1,222 @@
+#include "libarcdav3a_speakers.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <memory>
+#include <new>
+#include <vector>
+#include <spatialaudio/GainInterp.h>
+#include <spatialaudio/LoudspeakerLayouts.h>
+#include <spatialaudio/RendererMetadata.h>
+#include <spatialaudio/adm/GainCalculator.h>
+
+namespace {
+constexpr int channels = AV3A_SPEAKERS_CHANNELS;
+constexpr int max_channels = AVS3_SPATIAL_MAX_CHANNELS;
+// Sourcecodeforplayer e7d244d: ChannelNumConfig::CHANNEL_CONFIG_MC_7_1_4.
+constexpr int sdk_7_1_4 = 10;
+constexpr double radians_to_degrees = 57.2957795130823208768;
+// BS.2051 / SDK: FL FR FC LFE SL SR BL BR TFL TFR TBL TBR.
+// Windows / FFmpeg: FL FR FC LFE BL BR SL SR TFL TFR TBL TBR.
+constexpr int canonical_to_sdk[channels] = {0, 1, 2, 3, 6, 7, 4, 5, 8, 9, 10, 11};
+
+bool bit_flag(int value) { return value == 0 || value == 1; }
+bool valid_gain(float value) { return std::isfinite(value) && value >= 0; }
+
+int validate_info(const AVS3SpatialStreamInfo *info) {
+    if (!info || info->struct_size < sizeof(*info) ||
+        info->abi_version != AVS3_SPATIAL_ABI_VERSION)
+        return AV3A_SPEAKERS_INVALID;
+    if (info->format != AVS3_SPATIAL_FORMAT_BED_OBJECTS ||
+        info->channel_config != sdk_7_1_4 || info->bed_channels != channels ||
+        info->object_channels < 1 || info->object_channels > max_channels - channels ||
+        info->total_channels != channels + info->object_channels ||
+        info->bit_depth != 16)
+        return AV3A_SPEAKERS_UNSUPPORTED;
+    if (info->sample_rate < 8000 || info->sample_rate > 192000 ||
+        info->frame_length <= 0 || info->frame_length > AV3A_SPEAKERS_MAX_FRAMES)
+        return AV3A_SPEAKERS_INVALID;
+    for (int c = 0; c < channels; ++c) {
+        if (!bit_flag(info->channel_gain_valid[c]) ||
+            !bit_flag(info->channel_muted[c]) ||
+            !bit_flag(info->channel_position_valid[c]) ||
+            (info->channel_gain_valid[c] && !valid_gain(info->channel_gain_linear[c])))
+            return AV3A_SPEAKERS_INVALID;
+        // Only the explicitly identified standard bed is handled. Do not
+        // silently discard custom DirectSpeaker positioning metadata.
+        if (info->channel_position_valid[c])
+            return AV3A_SPEAKERS_UNSUPPORTED;
+    }
+    return AV3A_SPEAKERS_OK;
+}
+
+int validate_object(const AVS3SpatialObjectFrame &object) {
+    if (!bit_flag(object.position_valid) || !bit_flag(object.muted) ||
+        !bit_flag(object.jump_position) || !bit_flag(object.gain_valid) ||
+        !bit_flag(object.extent_valid) || !bit_flag(object.divergence_valid) ||
+        !bit_flag(object.channel_lock_valid) || !bit_flag(object.screen_ref_valid) ||
+        (object.gain_valid && !valid_gain(object.gain_linear)) ||
+        !std::isfinite(object.diffuse))
+        return AV3A_SPEAKERS_INVALID;
+    if (object.diffuse != 0 || object.extent_valid || object.divergence_valid ||
+        object.channel_lock_valid || object.screen_ref_valid)
+        return AV3A_SPEAKERS_UNSUPPORTED;
+    if (!object.position_valid)
+        return object.muted ? AV3A_SPEAKERS_OK : AV3A_SPEAKERS_INVALID;
+    if (!std::isfinite(object.x) || !std::isfinite(object.y) || !std::isfinite(object.z))
+        return AV3A_SPEAKERS_INVALID;
+    const double radius = std::hypot(std::hypot(double(object.x), double(object.y)), double(object.z));
+    return radius > 1e-12 && std::isfinite(radius) ? AV3A_SPEAKERS_OK : AV3A_SPEAKERS_INVALID;
+}
+}
+
+struct AV3ASpeakers {
+    AVS3SpatialStreamInfo initial;
+    spaudio::Layout layout;
+    spaudio::adm::ObjectGainCalculator calculator;
+    std::vector<spaudio::GainInterp<double>> object_interpolation;
+    std::vector<spaudio::GainInterp<double>> bed_interpolation;
+    std::vector<double> direct, diffuse;
+    std::vector<float> mono, planar;
+    std::array<float *, channels> planes;
+
+    explicit AV3ASpeakers(const AVS3SpatialStreamInfo &info)
+        : initial(info), layout(spaudio::Layout::getMatchingLayout("4+7+0")),
+          calculator(layout), direct(channels), diffuse(channels),
+          mono(info.frame_length), planar(size_t(channels) * info.frame_length) {
+        for (int c = 0; c < info.object_channels; ++c)
+            object_interpolation.emplace_back(channels);
+        for (int c = 0; c < channels; ++c) {
+            bed_interpolation.emplace_back(1);
+            planes[c] = planar.data() + size_t(c) * info.frame_length;
+        }
+    }
+};
+
+extern "C" int av3a_speakers_create(AV3ASpeakers **out,
+                                    const AVS3SpatialStreamInfo *info) {
+    if (!out) return AV3A_SPEAKERS_INVALID;
+    *out = nullptr;
+    const int result = validate_info(info);
+    if (result) return result;
+    try {
+        *out = new AV3ASpeakers(*info);
+        return AV3A_SPEAKERS_OK;
+    } catch (const std::bad_alloc &) {
+        return AV3A_SPEAKERS_NOMEM;
+    } catch (...) {
+        return AV3A_SPEAKERS_INTERNAL;
+    }
+}
+
+extern "C" void av3a_speakers_destroy(AV3ASpeakers *ctx) {
+    delete ctx;
+}
+
+extern "C" int av3a_speakers_process(AV3ASpeakers *ctx,
+    const AVS3SpatialStreamInfo *info, const AVS3SpatialFrame *metadata,
+    const int16_t *pcm, size_t input_samples, size_t frames,
+    uint32_t content_channel_mask, float *output, size_t output_samples) {
+    if (!ctx || !output || !pcm || !frames || frames > AV3A_SPEAKERS_MAX_FRAMES ||
+        output_samples < frames * channels)
+        return AV3A_SPEAKERS_INVALID;
+    std::fill_n(output, frames * channels, 0.0f);
+    int result = validate_info(info);
+    if (result) return result;
+    if (frames != size_t(info->frame_length) || frames != size_t(ctx->initial.frame_length) ||
+        info->sample_rate != ctx->initial.sample_rate ||
+        info->total_channels != ctx->initial.total_channels ||
+        info->object_channels != ctx->initial.object_channels ||
+        input_samples < frames * size_t(info->total_channels))
+        return AV3A_SPEAKERS_INVALID;
+    if (!metadata || metadata->struct_size < sizeof(*metadata) ||
+        metadata->abi_version != AVS3_SPATIAL_ABI_VERSION ||
+        metadata->object_count != info->object_channels ||
+        !bit_flag(metadata->has_static_metadata) || !bit_flag(metadata->has_dynamic_metadata))
+        return AV3A_SPEAKERS_INVALID;
+    const uint32_t all_channels = info->total_channels == 32 ? UINT32_MAX :
+        (UINT32_C(1) << info->total_channels) - 1;
+    if (content_channel_mask & ~all_channels) return AV3A_SPEAKERS_INVALID;
+    uint32_t seen = 0;
+    for (int i = 0; i < metadata->object_count; ++i) {
+        const AVS3SpatialObjectFrame &object = metadata->objects[i];
+        if (object.pcm_channel < channels || object.pcm_channel >= info->total_channels)
+            return AV3A_SPEAKERS_INVALID;
+        const uint32_t bit = UINT32_C(1) << object.pcm_channel;
+        if (seen & bit) return AV3A_SPEAKERS_INVALID;
+        seen |= bit;
+        result = validate_object(object);
+        if (result) return result;
+    }
+    try {
+        std::fill(ctx->planar.begin(), ctx->planar.end(), 0.0f);
+        // Preserve all twelve bed tracks, including the dedicated LFE.
+        // This direct assignment is only for the validated standard bed;
+        // all Objects below are independently spatially rendered.
+        for (int c = 0; c < channels; ++c) {
+            const bool audible = !info->channel_muted[c] &&
+                (content_channel_mask & (UINT32_C(1) << c));
+            for (size_t f = 0; f < frames; ++f)
+                ctx->mono[f] = audible ? pcm[f * info->total_channels + c] / 32768.0f : 0.0f;
+            const double gain = info->channel_gain_valid[c] ? info->channel_gain_linear[c] : 1.0;
+            ctx->bed_interpolation[c].SetGainValue(gain, unsigned(frames));
+            float *plane[] = {ctx->planes[c]};
+            ctx->bed_interpolation[c].ProcessAccumul(ctx->mono.data(), plane, unsigned(frames));
+        }
+        for (int i = 0; i < metadata->object_count; ++i) {
+            const AVS3SpatialObjectFrame &object = metadata->objects[i];
+            const bool audible = !object.muted &&
+                (content_channel_mask & (UINT32_C(1) << object.pcm_channel));
+            for (size_t f = 0; f < frames; ++f)
+                ctx->mono[f] = audible ? pcm[f * info->total_channels + object.pcm_channel] / 32768.0f : 0.0f;
+            spaudio::ObjectMetadata mapped;
+            mapped.trackInd = unsigned(object.pcm_channel);
+            mapped.blockLength = unsigned(frames);
+            mapped.cartesian = false;
+            mapped.gain = object.gain_valid ? object.gain_linear : 1.0;
+            // AVS3 ABI coordinates: left/up/front. ADM polar: positive azimuth
+            // left, positive elevation up. No arbitrary axis reinterpretation.
+            auto &polar = mapped.position.polarPosition();
+            if (object.position_valid) {
+                polar.azimuth = std::atan2(double(object.x), double(object.z)) * radians_to_degrees;
+                polar.elevation = std::atan2(double(object.y),
+                    std::hypot(double(object.x), double(object.z))) * radians_to_degrees;
+                polar.distance = std::hypot(std::hypot(double(object.x), double(object.y)), double(object.z));
+            }
+            ctx->calculator.CalculateGains(mapped, ctx->direct, ctx->diffuse);
+            for (int c = 0; c < channels; ++c)
+                if (!std::isfinite(ctx->direct[c]) || ctx->diffuse[c] != 0.0)
+                    return AV3A_SPEAKERS_INTERNAL;
+            auto &interpolation = ctx->object_interpolation[object.pcm_channel - channels];
+            interpolation.SetGainVector(ctx->direct, object.jump_position ? 0u : unsigned(frames));
+            interpolation.ProcessAccumul(ctx->mono.data(), ctx->planes.data(), unsigned(frames));
+        }
+        for (size_t f = 0; f < frames; ++f)
+            for (int c = 0; c < channels; ++c) {
+                const float value = ctx->planes[canonical_to_sdk[c]][f];
+                if (!std::isfinite(value)) {
+                    std::fill_n(output, frames * channels, 0.0f);
+                    return AV3A_SPEAKERS_INTERNAL;
+                }
+                output[f * channels + c] = value;
+            }
+        return AV3A_SPEAKERS_OK;
+    } catch (const std::bad_alloc &) {
+        std::fill_n(output, frames * channels, 0.0f);
+        return AV3A_SPEAKERS_NOMEM;
+    } catch (...) {
+        std::fill_n(output, frames * channels, 0.0f);
+        return AV3A_SPEAKERS_INTERNAL;
+    }
+}
+
+extern "C" const char *av3a_speakers_error_string(int result) {
+    switch (result) {
+    case AV3A_SPEAKERS_OK: return "success";
+    case AV3A_SPEAKERS_INVALID: return "invalid AV3A speaker parameters or metadata";
+    case AV3A_SPEAKERS_UNSUPPORTED: return "AV3A speaker mode supports only standard 7.1.4 bed with point objects";
+    case AV3A_SPEAKERS_NOMEM: return "AV3A speaker renderer allocation failed";
+    default: return "AV3A speaker renderer failed";
+    }
+}
