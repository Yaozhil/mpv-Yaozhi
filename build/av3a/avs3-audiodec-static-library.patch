diff --git a/av3adecoder/CMakeLists.txt b/av3adecoder/CMakeLists.txt
new file mode 100644
index 0000000..6e64cc1
--- /dev/null
+++ b/av3adecoder/CMakeLists.txt
@@ -0,0 +1,66 @@
+cmake_minimum_required(VERSION 3.19)
+
+project(AVS3AudioDec LANGUAGES C)
+
+file(GLOB AVS3_DECODER_SOURCES CONFIGURE_DEPENDS
+    "${CMAKE_CURRENT_SOURCE_DIR}/avs3Decoder/src/*.c"
+)
+file(GLOB AVS3_COMMON_SOURCES CONFIGURE_DEPENDS
+    "${CMAKE_CURRENT_SOURCE_DIR}/libavs3_common/*.c"
+)
+file(GLOB AVS3_DEBUG_SOURCES CONFIGURE_DEPENDS
+    "${CMAKE_CURRENT_SOURCE_DIR}/libavs3_debug/*.c"
+)
+list(FILTER AVS3_DECODER_SOURCES EXCLUDE REGEX
+    "/avs3_(io_dec|write_wav)\\.c$"
+)
+
+add_library(AVS3AudioDec STATIC
+    ${AVS3_DECODER_SOURCES}
+    ${AVS3_COMMON_SOURCES}
+    ${AVS3_DEBUG_SOURCES}
+)
+
+target_compile_features(AVS3AudioDec PRIVATE c_std_99)
+target_compile_definitions(AVS3AudioDec PRIVATE
+    AVS3_AUDIODEC_LIBRARY=1
+)
+target_compile_options(AVS3AudioDec PRIVATE
+    $<$<C_COMPILER_ID:GNU,Clang>:-fno-strict-aliasing>
+)
+target_include_directories(AVS3AudioDec
+    PUBLIC
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/avs3Decoder/include>
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/libavs3_common>
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/libavs3_debug>
+        $<INSTALL_INTERFACE:include/avs3a>
+)
+
+set_target_properties(AVS3AudioDec PROPERTIES
+    OUTPUT_NAME AVS3AudioDec
+    POSITION_INDEPENDENT_CODE ON
+)
+
+install(TARGETS AVS3AudioDec
+    ARCHIVE DESTINATION lib
+)
+install(FILES
+    avs3Decoder/include/avs3_decoder_interface.h
+    avs3Decoder/include/avs3_prot_dec.h
+    avs3Decoder/include/avs3_stat_dec.h
+    DESTINATION include/avs3a
+)
+install(DIRECTORY libavs3_common/
+    DESTINATION include/avs3a
+    FILES_MATCHING PATTERN "*.h"
+)
+install(DIRECTORY libavs3_debug/
+    DESTINATION include/avs3a
+    FILES_MATCHING PATTERN "*.h"
+)
+
+if(NOT CMAKE_CROSSCOMPILING)
+    message(WARNING
+        "AVS3AudioDec is intended to be built with the same target toolchain "
+        "as FFmpeg.")
+endif()
