+static int arcdav3a_set_layout(AVCodecContext *avctx, AVFrame *frame,
+			       unsigned long channels, unsigned long channel_config)
+{
+	AVChannelLayout layout = {
+		.order = AV_CHANNEL_ORDER_UNSPEC,
+		.nb_channels = channels,
+	};
+	ChannelNumConfig config = (ChannelNumConfig)channel_config;
+	int ret;
+
+	if (channels == 1)
+		layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_MONO;
+	else if (channels == 2)
+		layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_STEREO;
+	else if (config == CHANNEL_CONFIG_MC_5_1_4 && channels == 10)
+		layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_5POINT1POINT4_BACK;
+	else if (config == CHANNEL_CONFIG_MC_7_1_2 && channels == 10)
+		layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_7POINT1POINT2;
+	else if (config == CHANNEL_CONFIG_MC_7_1_4 && channels == 12)
+		layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_7POINT1POINT4_BACK;
+	else if (config == CHANNEL_CONFIG_HOA_ORDER3 && channels == 16)
+		layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_HEXADECAGONAL;
+
+	av_channel_layout_uninit(&frame->ch_layout);
+	ret = av_channel_layout_copy(&frame->ch_layout, &layout);
+	if (ret < 0)
+		return ret;
+
+	av_channel_layout_uninit(&avctx->ch_layout);
+	return av_channel_layout_copy(&avctx->ch_layout, &layout);
+}
