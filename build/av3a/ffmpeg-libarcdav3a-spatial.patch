+static void arcdav3a_destroy_renderer(arcdav3a_context *h)
+{
+	if (h->renderer)
+		audio_destroy(h->renderer);
+	h->renderer = NULL;
+	av_freep(&h->renderer_planar);
+	av_freep(&h->renderer_output);
+	h->renderer_output_capacity = 0;
+	h->renderer_channels = 0;
+	h->renderer_bed_channels = 0;
+	h->renderer_object_channels = 0;
+	h->renderer_frame_length = 0;
+	h->renderer_sample_rate = 0;
+	h->renderer_format = -1;
+	h->renderer_channel_config = -1;
+}
