+static int arcdav3a_init_renderer(AVCodecContext *avctx,
+				  const AVS3SpatialStreamInfo *info)
+{
+	arcdav3a_context *h = avctx->priv_data;
+	rendering_mode order;
+	float position[3];
+	int i;
+	int ret = AVERROR_EXTERNAL;
+
+	if (h->renderer &&
+	    h->renderer_channels == info->total_channels &&
+	    h->renderer_bed_channels == info->bed_channels &&
+	    h->renderer_object_channels == info->object_channels &&
+	    h->renderer_frame_length == info->frame_length &&
+	    h->renderer_sample_rate == info->sample_rate &&
+	    h->renderer_format == info->format &&
+	    h->renderer_channel_config == info->channel_config)
+		return 0;
+
+	arcdav3a_destroy_renderer(h);
+	if (info->total_channels <= 0 ||
+	    info->total_channels > AV3A_RENDER_MAX_CHANNELS ||
+	    info->bed_channels < 0 ||
+	    info->object_channels < 0 ||
+	    info->bed_channels + info->object_channels > info->total_channels ||
+	    info->frame_length <= 0 ||
+	    info->sample_rate <= 0)
+		return AVERROR_INVALIDDATA;
+
+	if (info->format == AVS3_SPATIAL_FORMAT_HOA) {
+		if (info->hoa_order < 1 || info->hoa_order > 7)
+			return AVERROR_PATCHWELCOME;
+		order = (rendering_mode)info->hoa_order;
+	} else {
+		order = AMBISONIC_THIRD_ORDER;
+	}
+	ret = audio_create_context(&h->renderer, order,
+				   info->frame_length, info->sample_rate);
+	if (ret != SUCCESS)
+		goto fail;
+	if (audio_initialize_context(h->renderer) != SUCCESS)
+		goto fail;
+
+	for (i = 0; i < AV3A_RENDER_MAX_CHANNELS; i++)
+		h->renderer_bed_source_ids[i] = -1;
+	for (i = 0; i < AVS3_SPATIAL_MAX_OBJECTS; i++)
+		h->renderer_object_source_ids[i] = -1;
+
+	if (info->format != AVS3_SPATIAL_FORMAT_HOA) {
+		for (i = 0; i < info->bed_channels; i++) {
+			if (info->channel_position_valid[i]) {
+				position[0] = info->channel_x[i];
+				position[1] = info->channel_y[i];
+				position[2] = info->channel_z[i];
+			} else {
+				arcdav3a_bed_position(info->channel_config, i,
+						     info->bed_channels, position);
+			}
+			if (!arcdav3a_position_valid(position))
+				goto fail;
+			if (audio_add_source(h->renderer, SOURCE_SPATIALIZE,
+					     position,
+					     &h->renderer_bed_source_ids[i],
+					     false) != SUCCESS)
+				goto fail;
+		}
+		for (i = 0; i < info->object_channels; i++) {
+			position[0] = 0.0f;
+			position[1] = 0.0f;
+			position[2] = 1.0f;
+			if (audio_add_source(h->renderer, SOURCE_SPATIALIZE,
+					     position,
+					     &h->renderer_object_source_ids[i],
+					     false) != SUCCESS)
+				goto fail;
+		}
+	}
+	if (audio_commit_scene(h->renderer) != SUCCESS)
+		goto fail;
+
+	h->renderer_planar = av_malloc_array(
+		(size_t)info->total_channels * info->frame_length,
+		sizeof(*h->renderer_planar));
+	if (!h->renderer_planar) {
+		ret = AVERROR(ENOMEM);
+		goto fail;
+	}
+
+	h->renderer_channels = info->total_channels;
+	h->renderer_bed_channels = info->bed_channels;
+	h->renderer_object_channels = info->object_channels;
+	h->renderer_frame_length = info->frame_length;
+	h->renderer_sample_rate = info->sample_rate;
+	h->renderer_format = info->format;
+	h->renderer_channel_config = info->channel_config;
+	h->have_last_spatial_frame = 0;
+	av_log(avctx, AV_LOG_INFO,
+	       "AV3A spatial renderer initialized: format=%d channels=%d objects=%d hoa=%d\n",
+	       info->format, info->total_channels, info->object_channels,
+	       info->hoa_order);
+	return 0;
+
+fail:
+	if (ret == SUCCESS)
+		ret = AVERROR_EXTERNAL;
+	arcdav3a_destroy_renderer(h);
+	return ret;
+}
+
+static int arcdav3a_ensure_renderer_output(arcdav3a_context *h,
+					   size_t samples)
+{
+	float *output;
+	size_t needed;
+
+	if (samples > SIZE_MAX / 2)
+		return AVERROR(ENOMEM);
+	needed = samples * 2;
+	if (needed <= h->renderer_output_capacity)
+		return 0;
+	output = av_realloc_array(h->renderer_output, needed, sizeof(*output));
+	if (!output)
+		return AVERROR(ENOMEM);
+	h->renderer_output = output;
+	h->renderer_output_capacity = needed;
+	return 0;
+}
+
+static int arcdav3a_select_object_metadata(
+	arcdav3a_context *h,
+	const AVS3SpatialStreamInfo *info,
+	const AVS3SpatialFrame *frame,
+	const AVS3SpatialFrame **selected)
+{
+	AVS3SpatialFrame next;
+	int i;
+
+	if (frame && frame->abi_version == AVS3_SPATIAL_ABI_VERSION &&
+	    frame->has_dynamic_metadata) {
+		if (frame->object_count != info->object_channels ||
+		    frame->object_count < 0 ||
+		    frame->object_count > AVS3_SPATIAL_MAX_OBJECTS)
+			return AVERROR_INVALIDDATA;
+		next = *frame;
+		if (h->have_last_spatial_frame) {
+			for (i = 0; i < next.object_count; i++) {
+				if (!next.objects[i].position_valid &&
+				    h->last_spatial_frame.objects[i].position_valid) {
+					next.objects[i].position_valid = 1;
+					next.objects[i].x =
+						h->last_spatial_frame.objects[i].x;
+					next.objects[i].y =
+						h->last_spatial_frame.objects[i].y;
+					next.objects[i].z =
+						h->last_spatial_frame.objects[i].z;
+				}
+			}
+		}
+		h->last_spatial_frame = next;
+		h->have_last_spatial_frame = 1;
+	} else if (!h->have_last_spatial_frame) {
+		return AVERROR_INVALIDDATA;
+	}
+	*selected = &h->last_spatial_frame;
+	return 0;
+}
+
+static int arcdav3a_render_block(
+	AVCodecContext *avctx,
+	const AVS3SpatialStreamInfo *info,
+	const AVS3SpatialFrame *frame,
+	const int16_t *input,
+	float *output)
+{
+	arcdav3a_context *h = avctx->priv_data;
+	const AVS3SpatialFrame *metadata = NULL;
+	int i;
+	int j;
+	int ret;
+
+	for (i = 0; i < info->total_channels; i++) {
+		float *plane = h->renderer_planar +
+			(size_t)i * info->frame_length;
+		for (j = 0; j < info->frame_length; j++)
+			plane[j] =
+				input[j * info->total_channels + i] / 32768.0f;
+	}
+
+	if (info->format == AVS3_SPATIAL_FORMAT_HOA) {
+		ambisonic_normalization_type normalization;
+
+		if (info->hoa_ordering != AVS3_SPATIAL_HOA_ORDERING_ACN)
+			return AVERROR_PATCHWELCOME;
+		if (info->hoa_normalization == AVS3_SPATIAL_HOA_N3D)
+			normalization = N3D;
+		else if (info->hoa_normalization == AVS3_SPATIAL_HOA_SN3D)
+			normalization = SN3D;
+		else
+			return AVERROR_PATCHWELCOME;
+		for (i = 0; i < info->total_channels; i++) {
+			int order = (int)sqrt((double)i);
+			int degree = i - order * (order + 1);
+			float gain = info->channel_muted[i] ? 0.0f :
+				(info->channel_gain_valid[i] ?
+				 info->channel_gain_linear[i] : 1.0f);
+
+			if (!arcdav3a_gain_valid(gain))
+				return AVERROR_INVALIDDATA;
+			if (audio_submit_ambisonic_channel_buffer(
+				    h->renderer,
+				    h->renderer_planar +
+					    (size_t)i * info->frame_length,
+				    order, degree, normalization, gain) != SUCCESS)
+				return AVERROR_EXTERNAL;
+		}
+	} else {
+		ret = arcdav3a_select_object_metadata(
+			h, info, frame, &metadata);
+		if (ret < 0)
+			return ret;
+		for (i = 0; i < info->bed_channels; i++) {
+			float gain = info->channel_muted[i] ? 0.0f :
+				(info->channel_gain_valid[i] ?
+				 info->channel_gain_linear[i] : 1.0f);
+
+			if (!arcdav3a_gain_valid(gain))
+				return AVERROR_INVALIDDATA;
+			if (audio_set_source_gain(
+				    h->renderer, h->renderer_bed_source_ids[i],
+				    gain) != SUCCESS ||
+			    audio_submit_source_buffer(
+				    h->renderer, h->renderer_bed_source_ids[i],
+				    h->renderer_planar +
+					    (size_t)i * info->frame_length,
+				    info->frame_length) != SUCCESS)
+				return AVERROR_EXTERNAL;
+		}
+		for (i = 0; i < metadata->object_count; i++) {
+			const AVS3SpatialObjectFrame *object =
+				&metadata->objects[i];
+			float position[3] = {
+				object->x, object->y, object->z
+			};
+			float gain = object->muted ? 0.0f :
+				(object->gain_valid ?
+				 object->gain_linear : 1.0f);
+			int channel = object->pcm_channel;
+
+			if (channel < 0 || channel >= info->total_channels ||
+			    !arcdav3a_gain_valid(gain))
+				return AVERROR_INVALIDDATA;
+			if (!object->muted) {
+				if (!object->position_valid)
+					return AVERROR_INVALIDDATA;
+				if (!arcdav3a_position_valid(position)) {
+					if (isfinite(position[0]) &&
+					    isfinite(position[1]) &&
+					    isfinite(position[2]) &&
+					    position[0] == 0.0f &&
+					    position[1] == 0.0f &&
+					    position[2] == 0.0f) {
+						position[2] = 1.0f;
+					} else {
+						return AVERROR_INVALIDDATA;
+					}
+				}
+				if (audio_set_source_position(
+					    h->renderer,
+					    h->renderer_object_source_ids[i],
+					    position) != SUCCESS)
+					return AVERROR_EXTERNAL;
+			}
+			if (audio_set_source_gain(
+				    h->renderer,
+				    h->renderer_object_source_ids[i],
+				    gain) != SUCCESS ||
+			    audio_submit_source_buffer(
+				    h->renderer,
+				    h->renderer_object_source_ids[i],
+				    h->renderer_planar +
+					    (size_t)channel * info->frame_length,
+				    info->frame_length) != SUCCESS)
+				return AVERROR_EXTERNAL;
+		}
+	}
+
+	if (audio_update_scene(h->renderer) != SUCCESS ||
+	    audio_get_interleaved_binaural_buffer(
+		    h->renderer, output,
+		    info->frame_length, false) != SUCCESS)
+		return AVERROR_EXTERNAL;
+	return 0;
+}
+
+static int arcdav3a_render_binaural(AVCodecContext *avctx,
+				    AVS3DecoderOutput *decoder_output,
+				    const uint8_t **data,
+				    unsigned long *data_size)
+{
+	arcdav3a_context *h = avctx->priv_data;
+	const AVS3SpatialStreamInfo *info = &decoder_output->spatial_info;
+	const int16_t *input = (const int16_t *)decoder_output->pOutData;
+	int samples;
+	int blocks;
+	int i;
+	int ret;
+
+	if (h->spatial_render != AV3A_RENDER_BINAURAL)
+		return 0;
+	if (!decoder_output->have_spatial_info ||
+	    info->abi_version != AVS3_SPATIAL_ABI_VERSION)
+		return AVERROR_INVALIDDATA;
+	if (info->format == AVS3_SPATIAL_FORMAT_CHANNELS) {
+		arcdav3a_destroy_renderer(h);
+		return 0;
+	}
+	if (decoder_output->nBits != 16 ||
+	    decoder_output->nChannel != info->total_channels ||
+	    decoder_output->nSamplerate != info->sample_rate ||
+	    info->total_channels <= 0 ||
+	    decoder_output->nlen %
+		    (info->total_channels * (int)sizeof(*input)))
+		return AVERROR_INVALIDDATA;
+	samples = decoder_output->nlen /
+		(info->total_channels * (int)sizeof(*input));
+	if (samples <= 0 || info->frame_length <= 0 ||
+	    samples % info->frame_length)
+		return AVERROR_INVALIDDATA;
+	blocks = samples / info->frame_length;
+	if (info->format != AVS3_SPATIAL_FORMAT_HOA &&
+	    h->spatial_frame_count != blocks)
+		return AVERROR_INVALIDDATA;
+
+	ret = arcdav3a_init_renderer(avctx, info);
+	if (ret < 0)
+		return ret;
+	ret = arcdav3a_ensure_renderer_output(h, samples);
+	if (ret < 0)
+		goto fail;
+	for (i = 0; i < blocks; i++) {
+		const AVS3SpatialFrame *frame =
+			info->format == AVS3_SPATIAL_FORMAT_HOA ? NULL :
+			&h->spatial_frames[i];
+
+		ret = arcdav3a_render_block(
+			avctx, info, frame,
+			input + (size_t)i * info->frame_length *
+				info->total_channels,
+			h->renderer_output +
+				(size_t)i * info->frame_length * 2);
+		if (ret < 0)
+			goto fail;
+	}
+
+	*data = (const uint8_t *)h->renderer_output;
+	*data_size = (unsigned long)((size_t)2 * samples *
+				     sizeof(*h->renderer_output));
+	return 1;
+
+fail:
+	arcdav3a_destroy_renderer(h);
+	h->have_last_spatial_frame = 0;
+	return ret;
+}
