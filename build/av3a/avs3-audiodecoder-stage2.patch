+#ifndef AVS3_SPATIAL_METADATA_H
+#define AVS3_SPATIAL_METADATA_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define AVS3_SPATIAL_ABI_VERSION 3U
+#define AVS3_SPATIAL_MAX_CHANNELS 32
+#define AVS3_SPATIAL_MAX_OBJECTS 32
+
+typedef enum AVS3SpatialFormat {
+    AVS3_SPATIAL_FORMAT_CHANNELS = 0,
+    AVS3_SPATIAL_FORMAT_OBJECTS = 1,
+    AVS3_SPATIAL_FORMAT_BED_OBJECTS = 2,
+    AVS3_SPATIAL_FORMAT_HOA = 3
+} AVS3SpatialFormat;
+
+typedef enum AVS3SpatialHoaNormalization {
+    AVS3_SPATIAL_HOA_UNKNOWN = -1,
+    AVS3_SPATIAL_HOA_SN3D = 0,
+    AVS3_SPATIAL_HOA_N3D = 1,
+    AVS3_SPATIAL_HOA_FUMA = 2
+} AVS3SpatialHoaNormalization;
+
+typedef enum AVS3SpatialHoaOrdering {
+    AVS3_SPATIAL_HOA_ORDERING_UNKNOWN = -1,
+    AVS3_SPATIAL_HOA_ORDERING_ACN = 0
+} AVS3SpatialHoaOrdering;
+
+typedef struct AVS3SpatialStreamInfo {
+    uint32_t struct_size;
+    uint32_t abi_version;
+    int32_t format;
+    int32_t sample_rate;
+    int32_t frame_length;
+    int32_t bit_depth;
+    int32_t total_channels;
+    int32_t bed_channels;
+    int32_t object_channels;
+    int32_t channel_config;
+    int32_t hoa_order;
+    int32_t hoa_normalization;
+    int32_t hoa_ordering;
+    int64_t total_bitrate;
+    int32_t channel_gain_valid[AVS3_SPATIAL_MAX_CHANNELS];
+    float channel_gain_linear[AVS3_SPATIAL_MAX_CHANNELS];
+    int32_t channel_muted[AVS3_SPATIAL_MAX_CHANNELS];
+    int32_t channel_position_valid[AVS3_SPATIAL_MAX_CHANNELS];
+    float channel_x[AVS3_SPATIAL_MAX_CHANNELS];
+    float channel_y[AVS3_SPATIAL_MAX_CHANNELS];
+    float channel_z[AVS3_SPATIAL_MAX_CHANNELS];
+} AVS3SpatialStreamInfo;
+
+typedef struct AVS3SpatialObjectFrame {
+    int32_t pcm_channel;
+    int32_t position_valid;
+    int32_t muted;
+    int32_t jump_position;
+    float x;
+    float y;
+    float z;
+    int32_t gain_valid;
+    float gain_linear;
+    float diffuse;
+    int32_t extent_valid;
+    int32_t divergence_valid;
+    int32_t channel_lock_valid;
+    int32_t screen_ref_valid;
+    float width;
+    float height;
+    float depth;
+    float divergence;
+    float divergence_azimuth_range;
+    int32_t channel_lock;
+    int32_t screen_ref;
+} AVS3SpatialObjectFrame;
+
+typedef struct AVS3SpatialFrame {
+    uint32_t struct_size;
+    uint32_t abi_version;
+    int32_t has_static_metadata;
+    int32_t has_dynamic_metadata;
+    int32_t object_count;
+    AVS3SpatialObjectFrame objects[AVS3_SPATIAL_MAX_OBJECTS];
+} AVS3SpatialFrame;
