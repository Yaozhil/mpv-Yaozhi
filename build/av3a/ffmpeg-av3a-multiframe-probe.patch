+#define AV3A_PROBE_FRAMES 3
+
+static int av3a_probe_frame_size(const uint8_t *buf, int buf_size)
+{
+    int64_t denominator;
+    int64_t numerator;
+    int64_t packet_bits;
+    AATFHeaderInfo hdf;
+
+    if (buf_size < AV3A_MAX_NBYTES_HEADER + 7 ||
+        av3a_read_aatf_frame_header(buf, &hdf) < 0 ||
+        hdf.total_bitrate <= 0 || hdf.sampling_rate <= 0)
+        return AVERROR_INVALIDDATA;
+
+    numerator = hdf.total_bitrate * AV3A_AUDIO_FRAME_SIZE;
+    if (hdf.sampling_rate == 44100) {
+        packet_bits = numerator / hdf.sampling_rate;
+        return (packet_bits + 7) / 8;
+    }
+
+    denominator = hdf.sampling_rate * 8LL;
+    return (numerator + denominator - 1) / denominator;
+}
