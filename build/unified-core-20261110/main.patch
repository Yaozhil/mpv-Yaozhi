+/*
+ * TV-led Dolby Vision output for vo_gpu_next on D3D11 (--dovi-tunnel).
+ *
+ * The picture and its Dolby Vision metadata are packed into an 8-bit RGB frame
+ * by dvtunnel.dll (the Vision Renderer tunnel, ported from Kodi), and the NVIDIA
+ * HDMI output is switched into Dolby Vision, so the TV does the tone mapping.
+ * The switch runs on the DLL's own thread; playback pauses on a black screen
+ * meanwhile and resumes once the TV is in Dolby Vision.
+ *
+ * This file is part of mpv; GPL-2.0-or-later (dvtunnel.dll is GPL).
+ */
+
+#pragma once
+
+#include <stdbool.h>
+
+#include <libplacebo/renderer.h>
+
+#include "common/common.h"
+
+struct vo;
+struct mp_log;
+struct mp_image;
+struct ra_ctx;
+struct dovi_tunnel;
+
+struct dovi_tunnel *dovi_tunnel_create(struct vo *vo, struct mp_log *log, struct ra_ctx *ra_ctx,
+                                       pl_gpu gpu, pl_log pllog);
+void dovi_tunnel_destroy(struct dovi_tunnel **t);
+
+// Before the frame starts: true if this frame will go through the tunnel, so the
+// swapchain must stay SDR.
+bool dovi_tunnel_wanted(struct dovi_tunnel *t, bool enabled, struct mp_image *mpi,
+                        struct mp_rect src);
+
+// Packs mpi into the back buffer with target's overlays (OSD and subtitles), or
+// draws a black frame while the output switches. Returns false when the frame
+// must be rendered normally. paused: playback is paused (by the user).
+bool dovi_tunnel_draw(struct dovi_tunnel *t, bool enabled, bool paused, bool interactive_osd,
+                      struct mp_image *mpi, struct mp_rect src,
+                      const struct pl_frame *target);
+
+// Seek-only decoded-frame diagnostics; preserves the HDMI request and carrier.
+void dovi_tunnel_reset(struct dovi_tunnel *t);
+void dovi_tunnel_start_file(struct dovi_tunnel *t);
+// Retire the old file's HDMI/metadata state; false is a no-op when never used.
+bool dovi_tunnel_file_changed(struct dovi_tunnel *t);
+
+// Keep native window options unchanged until an active HDMI output is restored.
+// All calls belong to the VO thread; the DLL does the display work asynchronously.
+bool dovi_tunnel_defer_window_change(struct dovi_tunnel *t, bool fullscreen);
+bool dovi_tunnel_window_change_pending(struct dovi_tunnel *t);
+bool dovi_tunnel_window_change_ready(struct dovi_tunnel *t);
+void dovi_tunnel_finish_window_change(struct dovi_tunnel *t, bool applied);
+
+// --dovi-tunnel-gpu: legacy AMD options map through mpv. TV output is NVIDIA only.
+void dovi_tunnel_set_gpu(struct dovi_tunnel *t, int mode);
+
+// Preferred HDMI resolution and policy for TVs without 2160p60 Dolby Vision.
+void dovi_tunnel_set_mode(struct dovi_tunnel *t, int resolution, int low60, bool busy);
+
+// --dovi-tunnel-content-type: what NVIDIA reports to the display as the content type
+// (0 ask when it is on auto, 1 full-screen video, 2 desktop, 3 game, 4 photo, 5 cinema,
+// 6 leave it). Set before entering.
+void dovi_tunnel_set_content_type(struct dovi_tunnel *t, int mode);
