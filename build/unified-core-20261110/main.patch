+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_FRESH_POSE_H
+#define MP_SECONDARY_ASS_FRESH_POSE_H
+
+#include "secondary_ass_clock.h"
+
+// A media pose emitted by a mandatory video draw, not a physical G/D sample.
+// It must never grant cache admission or mutate the physical sampler identity.
+struct secondary_ass_fresh_pose {
+    bool floor_valid;
+    double floor_pts;
+};
+
+static inline void secondary_ass_fresh_pose_reset(struct secondary_ass_fresh_pose *p)
+{
+    *p = (struct secondary_ass_fresh_pose){0};
+}
+
+static inline bool secondary_ass_fresh_pose_sample(
+    struct secondary_ass_fresh_pose *p, const struct secondary_ass_clock *clock,
+    int64_t video_wall, bool retained_valid, double retained_pts, double *pts)
+{
+    if (!pts || !clock->valid || clock->display_synced || video_wall <= 0 ||
+        clock->wall <= 0 ||
+        !isfinite(clock->speed) || clock->speed <= 0 ||
+        !isfinite(clock->phase_rate) ||
+        !isfinite(clock->speed + clock->phase_rate) ||
+        clock->speed + clock->phase_rate <= 0)
+        return false;
+    double next = secondary_ass_clock_sample(clock, video_wall);
+    if (!isfinite(next))
+        return false;
+    if (retained_valid && isfinite(retained_pts) && retained_pts > next)
+        next = retained_pts;
+    if (p->floor_valid && p->floor_pts > next)
+        next = p->floor_pts;
+    p->floor_valid = true;
+    p->floor_pts = next;
+    *pts = next;
+    return true;
+}
+
+// Clamp only the emitted subtitle input. The physical sample's PTS, G/D,
+// origin, tick and epoch remain intact. A newly accepted physical pose clears
+// this temporary floor once it catches up; a UI repaint cannot clear it.
+static inline double secondary_ass_fresh_pose_resume(
+    struct secondary_ass_fresh_pose *p, double physical_pts, bool physical_accepted)
+{
+    if (!p->floor_valid || !isfinite(physical_pts))
+        return physical_pts;
+    if (physical_pts < p->floor_pts)
+        return p->floor_pts;
+    if (physical_accepted)
+        secondary_ass_fresh_pose_reset(p);
+    return physical_pts;
+}
+
+#endif
