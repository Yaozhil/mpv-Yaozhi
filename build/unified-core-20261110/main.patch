+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_SECONDARY_ASS_QUIET_RECOVERY_H
+#define MP_SECONDARY_ASS_QUIET_RECOVERY_H
+
+#include "secondary_ass_present_plan.h"
+
+// A quiet/static ASS track still needs its media clock to reach future events.
+// A new physical namespace may bootstrap only from recovered real feedback;
+// this predicate does not translate any old slot or manufacture a plan.
+static inline bool secondary_ass_quiet_recovery_eligible(
+    const struct secondary_ass_physical *p, uint64_t sampler_epoch,
+    int64_t divisor, double configured_rate)
+{
+    if (!sampler_epoch || !p->epoch || sampler_epoch == p->epoch ||
+        p->epoch_exhausted || p->outlier_pending || !p->sync_segment_consistent ||
+        !p->success_generation || !p->success_contiguous ||
+        p->phase <= 0 || p->phase_slot <= 0 ||
+        p->sync_qpc_ns <= 0 || p->sync_slot <= 0 ||
+        !secondary_ass_physical_interval_valid(p->interval) || divisor <= 0 ||
+        !isfinite(configured_rate) || configured_rate <= 0)
+        return false;
+    // Retain the existing physical sampler's integer-divisor eligibility.
+    // A display/rate change must not silently reuse an incompatible divisor.
+    return fabs(configured_rate * p->interval * 1e-9 * divisor - 1) <= 0.005;
+}
+
+#endif
