+static void sync_dovi_fullscreen(void *ptr)
+{
+    struct vo_w32_state *w32 = ptr;
+    // Do not alter embedded, minimized or ordinary/windowed playback.
+    if (w32->parent || w32->destroyed || !w32->window ||
+        !w32->current_fs || !w32->opts->fullscreen || IsMinimized(w32->window))
+        return;
+    force_update_display_info(w32);
+    RECT target = get_screen_area(w32);
+    RECT current;
+    if (GetWindowRect(w32->window, &current) && !EqualRect(&current, &target)) {
+        MP_VERBOSE(w32, "DV fullscreen physical rectangle: %ld,%ld %ldx%ld.\n",
+                   target.left, target.top, rect_w(target), rect_h(target));
+        window_set_pos(w32, target);
+        signal_events(w32, VO_EVENT_RESIZE);
+    }
+}
+
+void vo_w32_sync_dovi_fullscreen(struct vo *vo)
+{
+    if (vo && vo->w32)
+        vo_w32_run_on_thread(vo, sync_dovi_fullscreen, vo->w32);
+}
