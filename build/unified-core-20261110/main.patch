+    CHECK(plan.valid && plan.fresh_clock_only, "existing fresh-clock helper accepts new-namespace candidate");
+    CHECK(plan.epoch == 95 && plan.target.slot > 0 && plan.base.slot > 0,
+          "bootstrap uses new physical namespace, not old zero/slot identity");
+    CHECK(plan.submit == F && plan.fallback_submit == F && plan.lifecycle_safe_wait == F,
+          "mandatory video F and lifecycle wait remain unchanged");
+    CHECK(!quiet_eligible(&p, 95, 2, 80), "same-epoch ordinary quiet path stays unchanged");
+    CHECK(!quiet_eligible(&p, 0, 2, 80), "unidentified sampler is not an epoch-recovery task");
+    CHECK(!quiet_eligible(&p, 94, 0, 80), "zero divisor is not physical authority");
+    CHECK(!quiet_eligible(&p, 94, 2, NAN), "NaN configured rate rejected");
+    CHECK(!quiet_eligible(&p, 94, 2, INFINITY), "infinite rate rejected");
+    CHECK(!quiet_eligible(&p, 94, 2, 0), "disabled clock rejected");
+#define BAD(field,value,label) do { struct secondary_ass_physical q=p; q.field=value; \
+    CHECK(!quiet_eligible(&q,94,2,80),label); } while (0)
+    BAD(epoch,0,"unknown physical epoch rejected");
+    BAD(epoch_exhausted,true,"exhausted physical epoch rejected");
+    BAD(outlier_pending,true,"outlier does not grant quiet bootstrap");
+    BAD(sync_segment_consistent,false,"inconsistent feedback cannot bootstrap");
+    BAD(success_generation,0,"no successful generation rejected");
+    BAD(success_contiguous,false,"noncontiguous successful prefix rejected");
+    BAD(phase,0,"missing phase wall rejected");
+    BAD(phase_slot,0,"missing physical phase slot rejected");
+    BAD(sync_qpc_ns,0,"missing raw observed QPC rejected");
+    BAD(sync_slot,0,"missing observed sync slot rejected");
+    BAD(interval,0,"missing physical interval rejected");
+    BAD(interval,6944444,"old divisor80 cannot silently carry into144Hz");
+#undef BAD
+    p.interval = 6250275;
+    CHECK(quiet_eligible(&p,94,2,80), "small observed period refinement retains 80/160 eligibility");
+}
+
+static void test_fresh_media_pose(void)
+{
+    struct secondary_ass_clock clock = {
+        .valid = true, .pts = 16.258242280082655, .wall = 18804847200LL, .speed = 1,
+    };
+    struct secondary_ass_sampler sampler = {
+        .valid = true, .physical_slots = true, .display_forecast = true,
+        .epoch = 75, .origin_slot = 4294969001LL, .tick = 227,
+        .sample_wall = 18804847200LL, .pts = clock.pts, .divisor = 2,
+    }, retained = sampler;
+    struct secondary_ass_fresh_pose pose = {0};
+    double out = sampler.pts, previous = out;
+    // Actual original-video F timestamps from run1's eight held fresh draws.
+    int64_t Fs[] = {18826610200LL,18866592267LL,18906592267LL,18946593000LL,
+                    18986592167LL,19026612133LL,19066600600LL,19106597800LL};
+    for (unsigned n=0; n<sizeof(Fs)/sizeof(Fs[0]); n++) {
+        CHECK(emit_pose(&pose,&clock,Fs[n],true,sampler.pts,&out),
+              "mandatory fresh draw can emit its anchored media pose");
+        CHECK(out > previous, "run1 fresh inputs no longer repeat for300ms");
+        previous = out;
+    }
+    CHECK(out - sampler.pts > .300, "eight necessary fresh draws advance media input through observed quarantine");
+    CHECK(memcmp(&sampler,&retained,sizeof(sampler))==0,
+          "fallback never rewrites retained physical sampler origin/tick/epoch/PTS");
+    CHECK(pose.floor_valid && CLOSE(pose.floor_pts,out), "fallback publishes a separate pose floor");
+    double floor = pose.floor_pts;
+    double behind = floor - .050;
+    CHECK(CLOSE(secondary_ass_fresh_pose_resume(&pose,behind,true),floor),
+          "recovered but lagging physical pose cannot move emitted input backward");
+    CHECK(pose.floor_valid, "lagging physical tick cannot clear recovery floor");
+    CHECK(CLOSE(secondary_ass_fresh_pose_resume(&pose,floor,false),floor) && pose.floor_valid,
+          "manual repaint cannot clear floor even at equal input");
+    CHECK(CLOSE(secondary_ass_fresh_pose_resume(&pose,floor+.001,true),floor+.001) && !pose.floor_valid,
+          "accepted physical sample clears floor once it catches up");
+    // If a captured prior D is slightly ahead of new mandatory F, keep one pose.
+    double ahead=secondary_ass_clock_sample(&clock,Fs[0])+.010;
+    CHECK(secondary_ass_fresh_pose_sample(&pose,&clock,Fs[0],true,ahead,&out) && CLOSE(out,ahead),
+          "future retained physical pose is never pulled backward to an earlier F");
+    CHECK(secondary_ass_fresh_pose_sample(&pose,&clock,Fs[1],true,ahead,&out) && out>ahead,
+          "retained-future clamp releases as the real F advances");
+}
+
+static void test_lifecycle(void)
+{
+    struct secondary_ass_fresh_pose p={0};
+    struct secondary_ass_clock c={.valid=true,.wall=1000000000,.pts=100,.speed=1};
+    double out=0;
+    CHECK(secondary_ass_fresh_pose_sample(&p,&c,1100000000,false,0,&out) && CLOSE(out,100.1),
+          "clock-based pose uses original F rather than CPU wake time");
+    secondary_ass_fresh_pose_reset(&p); // pause/rate0/sub replacement scope reset
+    CHECK(!p.floor_valid, "lifecycle reset removes stale pose floor");
+    secondary_ass_clock_reset(&c);
+    CHECK(!secondary_ass_fresh_pose_sample(&p,&c,1200000000,false,0,&out),
+          "paused/unanchored clock grants no media pose");
+    c=(struct secondary_ass_clock){.valid=true,.wall=1000000000,.pts=100,.speed=1};
+    CHECK(secondary_ass_clock_anchor(&c,10,2000000000,false), "backward seek is a real clock discontinuity");
+    secondary_ass_fresh_pose_reset(&p);
+    CHECK(secondary_ass_fresh_pose_sample(&p,&c,2100000000,false,0,&out) && CLOSE(out,10.1),
+          "seek/reload may legitimately return to an earlier media timeline");
+    secondary_ass_clock_set_speed(&c,2,2200000000);
+    secondary_ass_fresh_pose_reset(&p);
+    CHECK(secondary_ass_fresh_pose_sample(&p,&c,2300000000,false,0,&out) && CLOSE(out,10.4),
+          "speed change integrates old speed before applying new slope");
+    c.display_synced=true;
+    CHECK(!secondary_ass_fresh_pose_sample(&p,&c,2400000000,false,0,&out),
+          "display-synced video never receives this fallback");
+    c.display_synced=false;
+    CHECK(!secondary_ass_fresh_pose_sample(&p,&c,0,false,0,&out), "unknown F rejected");
+    c.wall=0;
+    CHECK(!secondary_ass_fresh_pose_sample(&p,&c,2400000000,false,0,&out), "unanchored wall rejected");
+    c.wall=2000000000; c.speed=NAN;
+    CHECK(!secondary_ass_fresh_pose_sample(&p,&c,2400000000,false,0,&out), "invalid speed rejected");
+    c.speed=1; c.phase_rate=-2;
+    CHECK(!secondary_ass_fresh_pose_sample(&p,&c,2400000000,false,0,&out), "non-forward clock slope rejected");
+}
+
+int main(void)
+{
+    test_quiet_epoch(); test_fresh_media_pose(); test_lifecycle();
+    printf("{\"checks\":%d,\"failures\":%d,\"display_verified\":false,\"core_built\":false}\n",checks,failures);
+    return failures ? 1 : 0;
+}
