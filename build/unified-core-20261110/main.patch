+        return;
+    struct priv *p = ra->priv;
+    p->dovi_transport = active;
+}
+
+void ra_d3d11_ctx_set_dovi_present_blocked(struct ra_ctx *ra, bool blocked)
+{
+    if (!ra || !ra->swapchain || ra->swapchain->fns != &d3d11_swapchain)
+        return;
+    struct priv *p = ra->priv;
+    if (p->dovi_present_blocked == blocked)
+        return;
+    p->dovi_present_blocked = blocked;
+    d3d11_present_generation_invalidate(p);
+    p->early_present_wait = NULL;
+    p->early_present_generation = 0;
+    p->early_present_target = 0;
+    p->last_sync_refresh_count = 0;
+    p->last_sync_qpc_time = 0;
+    p->vsync_duration_qpc = 0;
+    p->early_statistics_disjoint = true;
+    MP_VERBOSE(ra, "Dolby Vision Present %s during output transition.\n",
+               blocked ? "held" : "resumed");
+}
+
+uint64_t ra_d3d11_ctx_dovi_generation(struct ra_ctx *ra)
+{
+    if (!ra || !ra->swapchain || ra->swapchain->fns != &d3d11_swapchain)
+        return 0;
+    struct priv *p = ra->priv;
+    return p->present_generation;
+}
+
+bool ra_d3d11_ctx_prepare_dovi_carrier(struct ra_ctx *ra, bool reset_hdr_state)
+{
+    if (!ra || !ra->swapchain || ra->swapchain->fns != &d3d11_swapchain)
+        return false;
+    struct priv *p = ra->priv;
+    // Keep the existing read-only path when entering from an SDR desktop.
+    // An external Windows HDR transition can invalidate the actual DXGI state
+    // without invalidating libplacebo's cached SDR hint. Support is not state:
+    // an HDR-origin request rebinds before the worker sends any DV signalling.
+    DXGI_SWAP_CHAIN_DESC desc = {0};
+    HRESULT hr = IDXGISwapChain_GetDesc(p->swapchain, &desc);
+    bool rgb8 = desc.BufferDesc.Format == DXGI_FORMAT_R8G8B8A8_UNORM ||
+                desc.BufferDesc.Format == DXGI_FORMAT_B8G8R8A8_UNORM;
+    if (FAILED(hr) || !rgb8 || desc.SampleDesc.Count != 1) {
+        MP_WARN(ra, "Dolby Vision carrier is not an unmodified 8-bit RGB swapchain.\n");
+        return false;
+    }
+    IDXGISwapChain3 *sc3 = NULL;
+    hr = IDXGISwapChain_QueryInterface(p->swapchain, &IID_IDXGISwapChain3, (void **)&sc3);
+    UINT support = 0;
+    if (SUCCEEDED(hr))
+        hr = IDXGISwapChain3_CheckColorSpaceSupport(sc3, DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709,
+                                                  &support);
+    bool supported = SUCCEEDED(hr) && (support & DXGI_SWAP_CHAIN_COLOR_SPACE_SUPPORT_FLAG_PRESENT);
+    IDXGISwapChain4 *sc4 = NULL;
+    if (supported && reset_hdr_state) {
+        hr = IDXGISwapChain_QueryInterface(p->swapchain, &IID_IDXGISwapChain4, (void **)&sc4);
+        if (SUCCEEDED(hr))
+            hr = IDXGISwapChain3_SetColorSpace1(sc3, DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709);
+        if (SUCCEEDED(hr))
+            hr = IDXGISwapChain4_SetHDRMetaData(sc4, DXGI_HDR_METADATA_TYPE_NONE, 0, NULL);
+        supported = SUCCEEDED(hr);
+    }
+    SAFE_RELEASE(sc4);
+    SAFE_RELEASE(sc3);
+    if (!supported)
+        MP_WARN(ra, "Could not prepare Dolby Vision SDR carrier (HDR reset %d): %s\n",
+                reset_hdr_state, mp_HRESULT_to_str(hr));
+    else if (reset_hdr_state)
+        MP_INFO(ra, "Dolby Vision carrier: SDR RGB full prepared before Dolby Vision signalling, HDR10 metadata cleared.\n");
+    else
+        MP_INFO(ra, "Dolby Vision carrier: 8-bit RGB verified; preserving driver HDMI signalling.\n");
+    return supported;
 }
 
