@@ -0,0 +1,214 @@
+/*
+ * dvtunnel.dll: TV-led Dolby Vision output for a D3D11 video player.
+ *
+ * The 视界渲染器 tunnel (ported from Kodi's dolby-vision-test branch, GPL-2.0-or-later)
+ * behind a plain C interface, so a MinGW-built mpv can load it at run time.
+ *
+ * Per frame:
+ *   dvt_render()       packs the picture and its Dolby Vision metadata; with
+ *                      DVT_RENDER_DIRECT straight into the back buffer (nothing to overlay)
+ *   dvt_gui_texture()  a transparent texture the player draws its OSD/subtitles into
+ *   dvt_finish()       blends that GUI into the packed frame and writes the back buffer
+ * Output (on a background thread, so the render thread never waits):
+ *   dvt_output()       asks for Dolby Vision output on a monitor, or for leaving it, and
+ *                      returns the current state; the notify callback runs on each change
+ *
+ * All calls for one context except the callbacks come from one thread, the one using
+ * the device's immediate context.
+ */
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define DVT_API_VERSION 8
+
+#ifdef DVT_BUILD
+#define DVT_API __declspec(dllexport)
+#else
+#define DVT_API
+#endif
+
+typedef struct dvt_ctx dvt_ctx;
+
+struct ID3D11Device;
+struct ID3D11Texture2D;
+
+enum dvt_log_level {
+    DVT_LOG_ERROR = 0,
+    DVT_LOG_WARN = 1,
+    DVT_LOG_INFO = 2,
+    DVT_LOG_DEBUG = 3,
+};
+
+typedef void (*dvt_log_fn)(void *opaque, int level, const char *line);
+// Called from the output thread when the output state changes.
+typedef void (*dvt_notify_fn)(void *opaque);
+
+enum dvt_format {
+    DVT_FMT_D3D11 = 0,     // texture/slice: a P010 texture (array) on the context's device
+    DVT_FMT_P010 = 1,      // planes[0] luma, planes[1] interleaved CbCr; 16-bit, MSB aligned
+    DVT_FMT_YUV420P10 = 2, // planes[0..2]; 16-bit, LSB aligned (FFmpeg yuv420p10le)
+};
+
+struct dvt_rect { unsigned left, top, right, bottom; };
+
+struct dvt_picture {
+    int format; // enum dvt_format
+    unsigned width, height;
+    struct ID3D11Texture2D *texture;
+    unsigned slice;
+    const uint8_t *planes[3];
+    ptrdiff_t strides[3];
+};
+
+enum dvt_render_flags {
+    DVT_RENDER_DIRECT = 1, // pack straight into the target; no GUI, no dvt_finish
+};
+
+enum dvt_output_state {
+    DVT_OUTPUT_OFF = 0,
+    DVT_OUTPUT_ENTRY_BLOCKED = 8, // read-only preflight rejected; no display changes
+    DVT_OUTPUT_PREPARING = 7, // SDR swapchain acknowledgement before DV signalling
+    DVT_OUTPUT_RECOVERY_FAILED = 6, // hold Present; explicit recovery required
+    DVT_OUTPUT_ENTERING = 1, // switching; takes a few seconds
+    DVT_OUTPUT_ON = 2,
+    DVT_OUTPUT_LEAVING = 3,
+    DVT_OUTPUT_LIMIT60 = 5, // the selected 4K mode exceeds the TV capability
+    DVT_OUTPUT_FAILED = 4,   // stays until Dolby Vision output is no longer asked for
+};
+
+// Read-only entry preflight. Result: 0 confirmed SDR, 1 HDR, 2 WCG,
+// 3 conflicting observations, 4 unsafe/ambiguous target, -1 unavailable.
+// source: 1 current Windows API, 2 compatible Windows API, 3 DXGI + NVAPI.
+struct dvt_preflight {
+    int result, source, windows_mode, driver_hdr, driver_output, dxgi_mode;
+    char target[96];
+    char reason[160];
+};
+typedef int (*dvt_check_output_fn)(void *hmonitor, struct dvt_preflight *info);
+DVT_API int dvt_check_output(void *hmonitor, struct dvt_preflight *info);
+// Nonblocking render-thread form: -2 means checking. refresh starts a new
+// explicit request. At most one read-only driver probe is in flight.
+typedef int (*dvt_poll_output_fn)(void *hmonitor, int refresh, struct dvt_preflight *info);
+DVT_API int dvt_poll_output(void *hmonitor, int refresh, struct dvt_preflight *info);
+
+typedef int (*dvt_api_version_fn)(void);
+DVT_API int dvt_api_version(void);
+
+// Creates a context on the player's device. log and notify may be NULL; log lines
+// also go to %ProgramData%\VisionRenderer\mpv-dv.log.
+typedef dvt_ctx *(*dvt_create_fn)(struct ID3D11Device *device, dvt_log_fn log,
+                                  dvt_notify_fn notify, void *opaque);
+DVT_API dvt_ctx *dvt_create(struct ID3D11Device *device, dvt_log_fn log,
+                            dvt_notify_fn notify, void *opaque);
+
+// Leaves Dolby Vision output (waits for it) and frees the context.
+typedef void (*dvt_destroy_fn)(dvt_ctx *ctx);
+DVT_API void dvt_destroy(dvt_ctx *ctx);
+
+// Packs one picture. dovi/dovi_size: the frame's AVDOVIMetadata side data. el: the
+// Profile 7 enhancement layer (half size) or NULL. target: the back buffer (8-bit
+// RGBA or BGRA); without DVT_RENDER_DIRECT only its size and format are used here.
+// dest is the even-aligned destination rectangle, or NULL for centered aspect fit.
+// Returns 1 on success, 0 when this picture cannot be sent.
+typedef int (*dvt_render_fn)(dvt_ctx *ctx, const void *dovi, size_t dovi_size,
+                             const struct dvt_picture *bl, const struct dvt_picture *el,
+                             struct ID3D11Texture2D *target, int flags,
+                       const struct dvt_rect *dest);
+DVT_API int dvt_render(dvt_ctx *ctx, const void *dovi, size_t dovi_size,
+                       const struct dvt_picture *bl, const struct dvt_picture *el,
+                       struct ID3D11Texture2D *target, int flags,
+                       const struct dvt_rect *dest);
+
+// After dvt_render without DVT_RENDER_DIRECT: an R8G8B8A8 render target the size of
+// the output, cleared to transparent, for the GUI (premultiplied sRGB with alpha).
+// Returns 0 when the stream allows no GUI.
+typedef int (*dvt_gui_texture_fn)(dvt_ctx *ctx, struct ID3D11Texture2D **gui);
+DVT_API int dvt_gui_texture(dvt_ctx *ctx, struct ID3D11Texture2D **gui);
+
+// Writes the packed frame to target (the texture given to dvt_render), with the
+// GUI blended in when with_gui is set. Returns 1 on success.
+typedef int (*dvt_finish_fn)(dvt_ctx *ctx, int with_gui, struct ID3D11Texture2D *target);
+DVT_API int dvt_finish(dvt_ctx *ctx, int with_gui, struct ID3D11Texture2D *target);
+
+// want: Dolby Vision output on hmonitor for a stream of fps frames per second, or
+// (want = 0) leave it. Never blocks. Moving to another monitor leaves and re-enters.
+// mode is a preferred or fixed HDMI width, or the desktop mode.
+// On success link receives the confirmed HDMI dimensions (optional).
+enum dvt_mode {
+    DVT_MODE_DESKTOP = 0,
+    DVT_MODE_1080 = 1920,
+    DVT_MODE_2160 = 3840,
+    DVT_MODE_PREFER_2160 = -3840,
+};
+struct dvt_link { unsigned width, height; };
+// want=2 acknowledges DVT_OUTPUT_PREPARING for the same current request.
+// Returns the current enum dvt_output_state.
+typedef int (*dvt_output_fn)(dvt_ctx *ctx, int want, void *hmonitor, double fps,
+                             int mode, struct dvt_link *link);
+DVT_API int dvt_output(dvt_ctx *ctx, int want, void *hmonitor, double fps,
+                       int mode, struct dvt_link *link);
+
+// Restores a display a crashed player left in Dolby Vision. Blocks; call at start.
+typedef void (*dvt_remove_leftover_fn)(void);
+DVT_API void dvt_remove_leftover(void);
+
+// Writes the player's own line to mpv-dv.log (not passed back to the log callback).
+typedef void (*dvt_log_fn2)(const char *line);
+DVT_API void dvt_log(const char *line);
+
+// Playback diagnostics (any thread, any stream, no context needed): with ATTACH the DLL
+// logs the system once, starts a guard process that logs how the player ends and
+// restores the TV, a crash log with a dump file, and a watchdog for a frozen window or
+// picture (it records every thread's call stack when stuck).
+enum dvt_diag_event {
+    DVT_DIAG_ATTACH = 0,  // value: the player's HWND
+    DVT_DIAG_DETACH = 1,
+    DVT_DIAG_PLAYING = 2,
+    DVT_DIAG_PAUSED = 3,
+    DVT_DIAG_SEEK = 4,
+    DVT_DIAG_FRAME = 5,   // a picture was shown; value: its time in 100 ns units
+};
+typedef void (*dvt_diag_fn)(int event, long long value);
+DVT_API void dvt_diag(int event, long long value);
+
+// The graphics card driving a monitor. Only NVIDIA cards switch through NVAPI.
+enum dvt_gpu {
+    DVT_GPU_UNKNOWN = 0,
+    DVT_GPU_NVIDIA = 1,
+    DVT_GPU_AMD = 2,
+    DVT_GPU_INTEL = 3,
+    DVT_GPU_OTHER = 4,
+};
+// Returns enum dvt_gpu; name (may be NULL) gets the card's name in UTF-8.
+typedef int (*dvt_monitor_gpu_fn)(void *hmonitor, char *name, size_t name_size);
+DVT_API int dvt_monitor_gpu(void *hmonitor, char *name, size_t name_size);
+
+enum dvt_options {
+    // 50/60 fps films on a TV without 2160p60 Dolby Vision go out at 1080p60 Dolby Vision
+    // (the desktop is switched for the film); without it they are refused.
+    DVT_OPT_LOWRES_60 = 2,
+};
+typedef void (*dvt_set_options_fn)(int options);
+DVT_API void dvt_set_options(int options);
+
+// NVIDIA "content type reported to the display" on a monitor, as the control panel
+// lists it: 0 full-screen video, 1 desktop programs, 2 game, 3 photo, 4 cinema, 7 auto.
+// set_to >= 0 also sets it (7 is never written). Returns the value before, -1 unknown
+// (not NVIDIA), -2 the set failed.
+typedef int (*dvt_content_type_fn)(void *hmonitor, int set_to);
+DVT_API int dvt_content_type(void *hmonitor, int set_to);
+
+// Windows HDR on a monitor. set: -1 only reads it, 0 turns it off, 1 on.
+// Returns 2 on, 1 off, 0 the display has no HDR, -1 unknown.
+typedef int (*dvt_windows_hdr_fn)(void *hmonitor, int set);
+DVT_API int dvt_windows_hdr(void *hmonitor, int set);
+
+#ifdef __cplusplus
+}
+#endif
