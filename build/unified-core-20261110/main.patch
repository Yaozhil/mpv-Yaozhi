+// Set the current level before publishing an event. Coalesced events are fine:
+// the core always re-reads the current level, never treats the bit as a toggle.
+void vo_set_output_wait(struct vo *vo, bool waiting)
+{
+    struct vo_internal *in = vo->in;
+    mp_mutex_lock(&in->lock);
+    bool changed = in->output_wait != waiting;
+    in->output_wait = waiting;
+    mp_mutex_unlock(&in->lock);
+    if (changed)
+        vo_event(vo, VO_EVENT_OUTPUT_WAIT);
+}
+
+bool vo_get_output_wait(struct vo *vo)
+{
+    struct vo_internal *in = vo->in;
+    mp_mutex_lock(&in->lock);
+    bool waiting = in->output_wait;
+    mp_mutex_unlock(&in->lock);
+    return waiting;
+}
