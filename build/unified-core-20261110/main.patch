+/* Physical output slots are separate from a stream's compact channel map.
+ * Never infer these slots from a channel count or reinterpret unnamed PCM.
+ * This file is part of mpv; LGPL-2.1-or-later.
+ */
+#ifndef MP_DEVICE_CHANNEL_MAP_H
+#define MP_DEVICE_CHANNEL_MAP_H
+
+#include "audio/chmap.h"
+
+static inline bool mp_device_chmap_fully_named(const struct mp_chmap *map)
+{
+    if (!map->num || map->num > MP_NUM_CHANNELS)
+        return false;
+    for (int c = 0; c < map->num; c++) {
+        if (map->speaker[c] >= MP_SPEAKER_ID_NA)
+            return false;
+    }
+    return true;
+}
+
+// Both maps must already have passed mp_chmap_is_valid(). A profile may contain
+// padding, but must have an unambiguous slot for every named input speaker.
+static inline bool mp_device_chmap_covers(const struct mp_chmap *profile,
+                                         const struct mp_chmap *input)
+{
+    if (!mp_device_chmap_fully_named(input) || profile->num < input->num ||
+        profile->num > MP_NUM_CHANNELS)
+        return false;
+    for (int c = 0; c < input->num; c++) {
+        int matches = 0;
+        for (int o = 0; o < profile->num; o++)
+            matches += input->speaker[c] == profile->speaker[o];
+        if (matches != 1)
+            return false;
+    }
+    return true;
+}
+
+// DIRECTOUT has no speaker semantics. Only an explicit/trusted profile can
+// supply them, and its count must equal the driver-accepted transport count.
+static inline bool mp_device_chmap_accepts(const struct mp_chmap *profile,
+                                          const struct mp_chmap *wire)
+{
+    if (!profile->num || wire->num != profile->num)
+        return false;
+    bool directout = true, same = true;
+    for (int c = 0; c < wire->num; c++) {
+        directout &= wire->speaker[c] == MP_SPEAKER_ID_NA;
+        same &= wire->speaker[c] == profile->speaker[c];
+    }
+    return directout || same;
+}
+
+#endif
