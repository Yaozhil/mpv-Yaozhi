@@ -0,0 +1,400 @@
+/*
+ * Built-in client that drives liborender's spatial object overlay.
+ *
+ * Replaces the former omniphony-overlay.lua shim: that script needed LuaJIT's
+ * FFI to reach the liborender symbols, so it silently disabled itself on
+ * builds using PUC Lua (the released Windows/Linux bundles). The overlay is
+ * still generated entirely inside liborender — this file only pulls the
+ * finished ASS payload (and the BGRA heatmap bitmap) and hands them to mpv's
+ * `osd-overlay` / `overlay-add` commands, which must be issued from a client
+ * handle on its own thread (the decoder thread has neither).
+ *
+ * The client is named "omniphony_overlay" (mp_new_client rewrites any
+ * non-alphanumeric character to '_', so a dashed name cannot exist). User
+ * input.conf lines:
+ *     KEY script-binding omniphony_overlay/<name>
+ *     KEY script-message omniphony-overlay <name>
+ *
+ * This file is part of mpv. mpv is free software; you can redistribute it
+ * and/or modify it under the terms of the GNU Lesser General Public License
+ * as published by the Free Software Foundation; either version 2.1 of the
+ * License, or (at your option) any later version.
+ */
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "common/orender_abi.h"
+#include "common/orender_dl.h"
+
+#include "common/common.h"
+#include "common/msg.h"
+#include "mpv/client.h"
+#include "osdep/threads.h"
+#include "osdep/timer.h"
+#include "player/client.h"
+#include "player/core.h"
+
+#define OVERLAY_ID 47
+#define HEATMAP_OVERLAY_ID 48
+#define REDRAW_PERIOD (1.0 / 30)
+/* Generous fixed buffer: the ASS payload is bounded (cube + capped objects
+ * and trails). If a frame ever exceeds it we grow and skip that one redraw. */
+#define INITIAL_CAP (64 * 1024)
+#define HEATMAP_PIX_CAP (256 * 256 * 4)
+
+struct overlay_ctx {
+    struct mp_log *log;
+    mpv_handle *client;
+    const struct orender_dl *dl;   // loaded + overlay group verified by start()
+
+    bool enabled;
+    bool shown;
+    bool heatmap_shown;
+
+    uint8_t *buf;
+    size_t cap;
+
+    uint8_t *heatmap_buf;
+    int32_t heatmap_geom[6];
+    /* Fixed-lifetime buffer → its address is constant; formatted once. */
+    char heatmap_addr[32];
+};
+
+static void cmd_show_text(struct overlay_ctx *ctx, const char *text)
+{
+    const char *args[] = {"show-text", text, "1000", NULL};
+    mpv_command(ctx->client, args);
+}
+
+static void hide(struct overlay_ctx *ctx)
+{
+    if (!ctx->shown)
+        return;
+    ctx->shown = false;
+
+    char *keys[] = {"name", "id", "format", "data", "res_x", "res_y", "z",
+                    "hidden"};
+    mpv_node vals[8] = {
+        {.format = MPV_FORMAT_STRING, .u.string = "osd-overlay"},
+        {.format = MPV_FORMAT_INT64,  .u.int64 = OVERLAY_ID},
+        {.format = MPV_FORMAT_STRING, .u.string = "none"},
+        {.format = MPV_FORMAT_STRING, .u.string = ""},
+        {.format = MPV_FORMAT_INT64,  .u.int64 = 0},
+        {.format = MPV_FORMAT_INT64,  .u.int64 = 0},
+        {.format = MPV_FORMAT_INT64,  .u.int64 = 0},
+        {.format = MPV_FORMAT_FLAG,   .u.flag = 1},
+    };
+    mpv_node_list map = {.num = 8, .values = vals, .keys = keys};
+    mpv_node cmd = {.format = MPV_FORMAT_NODE_MAP, .u.list = &map};
+    mpv_command_node(ctx->client, &cmd, NULL);
+}
+
+static void hide_heatmap(struct overlay_ctx *ctx)
+{
+    if (!ctx->heatmap_shown)
+        return;
+    ctx->heatmap_shown = false;
+
+    char id[12];
+    snprintf(id, sizeof(id), "%d", HEATMAP_OVERLAY_ID);
+    const char *args[] = {"overlay-remove", id, NULL};
+    mpv_command(ctx->client, args);
+}
+
+/* Pull the flattened BGRA heatmap and hand it to `overlay-add`, composited
+ * under the ASS layer. A 0 return (disabled / silent / no objects) clears it.
+ * Independent of the ASS pull — does not advance trails. */
+static void redraw_heatmap(struct overlay_ctx *ctx, int64_t res_x, int64_t res_y)
+{
+    size_t n = ctx->dl->overlay_heatmap_bgra(res_x, res_y, ctx->heatmap_buf,
+                                             HEATMAP_PIX_CAP, ctx->heatmap_geom);
+    if (n == 0) {
+        hide_heatmap(ctx);
+        return;
+    }
+    ctx->heatmap_shown = true;
+
+    int32_t *g = ctx->heatmap_geom;
+    mpv_node vals[12] = {
+        {.format = MPV_FORMAT_STRING, .u.string = "overlay-add"},
+        {.format = MPV_FORMAT_INT64,  .u.int64 = HEATMAP_OVERLAY_ID},
+        {.format = MPV_FORMAT_INT64,  .u.int64 = g[0]},  /* x (screen px) */
+        {.format = MPV_FORMAT_INT64,  .u.int64 = g[1]},  /* y */
+        {.format = MPV_FORMAT_STRING, .u.string = ctx->heatmap_addr},
+        {.format = MPV_FORMAT_INT64,  .u.int64 = 0},     /* offset */
+        {.format = MPV_FORMAT_STRING, .u.string = "bgra"},
+        {.format = MPV_FORMAT_INT64,  .u.int64 = g[2]},  /* source w */
+        {.format = MPV_FORMAT_INT64,  .u.int64 = g[3]},  /* source h */
+        {.format = MPV_FORMAT_INT64,  .u.int64 = g[2] * 4}, /* stride */
+        {.format = MPV_FORMAT_INT64,  .u.int64 = g[4]},  /* display w */
+        {.format = MPV_FORMAT_INT64,  .u.int64 = g[5]},  /* display h */
+    };
+    mpv_node_list args = {.num = 12, .values = vals};
+    mpv_node cmd = {.format = MPV_FORMAT_NODE_ARRAY, .u.list = &args};
+    mpv_command_node(ctx->client, &cmd, NULL);
+}
+
+static void redraw(struct overlay_ctx *ctx)
+{
+    if (!ctx->enabled)
+        return;
+
+    int64_t res_x = 0, res_y = 0;
+    mpv_get_property(ctx->client, "osd-width", MPV_FORMAT_INT64, &res_x);
+    mpv_get_property(ctx->client, "osd-height", MPV_FORMAT_INT64, &res_y);
+    if (res_x <= 0 || res_y <= 0)
+        return;
+
+    /* One call == one overlay redraw: the library rebuilds the scene and
+     * advances the motion trails on each call, so call exactly once. */
+    size_t n = ctx->dl->overlay_ass(res_x, res_y, ctx->buf, ctx->cap);
+    if (n == 0) {
+        /* Nothing to draw (disabled, non-spatial, or empty) → clear both. */
+        hide(ctx);
+        hide_heatmap(ctx);
+        return;
+    }
+    if (n > ctx->cap) {
+        /* Outgrew the buffer (very unlikely): grow, skip this frame. */
+        ctx->cap = n;
+        ctx->buf = realloc(ctx->buf, ctx->cap + 1);
+        MP_HANDLE_OOM(ctx->buf);
+        return;
+    }
+    ctx->buf[n] = '\0';
+
+    ctx->shown = true;
+    char *keys[] = {"name", "id", "format", "data", "res_x", "res_y", "z",
+                    "hidden"};
+    mpv_node vals[8] = {
+        {.format = MPV_FORMAT_STRING, .u.string = "osd-overlay"},
+        {.format = MPV_FORMAT_INT64,  .u.int64 = OVERLAY_ID},
+        {.format = MPV_FORMAT_STRING, .u.string = "ass-events"},
+        {.format = MPV_FORMAT_STRING, .u.string = (char *)ctx->buf},
+        {.format = MPV_FORMAT_INT64,  .u.int64 = res_x},
+        {.format = MPV_FORMAT_INT64,  .u.int64 = res_y},
+        {.format = MPV_FORMAT_INT64,  .u.int64 = 0},
+        {.format = MPV_FORMAT_FLAG,   .u.flag = 0},
+    };
+    mpv_node_list map = {.num = 8, .values = vals, .keys = keys};
+    mpv_node cmd = {.format = MPV_FORMAT_NODE_MAP, .u.list = &map};
+    mpv_command_node(ctx->client, &cmd, NULL);
+
+    redraw_heatmap(ctx, res_x, res_y);
+}
+
+/* Absolute master enable/disable. Also gates the redraw timer and hides both
+ * OSD layers when off. */
+static void set_active(struct overlay_ctx *ctx, bool on)
+{
+    ctx->enabled = on;
+    ctx->dl->overlay_set_enabled(on);
+    if (on) {
+        redraw(ctx);
+    } else {
+        hide(ctx);
+        hide_heatmap(ctx);
+    }
+}
+
+/* Master toggle: flip in the library (returns the new state) so it tracks
+ * Studio's OSC changes; the renderer is the single source of truth. */
+static void toggle_master(struct overlay_ctx *ctx)
+{
+    ctx->enabled = ctx->dl->overlay_toggle() != 0;
+    if (ctx->enabled) {
+        redraw(ctx);
+    } else {
+        hide(ctx);
+        hide_heatmap(ctx);
+    }
+    cmd_show_text(ctx, ctx->enabled ? "Spatial overlay: on"
+                                    : "Spatial overlay: off");
+}
+
+static void bool_toggle(struct overlay_ctx *ctx, int (*fn)(void),
+                        const char *label)
+{
+    char text[80];
+    snprintf(text, sizeof(text), "%s: %s", label, fn() ? "on" : "off");
+    cmd_show_text(ctx, text);
+    redraw(ctx);
+}
+
+static void cycle_colormap(struct overlay_ctx *ctx)
+{
+    char text[80];
+    snprintf(text, sizeof(text), "Heatmap colormap: %" PRIu32,
+             ctx->dl->overlay_cycle_heatmap_colormap());
+    cmd_show_text(ctx, text);
+    redraw(ctx);
+}
+
+static void adjust_bands(struct overlay_ctx *ctx, int32_t delta)
+{
+    char text[80];
+    snprintf(text, sizeof(text), "Heatmap planes: %" PRIu32,
+             ctx->dl->overlay_adjust_heatmap_bands(delta));
+    cmd_show_text(ctx, text);
+    redraw(ctx);
+}
+
+/* Shared command vocabulary of the named key bindings
+ * (`script-binding omniphony-overlay/<cmd>`) and the script message
+ * (`script-message omniphony-overlay <cmd>`). */
+static void run_overlay_cmd(struct overlay_ctx *ctx, const char *cmd)
+{
+    if (!strcmp(cmd, "enable")) {
+        set_active(ctx, true);
+    } else if (!strcmp(cmd, "disable")) {
+        set_active(ctx, false);
+    } else if (!strcmp(cmd, "toggle")) {
+        toggle_master(ctx);
+    } else if (!strcmp(cmd, "labels")) {
+        bool_toggle(ctx, ctx->dl->overlay_toggle_labels, "Overlay labels");
+    } else if (!strcmp(cmd, "objects")) {
+        bool_toggle(ctx, ctx->dl->overlay_toggle_objects, "Overlay objects");
+    } else if (!strcmp(cmd, "trails")) {
+        bool_toggle(ctx, ctx->dl->overlay_toggle_trails, "Overlay trails");
+    } else if (!strcmp(cmd, "heatmap")) {
+        bool_toggle(ctx, ctx->dl->overlay_toggle_heatmap, "Energy heatmap");
+    } else if (!strcmp(cmd, "colormap") || !strcmp(cmd, "heatmap-colormap")) {
+        cycle_colormap(ctx);
+    } else if (!strcmp(cmd, "bands-inc") || !strcmp(cmd, "heatmap-bands-inc")) {
+        adjust_bands(ctx, 1);
+    } else if (!strcmp(cmd, "bands-dec") || !strcmp(cmd, "heatmap-bands-dec")) {
+        adjust_bands(ctx, -1);
+    } else {
+        MP_VERBOSE(ctx, "unknown overlay command: %s\n", cmd);
+    }
+}
+
+/* Mirror the dispatch rule of Lua's mp.add_key_binding (defaults.lua,
+ * non-repeatable form): plain keys fire on down/press, mouse buttons on
+ * up/press; canceled and repeat events are dropped. */
+static bool key_state_fires(const char *state)
+{
+    bool is_mouse = state[0] && state[1] == 'm';
+    bool canceled = state[0] && state[1] && state[2] == 'c';
+    if (canceled || state[0] == 'r')
+        return false;
+    if (is_mouse)
+        return state[0] == 'u' || state[0] == 'p';
+    return state[0] == 'd' || state[0] == 'p';
+}
+
+static void handle_client_message(struct overlay_ctx *ctx,
+                                  mpv_event_client_message *msg)
+{
+    if (msg->num_args >= 3 && !strcmp(msg->args[0], "key-binding")) {
+        if (key_state_fires(msg->args[2]))
+            run_overlay_cmd(ctx, msg->args[1]);
+        return;
+    }
+    /* `script-message omniphony-overlay <cmd>` broadcasts to every client.
+     * Also accept the underscored spelling of the client name. */
+    if (msg->num_args >= 2 && (!strcmp(msg->args[0], "omniphony-overlay") ||
+                               !strcmp(msg->args[0], "omniphony_overlay")))
+        run_overlay_cmd(ctx, msg->args[1]);
+}
+
+static MP_THREAD_VOID overlay_thread(void *p)
+{
+    struct overlay_ctx *ctx = p;
+    mp_thread_set_name("orender-ov");
+
+    mpv_observe_property(ctx->client, 0, "osd-width", MPV_FORMAT_INT64);
+    mpv_observe_property(ctx->client, 0, "osd-height", MPV_FORMAT_INT64);
+
+    double next_redraw = mp_time_sec();
+    bool terminate = false;
+    while (!terminate) {
+        double timeout = ctx->enabled
+                             ? MPMAX(0, next_redraw - mp_time_sec())
+                             : 1e9;
+        mpv_event *ev = mpv_wait_event(ctx->client, timeout);
+        switch (ev->event_id) {
+        case MPV_EVENT_SHUTDOWN:
+            terminate = true;
+            break;
+        case MPV_EVENT_PROPERTY_CHANGE:
+            /* osd-width/-height: redraw immediately so the overlay tracks
+             * window resizes snappily. */
+            redraw(ctx);
+            next_redraw = mp_time_sec() + REDRAW_PERIOD;
+            break;
+        case MPV_EVENT_CLIENT_MESSAGE:
+            handle_client_message(ctx, ev->data);
+            break;
+        default:
+            break;
+        }
+        if (ctx->enabled && mp_time_sec() >= next_redraw) {
+            redraw(ctx);
+            next_redraw = mp_time_sec() + REDRAW_PERIOD;
+        }
+    }
+
+    /* Clear on shutdown so the OSD doesn't linger past quit (best effort —
+     * the core may already reject commands). */
+    ctx->enabled = false;
+    hide(ctx);
+    hide_heatmap(ctx);
+
+    mpv_handle *client = ctx->client;
+    free(ctx->buf);
+    free(ctx->heatmap_buf);
+    talloc_free(ctx);
+    mpv_destroy(client);
+    MP_THREAD_RETURN();
+}
+
+void mp_orender_overlay_start(struct MPContext *mpctx)
+{
+    /* The overlay is pure cosmetics: when liborender is absent/incompatible
+     * (the decoder already logs the one actionable warning) or predates the
+     * overlay API, quietly don't start the client thread. */
+    const struct orender_dl *dl = orender_dl_get(mpctx->global, mpctx->log);
+    if (!dl || !dl->have_overlay) {
+        MP_VERBOSE(mpctx, "orender overlay: not starting (%s)\n",
+                   dl ? "library lacks the overlay symbols"
+                      : orender_dl_error());
+        return;
+    }
+
+    /* Created before the thread so a destroyed MPContext can't race the
+     * client creation (same pattern as scripting.c). */
+    mpv_handle *client = mp_new_client(mpctx->clients, "omniphony_overlay");
+    if (!client) {
+        MP_ERR(mpctx, "orender overlay: failed to create client\n");
+        return;
+    }
+    mp_client_set_weak(client);
+
+    struct overlay_ctx *ctx = talloc_zero(NULL, struct overlay_ctx);
+    ctx->log = mp_client_get_log(client);
+    ctx->client = client;
+    ctx->dl = dl;
+    ctx->enabled = true;
+    ctx->cap = INITIAL_CAP;
+    ctx->buf = malloc(ctx->cap + 1);
+    ctx->heatmap_buf = malloc(HEATMAP_PIX_CAP);
+    if (!ctx->buf || !ctx->heatmap_buf)
+        abort();
+    snprintf(ctx->heatmap_addr, sizeof(ctx->heatmap_addr), "&0x%" PRIxPTR,
+             (uintptr_t)ctx->heatmap_buf);
+
+    mp_thread thread;
+    if (mp_thread_create(&thread, overlay_thread, ctx)) {
+        free(ctx->buf);
+        free(ctx->heatmap_buf);
+        talloc_free(ctx);
+        mpv_destroy(client);
+        MP_ERR(mpctx, "orender overlay: failed to create thread\n");
+        return;
+    }
+    mp_thread_detach(thread);
+}
