+/* ── loader state (process singleton) ─────────────────────────────────────── */
+
+static mp_static_mutex load_lock = MP_STATIC_MUTEX_INITIALIZER;
+static enum { LOAD_UNTRIED, LOAD_OK, LOAD_FAILED } load_state = LOAD_UNTRIED;
+static struct orender_dl table;
