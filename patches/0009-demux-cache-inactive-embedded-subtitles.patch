From aa1e3e9f96e0f9708365443c41797930ba18349a Mon Sep 17 00:00:00 2001
From: Codex Patch Check <codex-patch-check@local.invalid>
Date: Wed, 19 Aug 2026 06:39:32 +0800
Subject: [PATCH] demux: cache inactive embedded subtitles

---
 demux/demux.c      | 85 ++++++++++++++++++++++++++++++++++++++++++++--
 demux/demux.h      |  3 ++
 demux/demux_disc.c | 15 ++++++--
 demux/demux_lavf.c | 24 +++++++++++++
 demux/demux_mkv.c  | 40 ++++++++++++++++++++--
 5 files changed, 160 insertions(+), 7 deletions(-)

diff --git a/demux/demux.c b/demux/demux.c
index 20d2739d97b7bcd29b6660f8b2d5b347a7614b4f..952a2f7208ec10363ee81819cd429d56d37f35c6 100644
--- a/demux/demux.c
+++ b/demux/demux.c
@@ -388,6 +388,7 @@ struct demux_stream {
 
     // demuxer state
     bool selected;          // user wants packets from this stream
+    bool cache_inactive;    // demuxer wants packets while this is unselected
     bool eager;             // try to keep at least 1 packet queued
                             // if false, this stream is disabled, or passively
                             // read (like subtitles)
@@ -923,7 +924,7 @@ static void update_stream_selection_state(struct demux_internal *in,
     for (int n = 0; n < in->num_ranges; n++) {
         struct demux_cached_range *range = in->ranges[n];
 
-        if (!ds->selected)
+        if (!ds->selected && !ds->cache_inactive)
             clear_queue(range->streams[ds->index]);
 
         update_seek_ranges(range);
@@ -2114,7 +2115,8 @@ static void add_packet_locked(struct sh_stream *stream, demux_packet_t *dp)
 
     struct demux_queue *queue = ds->queue;
 
-    bool drop = !ds->selected || in->seeking || ds->sh->attached_picture;
+    bool drop = (!ds->selected && !ds->cache_inactive) || in->seeking ||
+                ds->sh->attached_picture;
 
     if (!drop) {
         // If libavformat splits packets, some packets will have pos unset, so
@@ -4092,6 +4094,63 @@ static void refresh_track(struct demux_internal *in, struct sh_stream *stream,
 {
     struct demux_stream *ds = stream->ds;
     ref_pts = MP_ADD_PTS(ref_pts, -in->ts_offset);
+    // Subtitle selection asks for packets 10 seconds before the playback
+    // point.  Keep that preroll for the queue lookup, but test cache coverage
+    // at the actual playback point so a valid A/V cache range is not rejected.
+    double cache_ref_pts = ref_pts;
+    if (ds->type == STREAM_SUB)
+        cache_ref_pts = MP_ADD_PTS(cache_ref_pts, 10.0);
+    // Sparse subtitle queues need not contain a packet at ref_pts. If the
+    // current range has already been demuxed through ref_pts, the demuxer has
+    // also delivered every embedded subtitle packet up to it.
+    struct demux_cached_range *range = in->current_range;
+    bool cache_covers_ref = range && ds->queue == range->streams[ds->index];
+    if (cache_covers_ref) {
+        double cache_start = range->seek_start != MP_NOPTS_VALUE
+            ? range->seek_start : ds->queue->seek_start;
+        bool starts_before_ref = range->is_bof ||
+            (cache_start != MP_NOPTS_VALUE && cache_ref_pts >= cache_start);
+        bool ends_after_ref = range->is_eof ||
+            (range->seek_end != MP_NOPTS_VALUE &&
+             cache_ref_pts <= range->seek_end);
+        ends_after_ref |= in->demux_ts != MP_NOPTS_VALUE &&
+                          in->demux_ts >= cache_ref_pts;
+        cache_covers_ref = starts_before_ref && ends_after_ref;
+    }
+    if (ds->cache_inactive && cache_covers_ref) {
+        // ref_pts includes mpv's subtitle preroll. PGS packets are sparse and
+        // a visible composition can start before that preroll point, so resume
+        // decoding from the most recent PGS packet group at the display time.
+        double display_pts = ds->type == STREAM_SUB
+            ? MP_ADD_PTS(ref_pts, 10.0) : ref_pts;
+        struct demux_packet *target = NULL;
+        struct demux_packet *group_start = NULL;
+        double group_pts = MP_NOPTS_VALUE;
+        for (struct demux_packet *dp = ds->queue->head; dp; dp = dp->next) {
+            double pts = MP_PTS_OR_DEF(dp->pts, dp->dts);
+            if (pts == MP_NOPTS_VALUE)
+                continue;
+            if (!group_start || fabs(pts - group_pts) > 0.000001) {
+                group_start = dp;
+                group_pts = pts;
+            }
+            if (pts <= display_pts)
+                target = group_start;
+            else if (!target)
+                target = group_start;
+            if (pts > display_pts && target)
+                break;
+        }
+        // An empty span is also valid for sparse subtitles. The next packet,
+        // if any, is beyond the cached playback interval, so a refresh seek
+        // would only disrupt the A/V cache without producing a subtitle.
+        ds->reader_head = target;
+        ds->eof = false;
+        ds->skip_to_keyframe = false;
+        MP_VERBOSE(in, "using cached packets for stream %d at %f%s\n",
+                   stream->index, ref_pts, target ? "" : " (subtitle gap)");
+        return;
+    }
 
     if (in->back_demuxing)
         ds->back_seek_pos = ref_pts;
@@ -4193,6 +4252,28 @@ bool demux_stream_is_selected(struct sh_stream *stream)
     return r;
 }
 
+void demuxer_set_stream_cache_inactive(struct sh_stream *stream, bool enabled)
+{
+    if (!stream)
+        return;
+
+    struct demux_internal *in = stream->ds->in;
+    struct demux_stream *ds = stream->ds;
+    mp_mutex_lock(&in->lock);
+    if (ds->cache_inactive != enabled) {
+        ds->cache_inactive = enabled;
+        if (!enabled && !ds->selected) {
+            for (int n = 0; n < in->num_ranges; n++) {
+                struct demux_cached_range *range = in->ranges[n];
+                clear_queue(range->streams[ds->index]);
+                update_seek_ranges(range);
+            }
+            free_empty_cached_ranges(in);
+        }
+    }
+    mp_mutex_unlock(&in->lock);
+}
+
 void demux_set_stream_wakeup_cb(struct sh_stream *sh,
                                 void (*cb)(void *ctx), void *ctx)
 {
diff --git a/demux/demux.h b/demux/demux.h
index 6fabf64b9940ee9b100050807eacd7c16a1c9258..d3c54e5067d328019f6405fc7cb9af0ba11ff337 100644
--- a/demux/demux.h
+++ b/demux/demux.h
@@ -300,6 +300,9 @@ int demux_read_packet_async(struct sh_stream *sh, struct demux_packet **out_pkt)
 int demux_read_packet_async_until(struct sh_stream *sh, double min_pts,
                                   struct demux_packet **out_pkt);
 bool demux_stream_is_selected(struct sh_stream *stream);
+// Let a demuxer retain packets for an inactive stream. This is intended for
+// sparse, switchable embedded subtitle tracks only.
+void demuxer_set_stream_cache_inactive(struct sh_stream *stream, bool enabled);
 void demux_set_stream_wakeup_cb(struct sh_stream *sh,
                                 void (*cb)(void *ctx), void *ctx);
 struct demux_packet *demux_read_any_packet(struct demuxer *demuxer);
diff --git a/demux/demux_disc.c b/demux/demux_disc.c
index 86557a711c2daa257ebb9fcdf79868787a7da62b..f63ac0291e9de007e93e7b8cd4df867f5efeb0bf 100644
--- a/demux/demux_disc.c
+++ b/demux/demux_disc.c
@@ -58,8 +58,13 @@ static void reselect_streams(demuxer_t *demuxer)
     int num_slave = demux_get_num_stream(p->slave);
     for (int n = 0; n < MPMIN(num_slave, p->num_streams); n++) {
         if (p->streams[n]) {
-            demuxer_select_track(p->slave, demux_get_stream(p->slave, n),
-                MP_NOPTS_VALUE, demux_stream_is_selected(p->streams[n]));
+            struct sh_stream *src = demux_get_stream(p->slave, n);
+            bool selected = demux_stream_is_selected(p->streams[n]);
+            demuxer_select_track(p->slave, src, MP_NOPTS_VALUE, selected);
+            if (src && src->type == STREAM_SUB)
+                demuxer_set_stream_cache_inactive(src, true);
+            if (p->streams[n]->type == STREAM_SUB)
+                demuxer_set_stream_cache_inactive(p->streams[n], true);
         }
     }
 }
@@ -116,6 +121,7 @@ static void add_dvd_streams(demuxer_t *demuxer)
             sh->codec->extradata_size = strlen(s);
 
             demux_add_sh_stream(demuxer, sh);
+            demuxer_set_stream_cache_inactive(sh, true);
         }
     }
 }
@@ -134,6 +140,7 @@ static void add_streams(demuxer_t *demuxer)
             if (sub) {
                 mp_assert(p->num_streams == n); // directly mapped
                 MP_TARRAY_APPEND(p, p->streams, p->num_streams, sub);
+                demuxer_set_stream_cache_inactive(sub, true);
                 continue;
             }
         }
@@ -158,6 +165,8 @@ static void add_streams(demuxer_t *demuxer)
         }
         get_disc_lang(demuxer->stream, sh, p->is_dvd);
         demux_add_sh_stream(demuxer, sh);
+        if (src->type == STREAM_SUB)
+            demuxer_set_stream_cache_inactive(sh, true);
     }
 
     // Mirror slave sh_stream_group onto the disc-level sh_streams. This is needed
@@ -248,7 +257,7 @@ static bool d_read_packet(struct demuxer *demuxer, struct demux_packet **out_pkt
     }
 
     struct sh_stream *sh = p->streams[pkt->stream];
-    if (!demux_stream_is_selected(sh)) {
+    if (!demux_stream_is_selected(sh) && sh->type != STREAM_SUB) {
         talloc_free(pkt);
         return true;
     }
diff --git a/demux/demux_lavf.c b/demux/demux_lavf.c
index ed55dd517e6ac70d597f814c448c0001c8e88d63..d0b4d510c7983ace9d72459d75059ae4052b9605 100644
--- a/demux/demux_lavf.c
+++ b/demux/demux_lavf.c
@@ -599,11 +599,35 @@ static void guess_and_set_vobsub_name(struct demuxer *demuxer, AVDictionary **d)
 static void select_tracks(struct demuxer *demuxer, int start)
 {
     lavf_priv_t *priv = demuxer->priv;
+    int switchable_subs = 0;
+
+    for (int n = 0; n < priv->num_streams; n++) {
+        struct sh_stream *stream = priv->streams[n]->sh;
+        if (stream && stream->type == STREAM_SUB && !stream->attached_picture)
+            switchable_subs++;
+    }
+
+    for (int n = 0; n < priv->num_streams; n++) {
+        struct sh_stream *stream = priv->streams[n]->sh;
+        if (stream && stream->type == STREAM_SUB) {
+            demuxer_set_stream_cache_inactive(
+                stream, switchable_subs > 1 && !stream->attached_picture);
+        }
+    }
+
     for (int n = start; n < priv->num_streams; n++) {
         struct sh_stream *stream = priv->streams[n]->sh;
         AVStream *st = priv->avfc->streams[n];
         bool selected = stream && demux_stream_is_selected(stream) &&
                         !stream->attached_picture;
+        // Keep every embedded subtitle stream in the demux cache when there
+        // is a real choice of subtitle tracks.  Track switching can then use
+        // packets at the current playback position without a refresh seek.
+        if (switchable_subs > 1 && stream && stream->type == STREAM_SUB &&
+            !stream->attached_picture)
+        {
+            selected = true;
+        }
         if (!selected && priv->streams[n]->dovi_split) {
             struct sh_stream *el =
                 mp_dovi_split_el_stream(priv->streams[n]->dovi_split);
diff --git a/demux/demux_mkv.c b/demux/demux_mkv.c
index 0b59be5fb6777f2f3d5df5581e3939cfd35ecf3c..4416702d7268723f7ac20697f9ca81d0ffe15371 100644
--- a/demux/demux_mkv.c
+++ b/demux/demux_mkv.c
@@ -223,7 +223,7 @@ typedef struct mkv_demuxer {
     int v_skip_to_keyframe, a_skip_to_keyframe;
     int a_skip_preroll;
     int subtitle_preroll;
-
+    bool cache_inactive_subtitles;
     bool index_has_durations;
 
     bool eof_warning, keyframe_warning;
@@ -1569,6 +1569,7 @@ static void init_track(demuxer_t *demuxer, mkv_track_t *track,
 static int demux_mkv_open_video(demuxer_t *demuxer, mkv_track_t *track);
 static int demux_mkv_open_audio(demuxer_t *demuxer, mkv_track_t *track);
 static int demux_mkv_open_sub(demuxer_t *demuxer, mkv_track_t *track);
+static void update_inactive_subtitle_cache(demuxer_t *demuxer);
 
 static void display_create_tracks(demuxer_t *demuxer)
 {
@@ -1587,6 +1588,34 @@ static void display_create_tracks(demuxer_t *demuxer)
             break;
         }
     }
+
+    // Enable this before the first seek so the normal subtitle preroll also
+    // captures inactive tracks at the initial playback position.
+    update_inactive_subtitle_cache(demuxer);
+}
+
+static void update_inactive_subtitle_cache(demuxer_t *demuxer)
+{
+    mkv_demuxer_t *mkv_d = demuxer->priv;
+    int num_subtitles = 0;
+
+    for (int n = 0; n < mkv_d->num_tracks; n++) {
+        mkv_track_t *track = mkv_d->tracks[n];
+        if (track->type == MATROSKA_TRACK_SUBTITLE && track->stream &&
+            !track->stream->attached_picture) {
+            num_subtitles++;
+        }
+    }
+
+    mkv_d->cache_inactive_subtitles = num_subtitles > 1;
+    for (int n = 0; n < mkv_d->num_tracks; n++) {
+        mkv_track_t *track = mkv_d->tracks[n];
+        if (track->type == MATROSKA_TRACK_SUBTITLE && track->stream) {
+            demuxer_set_stream_cache_inactive(
+                track->stream, mkv_d->cache_inactive_subtitles &&
+                !track->stream->attached_picture);
+        }
+    }
 }
 
 static const char *const mkv_video_tags[][2] = {
@@ -3122,7 +3151,14 @@ static int handle_block(demuxer_t *demuxer, struct block_info *block_info)
                                     ? mp_dovi_split_el_stream(track->dovi_split)
                                     : NULL;
     bool need_for_split = split_el && demux_stream_is_selected(split_el);
-    if (!demux_stream_is_selected(stream) && !need_for_split)
+    // Preserve every embedded subtitle stream when there is a real subtitle
+    // choice. The generic cache can then serve the packets at the current
+    // playback point instead of forcing a refresh seek on a later switch.
+    bool cache_inactive_subtitle = track->type == MATROSKA_TRACK_SUBTITLE &&
+                                  !stream->attached_picture &&
+                                  mkv_d->cache_inactive_subtitles;
+    if (!demux_stream_is_selected(stream) && !need_for_split &&
+        !cache_inactive_subtitle)
         return 0;
 
     current_pts = tc / 1e9 - track->codec_delay;
