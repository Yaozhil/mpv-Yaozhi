From 742d3c8cbe680543b44acd4ea90bff3cbc6a8f5a Mon Sep 17 00:00:00 2001
From: Yaozhi mpv build <build@local.invalid>
Date: Mon, 17 Aug 2026 11:32:04 +0800
Subject: [PATCH] demux: cache inactive embedded subtitles for instant
 switching

---
 demux/demux.c      | 46 ++++++++++++++++++++++++++++++++++++++++++++--
 demux/demux_lavf.c | 16 ++++++++++++++++
 2 files changed, 60 insertions(+), 2 deletions(-)

diff --git a/demux/demux.c b/demux/demux.c
index 20d2739d9..8a4648ca4 100644
--- a/demux/demux.c
+++ b/demux/demux.c
@@ -923,7 +923,10 @@ static void update_stream_selection_state(struct demux_internal *in,
     for (int n = 0; n < in->num_ranges; n++) {
         struct demux_cached_range *range = in->ranges[n];
 
-        if (!ds->selected)
+        // libavformat keeps inactive embedded subtitle packets when a file
+        // offers multiple subtitle tracks.  Retain those sparse queues so a
+        // later switch can start from the existing cache without seeking.
+        if (!ds->selected && ds->type != STREAM_SUB)
             clear_queue(range->streams[ds->index]);
 
         update_seek_ranges(range);
@@ -2114,7 +2117,8 @@ static void add_packet_locked(struct sh_stream *stream, demux_packet_t *dp)
 
     struct demux_queue *queue = ds->queue;
 
-    bool drop = !ds->selected || in->seeking || ds->sh->attached_picture;
+    bool drop = (!ds->selected && ds->type != STREAM_SUB) || in->seeking ||
+                ds->sh->attached_picture;
 
     if (!drop) {
         // If libavformat splits packets, some packets will have pos unset, so
@@ -4093,6 +4097,44 @@ static void refresh_track(struct demux_internal *in, struct sh_stream *stream,
     struct demux_stream *ds = stream->ds;
     ref_pts = MP_ADD_PTS(ref_pts, -in->ts_offset);
+    // Sparse subtitle queues need not contain a packet at ref_pts. If the
+    // current range has already been demuxed through ref_pts, lavf has also
+    // delivered every embedded subtitle packet up to it.
+    struct demux_cached_range *range = in->current_range;
+    bool cache_covers_ref = range && ds->queue == range->streams[ds->index];
+    if (cache_covers_ref) {
+        double cache_start = range->seek_start != MP_NOPTS_VALUE
+            ? range->seek_start : ds->queue->seek_start;
+        bool starts_before_ref = range->is_bof ||
+            (cache_start != MP_NOPTS_VALUE && ref_pts >= cache_start);
+        bool ends_after_ref = range->is_eof ||
+            (range->seek_end != MP_NOPTS_VALUE && ref_pts <= range->seek_end);
+        ends_after_ref |= in->demux_ts != MP_NOPTS_VALUE &&
+                          in->demux_ts >= ref_pts;
+        cache_covers_ref = starts_before_ref && ends_after_ref;
+    }
+    if (ds->type == STREAM_SUB && cache_covers_ref) {
+        struct demux_packet *target = NULL;
+        for (struct demux_packet *dp = ds->queue->head; dp; dp = dp->next) {
+            double pts = MP_PTS_OR_DEF(dp->pts, dp->dts);
+            if (pts == MP_NOPTS_VALUE)
+                continue;
+            double duration = dp->duration > 0 ? dp->duration : dp->sub_duration;
+            double end = duration > 0 ? pts + duration : pts;
+            if (end >= ref_pts) {
+                target = dp;
+                break;
+            }
+        }
+        if (target) {
+            ds->reader_head = target;
+            ds->eof = false;
+            ds->skip_to_keyframe = false;
+            MP_VERBOSE(in, "using cached packets for stream %d at %f\n",
+                       stream->index, ref_pts);
+            return;
+        }
+    }
 
     if (in->back_demuxing)
         ds->back_seek_pos = ref_pts;
     // Avoid refresh seek for video streams except when immediately after a seek
diff --git a/demux/demux_lavf.c b/demux/demux_lavf.c
index ed55dd517..719ff4538 100644
--- a/demux/demux_lavf.c
+++ b/demux/demux_lavf.c
@@ -599,11 +599,27 @@ static void guess_and_set_vobsub_name(struct demuxer *demuxer, AVDictionary **d)
 static void select_tracks(struct demuxer *demuxer, int start)
 {
     lavf_priv_t *priv = demuxer->priv;
+    int switchable_subs = 0;
+
+    for (int n = 0; n < priv->num_streams; n++) {
+        struct sh_stream *stream = priv->streams[n]->sh;
+        if (stream && stream->type == STREAM_SUB && !stream->attached_picture)
+            switchable_subs++;
+    }
+
     for (int n = start; n < priv->num_streams; n++) {
         struct sh_stream *stream = priv->streams[n]->sh;
         AVStream *st = priv->avfc->streams[n];
         bool selected = stream && demux_stream_is_selected(stream) &&
                         !stream->attached_picture;
+        // Keep every embedded subtitle stream in the demux cache when there
+        // is a real choice of subtitle tracks.  Track switching can then use
+        // packets at the current playback position without a refresh seek.
+        if (switchable_subs > 1 && stream && stream->type == STREAM_SUB &&
+            !stream->attached_picture)
+        {
+            selected = true;
+        }
         if (!selected && priv->streams[n]->dovi_split) {
             struct sh_stream *el =
                 mp_dovi_split_el_stream(priv->streams[n]->dovi_split);
-- 
