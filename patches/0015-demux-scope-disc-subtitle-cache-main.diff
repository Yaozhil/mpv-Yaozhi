     in->tracks_switched = true;
     if (ds->selected)
@@ -4258,6 +4261,35 @@ bool demux_stream_is_selected(struct sh_stream *stream)
     return r;
 }
 
+bool demux_stream_get_selection_state(struct sh_stream *stream,
+                                      double *ref_pts)
+{
+    if (!stream) {
+        if (ref_pts)
+            *ref_pts = MP_NOPTS_VALUE;
+        return false;
+    }
+    struct demux_stream *ds = stream->ds;
+    mp_mutex_lock(&ds->in->lock);
+    bool selected = ds->selected;
+    if (ref_pts)
+        *ref_pts = ds->select_ref_pts;
+    mp_mutex_unlock(&ds->in->lock);
+    return selected;
+}
+
+bool demux_stream_is_selected_or_cached(struct sh_stream *stream)
+{
+    if (!stream)
+        return false;
+
+    struct demux_stream *ds = stream->ds;
+    mp_mutex_lock(&ds->in->lock);
+    bool readable = ds->selected || ds->cache_inactive;
+    mp_mutex_unlock(&ds->in->lock);
+    return readable;
+}
