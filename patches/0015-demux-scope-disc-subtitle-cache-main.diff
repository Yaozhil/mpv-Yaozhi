+static void update_inactive_subtitle_cache(demuxer_t *demuxer)
+{
+    struct priv *p = demuxer->priv;
+    int num_subtitles = 0;
+
+    for (int n = 0; n < p->num_streams; n++) {
+        struct sh_stream *sh = p->streams[n];
+        if (sh && sh->type == STREAM_SUB && !sh->attached_picture)
+            num_subtitles++;
+    }
+
+    p->cache_inactive_subtitles = num_subtitles > 1;
+    for (int n = 0; n < p->num_streams; n++) {
+        struct sh_stream *sh = p->streams[n];
+        if (sh && sh->type == STREAM_SUB) {
+            demuxer_set_stream_cache_inactive(
+                sh, p->cache_inactive_subtitles && !sh->attached_picture);
+        }
+    }
+}
