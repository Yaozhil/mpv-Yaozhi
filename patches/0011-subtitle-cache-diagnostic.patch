From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yaozhi mpv build <build@local.invalid>
Date: Wed, 19 Aug 2026 08:00:00 +0800
Subject: [PATCH] demux: diagnose inactive subtitle cache coverage

---
 demux/demux.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/demux/demux.c b/demux/demux.c
index 952a2f720..8a097b286 100644
--- a/demux/demux.c
+++ b/demux/demux.c
@@ -4117,6 +4117,16 @@ static void refresh_track(struct demux_internal *in, struct sh_stream *stream,
                           in->demux_ts >= cache_ref_pts;
         cache_covers_ref = starts_before_ref && ends_after_ref;
     }
+    MP_VERBOSE(in, "subtitle cache check stream=%d inactive=%d ref=%f cache_ref=%f "
+               "same_queue=%d range_start=%f range_end=%f demux_ts=%f "
+               "bof=%d eof=%d head=%d seekable_cache=%d\\n",
+               stream->index, ds->cache_inactive, ref_pts, cache_ref_pts,
+               range && ds->queue == range->streams[ds->index],
+               range ? range->seek_start : MP_NOPTS_VALUE,
+               range ? range->seek_end : MP_NOPTS_VALUE,
+               in->demux_ts, range ? range->is_bof : 0,
+               range ? range->is_eof : 0, !!ds->queue->head,
+               in->seekable_cache);
     if (ds->cache_inactive && cache_covers_ref) {
         // ref_pts includes mpv's subtitle preroll. PGS packets are sparse and
         // a visible composition can start before that preroll point, so resume
