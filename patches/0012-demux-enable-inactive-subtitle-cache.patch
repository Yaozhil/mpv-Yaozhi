From 19f54f77ce619c03c7f7e34cbcc6b6853973727c Mon Sep 17 00:00:00 2001
From: Codex Patch Check <codex-patch-check@local.invalid>
Date: Wed, 19 Aug 2026 09:29:29 +0800
Subject: [PATCH] demux: bound implicit subtitle cache prefetch

---
 demux/demux.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/demux/demux.c b/demux/demux.c
index f89158f23..ad35fac55 100644
--- a/demux/demux.c
+++ b/demux/demux.c
@@ -2574,13 +2574,13 @@ static void update_opts(struct demuxer *demuxer)
     int seekable = opts->seekable_cache;
     bool is_streaming = in->d_thread->is_streaming;
     bool use_cache = is_streaming || in->cache_inactive_streams;
-    bool implicit_subtitle_cache = in->cache_inactive_streams &&
-                                   !is_streaming && opts->enable_cache < 0;
     if (opts->enable_cache >= 0)
         use_cache = opts->enable_cache == 1;
 
     if (use_cache) {
-        if (!implicit_subtitle_cache)
+        if (in->cache_inactive_streams && !is_streaming && opts->enable_cache < 0)
+            in->min_secs = MPMIN(in->min_secs, 30.0);
+        else
             in->min_secs = MPMAX(in->min_secs, opts->min_secs_cache);
         if (seekable < 0)
             seekable = 1;
-- 
